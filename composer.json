{
    "name": "catto-learning/lms",
    "description": "Open-source learning commerce and delivery platform built with PHP, Symfony, Twig and PostgreSQL.",
    "type": "project",
    "require": {
        "php": ">=8.5.9 <9.0",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-zip": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "dompdf/dompdf": "^3",
        "friendsofphp/proxy-manager-lts": "^1.0.19",
        "geocoder-php/geoip2-provider": "^4.0",
        "league/omnipay": "^3",
        "mcp/sdk": "^0.7",
        "omnipay/dummy": "^3",
        "psr/container": "^2.0",
        "robmorgan/phinx": "^0.16",
        "symfony/asset-mapper": "8.1.*",
        "symfony/cache": "8.1.*",
        "symfony/clock": "8.1.*",
        "symfony/config": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/doctrine-bridge": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/error-handler": "8.1.*",
        "symfony/event-dispatcher": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/finder": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/mailer": "^8.1",
        "symfony/mime": "8.1.*",
        "symfony/password-hasher": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-core": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/security-http": "8.1.*",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/stopwatch": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/twig-bridge": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/type-info": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/var-dumper": "8.1.*",
        "symfony/var-exporter": "8.1.*",
        "symfony/workflow": "8.1.*",
        "symfony/yaml": "8.1.*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "CattoLearning\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CattoLearning\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.5.9"
        }
    },
    "scripts": {
        "analyse": "php -d memory_limit=-1 vendor/bin/phpstan analyse",
        "migrate": "vendor/bin/phinx migrate -c phinx.php -e development",
        "migrations:status": "vendor/bin/phinx status -c phinx.php -e development",
        "test": "vendor/bin/phpunit",
        "architecture:check": "php tools/check-architecture.php",
        "release:validate": "php tools/validate-release.php",
        "api-token:create": "php tools/create-api-token.php",
        "api-token:list": "php tools/list-api-tokens.php",
        "mcp:serve": "php tools/mcp-server.php",
        "api-token:revoke": "php tools/revoke-api-token.php",
        "runtime:check": "php tools/check-runtime-hazards.php",
        "test-suite:check": "php tools/check-test-suite.php",
        "test:unit": "vendor/bin/phpunit --testsuite Unit",
        "test:architecture": "vendor/bin/phpunit --testsuite Architecture",
        "test:integration": "vendor/bin/phpunit --testsuite Integration",
        "qa": [
            "@test-suite:check",
            "@test",
            "@analyse",
            "@architecture:check",
            "@runtime:check",
            "php tools/validate-ui-contracts.php",
            "@release:validate"
        ],
        "themes:sync": "php tools/sync-themes.php",
        "themes:install": "php tools/install-bundled-themes.php",
        "themes:package": "php tools/package-bundled-themes.php",
        "seeds:publish": "php tools/publish-seed-names.php",
        "seeds:generate": "php tools/seed-generate.php",
        "smoke:install": [
            "php tools/reset-development-database.php --force",
            "@migrate",
            "@migrations:status",
            "@themes:install",
            "@themes:sync",
            "@seeds:publish",
            "php tools/smoke-app-boot.php"
        ],
        "test:commerce": "vendor/bin/phpunit --group commerce"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Richard Catto",
            "role": "Project creator and maintainer"
        }
    ],
    "version": "0.8",
    "extra": {
        "public-dir": "public_html"
    }
}
