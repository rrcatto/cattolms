APP_ENV=development
APP_DEBUG=true
APP_KEY=replace-with-64-cryptographically-random-hexadecimal-characters
# Initial/default Platform name. Administration → Settings may override this in PostgreSQL.
APP_NAME="Your Site Name"
APP_DOMAIN=learning.example.test
APP_URL=https://learning.example.test
APP_ADMIN_EMAIL=administrator@example.test
APP_TIMEZONE=Africa/Johannesburg

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=catto_learning
DB_USER=catto_learning
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# Initial/default outgoing mail configuration. Administration → Settings may override
# these MAIL_* values in PostgreSQL. URL-encode reserved DSN credentials.
MAILER_DSN=smtp://username:password@smtp.example.test:587
MAIL_FROM_ADDRESS=learning@example.test
MAIL_FROM_NAME="Your Site Name"
# Leave blank to receive replies at MAIL_FROM_ADDRESS.
MAIL_REPLY_TO=

AUTH_MAGIC_LINK_TTL=1800
AUTH_SESSION_TTL=86400
AUTH_SESSION_TOUCH_INTERVAL=300
AUTH_SESSION_COOKIE=catto_learning_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_REQUEST_WINDOW=900
AUTH_REQUEST_LIMIT_EMAIL=5
AUTH_REQUEST_LIMIT_IP=20

PHP_SESSION_COOKIE=catto_learning_web
PHP_SESSION_TTL=86400
PHP_SESSION_SECURE=true

# Optional comma-separated additions to the built-in company public-webmail denylist.
COMPANY_PUBLIC_EMAIL_DOMAINS_EXTRA=

# CATTO_LEARNING_API_TOKEN is supplied to the local MCP process at launch.
# Do not place a real token in a public or committed configuration file.
# Optional local GeoLite2/GeoIP2 City database used by Geocoder PHP for
# Administration → Activity IP-location labels. Leave blank to disable GeoIP.
GEOIP_DATABASE=

# --- Seed Database (v0.5.8) -------------------------------------------------
# The shared SEED System Company. It is created once by the baseline migration and is the
# default company for generated identities; cleaning up a seed set never removes it.
#
# SEED_SYSTEM_COMPANY_DOMAIN must differ from APP_DOMAIN, because companies.domain is unique
# across the whole platform, and it must be a domain you actually receive mail for.
#
# Generated companies each get a synthetic domain ending in .seed.invalid, which RFC 2606
# reserves so it can never resolve. A generated address is stored and displayed with that
# synthetic domain, but mail to it is delivered to the local part at
# SEED_SYSTEM_COMPANY_DOMAIN instead - so one real inbox receives every seed message and an
# un-rewritten address bounces rather than reaching a stranger.
#
# Leave SEED_SYSTEM_COMPANY_DOMAIN blank to disable the rewrite entirely; seed mail then
# simply cannot be delivered, which is a safe default for an installation that never signs in
# as a generated identity.
SEED_SYSTEM_COMPANY_NAME="SEED System Company"
SEED_SYSTEM_COMPANY_DOMAIN=seed.learning.example.test
