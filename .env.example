APP_ENV=development
APP_DEBUG=true
APP_KEY=replace-with-64-cryptographically-random-hexadecimal-characters
# Initial/default Platform name. Administration → Settings may override this in PostgreSQL.
APP_NAME="Your Site Name"
APP_DOMAIN=learning.example.test
APP_URL=https://learning.example.test
APP_DEFAULT_THEME=default
APP_ADMIN_EMAIL=administrator@example.test
APP_TIMEZONE=Africa/Johannesburg

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=catto_learning
DB_USER=catto_learning
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# Initial/default outgoing mail configuration. Administration → Settings may override
# these MAIL_* values in PostgreSQL. URL-encode reserved DSN credentials.
MAILER_DSN=smtp://username:password@smtp.example.test:587
MAIL_FROM_ADDRESS=learning@example.test
MAIL_FROM_NAME="Your Site Name"
# Leave blank to receive replies at MAIL_FROM_ADDRESS.
MAIL_REPLY_TO=

AUTH_MAGIC_LINK_TTL=1800
AUTH_SESSION_TTL=86400
AUTH_SESSION_TOUCH_INTERVAL=300
AUTH_SESSION_COOKIE=catto_learning_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_REQUEST_WINDOW=900
AUTH_REQUEST_LIMIT_EMAIL=5
AUTH_REQUEST_LIMIT_IP=20

PHP_SESSION_COOKIE=catto_learning_web
PHP_SESSION_TTL=86400
PHP_SESSION_SECURE=true

# Optional comma-separated additions to the built-in company public-webmail denylist.
COMPANY_PUBLIC_EMAIL_DOMAINS_EXTRA=

# CATTO_LEARNING_API_TOKEN is supplied to the local MCP process at launch.
# Do not place a real token in a public or committed configuration file.