# Lengths of time are written one way everywhere, here and in Administration > Settings: a whole number
# and a letter for each unit, largest first, with no spaces: y years, w weeks, d days, h hours, m minutes
# and s seconds, such as 3y, 4w2d, 1h30m or 90s (m is minutes, never months). From a date, a year is a
# calendar year (the same date next year); as a fixed length, a year is 365 days.

# How the program runs. development: a server error shows its reason, templates are rebuilt when they change and
# every database query is logged. production: none of that. Anything but production is development. It does not say
# whether the site is real (APP_SITE_MODE does). An install keeps it as it is; only the site's owner changes it.
APP_ENV=development
# demo or live. A demo site (test, development or a public demonstration) says so on every page
# and email, keeps out of search engines, marks every order and its documents as a simulation, shows fake
# bank details labelled as fake and offers the simulated card. A live site takes real orders. Anything
# but live, or no value, is demo. Administration → Settings → Site mode may override this.
APP_SITE_MODE=demo
APP_KEY=replace-with-64-cryptographically-random-hexadecimal-characters
# Initial/default Platform name. Administration → Settings may override this in PostgreSQL.
APP_NAME="Your Site Name"
# The domain this installation answers on. Seed Database companies get generated domains ending in
# .invalid; mail to their people is delivered to the same local part at this domain instead.
# The public legal pages (/terms, /refunds, /privacy) print it as the supplier's website.
APP_DOMAIN=learning.example.test
APP_URL=https://learning.example.test

# Absolute path to the deployed code root, which is the directory holding vendor/.
# The web root reads this to locate the application, so a release can be switched by
# repointing the symlink this names rather than by editing the front controller.
APP_CODEBASE_PATH=/usr/local/lib/php/cattolms/current
# The administrator's address. The public legal pages print it as the supplier's email address and
# as the address refund requests and privacy questions are sent to.
APP_ADMIN_EMAIL=administrator@example.test
APP_TIMEZONE=Africa/Johannesburg
# The Site Owner: the business hosting the site, which the legal pages, invoices, receipts, credit notes,
# certificates and EFT instructions name. Administration → Settings → Site Owner may override each value.
# The email address is APP_ADMIN_EMAIL and the website APP_DOMAIN. SITE_OWNER_LEGAL_FORM is company or
# sole_proprietor; SITE_OWNER_REGISTRATION_NUMBER applies to a company. The address may be written on one
# line with commas. Placeholders only: never commit a real business's details.
SITE_OWNER_TRADING_NAME="Example Learning"
SITE_OWNER_LEGAL_NAME="Example Learning (Pty) Ltd"
SITE_OWNER_LEGAL_FORM=company
SITE_OWNER_REGISTRATION_NUMBER=2026/000000/07
SITE_OWNER_TAX_NUMBER=
SITE_OWNER_ADDRESS="1 Example Street, Example Town, 0000, Example Province, South Africa"
SITE_OWNER_PHONE="+27 00 000 0000"
SITE_OWNER_INFORMATION_OFFICER="Example Information Officer"
# Leave empty for "None"; otherwise name the bodies and codes of conduct, or the accreditation.
SITE_OWNER_MEMBERSHIPS=
SITE_OWNER_ACCREDITATION=
# The bank account customers pay into by EFT: all four, or none.
SITE_OWNER_BANK_NAME=
SITE_OWNER_BANK_ACCOUNT_NAME=
SITE_OWNER_BANK_ACCOUNT_NUMBER=
SITE_OWNER_BANK_BRANCH_CODE=
# Where this installation trades, and in what.
# APP_LOCALE decides how money and dates are formatted; APP_CURRENCY is an ISO 4217 code and
# APP_COUNTRY an ISO 3166-1 alpha-2 code. The currency symbol is deliberately not configured: PHP's
# intl extension derives it from the code and the locale, along with symbol placement and the
# thousands and decimal separators, which a hand-set symbol gets wrong the moment a second country
# is added.
APP_LOCALE=en_ZA
APP_CURRENCY=ZAR
APP_COUNTRY=ZA
# VAT is not charged until this is set. Prices are stored and entered EXCLUDING VAT; the interface
# adds it and shows the inclusive figure. A rate of 0 means no VAT line and no tax invoice.
APP_VAT_RATE=0

# Commerce settings. Each is the default; Administration → Settings → Commerce may override it in
# PostgreSQL. The legal pages print the periods and fees in force, and a change applies to later
# purchases only. Fees are a percentage plus a fixed amount in cents (2.9%+150 is 2.9% plus R1.50);
# the EFT refund fee is amount:fee tiers in cents (0:2000,1000000:10000 is R20 under R10,000 and
# R100 from R10,000). Periods are lengths of time, written as the top of this file says.
COMMERCE_STITCH_FEE=0%+0
COMMERCE_STITCH_REFUND_FEE=0%+0
COMMERCE_EFT_REFUND_FEE=0:2000,1000000:10000
# The letters that start every new account reference (1 to 3 capital letters).
COMMERCE_ACCOUNT_PREFIX=CL
COMMERCE_WALLET_EXPIRY=3y
COMMERCE_WALLET_REMINDER=30d
COMMERCE_REFUND_WINDOW=7d
COMMERCE_PAYMENT_DUE=7d
COMMERCE_PAYMENT_LINK_LIFETIME=1h

# Card payments through Stitch. Administration > Settings > Payment methods can tick card only when both
# keys are set (and once the Stitch connection is built). Keep the real keys in .env, never here.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=

# Identity verification through Didit's hosted page (https://business.didit.me), needed only before a
# certificate and transcript are issued. Until all three are set (a value that still starts with
# replace-with- counts as not set), verification is not available and certificates wait. Enter the
# webhook address Administration > Settings > Identity verification shows
# (https://<your domain>/webhooks/didit) as the destination in the Didit console, subscribed to
# status.updated, and copy its secret_shared_key here as DIDIT_WEBHOOK_SECRET.
DIDIT_API_KEY=replace-with-your-didit-api-key
DIDIT_WORKFLOW_ID=replace-with-your-didit-workflow-id
DIDIT_WEBHOOK_SECRET=replace-with-your-didit-webhook-secret

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=catto_learning
DB_USER=catto_learning
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# Initial/default outgoing mail configuration. Administration → Settings may override
# these MAIL_* values in PostgreSQL. URL-encode reserved DSN credentials.
MAILER_DSN=smtp://username:password@smtp.example.test:587
MAIL_FROM_ADDRESS=learning@example.test
MAIL_FROM_NAME="Your Site Name"
# Leave blank to receive replies at MAIL_FROM_ADDRESS.
MAIL_REPLY_TO=

# News to the people who asked for it (Administration → Settings → Mailing overrides each). It comes from its own
# address on its own subdomain, and its stop, open and click links use that subdomain too, so a news campaign's
# reputation never touches the order and sign-in emails. Blank: the MAIL_* sender and APP_URL.
MAILING_FROM_ADDRESS=news@news.example.test
MAILING_FROM_NAME="Your Site Name"
MAILING_LINK_BASE=https://news.example.test
# smtp (MAILING_DSN, or MAILER_DSN when blank) or cattomail (its API below).
MAILING_TRANSPORT=smtp
MAILING_DSN=
CATTOMAIL_API_BASE_URL=
CATTOMAIL_API_KEY=
CATTOMAIL_WEBHOOK_SECRET=
CATTOMAIL_WEBHOOK_SECRET_PREVIOUS=

# How long a sign-in link lasts, how long a session lasts, and how often a session in use is renewed.
AUTH_MAGIC_LINK_TTL=30m
AUTH_SESSION_TTL=1d
AUTH_SESSION_TOUCH_INTERVAL=5m
AUTH_SESSION_COOKIE=catto_learning_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
# Sign-in link requests are limited per email address and per IP address within this window.
AUTH_REQUEST_WINDOW=15m
AUTH_REQUEST_LIMIT_EMAIL=5
AUTH_REQUEST_LIMIT_IP=20
# Who may sign in. ADMIN: only administrators (APP_ADMIN_EMAIL and ADMIN accounts) and the addresses listed below.
# EVERYONE: everyone. With no value, any other value or no AUTH_SIGNIN at all, it is ADMIN.
# Administration > Settings > Who can sign in overrides both, and its Reset returns to them.
AUTH_SIGNIN=ADMIN
# Addresses that may sign in under ADMIN, separated by commas. Without it, none.
AUTH_SIGNIN_ALLOWED_EMAILS=
# The sign-up check's countries, as two-letter codes separated by commas (ZA, NA), judged by the country of the visitor's
# IP address. A registration from a blocked country may register like anyone else and is held for the administrator's
# approval without being told why; one from outside the allowed countries is only a warning sign on Sign-up Attempts.
# Empty allowed: every country. Administration > Settings > Sign-up checks overrides both.
SIGNUP_ALLOWED_COUNTRIES=
SIGNUP_BLOCKED_COUNTRIES=

PHP_SESSION_COOKIE=catto_learning_web
PHP_SESSION_TTL=1d
# The application log (storage/logs/application.log), and any other log beside it, is moved into storage/logs/archive
# and compressed just after midnight every day, and started afresh. Archives older than this are deleted: a length of time, written as the top of
# this file says (2w is two weeks). Administration > Settings > Maintenance overrides it.
LOG_ARCHIVES_KEPT_FOR=2w
PHP_SESSION_SECURE=true

# Optional comma-separated additions to the built-in company public-webmail denylist.
COMPANY_PUBLIC_EMAIL_DOMAINS_EXTRA=

# CATTO_LEARNING_API_TOKEN is supplied to the local MCP process at launch.
# Do not place a real token in a public or committed configuration file.
# Optional local GeoLite2/GeoIP2 City database (a free MaxMind account downloads it) for the countries
# Administration shows and the sign-up check reads. Put GeoLite2-ASN.mmdb in the same folder for the network
# names. Leave blank to disable GeoIP.
GEOIP_DATABASE=
