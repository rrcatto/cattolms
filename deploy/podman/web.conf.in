# CattoLMS's web server inside the pod (deploy/podman/README.md), written by cattolms-podman.sh from this template:
# @SITE@ is the site's home directory. The server's own web server answers the public on 80 and 443, holds the
# certificate and forwards the site here (127.0.0.1 only), with the Host, X-Forwarded-For and X-Forwarded-Proto headers.

# The request was HTTPS when the server's web server says so.
map $http_x_forwarded_proto $cattolms_https {
    https on;
    default "";
}

server {
    listen 8080;
    server_name _;

    root @SITE@/public_html;
    index index.php index.html;
    client_max_body_size 64M;
    server_tokens off;

    # Only the server's own web server can reach this port, so the visitor's address is the one it forwards.
    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ "\.php(/|$)" {
        try_files $fastcgi_script_name =404;
        fastcgi_split_path_info "^(.+\.php)(/.+)$";
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS $cattolms_https if_not_empty;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        # As long as the server's web server waits (proxy_read_timeout 180s): a long request, such as importing a
        # catalogue package of many courses, is answered, not cut off at nginx's default 60 seconds.
        fastcgi_read_timeout 180s;
        fastcgi_pass 127.0.0.1:9000;
    }

    location ~ /\. {
        deny all;
    }
}
