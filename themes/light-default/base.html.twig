<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ page.title ?: app.name }} · {{ app.name }}</title>
		<meta name="description" content="Structured self-study courses, progress tracking and assessments.">
		<meta name="theme-color" content="#f3f5f8">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		{% for resourceUrl in platform.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.external_styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		<noscript>
			<style>.tab-panel{display:block!important}.panel-tabs{display:none}.ld-nav{display:block}.ld-burger{display:none}</style>
		</noscript>
	</head>
	<body class="ld-body ld-family-{{ page.type ?: 'content' }} {{ page.body_class }} {{ course_content_mode ? 'cl-course-page' : '' }}">
		<a class="ld-skip" href="#ld-main">Skip to content</a>
		<header class="ld-topbar">
			<div class="ld-topbar-inner">
				<a class="ld-brand" href="{{ app.base_url }}">
				<span class="ld-mark" aria-hidden="true"><svg class="ld-ico"><use href="{{ theme.asset_url }}/img/icons.svg#ld-mark"></use></svg></span>
				<span class="ld-brand-copy">
				<strong class="ld-brand-name">{{ app.name }}</strong>
				<small class="ld-brand-sub">{{ page.subtitle ?: 'Learning platform' }}</small>
				</span>
				</a>
				<button class="ld-burger" type="button" data-ld-nav-toggle aria-expanded="false" aria-controls="ld-primary-nav">
				<svg class="ld-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#ld-menu"></use></svg>
				<span>Menu</span>
				</button>
				{% include '@theme/partials/navigation.html.twig' %}
				{% if user.logged_in %}
					<span class="ld-status" title="{{ user.name }}"><i aria-hidden="true"></i><span>{{ user.name }}</span></span>
				{% endif %}
			</div>
		</header>
		<div class="ld-stage">
			<div class="ld-shell">
				<div class="ld-frame">
					<div class="ld-frame-chrome">
						<svg class="ld-ico ld-chrome-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#ld-location"></use></svg>
						{% if breadcrumbs|length > 0 %}
							<nav class="ld-crumbs" aria-label="Breadcrumb">
								{% for crumb in breadcrumbs %}
									{% if crumb.current %}
										<span class="ld-crumb ld-crumb-current" aria-current="page">{{ crumb.label }}</span>
									{% else %}
										<a class="ld-crumb" href="{{ crumb.href }}">{{ crumb.label }}</a><span class="ld-crumb-sep" aria-hidden="true">/</span>
									{% endif %}
								{% endfor %}
							</nav>
						{% else %}
							<span class="ld-crumbs"><span class="ld-crumb ld-crumb-current">{{ page.title }}</span></span>
						{% endif %}
						{% if theme_preview_active %}
							<span class="ld-chrome-flag">Theme preview</span>
						{% endif %}
					</div>
					{% include '@theme/partials/flash.html.twig' %}
					<main class="ld-main" id="ld-main">
						{% block page_content %}
							{% block page_body %}
							{% endblock %}
						{% endblock %}
					</main>
				</div>
				{% include '@theme/partials/footer.html.twig' %}
			</div>
		</div>
		{% for resourceUrl in platform.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.external_scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
	</body>
</html>
