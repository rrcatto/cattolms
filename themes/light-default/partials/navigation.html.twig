{#
  Primary navigation is rendered entirely from the core-supplied @navigation
  hierarchy. The theme owns icon artwork and presentation only: it never
  maintains its own route catalogue and never decides who may see an item.
  Items supplied as POST keep their method and CSRF token.
#}
<nav class="ld-nav" id="ld-primary-nav" aria-label="Primary navigation">
	{% for item in navigation %}
		{% if item.children|length > 0 %}
			<details class="ld-menu {{ item.active ? 'is-active' : '' }}" data-cl-dropdown data-nav-item="{{ item.key }}">
				<summary class="ld-nav-link">
					<svg class="ld-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ item.icon_id }}"></use></svg>
					<span>{{ item.label }}</span>
					<svg class="ld-ico ld-caret" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#ld-chevron"></use></svg>
				</summary>
				<div class="ld-menu-panel cl-nav-panel">
					<nav aria-label="{{ item.label }}">
						{% for child in item.children %}
							{% if child.children|length > 0 %}
								<div class="nav-group nav-flyout-edge {{ child.active ? 'nav-group-current' : '' }}" data-nav-item="{{ child.key }}">
									<button class="nav-group-label" type="button" aria-haspopup="true">
									<svg class="ld-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg>
									<span>{{ child.label }}</span>
									<span class="nav-group-caret" aria-hidden="true">&rsaquo;</span>
									</button>
									<div class="nav-subpanel cl-nav-panel">
										{% for grandchild in child.children %}
											<a class="ld-menu-link nav-sublink {{ grandchild.active ? 'active' : '' }}" href="{{ grandchild.href }}" data-nav-item="{{ grandchild.key }}">
											<svg class="ld-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ grandchild.icon_id }}"></use></svg>
											<span>{{ grandchild.label }}</span>
											</a>
										{% endfor %}
									</div>
								</div>
							{% else %}
								<a class="ld-menu-link {{ child.active ? 'active' : '' }}" href="{{ child.href }}" data-nav-item="{{ child.key }}">
								<svg class="ld-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg>
								<span>{{ child.label }}</span>
								</a>
							{% endif %}
						{% endfor %}
					</nav>
				</div>
			</details>
		{% else %}
			{% if item.method == 'POST' %}
				<form class="ld-nav-form" action="{{ item.href }}" method="post" data-nav-item="{{ item.key }}">
					<input type="hidden" name="csrf" value="{{ item.csrf }}">
					<button class="ld-nav-link ld-nav-post" type="submit">
					<svg class="ld-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ item.icon_id }}"></use></svg>
					<span>{{ item.label }}</span>
					</button>
				</form>
			{% else %}
				<a class="ld-nav-link {{ item.key == 'signin' ? 'ld-nav-cta' : '' }} {{ item.active ? 'is-active' : '' }}" href="{{ item.href }}" data-nav-item="{{ item.key }}">
				<svg class="ld-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ item.icon_id }}"></use></svg>
				<span>{{ item.label }}</span>
				</a>
			{% endif %}
		{% endif %}
	{% endfor %}
</nav>
