<footer class="cl-footer">
				<div class="cl-footer-inner">
<div class="cl-footer-grid">
					<section class="cl-footer-section">
						<div class="fs-footer-brand">
						<span class="cl-brand-mark">CL</span>
						<div>
							<strong>{{ app.name }}</strong><span>Learn at your own pace</span>
						</div>
						</div>
						<p>
						Focused self-study courses with clear progress, meaningful assessment and secure access.
						</p>
					</section>
					<section class="cl-footer-section"><h2>Explore</h2>
<nav class="cl-footer-nav" aria-label="Footer navigation">
{% for item in footer_navigation %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}
</nav>
</section>
<section class="cl-footer-section">
						<h2>
						Follow
						</h2>
						<div class="cl-footer-social" aria-label="Social media">
						{# The marks and their addresses are Core's (footer_social): each platform's home page until the
						   settings give a profile address. #}
						{% for mark in footer_social|default([]) %}
						<a href="{{ mark.href }}" aria-label="{{ mark.label }}" rel="noopener noreferrer" target="_blank"><svg class="cl-footer-social-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#social-{{ mark.key }}"></use></svg></a>
						{% endfor %}
						</div>
					</section>
				</div>
				<div class="fs-footer-bottom">
					© 2026 {{ app.name }} · All rights reserved.
				</div>
			</div>
</footer>
