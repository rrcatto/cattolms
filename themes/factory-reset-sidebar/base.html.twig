<!doctype html>
<html lang="en-ZA">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ title }} · {{ app.name }}</title>
		<meta name="description" content="Structured self-study courses, progress tracking and assessments.">
		{% for resourceUrl in platform.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.external_styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
	</head>
	<body class="factory-sidebar-theme {{ page.body_class }} {{ course_content_mode ? 'cl-course-page' : '' }}">
		<div class="fs-shell">
			<aside class="sidebar fs-sidebar" id="sidebar" data-theme-nav>
				<a class="brand fs-brand" href="/" aria-label="{{ app.name }} home">
				<span class="brand-mark">CL</span>
				<span><strong>{{ app.name }}</strong><small>Learning platform</small></span>
				</a>
				<div class="side-label">
					Navigation
				</div>
				<nav class="side-nav" aria-label="Primary">
					{% for nav in navigation %}
						{% if nav.children|length > 0 %}
							<details class="fs-submenu {{ nav.active ? 'active' : '' }}" data-nav-item="{{ nav.key }}" data-cl-dropdown {{ nav.active ? 'open' : '' }}>
								<summary class="nav-link">
									<svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ nav.icon_id }}"></use></svg><span>{{ nav.label }}</span><span class="fs-chevron">⌄</span>
								</summary>
								<nav class="fs-submenu-panel" aria-label="{{ nav.label }}">
									{% for child in nav.children %}
										{% if child.children|length > 0 %}
											<div class="nav-group {{ child.active ? 'nav-group-current' : '' }}" data-nav-item="{{ child.key }}">
												<button class="nav-group-label" type="button" aria-haspopup="true"><svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg>{{ child.label }}<span class="nav-group-caret" aria-hidden="true">&rsaquo;</span></button>
												<div class="nav-subpanel">
													{% for grandchild in child.children %}
														<a class="nav-sublink {{ grandchild.active ? 'active' : '' }}" href="{{ grandchild.href }}" data-nav-item="{{ grandchild.key }}"><svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ grandchild.icon_id }}"></use></svg>{{ grandchild.label }}</a>
													{% endfor %}
												</div>
											</div>
										{% else %}
											<a class="{{ child.active ? 'active' : '' }}" href="{{ child.href }}" data-nav-item="{{ child.key }}"><svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg>{{ child.label }}</a>
										{% endif %}
									{% endfor %}
								</nav>
							</details>
						{% endif %}
						{% if nav.children|length == 0 and nav.method != 'POST' %}
							<a class="nav-link {{ nav.active ? 'active' : '' }}" href="{{ nav.href }}" data-nav-item="{{ nav.key }}"><svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ nav.icon_id }}"></use></svg>{{ nav.label }}</a>
						{% endif %}
						{% if nav.method == 'POST' %}
							<form action="{{ nav.href }}" method="post" data-nav-item="{{ nav.key }}">
								<input type="hidden" name="csrf" value="{{ nav.csrf }}">
								<button class="nav-link" type="submit"><svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ nav.icon_id }}"></use></svg>{{ nav.label }}</button>
							</form>
						{% endif %}
					{% endfor %}
				</nav>
			</aside>
			<div class="main fs-main">
				<header class="topbar fs-topbar">
					<div class="fs-topbar-left">
						<button class="icon-btn mobile-menu" id="mobileMenu" type="button" aria-label="Open navigation">☰</button>
						<nav class="fs-breadcrumbs" aria-label="Breadcrumb">
							{% for crumb in breadcrumbs %}
								{% if crumb.current %}
									<span class="fs-breadcrumb-current" aria-current="page">{{ crumb.label }}</span>
								{% else %}
									<a href="{{ crumb.href }}">{{ crumb.label }}</a><span class="fs-breadcrumb-separator" aria-hidden="true">/</span>
								{% endif %}
							{% endfor %}
						</nav>
					</div>
					<div class="fs-account-actions">
						{% if is_authenticated %}
							<a class="fs-profile-link" href="/account/profile">Profile</a>
							<form action="/logout" method="post">
								<input type="hidden" name="csrf" value="{{ csrf }}">
								<button class="btn btn-soft btn-sm" type="submit">Logout</button>
							</form>
						{% else %}
							<a class="btn btn-primary btn-sm" href="/login">Register / Sign in</a>
						{% endif %}
					</div>
				</header>
				<main class="content fs-content">
					{% include '@theme/partials/flash.html.twig' %}
					{% block page_content %}
						{% block page_body %}
						{% endblock %}
					{% endblock %}
				</main>
			</div>
			<footer class="fs-footer">
				<div class="fs-footer-grid">
					<section>
						<div class="fs-footer-brand">
						<span class="brand-mark">CL</span>
						<div>
							<strong>{{ app.name }}</strong><span>Learn at your own pace</span>
						</div>
						</div>
						<p>
						Focused self-study courses with clear progress, meaningful assessment and secure access.
						</p>
					</section>
					<section>
						<h2>
						Learning
						</h2>
						<a href="/courses">Course catalogue</a>
						{% if is_authenticated %}
						<a href="/account/library">My Learning</a>
						{% endif %}
						<a href="/help">Help Centre</a>
					</section>
					<section>
						<h2>
						Information
						</h2>
						<a href="/privacy">Privacy</a>
						<a href="/contact">Contact us</a>
						{% if not is_authenticated %}
						<a href="/login">Register / Sign in</a>
						{% endif %}
					</section>
					<section>
						<h2>
						Follow
						</h2>
						<div class="fs-socials" aria-label="Social media">
						<span title="Facebook" aria-label="Facebook">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-9h3l.5-3h-3.5V8.1c0-.9.3-1.6 1.7-1.6H17V3.8c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5V10H7v3h3v9h3.5z"/></svg>
						</span>
						<span title="LinkedIn" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.4 7.5A2.1 2.1 0 1 1 5.4 3.3a2.1 2.1 0 0 1 0 4.2zM3.6 9h3.6v11.4H3.6V9zm5.8 0h3.4v1.6h.1c.5-.9 1.7-2 3.6-2 3.8 0 4.5 2.5 4.5 5.8v6h-3.6v-5.3c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.4H9.4V9z"/></svg>
						</span>
						<span title="YouTube" aria-label="YouTube">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.2a3 3 0 0 0-2.1-2.1C17.7 4.6 12 4.6 12 4.6s-5.7 0-7.5.5a3 3 0 0 0-2.1 2.1A31 31 0 0 0 1.9 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.8.5 7.5.5 7.5.5s5.7 0 7.5-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM10 15.4V8.6l6 3.4-6 3.4z"/></svg>
						</span>
						<span title="Instagram" aria-label="Instagram">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 2h9.6A5.2 5.2 0 0 1 22 7.2v9.6a5.2 5.2 0 0 1-5.2 5.2H7.2A5.2 5.2 0 0 1 2 16.8V7.2A5.2 5.2 0 0 1 7.2 2zm0 1.8a3.4 3.4 0 0 0-3.4 3.4v9.6a3.4 3.4 0 0 0 3.4 3.4h9.6a3.4 3.4 0 0 0 3.4-3.4V7.2a3.4 3.4 0 0 0-3.4-3.4H7.2zm10.1 1.4a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4zM12 6.8A5.2 5.2 0 1 1 12 17.2 5.2 5.2 0 0 1 12 6.8zm0 1.8A3.4 3.4 0 1 0 12 15.4 3.4 3.4 0 0 0 12 8.6z"/></svg>
						</span>
						</div>
						<p class="fs-social-note">
						Social profile links can be added when the official profile URLs are defined.
						</p>
					</section>
				</div>
				<div class="fs-footer-bottom">
					© 2026 {{ app.name }} · All rights reserved.
				</div>
			</footer>
		</div>
		{% for resourceUrl in platform.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.external_scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
	</body>
</html>
