<footer class="gn-footer">
	<div class="gn-footer-art" aria-hidden="true">
	</div>
	<div class="gn-footer-veil" aria-hidden="true">
	</div>
	<div class="gn-footer-inner">
		<div class="gn-footer-grid gn-footer-grid-v113">
			<section class="gn-footer-lead">
				<h3>
					{{ app_name }}
				</h3>
				<p>
					Structured self-study courses, measurable progress, assessments and certificates in one learning account.
				</p>
				<div class="gn-social" aria-label="Social media and contact links">
					<a href="#" aria-label="Facebook"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-facebook"></use></svg></a>
					<a href="#" aria-label="Threads"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-threads"></use></svg></a>
					<a href="#" aria-label="X"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-x"></use></svg></a>
					<a href="#" aria-label="Instagram"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-instagram"></use></svg></a>
					<a href="#" aria-label="LinkedIn"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-linkedin"></use></svg></a>
					<a href="#" aria-label="YouTube"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-youtube"></use></svg></a>
					<a href="#" aria-label="WhatsApp"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-whatsapp"></use></svg></a>
					<a href="/contact" aria-label="Email / contact"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-email"></use></svg></a>
				</div>
			</section>
			<section class="gn-footer-links">
				<h4>
					Explore
				</h4>
				<ul>
					{% for footerItem in footer_navigation %}
						<li>
							<a href="{{ footerItem.href }}">{{ footerItem.label }}</a>
						</li>
					{% endfor %}
				</ul>
			</section>
			<section class="gn-footer-contact">
				<h4>
					Get in touch
				</h4>
				<p>
					Questions about a course, your account or company learning? Send us a message.
				</p>
				{{ ui('action.link', {label: 'Open the contact form', href: '/contact', variant: 'primary'}) }}
			</section>
		</div>
		<div class="gn-footnote">
			<span>&copy; 2026 Richard Catto</span>
			<span class="gn-footnote-mark">{{ theme.name }} {{ theme.version }}</span>
		</div>
	</div>
</footer>
