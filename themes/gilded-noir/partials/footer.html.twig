<footer class="cl-footer">
	<div class="gn-footer-art" aria-hidden="true">
	</div>
	<div class="gn-footer-veil" aria-hidden="true">
	</div>
	<div class="cl-footer-inner">
		<div class="cl-footer-grid">
			<section class="cl-footer-section cl-footer-section-lead">
				<h3>
					{{ app_name }}
				</h3>
				<p>
					Structured self-study courses, measurable progress, assessments and certificates in one learning account.
				</p>
				<div class="cl-footer-social" aria-label="Social media and contact links">
					{# The marks and their addresses are Core's (footer_social): each platform's home page until the
					   settings give a profile address. The drawings are this theme's own sprite. #}
					{% for mark in footer_social|default([]) %}
					<a href="{{ mark.href }}" aria-label="{{ mark.label }}" rel="noopener noreferrer" target="_blank"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-{{ mark.key }}"></use></svg></a>
					{% endfor %}
					<a href="/contact" aria-label="Email / contact"><svg class="gn-social-icon" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#social-email"></use></svg></a>
				</div>
			</section>
			<section class="cl-footer-section cl-footer-section-links">
				<h4>
					Explore
				</h4>
				<nav class="cl-footer-nav" aria-label="Explore"><ul>
					{% for footerItem in footer_navigation %}
						<li>
							<a href="{{ footerItem.href }}">{{ footerItem.label }}</a>
						</li>
					{% endfor %}
				</ul></nav>
			</section>
			<section class="cl-footer-section cl-footer-section-contact">
				<h4>
					Get in touch
				</h4>
				<p>
					Questions about a course, your account or company learning? Send us a message.
				</p>
				{{ ui('action.link', {label: 'Open the contact form', href: '/contact', variant: 'primary'}) }}
			</section>
		</div>
		<div class="gn-footnote">
			<span>&copy; 2026 Richard Catto</span>
			<span class="gn-footnote-mark">{{ theme.name }} {{ theme.version }}</span>
		</div>
	</div>
</footer>
