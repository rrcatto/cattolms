<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ title }} · {{ app_name }}</title>
		<meta name="description" content="Structured self-study courses, progress tracking and assessments.">
		<meta name="theme-color" content="#0f0f10">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		{% for resourceUrl in platform.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.external_styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
	</head>
	<body class="cl-body gn-body gn-family-{{ page.type ?: 'content' }} {{ page.body_class }} {{ course_content_mode ? 'cl-course-page' : '' }}" data-cl-navigation="top">
		<a class="cl-skip-link" href="#cl-main">Skip to content</a>
		<div class="gn-canvas" aria-hidden="true"></div>
		<div class="cl-shell">
			<header class="cl-header" data-theme-nav>
				<div class="gn-ribbon" aria-hidden="true"></div>
				<div class="cl-header-inner">
					<a class="cl-brand" href="{{ app.base_url }}" aria-label="{{ app.name }} home"><span class="cl-brand-mark" aria-hidden="true">CL</span><span class="cl-brand-copy"><strong>{{ app.name }}</strong><small>{{ theme.name }}</small></span></a>
					<button class="cl-nav-toggle" type="button" data-cl-nav-toggle aria-expanded="false" aria-controls="cl-primary-navigation">Menu</button>
					{% include '@platform/partials/navigation.html.twig' %}
				</div>
			</header>
			<div class="cl-page">
				<section class="cl-page-context" aria-label="Page context" data-theme-breadcrumb>
					<div class="cl-page-context-inner">
						{{ ui('layout.breadcrumb', {items: breadcrumbs}) }}
						{% include '@platform/partials/cart-summary.html.twig' %}
					</div>
				</section>
				<div class="cl-page-frame">
					<div class="gn-plate-cap" aria-hidden="true"></div>
					<main class="cl-main" id="cl-main">
						{% include '@platform/partials/flash-messages.html.twig' %}
						{% block page_content %}{% block page_body %}{% endblock %}{% endblock %}
					</main>
					{% include '@theme/partials/footer.html.twig' %}
				</div>
			</div>
		</div>
		{% for resourceUrl in platform.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.external_scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
	</body>
</html>
