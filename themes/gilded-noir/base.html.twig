<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ title }} · {{ app_name }}</title>
		<meta name="description" content="Structured self-study courses, progress tracking and assessments.">
		<meta name="theme-color" content="#0f0f10">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		{% for resourceUrl in platform.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.external_styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
	</head>
	<body class="gn-body gn-family-{{ page.type ?: 'content' }} {{ body_class }} {{ course_content_mode ? 'cl-course-page' : '' }}">
		<a class="gn-skip" href="#gn-main">Skip to content</a>
		<div class="gn-canvas" aria-hidden="true">
		</div>
		<div class="gn-shell">
			<header class="gn-header" data-theme-nav>
				<div class="gn-ribbon" aria-hidden="true">
				</div>
				<div class="gn-nav-inner">
					<a class="gn-brand" href="/">
					<span class="gn-brand-mark" aria-hidden="true">CL</span>
					<span class="gn-brand-copy">
					<strong>{{ app_name }}</strong>
					<small>Gilded Noir</small>
					</span>
					</a>
					<button class="gn-nav-toggle" type="button" data-gn-nav-toggle aria-expanded="false" aria-controls="gn-primary-nav">
					<svg class="gn-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#gn-menu"></use></svg>
					<span>Menu</span>
					</button>
					<nav class="gn-primary" id="gn-primary-nav" aria-label="Primary navigation">
						{% for item in navigation %}
							{% if item.children %}
								<details class="gn-menu {{ item.active ? 'active' : '' }}" data-cl-dropdown data-nav-item="{{ item.key }}">
									<summary class="gn-nav-link">
										<svg class="gn-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ item.icon_id }}"></use></svg>
										<span>{{ item.label }}</span>
										<svg class="gn-icon gn-caret" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ theme.asset_url }}/img/icons.svg#gn-chevron"></use></svg>
									</summary>
									<div class="gn-menu-panel cl-nav-panel">
										<nav aria-label="{{ item.label }} navigation">
											{% for child in item.children %}
												{% if child.children|length > 0 %}
													<div class="nav-group nav-flyout-edge {{ child.active ? 'nav-group-current' : '' }}" data-nav-item="{{ child.key }}">
														<button class="nav-group-label" type="button" aria-haspopup="true">
														<svg class="gn-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg>
														<span>{{ child.label }}</span>
														<span class="nav-group-caret" aria-hidden="true">&rsaquo;</span>
														</button>
														<div class="nav-subpanel cl-nav-panel">
															{% for grandchild in child.children %}
																<a class="nav-sublink {{ grandchild.active ? 'active' : '' }}" href="{{ grandchild.href }}" data-nav-item="{{ grandchild.key }}">
																<svg class="gn-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ grandchild.icon_id }}"></use></svg>
																<span>{{ grandchild.label }}</span>
																</a>
															{% endfor %}
														</div>
													</div>
												{% else %}
													<a class="{{ child.active ? 'active' : '' }}" href="{{ child.href }}" data-nav-item="{{ child.key }}">
													<svg class="gn-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg>
													<span>{{ child.label }}</span>
													</a>
												{% endif %}
											{% endfor %}
										</nav>
									</div>
								</details>
							{% else %}
								{% if item.method == 'POST' %}
{#
									The signed-in identity, in the bar rather than as a band across the page
									body. The band is core's and is right for the themes built round a wide
									content column; this theme's body is narrower and it did not fit.

									It sits here, immediately before Logout, because that is the end of the
									bar and the identity belongs with the control that ends the session. Only
									the name and one badge are certain of their space: the address is offered
									and hidden by CSS when the bar is too narrow to hold it.

									The name shown is the display name - `RichardC` - and not the full name it
									is not an abbreviation of. A bar has one line to spend, and a full name
									spends it on middle names nobody asked this control to show. identity_name
									remains the fallback, because the display name column is nullable.
#}
									{% if user.logged_in %}
										{% set gn_identity_label = identity_display_name is defined and identity_display_name
											? identity_display_name
											: (identity_name is defined and identity_name ? identity_name : user.name) %}
										<div class="gn-identity" data-nav-item="identity">
											{% if identity_image is defined and identity_image %}
												<img class="gn-identity-avatar" src="{{ identity_image }}" alt="" width="46" height="46">
											{% else %}
												<span class="gn-identity-avatar gn-identity-avatar-empty" aria-hidden="true">{{ gn_identity_label ? gn_identity_label|slice(0, 1)|upper : '?' }}</span>
											{% endif %}
											<span class="gn-identity-text">
												<strong class="gn-identity-name">{{ gn_identity_label }}</strong>
												{% if identity_email is defined and identity_email %}
													<span class="gn-identity-email">{{ identity_email }}</span>
												{% endif %}
											</span>
											{% if identity_role is defined and identity_role %}
												<span class="gn-identity-role">{{ identity_role }}</span>
											{% endif %}
										</div>
									{% endif %}
									<form class="gn-nav-form" action="{{ item.href }}" method="post" data-nav-item="{{ item.key }}">
										<input type="hidden" name="csrf" value="{{ item.csrf }}">
										<button class="gn-nav-link gn-nav-signout" type="submit">
										<svg class="gn-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ item.icon_id }}"></use></svg>
										<span>{{ item.label }}</span>
										</button>
									</form>
								{% else %}
									<a class="gn-nav-link {{ item.key == 'signin' ? 'gn-nav-cta' : '' }} {{ item.active ? 'active' : '' }}" href="{{ item.href }}" data-nav-item="{{ item.key }}">
									<svg class="gn-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ item.icon_id }}"></use></svg>
									<span>{{ item.label }}</span>
									</a>
								{% endif %}
							{% endif %}
						{% endfor %}
					</nav>
				</div>
				{% if breadcrumbs|length > 1 %}
					<div class="gn-breadcrumb-bar" data-theme-breadcrumb>
						<div class="gn-breadcrumb-inner">
							<nav class="gn-breadcrumbs" aria-label="Breadcrumb">
								{% for crumb in breadcrumbs %}
									{% if crumb.current %}
										<span class="gn-crumb current" aria-current="page">{{ crumb.label }}</span>
									{% else %}
										<a class="gn-crumb" href="{{ crumb.href }}">{{ crumb.label }}</a><span class="gn-crumb-sep" aria-hidden="true">/</span>
									{% endif %}
								{% endfor %}
							</nav>
						</div>
					</div>
				{% endif %}
			</header>
			<div class="gn-stage">
				<div class="gn-plate">
{#
					Catto Learning renders the page title inside every platform view, so the theme
					adds a decorative cap rather than repeating the heading.

					A Twig comment, not an HTML one: an HTML comment is served to the browser
					verbatim on every page this theme renders.
#}
					<div class="gn-plate-cap" aria-hidden="true">
					</div>
					<main class="gn-main" id="gn-main">
						{% include '@theme/partials/flash.html.twig' %}
						{% block page_content %}
							{% block page_body %}
							{% endblock %}
						{% endblock %}
					</main>
					{% include '@theme/partials/footer.html.twig' %}
				</div>
			</div>
		</div>
		{% for resourceUrl in platform.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.external_scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
	</body>
</html>
