<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ page.title }} · {{ app.name }}</title>
		{% for resourceUrl in platform.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.external_styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
		{% for resourceUrl in theme.styles %}
			<link href="{{ resourceUrl }}" rel="stylesheet">
		{% endfor %}
	</head>
	<body class="rl-body {{ page.body_class }} {{ course_content_mode ? 'cl-course-page' : '' }}">
		{% if user.logged_in %}
			<div class="rl-shell">
				<header class="rl-header" data-theme-nav>
					<div class="rl-header-inner">
						<a class="rl-brand" href="/" aria-label="Home"><span class="rl-brand-mark">CL</span><span class="rl-brand-copy"><strong>{{ app.name }}</strong><small>Radiant Learning</small></span></a>
						<nav class="rl-nav" aria-label="Primary navigation">
							{% for nav in navigation %}
								{% if nav.children|length > 0 %}
									<details class="rl-menu {{ nav.active ? 'active' : '' }}" data-cl-dropdown data-nav-item="{{ nav.key }}">
										<summary class="rl-nav-link">
											<svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ nav.icon_id }}"></use></svg><span>{{ nav.label }}</span><span class="rl-caret" aria-hidden="true">⌄</span>
										</summary>
										<div class="rl-menu-panel cl-nav-panel">
											<nav aria-label="{{ nav.label }}">
												{% for child in nav.children %}
													{% if child.children|length > 0 %}
														<div class="nav-group {{ child.active ? 'nav-group-current' : '' }}" data-nav-item="{{ child.key }}">
															<div class="nav-group-label">
																<svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg><span>{{ child.label }}</span>
															</div>
															<div class="nav-subpanel cl-nav-panel">
																{% for grandchild in child.children %}
																	<a class="nav-sublink {{ grandchild.active ? 'active' : '' }}" href="{{ grandchild.href }}" data-nav-item="{{ grandchild.key }}"><svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ grandchild.icon_id }}"></use></svg>{{ grandchild.label }}</a>
																{% endfor %}
															</div>
														</div>
													{% else %}
														<a class="{{ child.active ? 'active' : '' }}" href="{{ child.href }}" data-nav-item="{{ child.key }}"><svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg>{{ child.label }}</a>
													{% endif %}
												{% endfor %}
											</nav>
										</div>
									</details>
								{% elseif nav.method != 'POST' %}
									<a class="rl-nav-link {{ nav.active ? 'active' : '' }}" href="{{ nav.href }}" data-nav-item="{{ nav.key }}"><svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ nav.icon_id }}"></use></svg><span>{{ nav.label }}</span></a>
								{% endif %}
							{% endfor %}
						</nav>
						<div class="rl-header-actions">
							<div class="rl-user-chip">
								<div class="avatar">
									CL
								</div>
								<span>{{ user.name }}</span>
							</div>
							{% for nav in navigation %}
								{% if nav.method == 'POST' %}
									<form action="{{ nav.href }}" method="post" data-nav-item="{{ nav.key }}">
										<input type="hidden" name="csrf" value="{{ nav.csrf }}">
										{{ ui('action.button', {label: (nav.label), variant: 'quiet', size: 'small', type: 'submit'}) }}
									</form>
								{% endif %}
							{% endfor %}
						</div>
					</div>
				</header>
				<main class="rl-main">
					<div class="rl-context" data-theme-breadcrumb>
						<div class="rl-context-inner">
							<div>
								<div class="page-kicker">
									{{ page.subtitle }}
								</div>
								<div class="page-title">
									{{ page.title }}
								</div>
							</div>
{% include '@platform/partials/cart-summary.html.twig' %}
						</div>
					</div>
					<div class="rl-content">
						{% include '@platform/partials/flash-messages.html.twig' %}
						{% block page_content %}
							{% block page_body %}
							{% endblock %}
						{% endblock %}
					</div>
{#
					The real footer, in place of the single centred grey line that stood in for one. It
					spans the page width and carries the container body's rounded border, so the shell has
					an end rather than trailing off.
#}
					{% include '@theme/partials/footer.html.twig' %}
				</main>
			</div>
		{% else %}
			<div class="public-shell">
				<nav class="public-nav" data-theme-nav>
					<div class="public-nav-inner">
						<a class="brand" href="/"><span class="brand-mark">CL</span><span><strong>{{ app.name }}</strong><small>Radiant Learning</small></span></a>
						<div class="public-links">
							{{ ui('action.link', {label: 'Home', variant: 'quiet', size: 'normal', href: '/', navigation_key: 'home'}) }}{{ ui('action.link', {label: 'Catalogue', variant: 'quiet', size: 'normal', href: '/courses', navigation_key: 'catalogue'}) }}{{ ui('action.link', {label: 'Register or sign in', variant: 'primary', size: 'normal', href: '/login'}) }}
						</div>
					</div>
				</nav>
				<main class="public-main">
					{% include '@platform/partials/flash-messages.html.twig' %}
					{{ block('page_content') }}
				</main>
				{% include '@theme/partials/footer.html.twig' %}
			</div>
		{% endif %}
		{% for resourceUrl in platform.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.external_scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
		{% for resourceUrl in theme.scripts %}
			<script src="{{ resourceUrl }}"></script>
		{% endfor %}
	</body>
</html>
