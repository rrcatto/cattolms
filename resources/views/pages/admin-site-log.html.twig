{#
	The Site Log (owner, 2026-11-04, the approved mockup): every page anyone asked for, one table chosen by feature cards
	(UX rule 2.6c), searched, filtered and paged. A secret in an address is never kept.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Site Analytics' %}{% set ph_title = 'Site Log' %}
	{% set ph_lead = subject ? 'Everything ' ~ subject ~ ' asked for.' : 'Every page anyone asked for: who, from where, and what the site answered.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	{% set a = 'viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' %}
	{% set sl_icons = {
		all: '<svg ' ~ a ~ '><path d="M4 6h16M4 12h16M4 18h16"/></svg>',
		signed: '<svg ' ~ a ~ '><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4.5 4-6.5 8-6.5s7 2 8 6.5"/></svg>',
		people: '<svg ' ~ a ~ '><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M16.5 14.5c2.6.2 4.4 2 5 5"/></svg>',
		bot: '<svg ' ~ a ~ '><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 8V4M9 13v1M15 13v1"/></svg>',
		missing: '<svg ' ~ a ~ '><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M9 9l4 4M13 9l-4 4"/></svg>',
		refused: '<svg ' ~ a ~ '><circle cx="12" cy="12" r="9"/><path d="m5.6 5.6 12.8 12.8"/></svg>',
		flagged: '<svg ' ~ a ~ '><path d="M5 21V4M5 4h13l-3 4 3 4H5"/></svg>',
	} %}
	{% set sl_cards = [] %}
	{% for key, one in kinds %}{% set sl_cards = sl_cards|merge([{value: key, label: one.label, icon: sl_icons[key], note: counts[key]|number_format}]) %}{% endfor %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		<form class="cl-library-lists" method="get" action="/admin/site-analytics/log" data-choose-submits>
			{% for name, value in carried %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
			{{ ui('form.picture-choice', {name: 'kind', legend: 'Kinds of request', id: 'site-log-kinds', size: 'small', columns: 4, selected: kind, items: sl_cards}) }}
			<noscript>{{ ui('action.button', {label: 'Show', variant: 'secondary', size: 'small', type: 'submit', icon: 'action-filter'}) }}</noscript>
		</form>
		<form action="/admin/site-analytics/log" method="get">
			<input type="hidden" name="kind" value="{{ kind }}"><input type="hidden" name="filtered" value="1">{% if subject %}<input type="hidden" name="a" value="{{ subject }}">{% endif %}
			{% if search %}<input type="hidden" name="sitelog_q" value="{{ search }}">{% endif %}
			{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Period', for: 'site-log-period'})} %}{% block control %}<select id="site-log-period" name="period" {{ ui_field_attrs(props) }}>{% for key, label in period_choices %}<option value="{{ key }}"{{ period.key == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'From', for: 'site-log-from', help: 'With Dates.'})} %}{% block control %}<input type="date" id="site-log-from" name="from" value="{{ period.fromDay }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'To', for: 'site-log-to', help: 'With Dates.'})} %}{% block control %}<input type="date" id="site-log-to" name="to" value="{{ period.toDay }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Country', for: 'site-log-country'})} %}{% block control %}<select id="site-log-country" name="country" {{ ui_field_attrs(props) }}><option value="">Every country</option>{% for one in countries %}<option value="{{ one.code }}"{{ country == one.code ? ' selected' : '' }}>{{ one.name }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
				{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Leave out administrators'})} %}{% block control %}<input type="checkbox" class="cl-check" name="admins" value="1"{{ leave_out ? ' checked' : '' }}>{% endblock %}{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Filter', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-filter'}) }}{% if filtered %}{{ ui('action.link', {label: 'Clear', variant: 'secondary', size: 'normal', href: '/admin/site-analytics/log', icon: 'action-clear'}) }}{% endif %}{% endblock %}{% endembed %}
			{% endblock %}{% endembed %}
		</form>
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'sitelog', pagination: sitelog_pagination, search: {ds_name: 'sitelog', ds_label: 'Search an address, a person, a page or a browser', ds_value: search, ds_action: '/admin/site-analytics/log', ds_hidden: search_carried}})} %}{% block results %}
			{% if rows %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr><th>When</th><th>Who</th><th>From</th><th>Network</th><th>Page</th><th>Answer</th><th>Browser</th><th><span class="visually-hidden">Lock out</span></th></tr>{% endblock %}
			{% block body %}{% for row in rows %}<tr data-site-request="{{ row.id }}">
				<td>{{ row.when }}</td>
				<td class="cell-text">{% if row.signed_in %}{{ ui('data.person', {name: row.who, href: row.who_href}) }}{% else %}<a href="{{ row.who_href }}">{{ row.who }}</a>{% endif %}{% if row.show_address %}<br><a class="small" href="{{ row.address_href }}">{{ row.address }}</a>{% endif %}{% if row.flag %}<br>{{ ui('feedback.badge', {label: row.flag.label, tone: row.flag.tone, size: 'small'}) }}{% endif %}</td>
				<td>{{ row.from }}</td>
				<td class="cell-text">{{ row.network }}</td>
				<td class="cell-text"><span class="cl-mono small">{{ row.method }} {{ row.page }}</span></td>
				<td>{{ ui('feedback.badge', {label: row.answer.label, tone: row.answer.tone, size: 'small'}) }}</td>
				<td class="cell-text">{{ row.browser }}</td>
				<td class="cell-actions">{% if row.lockable and can_manage %}{{ ui('action.link', {label: 'Lock out', variant: 'danger', size: 'small', icon: 'action-lock-out', icon_only: true, href: row.address_href ~ '#lock-out', aria_label: 'Lock out ' ~ row.who}) }}{% endif %}</td>
			</tr>{% endfor %}{% endblock %}
			{% endembed %}
			{% else %}{{ ui('feedback.empty', {summary: 'Nothing in the Site Log matches.'}) }}{% endif %}
		{% endblock %}{% endembed %}
		<p class="small mb-0 mt-5">The secret part of a sign-in link, unsubscribe link or private certificate address is never kept: it is written as ••••. Anything after a question mark in an address is left out too.</p>
	{% endblock %}{% endembed %}</section>
{% endblock %}
