{% extends layout %}
{% block page_body %}
<section class="cl-course-presentation catto-standalone cl-course-presentation-intro">
<header class="masthead" data-level="{{ course.level|default('') }}">
{% if course.level|default('') %}<p class="eyebrow">{{ course.level }}</p>{% endif %}
<h1>{{ course.title }}</h1>
{% if course.subtitle|default('') %}<p class="course-subtitle">{{ course.subtitle }}</p>{% endif %}
{% if course.summary|default('') %}<p class="course-summary">{{ course.summary }}</p>{% endif %}
<div class="meta"><span>{{ course.structure|length }} course items</span>{% if course.estimated_minutes|default(0) %}<span>{{ course.estimated_minutes }} minutes</span>{% endif %}</div>
</header>
<div class="course-introduction-copy">{{ course.introduction_html|raw }}</div>
{% if not course.enrolment.started_at %}
<form action="/learn/{{ course.slug }}/start{{ preview_query }}" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: 'Start course', variant: 'primary', size: 'large', type: 'submit'}) }}</form>
{% elseif course.structure|default([])|length %}
<nav class="cl-course-item-paging" aria-label="Course content">
<span></span>{% set first_is_assessment = course.structure[0].item_type|default('') in ['assessment', 'diagnostic'] %}{{ ui('action.link', {label: 'Begin course →', variant: 'primary', size: 'normal', href: '/learn/' ~ course.slug ~ '/item/' ~ course.structure[0].id ~ (first_is_assessment ? '/assessment/' ~ course.structure[0].item_key : '/content') ~ preview_query}) }}
</nav>
{% endif %}
{% if not is_preview and course.certificate|default(null) %}
<p class="cl-course-certificate-links">{{ ui('action.link', {label: 'View certificate', variant: 'primary', size: 'small', href: '/certificates/' ~ course.certificate.public_id}) }} {{ ui('action.link', {label: 'Download certificate PDF', variant: 'secondary', size: 'small', href: '/certificates/' ~ course.certificate.public_id ~ '/certificate.pdf'}) }}</p>
{% endif %}
{# Not in an ADMIN preview: previewing a course is authoring it, not studying it. #}
{% if not is_preview and 'LEARNING.REVIEW.CREATE' in permissions %}
<p class="cl-course-review-prompt">{{ ui('action.link', {label: 'Rate this course', variant: 'secondary', size: 'small', href: '/learn/' ~ course.slug ~ '/review'}) }}</p>
{% endif %}
</section>
{% endblock %}
