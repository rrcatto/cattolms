{% extends layout %}
{% block page_body %}
<section class="cl-course-presentation catto-standalone cl-course-presentation-intro">
<header class="masthead" data-level="{{ course.level|default('') }}">
{% if course.level|default('') %}<p class="eyebrow">{{ course.level }}</p>{% endif %}
<h1>{{ course.title }}</h1>
{% if course.subtitle|default('') %}<p class="course-subtitle">{{ course.subtitle }}</p>{% endif %}
{% if course.summary|default('') %}<p class="course-summary">{{ course.summary }}</p>{% endif %}
<div class="meta"><span>{{ course.structure|length }} course items</span>{% if course.estimated_minutes|default(0) %}<span>About {{ (course.estimated_minutes / 60)|round }} hours</span>{% endif %}</div>
</header>
<div class="course-introduction-copy">{{ course.introduction_html|raw }}</div>
{% if not course.enrolment.started_at %}
{# Starting begins the access period and cannot be undone, so the learner confirms it first (owner, 2026-10-17). #}
<form action="/learn/{{ course.slug }}/start{{ preview_query }}" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">
{# Whose refund starting ends (owner, 2026-10-29): the learner's own, the company's for a place from its credit, or none for a course given to test or a preview. #}
{% set start_refund = {own: ', and that a started course can no longer be refunded', company: ', and that once I start, my company can no longer get a refund for this place', none: ''}[course.start_refund|default('own')] %}
{{ ui('form.picture-choice', {multiple: true, legend: 'Before you start', legend_hidden: true, size: 'small', tick_value: 'yes', required: true, selected: [], items: [
	{value: 'confirm_start', label: 'Start my access period', icon: lucide('hourglass'), note: 'I understand that starting begins my access period of ' ~ course.access_period_label ~ ', which then runs to its end' ~ start_refund ~ '.'},
]}) }}
{# Asked once, here, whether they want the updates written about the course (mailing, step 1; owner, 2026-10-26). #}
{% if ask_follow|default(false) %}<input type="hidden" name="course_id" value="{{ course.id }}">{{ ui('form.picture-choice', {multiple: true, legend: 'Updates about this course', legend_hidden: true, size: 'small', selected: [], items: [
	{value: 'follow_course', label: 'Send me the updates written about this course by email', icon: lucide('bell'), note: 'I can stop at any time. Leave it unticked and you get none.'},
]}) }}{% endif %}
{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Start course', variant: 'primary', size: 'large', type: 'submit', icon: 'action-start'}) }}{% endblock %}{% endembed %}</form>
{% elseif course.first_stop_path|default(null) %}
{% include '@platform/partials/course-item-paging.html.twig' with {paging_previous: null, paging_next: null, paging_next_link: {href: course.first_stop_path ~ preview_query, label: 'Begin course →', icon: 'action-start'}} %}
{% endif %}
{% if not is_preview and course.certificate|default(null) %}
<p class="cl-course-certificate-links">{{ ui('action.link', {label: 'View certificate', variant: 'primary', size: 'small', href: '/certificates/' ~ course.certificate.public_id, icon: 'action-view'}) }} {{ ui('action.link', {label: 'Download certificate PDF', variant: 'secondary', size: 'small', href: '/certificates/' ~ course.certificate.public_id ~ '/certificate.pdf', icon: 'action-download'}) }}{% if course.certificate.transcript_public_id|default(null) %} {{ ui('action.link', {label: 'View transcript', variant: 'secondary', size: 'small', href: '/transcripts/' ~ course.certificate.transcript_public_id, icon: 'action-view'}) }}{% endif %} {{ ui('action.link', {label: 'Who can see them', variant: 'quiet', size: 'small', href: '/account/certificates#' ~ certificate_anchor(course.certificate), icon: 'action-share'}) }}</p>
{% elseif not is_preview and course.certificate_waiting|default(false) %}
{# A certificate is issued only to a verified account (owner, 2026-10-19). #}
<div class="cl-course-certificate-links">{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', heading: course.certificate_waiting_message})} %}{% block body %}{{ ui('action.link', {label: 'Verify my identity', variant: 'primary', size: 'small', href: '/account/verification?return=' ~ ('/learn/' ~ course.slug)|url_encode, icon: 'action-verify'}) }}{% endblock %}{% endembed %}</div>
{% endif %}
{# Not in an ADMIN preview: previewing a course is authoring it, not studying it. #}
{% if not is_preview and 'LEARNING.REVIEW.CREATE' in permissions %}
<p class="cl-course-review-prompt">{{ ui('action.link', {label: 'Rate this course', variant: 'secondary', size: 'small', href: '/learn/' ~ course.slug ~ '/review', icon: 'action-rate'}) }}</p>
{% endif %}
</section>
{% endblock %}
