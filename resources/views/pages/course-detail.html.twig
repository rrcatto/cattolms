{% extends layout %}
{% block page_body %}
	<section class="cl-page-head cl-course-head">
		<div class="container py-5">
			<div class="row g-4 align-items-center">
				<div class="col-lg-8">
					<div class="d-flex flex-wrap gap-2 mb-3">
						{% if course.category_name %}
							{% if course.category_name %}
								<span class="badge cl-badge-soft">{{ course.category_name }}</span>
							{% endif %}
						{% endif %}
						{% if course.level %}
							<span class="badge text-bg-light">{{ course.level }}</span>
						{% endif %}
					</div>
					<div class="cl-course-detail-headline">
						<h1 class="display-4 fw-bold">
							{{ course.title }}
						</h1>
{#
						The same star, the same partial and the same toggle as the catalogue card.
						A reader who favourites a course from a card and then opens it should find
						the control in the state they left it, and be able to change their mind
						without going back.
#}
						{% if can_favourite is defined and can_favourite %}
							{% include '@platform/partials/course-favourite.html.twig' with {course: course, favourite_return: favourite_return|default('/courses')} %}
						{% endif %}
					</div>
					{% if course.subtitle %}
						<p class="h4 text-white-50">
							{{ course.subtitle }}
						</p>
					{% endif %}
					<p class="lead mt-3 mb-0">
						{{ course.summary }}
					</p>
				</div>
				<div class="col-lg-4">
					<div class="cl-summary-card">
						<div>
							<span>Modules</span><strong>{{ course.module_count }}</strong>
						</div>
						<div>
							<span>Questions</span><strong>{{ course.question_count }}</strong>
						</div>
						<div>
							<span>Access starts</span><strong>When you start</strong>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="container py-5">
		<div class="row g-5">
			<div class="col-lg-8">
				<div class="cl-prose mb-5">
					{{ course.description_html|raw }}
				</div>
				<h2 class="h3 mb-3">
					Course modules
				</h2>
				<div class="cl-module-list">
					{% for module in course.modules %}
						<div class="cl-module-row">
							<span class="cl-module-number">{{ module.position }}</span>
							<div>
								<strong>{{ module.title }}</strong>
								{% if module.subtitle %}
									<small>{{ module.subtitle }}</small>
								{% endif %}
							</div>
							<span class="ms-auto text-body-secondary">
							{% if module.question_count > 0 %}
								{{ module.question_count }} questions
							{% endif %}
							</span>
						</div>
					{% endfor %}
				</div>
				<h2 class="h3 mt-5 mb-3">
					Grading
				</h2>
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th style="width:40%">
									Grade
								</th>
								<th style="width:30%">
									Minimum
								</th>
								<th style="width:30%">
									Result
								</th>
							</tr>
						</thead>
						<tbody>
							{% for band in course.grade_bands %}
								<tr>
									<td>
										<strong>{{ band.grade_label }}</strong>
									</td>
									<td>
										{{ band.minimum_percentage }}%
									</td>
									<td>
										{{ band.is_passing ? 'Pass' : 'Fail' }}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
			<aside class="col-lg-4">
				<div class="card cl-sticky-card">
					<div class="card-body p-4">
						<h2 class="h4">
							Course access
						</h2>
						{% if has_access %}
							<p>
								This course is already in your library.
							</p>
							<a class="btn btn-primary w-100" href="/learn/{{ course.slug }}">Open course</a>
						{% else %}
							{% if course.price_variants %}
								<form action="/courses/request" method="post">
									<input type="hidden" name="csrf" value="{{ csrf }}">
									<input type="hidden" name="course_id" value="{{ course.id }}">
									<div class="vstack gap-2 mb-3">
										{% for price_index, price in course.price_variants %}
											<label class="border rounded p-3 d-flex align-items-start gap-3">
											<input class="form-check-input mt-1" type="radio" name="access_period_seconds" value="{{ price.access_period_seconds }}" {{ price.is_default ? 'checked' : '' }} required>
											<span class="flex-grow-1"><strong>{{ price.price_label }}</strong>
											<br>
											<span>{{ price.access_period_label }} access</span>
											{% if price.label %}
												<small class="d-block text-body-secondary">{{ price.label }}</small>
											{% endif %}
											</span>
											{% if price.is_default %}
												<span class="badge text-bg-primary">Default</span>
											{% endif %}
											</label>
										{% endfor %}
									</div>
									{% if is_authenticated %}
										<div class="cl-form-actions">
											<button class="btn btn-primary w-100" type="submit">Request course</button>
										</div>
										<p class="small text-body-secondary mt-2 mb-0">
											Direct cart checkout is the next commerce stage.
										</p>
									{% else %}
										<a class="btn btn-primary w-100" href="/login?return={{ '/courses/'~course.slug|urlencode }}">Sign in to continue</a>
									{% endif %}
								</form>
							{% else %}
								<div class="alert alert-warning mb-0">
									This course does not currently have an active purchase price.
								</div>
							{% endif %}
						{% endif %}
					</div>
				</div>
			</aside>
		</div>
	</section>
{% endblock %}
