{% extends layout %}
{% block page_body %}
	<section class="cl-page-head cl-course-head">
		<div class="container py-5">
			<div class="row g-4 align-items-center">
				<div class="col-lg-8">
					<div class="d-flex flex-wrap gap-2 mb-3">
						{% if course.category_name %}
							{% if course.category_name %}
								{{ ui('feedback.badge', {label: (course.category_name), tone: 'neutral'}) }}
							{% endif %}
						{% endif %}
						{% if course.level %}
							{{ ui('feedback.badge', {label: (course.level), tone: 'neutral'}) }}
						{% endif %}
					</div>
					<div class="cl-course-detail-headline">
						<h1 class="display-4 fw-bold">
							{{ course.title }}
						</h1>
{#
						The same star, the same partial and the same toggle as the catalogue card.
						A reader who favourites a course from a card and then opens it should find
						the control in the state they left it, and be able to change their mind
						without going back.
#}
						{% if can_favourite is defined and can_favourite %}
							{% include '@platform/partials/course-favourite.html.twig' with {course: course, favourite_return: favourite_return|default('/courses')} %}
						{% endif %}
					</div>
					{% if course.subtitle %}
						<p class="h4 text-white-50">
							{{ course.subtitle }}
						</p>
					{% endif %}
					{% include '@platform/partials/course-rating-summary.html.twig' with {rating: rating} %}
					<p class="lead mt-3 mb-0">
						{{ course.summary }}
					</p>
				</div>
				<div class="col-lg-4">
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}
{{ ui('data.key-value-list', {items: [{label: 'Course Items', value: (course.item_count)}, {label: 'Questions', value: (course.question_count)}, {label: 'Access starts', value: 'When you start'}]}) }}
{% endblock %}
{% endembed %}
				</div>
			</div>
		</div>
	</section>
	<section class="cl-page-section container py-5">
		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {})} %}
{% block body %}

			<div>
				<div class="cl-prose mb-5">
					{{ course.description_html|raw }}
				</div>
				<h2 class="h3 mb-3">Course Content</h2>
                <ol>
                {% for node in course.structure %}
                    <li>{{ node.node_type == 'section' ? node.section_title : (node.display_title_override ?: node.item_title) }}</li>
                {% endfor %}
                </ol>
                {% if course.has_public_preview %}
                    {{ ui('action.link', {label: 'Preview this course', href: '/courses/' ~ course.slug ~ '/preview', variant: 'secondary'}) }}
                {% endif %}
				<h2 class="h3 mt-5 mb-3">
					Grading
				</h2>

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 40, label: 'Grade'}} %}
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 30, label: 'Range'}} %}
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 30, label: 'Result'}} %}
							</tr>

{% endblock %}
{% block body %}

							{% for band in course.grade_bands %}
								<tr>
									<td>
										<strong>{{ band.grade_label }}</strong>
									</td>
									<td>
										{{ band.range_label }}
									</td>
									<td>
										{{ band.is_passing ? 'Pass' : 'Fail' }}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

				<section id="reviews" aria-labelledby="course-reviews-heading">
					<h2 class="h3 mt-5 mb-3" id="course-reviews-heading">Reviews</h2>
					{% if rating.count > 0 %}
						<div class="cl-rating-overview">
							{% include '@platform/partials/course-rating-summary.html.twig' with {rating: rating} %}
							<dl class="cl-rating-distribution">
								{% for band in rating.distribution %}
									<div><dt>{{ band.stars }} {{ band.stars == 1 ? 'star' : 'stars' }}</dt><dd>{{ ui('feedback.progress', {value: band.percent, label: band.percent ~ '% of reviews give ' ~ band.stars ~ (band.stars == 1 ? ' star' : ' stars')}) }}<span>{{ band.count }}</span></dd></div>
								{% endfor %}
							</dl>
						</div>
					{% endif %}
					{% include '@platform/partials/course-reviews.html.twig' %}
				</section>
			</div>
			<aside>
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {sticky: true})} %}
{% block surface_body %}

						<h2 class="h4">
							Course access
						</h2>
						{% include '@platform/partials/course-purchase.html.twig' with {purchase: purchase, purchase_style: 'full'} %}
						{#
							Reviewing is offered to anyone who has held access to the course, including a
							learner whose access has expired, so it does not depend on has_access.
						#}
						{% if can_review %}
							<div class="cl-course-review-action">
								{% if own_review %}
									<p>Your review: {{ own_review.status == 'approved' ? 'published' : (own_review.status == 'pending' ? 'pending moderation' : 'not published') }}.</p>
								{% endif %}
								{{ ui('action.link', {label: own_review ? 'Edit your review' : 'Rate this course', variant: 'secondary', size: 'normal', full_width: true, href: '/learn/' ~ course.slug ~ '/review'}) }}
							</div>
						{% endif %}

{% endblock %}
{% endembed %}
			</aside>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
