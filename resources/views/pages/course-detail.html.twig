{% extends layout %}
{#
	A course's catalogue page, to help someone choose it (owner, 2026-10-30, the accepted mockup,
	REPORTS/course-page-mockup/, with the head kept as it was: the cover with the title and the favourite star, and one
	buy box, under Course access): "Watch course presentation" opens the trailer in a window as wide as the page's box
	(the window's Close, Esc, or a click outside closes it; without JavaScript the button opens the trailer in the free
	preview); then the course in cards: about it, how a module is made in one paragraph, its modules, what it holds and
	its reviews, beside Course access and the facts; then the free preview offered again.
#}
{% block page_body %}
	<section class="cl-page-head cl-course-head">
		<div class="cl-container py-12">
			{#
				The title and the favourite star over the course's cover picture when it has one (owner, 2026-10-20: "these
				course pages must look interesting … combine the image with the title overlaid on it"; 2026-10-30: "just the
				title and the favourite star"), at the top of the column below otherwise.
			#}
			{% set course_headline %}
					<div class="cl-course-detail-headline">
						<h1 class="cl-display-4 fw-bold">
							{{ course.title }}
						</h1>
{#
						The same star, the same partial and the same toggle as the catalogue card.
						A reader who favourites a course from a card and then opens it should find
						the control in the state they left it, and be able to change their mind
						without going back.
#}
						{% if can_favourite is defined and can_favourite %}
							{% include '@platform/partials/course-favourite.html.twig' with {course: course, favourite_return: favourite_return|default('/courses')} %}
						{% endif %}
					</div>
			{% endset %}
			{% set course_hero = course.cover_svg|default('') starts with '<svg' %}
			{% if course_hero %}
				<div class="cl-picture-head mb-7">
					<div class="cl-picture-head-art" aria-hidden="true">{{ course.cover_svg|raw }}</div>
					<div class="cl-picture-head-text">{{ course_headline }}</div>
				</div>
			{% endif %}
			<div class="cl-course-head-copy">
				{% if not course_hero %}{{ course_headline }}{% endif %}
				{% if course.subtitle %}
					<p class="h4 cl-text-light-muted">
						{{ course.subtitle }}
					</p>
				{% endif %}
				{% if rating.count > 0 %}{% include '@platform/partials/course-rating-summary.html.twig' with {rating: rating} %}{% endif %}
				{% if course_page.trailer %}
					{# The course's trailer, front and centre (owner, 2026-10-30): a button that opens it in a window. #}
					<p class="cl-course-watch">
						{{ ui('action.link', {label: 'Watch course presentation', href: course_page.trailer.href, variant: 'primary', size: 'large', icon: 'action-play', modal: 'course-presentation'}) }}
						<span class="cl-course-watch-note">{{ course_page.trailer.slides }} slides · {{ course_page.trailer.time }}{{ course_page.trailer.narrated ? ' · with narration' : '' }}</span>
					</p>
				{% endif %}
				<ul class="cl-course-facts">
					{% if course_page.modules %}<li>{{ course_page.modules|length }} {{ course_page.modules|length == 1 ? 'module' : 'modules' }}</li>{% endif %}
					{% if course_page.total %}<li>{{ course_page.total|capitalize }}</li>{% endif %}
					<li>Starts immediately</li>
				</ul>
			</div>
		</div>
	</section>
	<section class="cl-page-section">
		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {})} %}
{% block body %}
			<div class="cl-course-detail-main">
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}
				<h2 class="h4">About this course</h2>
				<div class="cl-prose">
					{{ course.description_html|raw }}
				</div>
{% endblock %}
{% endembed %}
				{% if course_page.modules %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
					<h2 class="h4">How each module works</h2>
					{% include '@platform/partials/course-module-parts.html.twig' with {modules_view: course_page} %}
{% endblock %}
{% endembed %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
					<div class="cl-course-modules-head">
						<h2 class="h4" id="course-modules">The {{ course_page.modules|length }} {{ course_page.modules|length == 1 ? 'module' : 'modules' }}</h2>
						{% if course_page.total %}<span>{{ course_page.total|capitalize }} in all</span>{% endif %}
					</div>
					{% include '@platform/partials/course-module-list.html.twig' with {modules_view: course_page, course_slug: course.slug, list_label_id: 'course-modules'} %}
					{# How results are worked out is in the FAQ (owner, 2026-10-20: "the grading belongs elsewhere, in a FAQ"). #}
					<p class="cl-course-grading-link">{{ ui('action.link', {label: 'How assessments and results work', variant: 'quiet', size: 'small', href: '/faq#grading', icon: 'nav-help'}) }}</p>
{% endblock %}
{% endembed %}
				{% else %}
					{# A course not arranged into modules lists what it holds, without its assessments, as before. #}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
					<h2 class="h4">Course Content</h2>
					<ol>
					{% for node in course.structure|filter(node => node.node_type == 'section' or node.item_type|default('') not in ['assessment', 'diagnostic']) %}
						<li>{{ node.node_type == 'section' ? node.section_title : (node.display_title_override ?: node.item_title) }}</li>
					{% endfor %}
					</ol>
					<p class="cl-course-grading-link">{{ ui('action.link', {label: 'How assessments and results work', variant: 'quiet', size: 'small', href: '/faq#grading', icon: 'nav-help'}) }}</p>
{% endblock %}
{% endembed %}
				{% endif %}
				{% if course_page.figures %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
					<h2 class="h4">What you get</h2>
					{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {columns: 3})} %}
{% block body %}
						{% for figure in course_page.figures %}{{ ui('data.stat-card', {value: figure.n, label: figure.label}) }}{% endfor %}
{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
				{% endif %}
				{#
					Reviews in their own card (owner, 2026-10-22), only when the course has a published review (owner, 2026-10-20:
					"just leave it out entirely if there are no reviews"). Each number of stars with reviews shows just those, and
					View all reviews takes the choice away again; the list is numbered, newest first.
				#}
				{% if rating.count > 0 %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
					<section id="reviews" class="cl-course-reviews" aria-labelledby="course-reviews-heading" data-keep-scroll>
						<h2 class="h4" id="course-reviews-heading">Reviews</h2>
						<div class="cl-rating-overview">
							{% include '@platform/partials/course-rating-summary.html.twig' with {rating: rating} %}
							<dl class="cl-rating-distribution">
								{% for band in rating.distribution %}
									{% set band_words = band.stars ~ (band.stars == 1 ? ' star' : ' stars') %}
									<div><dt>{% if band.count > 0 %}<a href="/courses/{{ course.slug }}?reviews_stars={{ band.stars }}#reviews"{% if band.stars == reviews_stars %} aria-current="true"{% endif %}>{{ band_words }}</a>{% else %}{{ band_words }}{% endif %}</dt><dd>{{ ui('feedback.progress', {value: band.percent, label: band.percent ~ '% of reviews give ' ~ band_words}) }}<span>{{ band.count }}</span></dd></div>
								{% endfor %}
							</dl>
						</div>
						{% if reviews_stars %}
							{% set shown = rating.distribution|filter(band => band.stars == reviews_stars)|first %}
							<p class="cl-review-filtered">{{ shown.count == 1 ? '1 review gives' : shown.count ~ ' reviews give' }} {{ reviews_stars }} {{ reviews_stars == 1 ? 'star' : 'stars' }}. {{ ui('action.link', {label: 'View all reviews', variant: 'secondary', size: 'small', href: '/courses/' ~ course.slug ~ '#reviews', icon: 'action-view-all'}) }}</p>
						{% endif %}
						{% include '@platform/partials/course-reviews.html.twig' %}
					</section>
{% endblock %}
{% endembed %}
				{% endif %}
			</div>
			<aside>
				{# Not sticky: the facts follow it in the column (2026-10-21: a sticky card rides over the card beneath it). #}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}
						<h2 class="h4" id="course-access">Course access</h2>
						{% include '@platform/partials/course-purchase.html.twig' with {purchase: purchase, purchase_style: 'full', purchase_key: 'side'} %}
						{# Following the course, for the updates written about it (mailing, step 1; owner, 2026-10-26). #}
						{% if follow|default(null) %}{% include '@platform/partials/follow-button.html.twig' with {fb: follow} %}{% endif %}
						{# Reviewing is offered to anyone who has held access to the course, including a learner whose access has expired. #}
						{% if can_review %}
							<div class="cl-course-review-action">
								{% if own_review %}
									<p>Your review: {{ own_review.status == 'approved' ? 'published' : (own_review.status == 'pending' ? 'pending moderation' : 'not published') }}.</p>
								{% endif %}
								{{ ui('action.link', {label: own_review ? 'Edit your review' : 'Rate this course', variant: 'secondary', size: 'normal', full_width: true, href: '/learn/' ~ course.slug ~ '/review', icon: (own_review ? 'action-edit' : 'action-rate')}) }}
							</div>
						{% endif %}
						{# A question opens the contact form with this course chosen: a problem with it once it is yours, a question before buying until then (owner, 2026-10-20). #}
						<p class="cl-course-contact-link">{{ purchase.state == 'owned' ? ui('action.link', {label: 'Report a problem with this course', variant: 'quiet', size: 'small', href: '/contact?reason=course&course=' ~ course.slug, icon: 'action-report'}) : ui('action.link', {label: 'Ask a question about this course', variant: 'quiet', size: 'small', href: '/contact?reason=before_buying&course=' ~ course.slug, icon: 'action-ask'}) }}</p>
{% endblock %}
{% endembed %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
						<h2 class="h4">At a glance</h2>
						{# A bought course opens at once (owner, 2026-10-20: "put 'immediately'"). #}
						{{ ui('data.key-value-list', {items: (course.category_name ? [{label: 'Category', value: course.category_name}] : [])|merge(course_page.modules ? [{label: 'Modules', value: course_page.modules|length}] : [])|merge(course_page.total ? [{label: 'Study time', value: course_page.total|capitalize}] : [])|merge(course.level ? [{label: 'Level', value: course.level}] : [])|merge([{label: 'Access starts', value: 'Immediately'}])}) }}
{% endblock %}
{% endembed %}
			</aside>
{% endblock %}
{% endembed %}
	</section>
	{% if course.has_public_preview and purchase.state != 'owned' %}
		<section class="cl-page-section" aria-labelledby="course-start-heading">
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}
				<div class="cl-course-start">
					<div>
						<h2 class="h3" id="course-start-heading">{{ course_page.free ? 'Ready to start? Begin with ' ~ course_page.free ~ ', free' : 'Ready to start? Try it free first' }}</h2>
						<p>Read the free preview before you decide. If it suits you, enrol in the full course.</p>
					</div>
					{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}{% block body %}{{ ui('action.link', {label: course_page.free ? 'Read ' ~ course_page.free ~ ' free' : 'Preview this course', variant: 'primary', href: '/courses/' ~ course.slug ~ '/preview', icon: 'action-preview'}) }}{{ ui('action.link', {label: 'Get this course', variant: 'secondary', href: '#course-access', icon: 'action-buy'}) }}{% endblock %}{% endembed %}
				</div>
{% endblock %}
{% endembed %}
		</section>
	{% endif %}
	{# The courses related to this one (owner, 2026-10-20), published ones only, in the catalogue's order. #}
	{% if related_courses|default([]) %}
	<section class="cl-page-section" aria-labelledby="related-courses-heading">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}
			<h2 class="h3" id="related-courses-heading">Related courses</h2>
			{{ ui('catalogue.course-grid', {courses: related_courses}) }}
{% endblock %}
{% endembed %}
	</section>
	{% endif %}
	{% if course_page.trailer %}
		{# The window the trailer plays in, as wide as the page's box (owner, 2026-10-30). #}
		{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'course-presentation', title: 'Course presentation', size: 'page'})} %}
{% block modal_body %}
			<p class="cl-course-presentation-note">{{ course.title }}. Esc closes this window.</p>
			{{ course_page.trailer.html|raw }}
{% endblock %}
{% block modal_actions %}
			{{ ui('action.button', {label: 'Close', variant: 'secondary', type: 'button', icon: 'action-cancel', close_modal: true}) }}
{% endblock %}
{% endembed %}
	{% endif %}
{% endblock %}
