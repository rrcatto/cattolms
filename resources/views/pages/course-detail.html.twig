{% extends layout %}
{% block page_body %}
	<section class="cl-page-head cl-course-head">
		<div class="container py-5">
			<div class="row g-4 align-items-center">
				<div class="col-lg-8">
					<div class="d-flex flex-wrap gap-2 mb-3">
						{% if course.category_name %}
							{% if course.category_name %}
								{{ ui('feedback.badge', {label: (course.category_name), tone: 'neutral'}) }}
							{% endif %}
						{% endif %}
						{% if course.level %}
							{{ ui('feedback.badge', {label: (course.level), tone: 'neutral'}) }}
						{% endif %}
					</div>
					<div class="cl-course-detail-headline">
						<h1 class="display-4 fw-bold">
							{{ course.title }}
						</h1>
{#
						The same star, the same partial and the same toggle as the catalogue card.
						A reader who favourites a course from a card and then opens it should find
						the control in the state they left it, and be able to change their mind
						without going back.
#}
						{% if can_favourite is defined and can_favourite %}
							{% include '@platform/partials/course-favourite.html.twig' with {course: course, favourite_return: favourite_return|default('/courses')} %}
						{% endif %}
					</div>
					{% if course.subtitle %}
						<p class="h4 text-white-50">
							{{ course.subtitle }}
						</p>
					{% endif %}
					<p class="lead mt-3 mb-0">
						{{ course.summary }}
					</p>
				</div>
				<div class="col-lg-4">
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}
{{ ui('data.key-value-list', {items: [{label: 'Modules', value: (course.module_count)}, {label: 'Questions', value: (course.question_count)}, {label: 'Access starts', value: 'When you start'}]}) }}
{% endblock %}
{% endembed %}
				</div>
			</div>
		</div>
	</section>
	<section class="container py-5">
		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {})} %}
{% block body %}

			<div>
				<div class="cl-prose mb-5">
					{{ course.description_html|raw }}
				</div>
				<h2 class="h3 mb-3">
					Course modules
				</h2>
				<div class="cl-module-list">
					{% for module in course.modules %}
						<div class="cl-module-row">
							<span class="cl-module-number">{{ module.position }}</span>
							<div>
								<strong>{{ module.title }}</strong>
								{% if module.subtitle %}
									<small>{{ module.subtitle }}</small>
								{% endif %}
							</div>
							<span class="ms-auto text-body-secondary">
							{% if module.question_count > 0 %}
								{{ module.question_count }} questions
							{% endif %}
							</span>
						</div>
					{% endfor %}
				</div>
				<h2 class="h3 mt-5 mb-3">
					Grading
				</h2>

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 40, label: 'Grade'}} %}
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 30, label: 'Minimum'}} %}
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 30, label: 'Result'}} %}
							</tr>

{% endblock %}
{% block body %}

							{% for band in course.grade_bands %}
								<tr>
									<td>
										<strong>{{ band.grade_label }}</strong>
									</td>
									<td>
										{{ band.minimum_percentage }}%
									</td>
									<td>
										{{ band.is_passing ? 'Pass' : 'Fail' }}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

			</div>
			<aside>
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {sticky: true})} %}
{% block surface_body %}

						<h2 class="h4">
							Course access
						</h2>
						{% if has_access %}
							<p>
								This course is already in your library.
							</p>
							{{ ui('action.link', {label: 'Open course', variant: 'primary', size: 'normal', full_width: true, href: '/learn/' ~ (course.slug)}) }}
						{% else %}
							{% if course.price_variants %}
								<form action="/cart/add" method="post">
									<input type="hidden" name="csrf" value="{{ csrf }}">
									<input type="hidden" name="course_id" value="{{ course.id }}">
									<div class="vstack gap-2 mb-3">
										{% for price_index, price in course.price_variants %}
											{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: (price.price_label) ~ ' ' ~ (price.access_period_label) ~ ' access {% if price.label %} ' ~ (price.label) ~ ' {% endif %} {% if price.is_default %} ' ~ (ui('feedback.badge', {label: 'Default', tone: 'info'})) ~ ' {% endif %}'})} %}
{% block control %}
<input class="form-check-input mt-1" type="radio" name="variant_id" value="{{ price.id }}" {{ price.is_default ? 'checked' : '' }} required>
{% endblock %}
{% endembed %}
										{% endfor %}
									</div>
                                    {% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

                                        {{ ui('action.button', {label: 'Add to cart', variant: 'primary', size: 'normal', type: 'submit', name: 'action', value: 'add', icon: 'action-add'}) }}
                                        {{ ui('action.button', {label: 'Buy now', variant: 'secondary', size: 'normal', type: 'submit', name: 'action', value: 'buy_now'}) }}
                                        {% if is_authenticated and 'CATALOGUE.COURSE.REQUEST' in permissions %}
                                            {{ ui('action.button', {label: 'Request from my company', variant: 'secondary', size: 'normal', type: 'submit', name: 'action', value: 'request'}) }}
                                        {% endif %}

{% endblock %}
{% endembed %}
								</form>
							{% else %}
								{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', section_spacing: false})} %}
{% block body %}

									This course does not currently have an active purchase price.

{% endblock %}
{% endembed %}
							{% endif %}
						{% endif %}

{% endblock %}
{% endembed %}
			</aside>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
