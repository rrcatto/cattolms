{% extends layout %}
{% block page_body %}
	{% if is_preview %}
		<div class="cl-preview-bar">
			<div class="container-fluid cl-container-wide d-flex justify-content-between align-items-center gap-2">
				<strong>Student-view preview</strong><span>Preview data remains until Reset preview.</span>
			</div>
		</div>
	{% endif %}
	<section class="container py-4 py-lg-5 cl-medium">
		<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
			<div>
				<span class="cl-kicker text-primary">{{ session.attempt_mode == 'diagnostic' ? 'Course diagnostic' : (session.attempt_mode == 'practice' ? 'Practice assessment' : 'Graded assessment') }}</span>
				<h1 class="h2 mb-0">
					{{ session.assessment_title }}
				</h1>
			</div>
			<div class="cl-countdown" data-assessment-countdown="{{ session.remaining_seconds }}" data-expiry-form="assessment-finish-form" aria-live="polite">
				{{ session.timer_label }}
			</div>
		</div>
		<div class="progress mb-3" role="progressbar" aria-label="Assessment progress" aria-valuenow="{{ session.counts.answered }}" aria-valuemin="0" aria-valuemax="{{ session.counts.total }}">
			<div class="progress-bar" style="width:{{ session.counts.total ? ((session.counts.answered / session.counts.total) * 100) : 0 }}%">
			</div>
		</div>
		<div class="d-flex justify-content-between text-body-secondary mb-4">
			<span>Answered {{ session.counts.answered }} of {{ session.counts.total }}</span><span>Skipped {{ session.counts.skipped }}</span>
		</div>
		{% if feedback %}
			<div class="alert {{ feedback.is_correct ? 'alert-success' : 'alert-warning' }}">
				<strong>{{ feedback.is_correct ? 'Correct.' : 'Not correct.' }}</strong>
				{% if not feedback.is_correct %}
					<div class="mt-2">
						<strong>Correct answer:</strong> {{ feedback.correct_option_html|raw }}
					</div>
				{% endif %}
				{% if feedback.explanation_html %}
					<div class="mt-2">
						{{ feedback.explanation_html|raw }}
					</div>
				{% endif %}
			</div>
		{% endif %}
		<div class="card cl-question-focus">
			<div class="card-body p-4 p-lg-5">
				<div class="d-flex justify-content-between gap-3 mb-3">
					<span class="badge cl-badge-soft">Question {{ question.sequence }} of {{ session.counts.total }}</span><span>{{ question.points }} point{{ question.points == 1 ? '' : 's' }}</span>
				</div>
				<div class="cl-question-text">
					{{ question.question_html|raw }}
				</div>
				<form action="{{ respond_action }}" method="post" class="mt-4">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<input type="hidden" name="question_id" value="{{ question.question_id }}">
					<div class="cl-options">
						{% for option in question.options %}
							<label class="cl-option">
							<input type="radio" name="option_id" value="{{ option.id }}">
							<span>{{ option.option_html|raw }}</span></label>
						{% endfor %}
					</div>
					<div class="cl-form-actions">
						<button class="btn btn-primary btn-lg" type="submit">Submit answer</button><button class="btn btn-outline-secondary btn-lg" type="submit" name="skip" value="1">Skip for now</button>
					</div>
				</form>
			</div>
		</div>
		<form id="assessment-finish-form" action="{{ finish_action }}" method="post" class="mt-3" onsubmit="return confirm('Finish now? Any skipped or unanswered questions will receive zero.');">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			<button class="btn btn-link text-danger px-0" type="submit">Finish assessment now</button>
		</form>
	</section>
{% endblock %}
