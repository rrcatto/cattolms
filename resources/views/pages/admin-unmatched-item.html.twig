{#
	One unmatched deposit (owner, 2026-10-19): what arrived, in a sentence, and the details from the
	statement. While it is open, ADMIN matches it to an order (find the account from a reference, then the
	order's button) or records that it was paid back. Once sorted out it says how, and nothing changes.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/commerce/unmatched' %}{% set ph_back_label = 'Unmatched Money' %}
	{% set ph_title = 'Unmatched deposit ' ~ item.id %}
	{% set ph_lead = item.amount_label ~ ' · arrived ' ~ item.received %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'What happened', heading_level: 2}) }}
		<p data-unmatched-status>{{ ui('feedback.badge', {label: item.status_label, tone: item.status_tone}) }}</p>
		<p class="cl-lead" data-unmatched-sentence>{{ item.sentence }}</p>
		{% if item.outcome %}<p data-unmatched-outcome>{% include '@platform/partials/admin/money-sentence.html.twig' with {ms_parts: item.outcome_parts} only %}</p>{% endif %}
		{{ ui('data.key-value-list', {items: [
			{label: 'Amount', value: item.amount_label},
			{label: 'Arrived', value: item.received},
			{label: 'Reference the payer used', value: item.payer_reference},
			{label: 'The bank’s reference', value: item.bank_reference},
			{label: 'Where it was seen', value: item.seen_where},
			{label: 'Put on this list', value: item.recorded},
		]}) }}
		<p data-unmatched-recorder><strong>Put on this list by:</strong> {{ ui('data.person', item.recorded_by_person) }}</p>
		{% if item.order_href %}{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}{% block body %}{{ ui('action.link', {label: 'Open order ' ~ item.order_label, variant: 'secondary', size: 'small', href: item.order_href, icon: 'action-open'}) }}{% endblock %}{% endembed %}{% endif %}
	{% endblock %}{% endembed %}</section>
	{% if item.state == 'open' and can_manage %}
	<section class="cl-page-section" id="unmatched-match">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Match it to an order', heading_level: 2, summary: 'When you know who paid it, find their account. Matching records it as that order’s EFT payment on the day it arrived.'}) }}
		<form action="/admin/commerce/unmatched/{{ item.id }}#unmatched-match" method="get">
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Their account reference or order number', for: 'unmatched-reference', required: true, help: 'Such as CL-20261018-13147-3 or CL-00000183.'})} %}{% block control %}<input id="unmatched-reference" name="reference" value="{{ reference }}" maxlength="200" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Find the account', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-search'}) }}{% endblock %}{% endembed %}
		</form>
		{% if match %}{% include '@platform/partials/admin/eft-match.html.twig' with {eft_match: match, eft_action: '/admin/commerce/unmatched/' ~ item.id ~ '/match', eft_hidden: {}, eft_button: 'Match it to this order'} %}{% endif %}
	{% endblock %}{% endembed %}</section>
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Paid it back', heading_level: 2, summary: 'When you have paid it back to whoever sent it, record that here. It leaves the list and never enters the Money Ledger.'}) }}
		<form action="/admin/commerce/unmatched/{{ item.id }}/returned" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">
			{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 2})} %}{% block body %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Date you paid it back', for: 'unmatched-returned-on', required: true})} %}{% block control %}<input id="unmatched-returned-on" type="date" name="returned_on" min="{{ item.received_on }}" max="{{ today }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'The bank’s reference for the payment back', for: 'unmatched-return-reference', required: true})} %}{% block control %}<input id="unmatched-return-reference" name="return_reference" maxlength="200" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Note', for: 'unmatched-note', full_width: true, help: 'Optional, such as who it was and why it was sent.'})} %}{% block control %}<textarea id="unmatched-note" name="note" maxlength="2000" {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}
			{% endblock %}{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Record that it was paid back', variant: 'secondary', size: 'normal', type: 'submit', icon: 'action-record-money'}) }}{% endblock %}{% endembed %}
		</form>
	{% endblock %}{% endembed %}</section>
	{% endif %}
{% endblock %}
