{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses/'~(course.id) %}
	{% set ph_back_label = course.title %}
	{% set ph_kicker = 'Course assessment' %}
	{% set ph_title = 'Final assessment' %}
	{% set ph_lead = 'The default is one graded attempt, but the course owner controls every attempt and scoring rule.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section container-fluid cl-container-wide py-5">
		<div class="row justify-content-center">
			<div class="col-xl-10">
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

					{{ ui('layout.section-head', {heading: 'Assessment details and question pool', heading_level: 2, summary: 'Learners see one randomly selected question at a time.'}) }}

						<form action="/admin/courses/{{ course.id }}/final-assessment" method="post" id="question-editor-form">
							<input type="hidden" name="csrf" value="{{ csrf }}">
							{% include '@platform/partials/assessment-editor.html.twig' %}
						</form>

{% endblock %}
{% endembed %}
			</div>
		</div>
	</section>
{% endblock %}
