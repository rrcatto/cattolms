{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses/'~(course.id) %}
	{% set ph_back_label = course.title %}
	{% set ph_kicker = 'Course assessment' %}
	{% set ph_title = 'Final assessment' %}
	{% set ph_lead = 'The default is one graded attempt, but the course owner controls every attempt and scoring rule.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="container-fluid cl-container-wide py-5">
		<div class="row justify-content-center">
			<div class="col-xl-10">
				<div class="card">
					<div class="card-header bg-white p-4">
						<h2 class="h4 mb-1">
							Assessment details and question pool
						</h2>
						<p class="text-body-secondary mb-0">
							Learners see one randomly selected question at a time.
						</p>
					</div>
					<div class="card-body p-4">
						<form action="/admin/courses/{{ course.id }}/final-assessment" method="post" id="question-editor-form">
							<input type="hidden" name="csrf" value="{{ csrf }}">
							{% include '@platform/partials/assessment-editor.html.twig' %}
						</form>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
