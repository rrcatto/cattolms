{#
	Mailing › Subscribers (owner, 2026-10-28, the approved mockup's page 6): everyone on at least one list. A feature card
	for each way of getting updates says how many chose it and shows only them (without JavaScript, Show); the search
	finds a name, email address or account reference. A table or a grid of cards, as the reader chooses (owner,
	2026-10-28), each with its Actions menu, Never email this address among them. Each name opens the person's
	subscriptions.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Mailing' %}{% set ph_title = 'Subscribers' %}
	{% set ph_lead = 'Everyone on at least one list, with how they get updates. Nobody is here unless they said yes.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	{% set a = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"' %}
	{% set sb_icons = {
		all: '<svg ' ~ a ~ '><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M16.5 14.5c2.6.2 4.4 2 5 5"/></svg>',
		instant: '<svg ' ~ a ~ '><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>',
		daily: '<svg ' ~ a ~ '><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
		weekly: '<svg ' ~ a ~ '><rect x="3.5" y="5" width="17" height="15" rx="1.5"/><path d="M3.5 10h17M8 3v4M16 3v4M7.5 14h2M11 14h2M14.5 14h2"/></svg>',
		monthly: '<svg ' ~ a ~ '><rect x="3.5" y="5" width="17" height="15" rx="1.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="M10 13.5h4l-2.5 4"/></svg>',
	} %}
	{% set sb_cards = [] %}
	{% for value, label in choices %}
		{% set sb_cards = sb_cards|merge([{value: value, label: label, icon: sb_icons[value], note: counts[value] == 1 ? '1 person' : counts[value] ~ ' people'}]) %}
	{% endfor %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'everyone'})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Everyone', summary: 'Choose a card to see only those people. Open a name for their lists and what they were sent.'}) }}
		<form class="cl-library-lists" method="get" action="/mailing/subscribers" data-choose-submits>
			{{ ui('form.picture-choice', {name: 'how', legend: 'How they get updates', id: 'subscriber-choices', size: 'small', columns: 'auto', selected: how, items: sb_cards}) }}
			<noscript>{{ ui('action.button', {label: 'Show', variant: 'secondary', size: 'small', type: 'submit', icon: 'action-filter'}) }}</noscript>
		</form>
		{% set sb_return = subscribers_return %}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'subscribers', pagination: subscribers_pagination, search: {ds_name: 'subscribers', ds_label: 'Search names, emails and account references', ds_value: subscribers_search, ds_action: '/mailing/subscribers', ds_hidden: how == 'all' ? {} : {how: how}}})} %}
		{% block toolbar %}{% if subscribers_pagination %}<div class="cl-list-toolbar">{% include '@platform/partials/view-switch.html.twig' with {vs: subscribers_view_switch} %}</div>{% endif %}{% endblock %}
		{% block results %}
			{% if subscribers and subscribers_view == 'grid' %}
			{% embed ui_template('data.card-grid') with {props: ui_props('data.card-grid', {columns: 5, label: 'Subscribers'})} %}{% block body %}
				{% for row in subscribers %}
				{% embed ui_template('data.card') with {props: ui_props('data.card', {title: row.name, href: '/mailing/subscribers/' ~ row.user_id, picture: 'round'})} %}
				{% block picture %}{% if row.picture_url|default('') %}<img src="{{ row.picture_url }}" alt="" width="96" height="96" loading="lazy">{% endif %}{% endblock %}
				{% block title %}{{ ui('data.person', {name: row.name, href: '/mailing/subscribers/' ~ row.user_id}) }}{% endblock %}
				{% block details %}
					<p class="cl-ui-card-line">{{ row.email }}</p>
					<div class="role-list">
						{{ ui('feedback.badge', {label: row.delivery == 'instant' ? 'As they happen' : (row.frequency == 'daily' ? 'Daily digest' : (row.frequency == 'monthly' ? 'Monthly digest' : 'Weekly digest')), tone: 'info'}) }}
						{% if row.never_emailed %}{{ ui('feedback.badge', {label: 'Never emailed', tone: 'danger'}) }}{% endif %}
					</div>
					<p class="cl-ui-card-line cl-ui-card-quiet">{{ row.lists }} {{ row.lists == 1 ? 'list' : 'lists' }} · Joined {{ row.joined|date('j M Y') }} · Last opened {{ row.last_opened ? row.last_opened|date('j M Y') : 'not yet' }}</p>
				{% endblock %}
				{% block actions %}{% include '@platform/partials/mailing-subscriber-actions.html.twig' with {row: row, return_to: sb_return} %}{% endblock %}
				{% endembed %}
				{% endfor %}
			{% endblock %}{% endembed %}
			{% elseif subscribers %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'Subscribers'})} %}
			{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 22, label: 'Name'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 25, label: 'Email'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 6, label: 'Lists'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 15, label: 'How'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 11, label: 'Joined'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 11, label: 'Last opened'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 10, label: ''}} %}</tr>{% endblock %}
			{% block body %}{% for row in subscribers %}<tr>
				<td class="cell-text">{{ ui('data.person', {name: row.name, href: '/mailing/subscribers/' ~ row.user_id}) }}</td>
				<td class="cell-text">{{ row.email }}{% if row.never_emailed %} {{ ui('feedback.badge', {label: 'Never emailed', tone: 'danger'}) }}{% endif %}</td>
				<td>{{ row.lists }}</td>
				<td>{{ row.delivery == 'instant' ? 'As they happen' : (row.frequency == 'daily' ? 'Daily digest' : (row.frequency == 'monthly' ? 'Monthly digest' : 'Weekly digest')) }}</td>
				<td>{{ row.joined|date('j M Y') }}</td>
				<td>{{ row.last_opened ? row.last_opened|date('j M Y') : 'Not yet' }}</td>
				<td class="cell-actions">{% include '@platform/partials/mailing-subscriber-actions.html.twig' with {row: row, return_to: sb_return} %}</td>
			</tr>{% endfor %}{% endblock %}
			{% endembed %}
			{% else %}
				{{ ui('feedback.empty', {heading: subscribers_search ? 'Nobody matches' : 'Nobody here yet', summary: subscribers_search ? 'Try another name, email address or account reference.' : 'People appear here once they say yes to a list.'}) }}
			{% endif %}
		{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}</section>
{% endblock %}
