{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin/course-items' %}{% set ph_back_label = 'Course Item Library' %}{% set ph_kicker = 'Immutable local files' %}{% set ph_title = 'Resource Library' %}{% set ph_lead = 'All locally stored Course Item files live here. URLs and YouTube IDs are stored on Course Items and are not Resources.' %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% for operation in ['upload','register'] %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
{{ ui('layout.section-head', {heading: operation == 'upload' ? 'Upload Resource' : 'Register existing file'}) }}
<form action="{{ operation == 'upload' ? '/admin/resources' : '/admin/resources/register' }}" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf" value="{{ csrf }}">
{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
{% for field in [{name:'title',label:'Resource title',required:true},{name:'description',label:'Description',required:false}] %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label:field.label,for:operation ~ '-' ~ field.name,required:field.required})} %}{% block control %}<input class="form-control" id="{{ operation }}-{{ field.name }}" name="{{ field.name }}" {{ field.required ? 'required' : '' }} {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% endfor %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label:'Resource type',for:operation ~ '-type',required:true})} %}{% block control %}<select class="form-select" id="{{ operation }}-type" name="resource_type" required {{ ui_field_attrs(props) }}>{% for type in resource_types %}<option value="{{ type }}">{{ type|replace({'_':' '})|title }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label:operation == 'upload' ? 'File' : 'Exact existing filename',for:operation ~ '-file',required:true,help:operation == 'register' ? 'The file must already be in the course-resources directory. No subdirectories or automatic renaming.' : 'Files are immutable. Duplicate filenames and titles are rejected.'})} %}{% block control %}<input class="form-control" id="{{ operation }}-file" type="{{ operation == 'upload' ? 'file' : 'text' }}" name="{{ operation == 'upload' ? 'resource_file' : 'filename' }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% endblock %}{% endembed %}
{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label:operation == 'upload' ? 'Upload Resource' : 'Register file',variant:'primary',type:'submit'}) }}{% endblock %}{% block secondary_actions %}{{ ui('action.link', {label:'Cancel',href:'/admin/resources'}) }}{% endblock %}{% endembed %}
</form>{% endblock %}{% endembed %}
{% endfor %}
<form method="get" action="/admin/resources">
{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Search title or filename',for:'resource-search'})} %}{% block control %}<input class="form-control" id="resource-search" name="q" value="{{ search }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Resource type',for:'resource-filter'})} %}{% block control %}<select class="form-select" id="resource-filter" name="type" {{ ui_field_attrs(props) }}><option value="">All types</option>{% for type in resource_types %}<option value="{{ type }}" {{ type == selected_type ? 'selected' : '' }}>{{ type|replace({'_':' '})|title }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
{{ ui('action.button',{label:'Search',type:'submit'}) }}</form>
{% if resources %}{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'Resource Library files'})} %}{% block header %}<tr><th>Resource</th><th>Type</th><th>File</th><th>Size</th><th>Usage</th><th>Actions</th></tr>{% endblock %}{% block body %}{% for resource in resources %}<tr><td><strong>{{ resource.title }}</strong><br>{{ resource.description }}</td><td>{{ resource.resource_type|replace({'_':' '}) }}</td><td>{{ resource.original_filename }}</td><td>{{ resource.byte_size }} bytes</td><td>{{ resource.usage_count }} Course Items{% if resource.usage %}<details><summary>Show usages</summary><ul>{% for usage in resource.usage %}<li><a href="/admin/course-items/{{ usage.id }}">{{ usage.title }} ({{ usage.item_key }})</a></li>{% endfor %}</ul></details>{% endif %}</td><td><a href="/course-resources/{{ resource.public_id }}">Open</a>{% if resource.usage_count == 0 %}<form action="/admin/resources/{{ resource.id }}/delete" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: 'Delete', variant: 'danger', type: 'submit', size: 'small', confirm: 'Delete this Resource file?'}) }}</form>{% endif %}</td></tr>{% endfor %}{% endblock %}{% endembed %}{% else %}{{ ui('feedback.empty', {heading: 'No Resources', summary: 'Upload the first local file.'}) }}{% endif %}
</section>
{% endblock %}
