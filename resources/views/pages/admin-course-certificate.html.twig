{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin/courses/' ~ course.id %}{% set ph_back_label = 'Course editor' %}{% set ph_kicker = 'Certificate settings' %}{% set ph_title = course.title %}{% set ph_lead = 'Whether this course issues a certificate, and its wording and signatory. The design is the current certificate template, shared by every course.' %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section container-fluid cl-container-wide py-5">

{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Certificate for this course', heading_level: 2, summary: 'A certificate is issued when a learner passes the course. It keeps the wording, names, result and design it was issued with.'}) }}
	<form action="/admin/courses/{{ course.id }}/certificate" method="post">
		<input type="hidden" name="csrf" value="{{ csrf }}">
		{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Issue a certificate after a passing overall result'})} %}{% block control %}<input type="checkbox" id="certificate-enabled" name="certificate_enabled" value="1" {{ course.certificate_enabled ? 'checked' : '' }}>{% endblock %}{% endembed %}
		{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 2})} %}{% block body %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Certificate title', for: 'certificate-title', help: 'For example Certificate of Completion.'})} %}{% block control %}<input id="certificate-title" name="certificate_title" maxlength="240" value="{{ course.certificate_title }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Body text', for: 'certificate-body', help: 'The words between the learner and the course, for example has successfully completed.'})} %}{% block control %}<input id="certificate-body" name="certificate_body_text" maxlength="500" value="{{ course.certificate_body_text }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Signatory name', for: 'signatory-name'})} %}{% block control %}<input id="signatory-name" name="certificate_signatory_name" maxlength="160" value="{{ course.certificate_signatory_name }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Signatory title', for: 'signatory-title'})} %}{% block control %}<input id="signatory-title" name="certificate_signatory_title" maxlength="160" value="{{ course.certificate_signatory_title }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Footer', for: 'certificate-footer', full_width: true, help: 'Optional, for example accreditation details.'})} %}{% block control %}<input id="certificate-footer" name="certificate_footer_text" maxlength="500" value="{{ course.certificate_footer_text }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
		{% endblock %}{% endembed %}
		{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save certificate settings', variant: 'primary', type: 'submit'}) }}{% endblock %}{% endembed %}
	</form>
{% endblock %}{% endembed %}

{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'certificate-preview'})} %}{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Preview', heading_level: 2, summary: 'This course’s certificate for a sample learner, in the current design, drawn by the renderer that issues certificates.'}) }}
	{% if current_template %}
	<p>Design: <strong>{{ current_template.template_name }}</strong>, version {{ current_template.version_number }}.
	{% if can_view_templates %}{{ ui('action.link', {label: 'Manage certificate templates', variant: 'secondary', size: 'small', href: '/admin/documents/templates?type=certificate'}) }}{% endif %}</p>
	{% endif %}
	{% include '@platform/partials/document-template-preview.html.twig' with {dp_error: preview_error, dp_pdf_href: '/admin/courses/' ~ course.id ~ '/certificate/sample.pdf', dp_title: 'Certificate preview for ' ~ course.title} %}
{% endblock %}{% endembed %}
</section>
{% endblock %}
