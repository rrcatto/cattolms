{% extends layout %}
{% block page_body %}
{% if admin_section.key == 'ui_components' %}{{ importmap() }}{% endif %}
	{% set ph_kicker = 'Administration' %}
	{% set ph_title = admin_section.label %}
	{% set ph_lead = admin_section.description %}
	{% set ph_action_href = can_access_admin ? '/admin' : '' %}
	{% set ph_action_label = 'All administration' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section section cl-admin-standalone-section" data-admin-section="{{ admin_section.key }}">
		{{ admin_section.content|raw }}
	</section>
{% endblock %}
