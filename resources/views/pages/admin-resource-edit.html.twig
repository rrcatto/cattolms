{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin/resources' %}{% set ph_back_label = 'Resource Library' %}{% set ph_kicker = 'Resource details' %}{% set ph_title = resource.title %}{% set ph_lead = resource.original_filename ~ ' · ' ~ size_label ~ '. The stored file never changes; only its details do.' %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
{{ ui('layout.section-head', {heading: 'Edit details', summary: 'A changed type must still suit every Course Item that uses this file.'}) }}
<form action="/admin/resources/{{ resource.id }}" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">
{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Resource title', for: 'resource-title', required: true})} %}{% block control %}<input class="form-control" id="resource-title" name="title" value="{{ resource.title }}" maxlength="240" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Resource type', for: 'resource-type', required: true})} %}{% block control %}<select class="form-select" id="resource-type" name="resource_type" required {{ ui_field_attrs(props) }}>{% for type in resource_types %}<option value="{{ type }}" {{ type == resource.resource_type ? 'selected' : '' }}>{{ type|replace({'_':' '})|capitalize }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Description', for: 'resource-description', full_width: true})} %}{% block control %}<textarea class="form-control" id="resource-description" name="description" rows="3" {{ ui_field_attrs(props) }}>{{ resource.description }}</textarea>{% endblock %}{% endembed %}
{% endblock %}{% endembed %}
{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save details', variant: 'primary', type: 'submit'}) }}{% endblock %}{% block secondary_actions %}{{ ui('action.link', {label: 'Cancel', href: '/admin/resources/' ~ resource.id}) }}{% endblock %}{% endembed %}
</form>
{% endblock %}{% endembed %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Used by', summary: usage ? usage|length ~ ' Course Items. It cannot be deleted while any item uses it.' : 'No Course Item uses this file, so it can be deleted from the Resource Library.'})} %}{% block section_actions %}{{ ui('action.link', {label: 'Create course item', href: '/admin/course-items/new?resource_id=' ~ resource.id, size: 'small', variant: 'primary', icon: 'action-add'}) }}{% endblock %}{% endembed %}
{% if usage %}{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}{% block body %}{% for item in usage %}{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}{% block body %}<strong>{{ item.title }}</strong><div><code>{{ item.item_key }}</code> · {{ item.item_type|replace({'_':' '}) }}</div>{% endblock %}{% block actions %}{{ ui('action.link', {label: 'Edit item', href: '/admin/course-items/' ~ item.id, size: 'small'}) }}{% endblock %}{% endembed %}{% endfor %}{% endblock %}{% endembed %}{% endif %}
{% endblock %}{% endembed %}
</section>
{% endblock %}
