{% extends layout %}

{% block page_body %}
{% set ph_kicker = 'Administration' %}
{% set ph_title = 'Platform administration' %}
{% set ph_lead = 'Every top-level Administration area is available in one workspace. Open only the sections you need.' %}
{% include '@platform/partials/page-head.html.twig' %}


<section class="cl-admin-workspace section" data-admin-workspace>
  {% for section in admin_sections %}
    <details class="cl-admin-section" data-admin-section="{{ section.key }}" {{ section.key=='dashboard' ? 'open' : '' }}>
      <summary class="cl-admin-section-summary">
        <span class="cl-admin-section-title">{{ section.label }}</span>
        <span class="cl-admin-section-description">{{ section.description }}</span>
        <span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
      </summary>
      <div class="cl-admin-section-content">
        <div class="cl-admin-section-actions"><a class="cl-admin-section-link" href="{{ section.route }}">Open as standalone page</a></div>
        {{ section.content|raw }}
      </div>
    </details>
  {% endfor %}
</section>
{% endblock %}
