{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses/'~(course.id) %}
	{% set ph_back_label = course.title %}
	{% set ph_kicker = 'Course module' %}
	{% set ph_title = module.id ? 'Edit module' : 'Add module' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section container-fluid cl-container-wide py-5">
		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {})} %}
{% block body %}

			<div>
				<form action="{{ form_action }}" method="post">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

					<input type="hidden" name="csrf" value="{{ csrf }}">
					{{ ui('layout.section-head', {heading: 'Module content', heading_level: 2}) }}

						{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Position', full_width: false, for: 'field-admin-module-form-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

								<input class="form-control" type="number" min="1" name="position" value="{{ module.position }}" required id="field-admin-module-form-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Module key', full_width: false, for: 'field-admin-module-form-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

								<input class="form-control" name="module_key" value="{{ module.module_key }}" required id="field-admin-module-form-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Title', full_width: false, for: 'field-admin-module-form-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

								<input class="form-control" name="title" value="{{ module.title }}" required id="field-admin-module-form-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Subtitle', full_width: true, for: 'field-admin-module-form-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

								<input class="form-control" name="subtitle" value="{{ module.subtitle }}" id="field-admin-module-form-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Learning outcomes', full_width: true, for: 'field-admin-module-form-5-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

								<textarea class="form-control cl-rich-editor" name="learning_outcomes_html" rows="6" id="field-admin-module-form-5-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>{{ module.learning_outcomes_html }}</textarea>

{% endblock %}
{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Main module content', full_width: true, for: 'field-admin-module-form-6-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), help: 'Saving this field updates the main HTML block while retaining imported accordions and other structured blocks.'})} %}
{% block control %}

								<textarea class="form-control cl-rich-editor" name="content_html" rows="20" id="field-admin-module-form-6-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>{{ module.content_html }}</textarea>

{% endblock %}
{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Module summary', full_width: true, for: 'field-admin-module-form-7-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

								<textarea class="form-control cl-rich-editor" name="summary_html" rows="8" id="field-admin-module-form-7-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>{{ module.summary_html }}</textarea>

{% endblock %}
{% endembed %}
							<div>
								{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'This is a review/revision module'})} %}
{% block control %}

									<input id="is-review" type="checkbox" name="is_review" value="1" {{ module.is_review ? 'checked' : '' }}>

{% endblock %}
{% endembed %}
							</div>
							<div>
								{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'This module requires an assessment and counts toward the course module grade'})} %}
{% block control %}

									<input type="hidden" name="assessment_required" value="0">
									<input id="assessment-required" type="checkbox" name="assessment_required" value="1" {{ module.assessment_required ? 'checked' : '' }}>

{% endblock %}
{% endembed %}
							</div>

{% endblock %}
{% endembed %}
						{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

							{{ ui('action.button', {label: (module.id ? 'Save module' : 'Create module'), variant: 'primary', size: 'normal', type: 'submit', icon: 'action-add'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
				{% if module.id %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'assessment'})} %}
{% block surface_body %}

						{{ ui('layout.section-head', {heading: 'Module assessment', heading_level: 2, summary: 'Configure practice, question pools, timing, attempts, grading and individual questions.'}) }}

							<form action="/admin/courses/{{ course.id }}/modules/{{ module.id }}/assessment" method="post" id="question-editor-form">
								<input type="hidden" name="csrf" value="{{ csrf }}">
								{% include '@platform/partials/assessment-editor.html.twig' %}
							</form>

{% endblock %}
{% endembed %}
				{% endif %}
			</div>
			<aside>
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {sticky: true})} %}
{% block surface_body %}

						<h2 class="h4">
							Editing notes
						</h2>
						<ul>
							<li>
								Use CKEditor or Source mode for HTML.
							</li>
							<li>
								Published-course changes appear immediately for current learners.
							</li>
							<li>
								Imported structured accordions are retained.
							</li>
							<li>
								Assessment questions appear on a separate learner page.
							</li>
						</ul>
						{% if module.id %}
							<form action="/admin/courses/{{ course.id }}/modules/{{ module.id }}/delete" method="post" onsubmit="return confirm('Delete this module and its assessment?');">
								<input type="hidden" name="csrf" value="{{ csrf }}">
								{{ ui('action.button', {label: 'Delete module', variant: 'danger', size: 'normal', full_width: true, type: 'submit', icon: 'action-remove'}) }}
							</form>
						{% endif %}

{% endblock %}
{% endembed %}
			</aside>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
