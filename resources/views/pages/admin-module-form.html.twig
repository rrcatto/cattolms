{% extends layout %}

{% block page_body %}
{% set ph_back_href = '/admin/courses/'~(course.id) %}
{% set ph_back_label = course.title %}
{% set ph_kicker = 'Course module' %}
{% set ph_title = module.id ? 'Edit module' : 'Add module' %}
{% include '@platform/partials/page-head.html.twig' %}<section class="container-fluid cl-container-wide py-5"><div class="row g-4"><div class="col-xl-8"><form action="{{ form_action }}" method="post" class="card mb-4"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="card-header bg-white p-4"><h2 class="h4 mb-0">Module content</h2></div><div class="card-body p-4"><div class="row g-3"><div class="col-md-3"><label class="form-label">Position</label><input class="form-control" type="number" min="1" name="position" value="{{ module.position }}" required></div><div class="col-md-3"><label class="form-label">Module key</label><input class="form-control" name="module_key" value="{{ module.module_key }}" required></div><div class="col-md-6"><label class="form-label">Title</label><input class="form-control" name="title" value="{{ module.title }}" required></div><div class="col-12"><label class="form-label">Subtitle</label><input class="form-control" name="subtitle" value="{{ module.subtitle }}"></div><div class="col-12"><label class="form-label">Learning outcomes</label><textarea class="form-control cl-rich-editor" name="learning_outcomes_html" rows="6">{{ module.learning_outcomes_html }}</textarea></div><div class="col-12"><label class="form-label">Main module content</label><textarea class="form-control cl-rich-editor" name="content_html" rows="20">{{ module.content_html }}</textarea><div class="form-text">Saving this field updates the main HTML block while retaining imported accordions and other structured blocks.</div></div><div class="col-12"><label class="form-label">Module summary</label><textarea class="form-control cl-rich-editor" name="summary_html" rows="8">{{ module.summary_html }}</textarea></div><div class="col-12"><div class="form-check"><input class="form-check-input" id="is-review" type="checkbox" name="is_review" value="1" {{ module.is_review ? 'checked' : '' }}><label class="form-check-label" for="is-review">This is a review/revision module</label></div></div><div class="col-12"><div class="form-check"><input type="hidden" name="assessment_required" value="0"><input class="form-check-input" id="assessment-required" type="checkbox" name="assessment_required" value="1" {{ module.assessment_required ? 'checked' : '' }}><label class="form-check-label" for="assessment-required">This module requires an assessment and counts toward the course module grade</label></div></div></div><button class="btn btn-primary mt-4" type="submit">{{ module.id ? 'Save module' : 'Create module' }}</button></div></form>{% if module.id %}<section class="card" id="assessment"><div class="card-header bg-white p-4"><h2 class="h4 mb-1">Module assessment</h2><p class="text-body-secondary mb-0">Configure practice, question pools, timing, attempts, grading and individual questions.</p></div><div class="card-body p-4"><form action="/admin/courses/{{ course.id }}/modules/{{ module.id }}/assessment" method="post" id="question-editor-form"><input type="hidden" name="csrf" value="{{ csrf }}">{% include '@platform/partials/assessment-editor.html.twig' %}</form></div></section>{% endif %}</div><aside class="col-xl-4"><div class="card cl-sticky-card"><div class="card-body p-4"><h2 class="h4">Editing notes</h2><ul><li>Use CKEditor or Source mode for HTML.</li><li>Published-course changes appear immediately for current learners.</li><li>Imported structured accordions are retained.</li><li>Assessment questions appear on a separate learner page.</li></ul>{% if module.id %}<form action="/admin/courses/{{ course.id }}/modules/{{ module.id }}/delete" method="post" onsubmit="return confirm('Delete this module and its assessment?');"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-outline-danger w-100" type="submit">Delete module</button></form>{% endif %}</div></div></aside></div></section>
{% endblock %}
