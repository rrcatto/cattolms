{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin/documents/templates/' ~ template.id %}{% set ph_back_label = template.name %}{% set ph_kicker = template.type_label ~ ' template' %}{% set ph_title = 'Version ' ~ version.version_number %}{% set ph_lead = version.state == 'draft' ? 'The draft. It can still change until it is published.' : 'Published ' ~ (version.published_at|date('j M Y H:i')) ~ '. A published version never changes.' %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Version ' ~ version.version_number, heading_level: 2}) }}
	{{ ui('data.key-value-list', {items: [
		{label: 'State', value: version.state == 'draft' ? 'Draft' : 'Published'},
		{label: 'Page', value: version.settings_label},
		{label: 'Created', value: (version.created_at|date('j M Y H:i')) ~ (version.created_by_name ? ' by ' ~ version.created_by_name : '')},
		{label: 'Published', value: version.published_at ? (version.published_at|date('j M Y H:i')) ~ (version.published_by_name ? ' by ' ~ version.published_by_name : '') : '—'},
		{label: 'Note', value: version.change_note ?? '—'},
	]}) }}
	{% if can_manage and not has_draft %}
	<form action="/admin/documents/templates/{{ template.id }}/versions/{{ version.id }}/draft" method="post">
		<input type="hidden" name="csrf" value="{{ csrf }}">
		{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Start a new draft from this version', variant: 'primary', type: 'submit', icon: 'action-add'}) }}{% endblock %}{% endembed %}
	</form>
	{% elseif can_manage %}<p class="help">The template already has a draft. Publish or discard it before starting another from this version.</p>{% endif %}
{% endblock %}{% endembed %}

{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'template-preview'})} %}{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Preview', heading_level: 2}) }}
	{% include '@platform/partials/document-template-preview.html.twig' with {dp_error: preview_error, dp_pdf_href: '/admin/documents/templates/' ~ template.id ~ '/versions/' ~ version.id ~ '/sample.pdf', dp_title: 'Preview of version ' ~ version.version_number} %}
{% endblock %}{% endembed %}

{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Source', heading_level: 2}) }}
	{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 1})} %}{% block body %}
		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'HTML', for: 'version-html', full_width: true})} %}{% block control %}<textarea id="version-html" rows="20" class="cl-template-source" readonly {{ ui_field_attrs(props) }}>{{ version.html }}</textarea>{% endblock %}{% endembed %}
		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'CSS', for: 'version-css', full_width: true})} %}{% block control %}<textarea id="version-css" rows="10" class="cl-template-source" readonly {{ ui_field_attrs(props) }}>{{ version.css }}</textarea>{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}
{% endblock %}{% endembed %}
</section>
{% endblock %}
