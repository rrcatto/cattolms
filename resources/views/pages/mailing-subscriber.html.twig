{#
	One subscriber (owner, 2026-10-28, the approved mockup's page 6): who they are and how they get updates; the lists they
	are on, each with when and where they joined and Take off this list; what they were sent, with its opening and
	clicks; every answer they gave; and Stop all email, which takes them off every list and puts the address on
	Addresses never emailed.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/mailing/subscribers' %}{% set ph_back_label = 'Subscribers' %}
	{% set ph_kicker = 'Subscriber' %}
	{% set ph_title = person.name %}
	{% set ph_lead %}{{ ui('data.person', {name: person.name, reference: person.account_reference, email: person.email, href: '/admin/people/' ~ person.user_id, full: true}) }}{% endset %}
	{% set ph_actions %}{{ ui('action.link', {label: 'Open their account', variant: 'secondary', href: '/admin/people/' ~ person.user_id, icon: 'action-open'}) }}{% endset %}
	{% set ph_badges %}
		{{ ui('feedback.badge', {label: person.never_emailed ? 'Never emailed' : (lists ? 'Receiving' : 'On no list'), tone: person.never_emailed ? 'danger' : (lists ? 'success' : 'neutral')}) }}
		{{ ui('feedback.badge', {label: person.delivery == 'instant' ? 'Updates as they happen' : (person.delivery == 'per_list' ? 'A digest for each list' : 'One digest') ~ (person.delivery == 'instant' ? '' : ', ' ~ frequencies[person.frequency]|lower), tone: 'info'}) }}
		{% if person.delivery is null %}{{ ui('feedback.badge', {label: 'Not chosen yet', tone: 'neutral'}) }}{% endif %}
	{% endset %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
	{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'main-side', section_spacing: false})} %}
{% block body %}
		<div>
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'lists'})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'On these lists', summary: 'Taking them off one list leaves every other list they are on.'}) }}
			{% for list in lists %}
				<article class="cl-mailing-update">
					<div class="cl-mailing-update-main"><div>
						<p class="cl-mailing-update-headline"><a href="/mailing/lists/{{ list.id }}">{{ list.name }}</a></p>
						<p class="small cl-text-secondary">{{ {news: 'News and Updates', own: 'Your list', category: 'Category', course: 'Course', tag: 'Tag'}[list.kind] }} · since {{ list.changed_at|date('j M Y') }} · {{ sources[list.source]|default(list.source) }}</p>
					</div></div>
					{% if can_manage %}
					<div class="cl-mailing-update-actions"><form action="/mailing/subscribers/{{ person.user_id }}/take-off" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="list_id" value="{{ list.id }}">{{ ui('action.button', {label: 'Take off this list', variant: 'secondary', size: 'small', type: 'submit', icon: 'action-remove', confirm: 'Take ' ~ person.name ~ ' off ' ~ list.name ~ '?'}) }}</form></div>
					{% endif %}
				</article>
			{% else %}
				{{ ui('feedback.empty', {heading: 'On no list now', summary: 'They are not sent any news.'}) }}
			{% endfor %}
		{% endblock %}{% endembed %}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'sent'})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'What they were sent', summary: 'The latest 50, newest first.'}) }}
			{% if sent %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'Emails sent to them'})} %}
			{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Date'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 46, label: 'Email'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Opened'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Clicked'}} %}</tr>{% endblock %}
			{% block body %}{% for copy in sent %}<tr>
				<td>{{ (copy.handed_at ?: copy.created_at)|date('j M Y') }}</td>
				<td class="cell-text"><a href="/mailing/messages/{{ copy.campaign_id }}">{{ copy.subject }}</a>{% if not copy.handed_at %} {{ ui('feedback.badge', {label: copy.status == 'queued' ? 'Waiting to go' : 'Not sent', tone: 'neutral'}) }}{% endif %}</td>
				<td>{{ copy.first_opened_at ? copy.first_opened_at|date('j M Y') : '' }}</td>
				<td>{{ copy.click_count > 0 ? (copy.click_count == 1 ? '1 click' : copy.click_count ~ ' clicks') : '' }}</td>
			</tr>{% endfor %}{% endblock %}
			{% endembed %}
			{% else %}
				<p class="small">Nothing has been sent to them yet.</p>
			{% endif %}
		{% endblock %}{% endembed %}
		</div>
		<div>
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'history'})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'History', summary: 'Every answer they gave, newest first.'}) }}
			{% if history %}
			<ul class="cl-mailing-history">
				{% for event in history %}<li><span class="small cl-text-secondary">{{ event.created_at|date('j M Y, H:i') }}</span> {{ event.status == 'subscribed' ? 'Joined' : 'Left' }} {{ event.name }}: {{ sources[event.source]|default(event.source)|lower }}</li>{% endfor %}
			</ul>
			{% else %}
				<p class="small">No answers yet.</p>
			{% endif %}
		{% endblock %}{% endembed %}
		{% if can_manage and not person.never_emailed %}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'stop'})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Stop all email', summary: 'They are taken off every list and the address goes on Addresses never emailed. Account and order emails still go.'}) }}
			<form action="/mailing/subscribers/{{ person.user_id }}/stop" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: 'Stop all email to this address', variant: 'danger', size: 'small', type: 'submit', icon: 'action-remove', confirm: 'Stop all news to ' ~ person.email ~ '? Only taking the address off Addresses never emailed allows it again.'}) }}</form>
		{% endblock %}{% endembed %}
		{% endif %}
		</div>
{% endblock %}
{% endembed %}
	</section>
{% endblock %}
