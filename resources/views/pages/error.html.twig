{% extends layout %}
{% block page_body %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {tone: 'danger'})} %}
{% block surface_body %}

				<div class="cl-display-4 fw-bold cl-text-danger">
					{{ status }}
				</div>
				<h1 class="h3 mt-5">
					Request failed
				</h1>
				<p>
					{{ message }}
				</p>
				{{ ui('action.link', {label: 'Return home', variant: 'primary', size: 'normal', href: '/'}) }}

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
