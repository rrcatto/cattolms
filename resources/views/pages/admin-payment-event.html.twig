{#
	One step of one payment (MoneyRecords::paymentEvent). The page head names the account first; the first
	card says what happened as a sentence, then the facts in plain words (owner, 2026-10-18). The gateway's
	codes and everything it sent are folded under Technical details. It is opened from its order's page
	(owner, 2026-10-19), so the way back is to the order.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_back_href = event.order_href ~ '#order-records' %}{% set ph_back_label = 'Order ' ~ event.order_label %}
	{% set ph_title = 'Payment step ' ~ event.id %}
	{% if event.account_person %}{% set ph_lead %}{{ ui('data.person', event.account_person|merge({full: true})) }}{% endset %}{% else %}{% set ph_lead = event.account_reference_label ? 'Account ' ~ event.account_reference_label ~ ' · ' ~ (event.account_label ?: '—') : (event.account_label ?: 'No account') %}{% endif %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'What happened'}) }}
		<p class="cl-lead" data-payment-sentence>{% include '@platform/partials/admin/money-sentence.html.twig' with {ms_parts: event.sentence_parts} only %}</p>
		{{ ui('data.key-value-list', {items: [
			{label: 'When', value: event.when},
			{label: 'Amount', value: event.amount_label},
			{label: 'How', value: event.method_label},
			{label: 'Order', value: event.order_label},
			{label: 'Where the payment stands now', value: event.payment_state_label},
			{label: 'Bank or Stitch reference', value: event.provider_reference ?: '—'},
		]}) }}
		{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}{% block body %}
			{{ ui('action.link', {label: 'Open the order', variant: 'secondary', size: 'small', href: event.order_href}) }}
			{{ ui('action.link', {label: 'Every step of this payment', variant: 'secondary', size: 'small', href: event.payment_events_href}) }}
			{{ ui('action.link', {label: 'The order’s money in the ledger', variant: 'secondary', size: 'small', href: event.order_ledger_href}) }}
		{% endblock %}{% endembed %}
		{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Technical details', summary: 'The payment’s codes and what the gateway sent'})} %}{% block body %}
			{{ ui('data.key-value-list', {items: [{label: 'Payment', value: event.payment_id}, {label: 'Gateway', value: event.gateway}, {label: 'Step code', value: event.state}, {label: 'Event key', value: event.event_key}]|merge(event.lines)}) }}
		{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}</section>
{% endblock %}
