{% extends layout %}
{% block page_body %}
{% set ph_kicker = 'Catalogue' %}{% set ph_title = 'Course bundles' %}{% set ph_lead = 'Several courses for one bundle price. Each course in a bundle opens in your library like any other course you buy.' %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section">
	<p><a href="/courses">Browse all courses</a></p>
	{# Bundles as bundles (owner, 2026-11-07, the approved mockup): their own cards or their own list, List and Grid changing
	   them in place. #}
	{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'bundles', pagination: bundles_pagination})} %}
	{% block toolbar %}{% if bundles %}<div class="cl-list-toolbar">{% include '@platform/partials/view-switch.html.twig' with {vs: bundles_view_switch, vs_region: 'bundles-view'} %}</div>{% endif %}{% endblock %}
	{% block results %}
		{% if bundles %}
			{{ ui('catalogue.bundles', {bundles: bundles, view: bundles_view}) }}
		{% else %}
			{{ ui('feedback.empty', {heading: 'No bundles yet', summary: 'There are no course bundles on offer at the moment.'}) }}
		{% endif %}
	{% endblock %}
	{% endembed %}
</section>
{% endblock %}
