{#
Generated by: Claude Code CLI
Date time: 2026/09/06 23:55 SAST
Version: 0.6
Description:
  Course tag administration.

  Tags are cross-cutting classification, deliberately not a second hierarchy: that distinction is
  the whole reason both tags and categories exist. So this is a flat, searched, paginated list
  using the same three shared controls every other list on the platform uses, rather than the tree
  the categories screen renders.

  The slug is derived from the name rather than typed. It is the canonical key, so deriving it is
  what stops one tag becoming three through casing and spacing.

  The course count beside a tag is scoped to the reader's data universe. The label is shared; what
  is counted under it is not.

  Comments here are plain prose only: no angle brackets, no comment delimiters, no template tokens
  and no code. Each of those is read as markup rather than as text.

Changelog:
  2026/09/06 23:55 SAST
  - Created with the v0.6 tag administration surface.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses' %}
	{% set ph_back_label = 'Course administration' %}
	{% set ph_kicker = 'Course metadata' %}
	{% set ph_title = 'Course tags' %}
	{% set ph_lead = 'Cross-cutting labels a course may carry as many of as it needs.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<div class="container-fluid cl-container-wide pt-4">
		{% include '@platform/partials/admin/course-group-nav.html.twig' %}
	</div>
	<section class="container-fluid cl-container-wide py-5">
		<div class="toolbar">
			<div>
			</div>
			<button class="btn btn-primary" type="button" data-open-modal="createTagModal">＋ Create tag</button>
		</div>
		{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'tags', ds_label: 'Search tags', ds_value: tags_search, ds_action: '/admin/courses/tags'} %}
		<div id="tags-region" data-server-search-target>
			<div id="tags-results">
				{% if tags_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: tags_pagination} %}
				{% endif %}
				<div class="card">
					<div class="table-wrap">
						<table class="table align-middle mb-0">
							<thead>
								<tr>
									<th style="width:72%">
										Tag
									</th>
									<th style="width:8%">
										Courses
									</th>
									<th class="cell-actions" style="width:20%">
										Actions
									</th>
								</tr>
							</thead>
							<tbody>
								{% for tag in tags %}
									<tr>
										<td title="{{ tag.name }}">
											{{ tag.name }}
										</td>
										<td>
											{{ tag.course_count }}
										</td>
										<td class="cell-actions">
											<details class="row-menu" data-cl-dropdown>
												<summary class="btn btn-soft btn-sm row-menu-trigger">
													Actions ▾
												</summary>
												<div class="row-menu-panel">
													<a class="btn btn-soft btn-sm" href="/courses/tag/{{ tag.slug }}">View</a>
													<form action="/admin/courses/tags/{{ tag.id }}/delete" method="post">
														<input type="hidden" name="csrf" value="{{ csrf }}">
														<button class="btn btn-outline-danger btn-sm" type="submit" data-confirm="Delete this tag? It is detached from every course carrying it.">Delete</button>
													</form>
												</div>
											</details>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
				{% if tags_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: tags_pagination} %}
				{% endif %}
			</div>
		</div>
	</section>
	<div class="modal-backdrop" id="createTagModal" role="dialog" aria-modal="true" aria-labelledby="createTagTitle" aria-hidden="true" hidden>
		<div class="modal-card">
			<div class="modal-head">
				<div>
					<div class="eyebrow">
						Course metadata
					</div>
					<h3 id="createTagTitle">
						Create tag
					</h3>
				</div>
				<button class="close-btn" type="button" data-close-modal aria-label="Close">×</button>
			</div>
			<form action="/admin/courses/tags" method="post">
				<div class="modal-body">
					<div class="form-grid">
						<input type="hidden" name="csrf" value="{{ csrf }}">
						<div class="field">
							<label for="tag-name">Name</label>
							<input id="tag-name" name="name" maxlength="80" required>
						</div>
					</div>
				</div>
				<div class="modal-foot">
					<button class="btn btn-ghost" type="button" data-close-modal>Cancel</button>
					<button class="btn btn-primary" type="submit">Create tag</button>
				</div>
			</form>
		</div>
	</div>
{% endblock %}
