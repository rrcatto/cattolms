{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Administration' %}
	{% set ph_title = 'Course Tags' %}
	{% set ph_lead = 'Cross-cutting labels a course may carry as many of as it needs.' %}
	{# The page's main action belongs to the page, so it sits in the page head. #}
	{% set ph_actions %}{{ ui('action.button', {label: 'Create tag', variant: 'primary', size: 'normal', type: 'button', modal: 'createTagModal', icon: 'action-add'}) }}{% endset %}
	{% include '@platform/partials/page-head.html.twig' %}
	{# The plain section wrapper the other Courses pages use, so the card lands in the same place. #}
	<section class="cl-page-section">
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

				{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'The catalogue\'s tags', eyebrow: 'Course Tags', summary: 'Tags a course can carry. A tag crosses categories, so the same tag may appear on courses filed in different branches.'})} %}
{% endembed %}

			{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'tags', pagination: tags_pagination, search: {ds_name: 'tags', ds_label: 'Search tags', ds_value: tags_search, ds_action: '/admin/courses/tags'}})} %}
{% block results %}

						{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

								<tr>
									{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 72, label: 'Tag'}} %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'Courses'}} %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 20, label: 'Actions'}} %}
								</tr>

{% endblock %}
{% block body %}

								{% for tag in tags %}
									<tr>
										<td title="{{ tag.name }}">
											{% if tag.icon_svg|default('') %}<span class="cl-tag-icon" aria-hidden="true">{{ tag.icon_svg|raw }}</span> {% endif %}{{ tag.name }}
										</td>
										<td>
											{{ tag.course_count }}
										</td>
										<td class="cell-actions">
											{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true, icon: 'action-more'})} %}
{% block body %}

													{{ ui('action.link', {label: 'Edit', variant: 'primary', size: 'small', href: '/admin/courses/tags/' ~ (tag.id), aria_label: 'Edit ' ~ tag.name, icon: 'action-edit'}) }}
													{{ ui('action.link', {label: 'View', variant: 'secondary', size: 'small', href: '/courses/tag/' ~ (tag.slug), icon: 'action-view'}) }}
													<form action="/admin/courses/tags/{{ tag.id }}/delete" method="post">
														<input type="hidden" name="csrf" value="{{ csrf }}">
														{{ ui('action.button', {label: 'Delete', variant: 'danger', size: 'small', type: 'submit', confirm: 'Delete this tag? It is detached from every course carrying it.', icon: 'action-remove'}) }}
													</form>

{% endblock %}
{% endembed %}
										</td>
									</tr>
								{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
		{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'createTagModal', title: 'Create tag', action: '/admin/courses/tags', method: 'post', upload: true})} %}
{% block modal_body %}

					{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

						<input type="hidden" name="csrf" value="{{ csrf }}">
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Name', full_width: false, for: 'tag-name', required: true})} %}
{% block control %}

							<input id="tag-name" name="name" maxlength="80" required {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Icon (an SVG file, optional)', for: 'tag-icon', help: 'Shown in the tag on course cards and pages. Without one, a lettered icon is made.'})} %}{% block control %}<input class="cl-input" type="file" id="tag-icon" name="icon" accept=".svg,image/svg+xml" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% endblock %}
{% endembed %}

{% endblock %}
{% block modal_actions %}

					{{ ui('action.button', {label: 'Cancel', variant: 'quiet', size: 'normal', type: 'button', close_modal: true, icon: 'action-cancel'}) }}
					{{ ui('action.button', {label: 'Create tag', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-add'}) }}

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
