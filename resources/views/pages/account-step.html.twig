{% extends layout %}
{% block page_body %}
	{# What a signed-in person must do before anything else: their South African ID number once, when their account has
	   none (owner, 2026-10-27, 4A), which gives their date of birth (adults only, 2026-10-20), or, when their verified
	   identity document shows them under 18, the adults-only page, which goes no further. #}
	{% set ph_kicker = 'Your account' %}
	{% set ph_title = step == 'id_number' ? 'Before you continue' : 'This site is for adults' %}
	{% set ph_lead = step == 'id_number' ? 'Please give your South African ID number once. It shows that you are 18 or older, and each person has one account.' : 'Your identity document shows that you are under 18.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{% if step == 'id_number' %}
			{{ ui('layout.section-head', {heading: 'Your South African ID number', heading_level: 2, summary: 'Learners must be 18 or older and hold a South African ID number. It is kept encrypted with your account and shown only with its last seven digits hidden.'}) }}
			<form action="/account/id-number" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_path" value="{{ return_path }}">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'South African ID number', for: 'id-number', required: true, help: 'The 13 digits on your green ID book or smart ID card. Spaces are fine.'})} %}{% block control %}<input type="text" id="id-number" name="id_number" inputmode="numeric" autocomplete="off" maxlength="16" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Continue', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-next'}) }}{% endblock %}{% endembed %}
			</form>
			{% else %}
			{{ ui('layout.section-head', {heading: 'Your account cannot be used', heading_level: 2, summary: 'Learners must be 18 or older.'}) }}
			<p>The identity document you verified shows that you are under 18. This site is for adults, so your account goes no further. If this is wrong, <a href="/contact">contact us</a>.</p>
			{% endif %}
			<p>Read the <a href="/terms">Terms and Conditions</a> and the <a href="/privacy">Privacy Policy</a>.</p>
			<form action="/logout" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: step == 'id_number' ? 'Sign out instead' : 'Sign out', variant: 'quiet', size: 'small', type: 'submit', icon: 'nav-signout'}) }}</form>
		{% endblock %}{% endembed %}
	</section>
{% endblock %}
