{#
	One sign-up attempt (owner, 2026-10-26: "I can drill down on them for more details"): its risk and every signal the
	sign-up check found with its points and why, then where it came from, the browser and how the form was filled in, and
	what became of it, with the account it became.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Sign-up Attempts' %}{% set ph_title = attempt.email %}
	{% set ph_lead = 'Sent ' ~ attempt.created_at ~ (attempt.name ? ' as ' ~ attempt.name : '') ~ '.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: attempt.risk_label ~ ', ' ~ attempt.score ~ ' points', summary: attempt.signals ? 'What the sign-up check found, and why each counts.' : 'The sign-up check found nothing against it.'}) }}
		{% if attempt.signals %}
		{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
		{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 80, label: 'Found'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 20, label: 'Points'}} %}</tr>{% endblock %}
		{% block body %}{% for signal in attempt.signals %}<tr><td class="cell-text">{{ signal.words }}</td><td>{{ signal.points }}</td></tr>{% endfor %}{% endblock %}
		{% endembed %}
		{% endif %}
		{% if attempt.hold_words %}<p class="cl-mt-2">Held for approval: {{ attempt.hold_words|join(', ') }}.</p>{% endif %}
	{% endblock %}{% endembed %}</section>
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Where it came from', summary: 'From the IP address, looked up on this server.'}) }}
		{{ ui('data.key-value-list', {items: [
			{label: 'IP address', value: attempt.ip_address ?: 'None'},
			{label: 'Place', value: attempt.place},
			{label: 'Country', value: attempt.country},
			{label: 'Says they live in', value: attempt.home_country},
			{label: 'Network', value: attempt.network_name ? attempt.network_name ~ (attempt.network_asn ? ' (AS' ~ attempt.network_asn ~ ')' : '') : 'Unknown'},
			{label: 'Browser', value: attempt.user_agent ?: 'None described'},
			{label: 'Browser time zone', value: attempt.browser_time_zone ?: 'Not sent'},
			{label: 'Form open for', value: attempt.form_seconds is null ? 'Not known' : attempt.form_seconds ~ ' ' ~ (attempt.form_seconds == 1 ? 'second' : 'seconds')}
		]}) }}
	{% endblock %}{% endembed %}</section>
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'What became of it', summary: attempt.outcome_label ~ '.'}) }}
		{% set became = [{label: 'Account type', value: attempt.account_type == 'company' ? 'Company account' : 'Individual learner'}] %}
		{% if attempt.refusal %}{% set became = became|merge([{label: 'Refused with', value: attempt.refusal}]) %}{% endif %}
		{% if attempt.completed_at %}{% set became = became|merge([{label: 'Registered', value: attempt.completed_at}]) %}{% endif %}
		{{ ui('data.key-value-list', {items: became}) }}
		{% if attempt.account %}<p class="cl-mt-2">The account: {{ ui('data.person', {name: attempt.account.name, href: attempt.account.href}) }}</p>{% endif %}
	{% endblock %}{% endembed %}</section>
{% endblock %}
