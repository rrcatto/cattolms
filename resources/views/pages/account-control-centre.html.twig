{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Account' %}
	{% set ph_title = 'My account' %}
	{% set ph_lead = 'Every part of your account in one place.' %}
	{# The page head brings the identity band with it. #}
	{% include '@platform/partials/page-head.html.twig' %}
	{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

			{{ ui('layout.section-head', {heading: 'Your account', eyebrow: 'All sections', summary: 'Dashboard, profile, learning, login sessions and account activity in one place.'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
	<div class="cl-account-workspace section" data-account-workspace>
		{% for section in account_sections %}
			{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: (section.label), summary: (section.description), open: section.key == 'dashboard', workspace: 'account', section_key: (section.key)})} %}
{% block body %}

					{{ section.content|raw }}

{% endblock %}
{% block actions %}

						<a class="cl-ui-accordion-link" href="{{ section.route }}">Open as standalone page</a>

{% endblock %}
{% endembed %}
		{% endfor %}
	</div>
{% endblock %}
