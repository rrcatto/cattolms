{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'POPIA principle' %}
	{% set ph_title = 'Privacy' %}
	{% set ph_lead = 'What we record, why, and for how long.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section container cl-medium py-5">
		{# Prose belongs on a surface like every other block of text on the platform. #}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		<p>
			Catto Learning is designed to collect only information needed to provide accounts, learning access, transactions, support and explicitly authorised research or marketing.
		</p>
		<h2 class="h4 mt-4">
			Core commitments
		</h2>
		<ul>
			<li>
				Personal information is not sold.
			</li>
			<li>
				Marketing consent is separate from service administration.
			</li>
			<li>
				Backup email addresses must be verified.
			</li>
			<li>
				Users can inspect and revoke their active sessions.
			</li>
			<li>
				Operational disclosures to payment, mail and hosting providers will be described accurately in the production privacy notice.
			</li>
		</ul>
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', section_spacing: false})} %}
{% block body %}

			This Stage 1 page is a product-design statement, not the final legal privacy notice.

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
