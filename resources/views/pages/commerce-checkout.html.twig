{% extends layout %}
{% block page_body %}
    {% set ph_title = 'Checkout' %}{% set ph_kicker = '' %}
    {% include '@platform/partials/page-head.html.twig' %}
    <section class="cl-page-section container cl-medium py-5">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

        <nav aria-label="Checkout progress" class="cl-checkout-steps">
            <span>1. Signed in</span>
            <a href="/checkout/profile" {% if step == 'profile' %}aria-current="step"{% endif %}>2. My details</a>
            {% if checkout.profile_confirmed|default(false) %}<a href="/checkout/payment" {% if step == 'payment' %}aria-current="step"{% endif %}>3. Payment</a>{% else %}<span>3. Payment</span>{% endif %}
            <span {% if step == 'review' %}aria-current="step"{% endif %}>4. Review</span>
        </nav>
        {% if step == 'profile' %}
            <h2 class="h4">My details</h2><p>Signed in as {{ user_email }}. Your personal details are saved to your profile and your billing details to your reusable billing profile, which you can also change in Account → Profile.</p>
            <form action="/checkout/profile" method="post">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                {% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'First name', full_width: false, for: 'first-name', required: true})} %}
{% block control %}
<input id="first-name" name="first_name" autocomplete="given-name" value="{{ profile.first_name }}" maxlength="120" required {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Last name', full_width: false, for: 'last-name', required: true})} %}
{% block control %}
<input id="last-name" name="last_name" autocomplete="family-name" value="{{ profile.last_name }}" maxlength="120" required {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Cell number', full_width: false, for: 'mobile-number', required: true})} %}
{% block control %}
<input id="mobile-number" name="mobile_number" type="tel" autocomplete="tel" value="{{ profile.mobile_number }}" maxlength="60" required {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'RSA ID number', full_width: false, for: 'rsa-id', required: true})} %}
{% block control %}
<input id="rsa-id" name="identification_number" inputmode="numeric" pattern="[0-9]{13}" maxlength="13" value="{{ profile.identification_number }}" required {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}


{% endblock %}
{% endembed %}
                <h3 class="h5 mt-4">Billing details</h3>
                <p>Who your invoice is made out to. {{ billing.saved ? 'Your saved billing details are filled in; any change you make is saved for next time.' : 'These are saved for your next purchase.' }}</p>
                {% include '@platform/partials/billing-fields.html.twig' with {billing_prefix: 'checkout-billing'} %}
                {% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Continue to payment', variant: 'primary', size: 'normal', type: 'submit'}) }}<a href="/cart">Back to My Cart</a>
{% endblock %}
{% endembed %}
            </form>
        {% elseif step == 'payment' %}
            <h2 class="h4">Payment and invoice</h2>
            <form action="/checkout/payment" method="post">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                {% include '@platform/partials/commerce-payment-method.html.twig' with {selected_method: checkout.payment_method|default('dummy')} %}
                {% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Email my invoice to ' ~ (user_email)})} %}
{% block control %}
<input type="checkbox" name="invoice_email" value="yes" {{ checkout.invoice_email|default(false) ? 'checked' : '' }}>
{% endblock %}
{% endembed %}
                <p class="mt-3">Your PDF invoice will also be available in Account → COURSES → My Orders.</p>
                {% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Review my order', variant: 'primary', size: 'normal', type: 'submit'}) }}<a href="/checkout/profile">Back to my details</a>
{% endblock %}
{% endembed %}
            </form>
        {% else %}
            <h2 class="h4">Review my order</h2>
            {% for item in cart.items %}<p><strong>{{ item.title }}</strong> · {{ item.days }} days · {{ item.price_label }}</p>{% endfor %}
            {% for bundle in cart.bundles %}{% include '@platform/partials/commerce-bundle-line.html.twig' %}{% endfor %}
            {% for overlap in cart.overlaps %}{{ ui('feedback.notice', {tone: 'warning', heading: overlap}) }}{% endfor %}
            {% include '@platform/partials/commerce-promo-code.html.twig' %}
            <h3 class="h5 mt-4">Order total</h3>
            {{ ui('data.key-value-list', {items: cart.totals}) }}
            {% if cart.total_minor == 0 %}<p>Nothing to pay: the promotion covers this order, so it completes when you place it.</p>{% endif %}
            <h3 class="h5">Billed to</h3>
            {% include '@platform/partials/billing-address.html.twig' %}
            <p><a href="/checkout/profile">Change billing details</a></p>
            <p>Payment: {{ checkout.payment_method == 'eft' ? 'EFT / bank transfer' : 'Card (simulated)' }}. <a href="/checkout/payment">Change</a></p>
            <p>{{ checkout.invoice_email ? 'Email my invoice and make it available in My Orders.' : 'Make my invoice available in My Orders.' }}</p>
            <form action="/checkout/place" method="post">
                <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="cart_id" value="{{ cart.id }}"><input type="hidden" name="quote" value="{{ cart.quote }}">
                <p>Unpaid orders are automatically cancelled after 7 days. Paid course access starts when you begin, or automatically 90 days after payment. Free course access starts immediately. The selected access period then runs to expiry.</p>
                <p>Tax is not charged. For cancellation or refund assistance, <a href="/contact">contact us</a>. <a href="/privacy">Privacy information</a>.</p>
                {% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'I have reviewed my order and accept these purchase terms.'})} %}
{% block control %}
<input type="checkbox" name="accept_terms" value="yes" required>
{% endblock %}
{% endembed %}
                {% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Place my order', variant: 'primary', size: 'normal', type: 'submit'}) }}<a href="/cart">Edit My Cart</a>
{% endblock %}
{% endembed %}
            </form>
        {% endif %}

{% endblock %}
{% endembed %}</section>
{% endblock %}
