{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin' %}{% set ph_back_label = 'Administration' %}{% set ph_kicker = 'System' %}{% set ph_title = 'Document templates' %}{% set ph_lead = 'The HTML and CSS certificates, invoices, receipts and credit notes are generated from. Edit a draft, preview it with sample data and publish it. A published version never changes, and every document records the version it was made from.' %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
{% if can_manage %}<p>{{ ui('action.link', {label: 'New template', variant: 'primary', href: '/admin/documents/templates/new'}) }}</p>{% endif %}
<nav class="cl-filter-chips" aria-label="Filter by document type">
{% for chip in type_filters %}<a class="cl-filter-chip {{ chip.active ? 'is-current' : '' }}" href="{{ chip.href }}" {% if chip.active %}aria-current="true"{% endif %}>{{ chip.label }}</a>{% endfor %}
</nav>
<nav class="cl-filter-chips" aria-label="Filter by status">
{% for chip in status_filters %}<a class="cl-filter-chip {{ chip.active ? 'is-current' : '' }}" href="{{ chip.href }}" {% if chip.active %}aria-current="true"{% endif %}>{{ chip.label }}</a>{% endfor %}
</nav>
{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'templates', pagination: templates_pagination})} %}
{% block results %}
{% if templates %}
{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'Document templates', density: 'compact'})} %}
{% block header %}<tr><th scope="col">Template</th><th scope="col">Document</th><th scope="col">Published</th><th scope="col">Draft</th><th scope="col">Status</th><th scope="col">Updated</th></tr>{% endblock %}
{% block body %}
{% for row in templates %}
<tr>
	<td><a href="/admin/documents/templates/{{ row.id }}"><strong>{{ row.name }}</strong></a>{% if row.description %}<br><small>{{ row.description }}</small>{% endif %}</td>
	<td>{{ row.type_label }}</td>
	<td>{{ row.published_version_number ? 'Version ' ~ row.published_version_number : 'Not published' }}</td>
	<td>{{ row.draft_version_number ? 'Version ' ~ row.draft_version_number : '—' }}</td>
	<td>{% if row.is_current %}{{ ui('feedback.badge', {label: 'Current', tone: 'success', size: 'small'}) }}{% endif %}{% if row.status == 'archived' %}{{ ui('feedback.badge', {label: 'Archived', tone: 'neutral', size: 'small'}) }}{% elseif not row.is_current %}{{ ui('feedback.badge', {label: 'Active', tone: 'info', size: 'small'}) }}{% endif %}</td>
	<td>{{ row.updated_at|date('j M Y H:i') }}</td>
</tr>
{% endfor %}
{% endblock %}
{% endembed %}
{% else %}
{{ ui('feedback.empty', {heading: 'No templates', summary: filtered ? 'No template matches these filters.' : 'No document template exists yet.'}) }}
{% endif %}
{% endblock %}
{% endembed %}
{% endblock %}{% endembed %}
</section>
{% endblock %}
