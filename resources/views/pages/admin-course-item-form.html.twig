{% extends layout %}
{% block page_body %}
{# return_to is where editing began (Course Content or the Course Item Library), already validated by the controller; Back and Cancel go there. #}{% set ph_back_href = return_to ?: (course_id ? course_admin_url(course_code, '/content') : '/admin/course-items') %}{% set ph_back_label = course_id or return_to starts with '/admin/courses/' ? 'Course Content' : 'Course Item Library' %}{% set ph_kicker = item.id ? item.name|default(item.title|default('')) : (course_id ? 'Add item · Create new item' : 'New reusable content') %}{% set ph_title = title %}{% set ph_lead = item.id ? 'Save updates every placement of this Course Item. Save As creates an independent item and keeps the same Resource reference.' : (course_id ? 'The new ' ~ type_label ~ ' item is created and added to this course in one step.' : 'Created unassigned: it appears under Not currently in use until a course places it.') %}{% include '@CattoPHP/page/head.html.twig' %}
<section class="cl-page-section">
{% include '@platform/partials/admin/course-item-form.html.twig' with {cancel_href: ph_back_href} %}
{% if item.id %}
{# form_action is the saved item's address: a refused save may show a typed name that is not one yet. #}<form action="{{ form_action }}/delete" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: 'Delete unused Course Item', variant: 'danger', type: 'submit', confirm: 'Delete this Course Item?', icon: 'action-remove'}) }}</form>{% endif %}
</section>
{% endblock %}
