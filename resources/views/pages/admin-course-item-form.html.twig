{% extends layout %}
{% block page_body %}
{# return_to is where editing began (Course Content or the Course Item Library), already validated by the controller; Back and Cancel go there. #}{% set ph_back_href = return_to ?: (course_id ? '/admin/courses/' ~ course_id ~ '/content' : '/admin/course-items') %}{% set ph_back_label = course_id or return_to starts with '/admin/courses/' ? 'Course Content' : 'Course Item Library' %}{% set ph_kicker = item.id ? type_label : (course_id ? 'Add item · Create new item' : 'New reusable content') %}{% set ph_title = title %}{% set ph_lead = item.id ? 'Save updates every placement of this shared item. Save As creates an independent item and keeps the same Resource reference.' : (course_id ? 'The new ' ~ type_label ~ ' item is created and added to this course in one step.' : 'Created unassigned: it appears under Not currently in use until a course places it.') %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% include '@platform/partials/admin/course-item-form.html.twig' with {cancel_href: ph_back_href} %}
{% if item.id %}
<form action="/admin/course-items/{{ item.id }}/delete" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: 'Delete unused Course Item', variant: 'danger', type: 'submit', confirm: 'Delete this Course Item?'}) }}</form>{% endif %}
</section>
{% endblock %}
