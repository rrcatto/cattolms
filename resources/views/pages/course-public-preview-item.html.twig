{% extends '@platform/layout/course-item.html.twig' %}
{% block course_item_body %}
<h1>{{ item.node_type == 'section' ? (item.section_number|default(null) is not null ? 'Module ' ~ item.section_number ~ ': ' : '') ~ item.section_title : (item.display_title_override ?: item.item_title) }}</h1>
{# A module's lesson, summary, flash cards and practical work download as PDFs (owner, 2026-10-28, decision 6A). #}
{% if item.node_type == 'item' and item.part|default('') in ['lesson', 'summary', 'review', 'flashcards', 'practical'] %}<p class="cl-course-item-pdf">{{ ui('action.link', {label: 'Download as PDF', variant: 'secondary', size: 'small', href: '/courses/' ~ course.slug ~ '/preview/' ~ item.id ~ '/pdf' ~ course.public_preview_query|default(''), icon: 'action-download'}) }}</p>{% endif %}
<div class="cl-course-item-body cl-course-presentation catto-standalone">{{ item.rendered_html|raw }}</div>
{% include '@platform/partials/course-section-outline.html.twig' %}
{# The same row as the learner's (owner, 2026-11-01: the public preview is "supposed to SHOWCASE to potential students the exact same experience"); a visitor's ticks are kept in their own session only. #}
{% include '@platform/partials/course-item-paging.html.twig' with {paging_label: 'Public Course Content', paging_base: '/courses/' ~ course.slug ~ '/preview/', paging_query: course.public_preview_query|default(''), paging_previous: item.previous_node, paging_next: item.next_node, paging_complete: item.node_type == 'item' ? {action: '/courses/' ~ course.slug ~ '/preview/' ~ item.id ~ '/complete' ~ course.public_preview_query|default(''), done: item.is_done|default(false)} : null} %}
{% endblock %}
