{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin/courses' %}{% set ph_back_label = 'Courses' %}{% set ph_kicker = 'Courses' %}{% set ph_title = 'Certificate designs' %}{% set ph_lead = 'How your courses’ certificates look. Each course picks one on its Certificate page.' %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
{% if can_manage %}<p>{{ ui('action.link', {label: 'New design', variant: 'primary', href: '/admin/certificates/designs/new', icon: 'action-add'}) }}</p>{% endif %}
{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'Certificate designs'})} %}
{% block columns %}<colgroup><col class="cl-certificate-designs-col-design"><col><col>{% if can_manage %}<col class="cl-certificate-designs-col-actions">{% endif %}</colgroup>{% endblock %}
{% block header %}<tr><th scope="col">Design</th><th scope="col">Used by</th><th scope="col">Last edited</th>{% if can_manage %}<th scope="col"><span class="visually-hidden">Actions</span></th>{% endif %}</tr>{% endblock %}
{% block body %}
{% for row in designs %}
<tr>
	<td><span class="cl-certificate-design"><a href="/admin/certificates/designs/{{ row.id }}" tabindex="-1" aria-hidden="true"><img class="cl-certificate-design-thumb" src="{{ row.image }}" alt=""></a><span class="cl-certificate-design-name"><a href="/admin/certificates/designs/{{ row.id }}" class="cl-certificate-design-link">{{ row.name }}</a>{% if row.is_default %}{{ ui('feedback.badge', {label: 'Default for new courses', tone: 'info', size: 'small'}) }}{% endif %}</span></span></td>
	<td>{{ row.course_count == 0 ? 'No courses' : (row.course_count == 1 ? '1 course' : row.course_count ~ ' courses') }}</td>
	<td>{{ row.updated_at|date('j M Y, H:i') }}{% if row.updated_by %} · {{ row.updated_by }}{% endif %}</td>
	{% if can_manage %}<td class="cell-actions">
		{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true, aria_label: 'Actions for ' ~ row.name})} %}{% block body %}
			{{ ui('action.link', {label: 'Edit', variant: 'secondary', size: 'small', href: '/admin/certificates/designs/' ~ row.id}) }}
			<form action="/admin/certificates/designs/{{ row.id }}/duplicate" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: 'Duplicate', variant: 'secondary', size: 'small', type: 'submit'}) }}</form>
			{{ ui('action.link', {label: 'Delete', variant: 'danger', size: 'small', href: '/admin/certificates/designs/' ~ row.id ~ '/delete', icon: 'action-remove'}) }}
		{% endblock %}{% endembed %}
	</td>{% endif %}
</tr>
{% endfor %}
{% endblock %}
{% endembed %}
{% endblock %}{% endembed %}

{% if can_manage and designs %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
<form action="/admin/certificates/designs/default" method="post">
	<input type="hidden" name="csrf" value="{{ csrf }}">
	{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 2})} %}{% block body %}
		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'New courses start with', for: 'default-design', help: 'Changes nothing for courses that already have a design.'})} %}{% block control %}<select id="default-design" name="design_id" {{ ui_field_attrs(props) }}>{% for row in designs %}<option value="{{ row.id }}"{% if row.id == default_id %} selected{% endif %}>{{ row.name }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}
	{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save', variant: 'secondary', type: 'submit'}) }}{% endblock %}{% endembed %}
</form>
{% endblock %}{% endembed %}
{% endif %}
</section>
{% endblock %}
