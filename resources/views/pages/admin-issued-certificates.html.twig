{#
	Issued Certificates (owner, 2026-10-19): every certificate issued, newest first, searched and filtered,
	each opening its own page where it can be revoked with a reason.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Administration' %}{% set ph_title = 'Issued Certificates' %}
	{% set ph_lead = 'Every certificate issued, newest first, with its transcript. A certificate states that the learner took the course, in their verified name. Open one to see it or to revoke it.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Find certificates', summary: 'Search by certificate or transcript number, learner or course.'}) }}
		<form action="/admin/certificates" method="get">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Search', full_width: true, for: 'certificates-q'})} %}{% block control %}<input id="certificates-q" name="q" value="{{ filters.q }}" maxlength="120" placeholder="Number, learner or course" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Show', full_width: false, for: 'certificates-state'})} %}{% block control %}<select id="certificates-state" name="state" {{ ui_field_attrs(props) }}><option value="all" {{ filters.state == 'all' ? 'selected' : '' }}>All certificates</option><option value="valid" {{ filters.state == 'valid' ? 'selected' : '' }}>In force</option><option value="revoked" {{ filters.state == 'revoked' ? 'selected' : '' }}>Revoked</option></select>{% endblock %}{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Filter', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-filter'}) }}{{ ui('action.link', {label: 'Clear', variant: 'secondary', size: 'normal', href: '/admin/certificates', icon: 'action-clear'}) }}{% endblock %}{% endembed %}
		{% endblock %}{% endembed %}</form>
	{% endblock %}{% endembed %}</section>
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Certificates'}) }}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'certificates', pagination: certificates_pagination})} %}{% block results %}
			{% if rows %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 20, label: 'Number'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 22, label: 'Learner'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 28, label: 'Course', wide: true}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Issued', wide: true}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'State'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: ''}} %}</tr>{% endblock %}
			{% block body %}
				{% for row in rows %}
					<tr data-certificate-id="{{ row.id }}">
						<td class="cell-text"><strong>{{ row.certificate_number }}</strong>{% if row.transcript_number %}<br><span class="small">{{ row.transcript_number }}</span>{% endif %}</td>
						<td class="cell-text">{{ ui('data.person', {name: row.learner_name, reference: row.learner_reference, href: '/admin/people/' ~ row.user_id}) }}</td>
						<td class="cell-text"><a href="/admin/courses/{{ row.course_id }}">{{ row.course_title }}</a></td>
						<td class="small">{{ row.issued_at|date('j M Y') }}</td>
						<td>{{ ui('feedback.badge', {label: row.revoked_at ? 'Revoked' : 'In force', tone: row.revoked_at ? 'danger' : 'success', size: 'small'}) }}</td>
						<td class="cell-actions">{{ ui('action.link', {label: 'Open', variant: 'secondary', size: 'small', href: '/admin/certificates/' ~ row.id, aria_label: 'Open certificate ' ~ row.certificate_number, icon: 'action-open'}) }}</td>
					</tr>
				{% endfor %}
			{% endblock %}
			{% endembed %}
			{% else %}{{ ui('feedback.empty', {summary: filtered ? 'No certificate matches these filters.' : 'No certificate has been issued yet.'}) }}{% endif %}
		{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}</section>
{% endblock %}
