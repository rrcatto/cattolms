{% extends layout %}

{% block page_body %}
{% set ph_back_href = '/admin/courses/import' %}
{% set ph_back_label = 'Import another file' %}
{% set ph_kicker = 'Import preview' %}
{% set ph_title = analysis.course.title %}
{% set ph_lead = analysis.course.summary %}
{% include '@platform/partials/page-head.html.twig' %}
<section class="container-fluid cl-container-wide py-5"><div class="row g-4"><div class="col-xl-8">
<div class="row g-3 mb-4">
  <div class="col-md-4 col-xl-2"><div class="cl-stat h-100"><span>Modules</span><strong>{{ analysis.display_module_count }}</strong></div></div>
  <div class="col-md-4 col-xl-2"><div class="cl-stat h-100"><span>Module assessments</span><strong>{{ analysis.display_module_assessment_count }}</strong><small class="d-block text-body-secondary">{{ analysis.display_module_question_count }} questions</small></div></div>
  <div class="col-md-4 col-xl-2"><div class="cl-stat h-100"><span>Diagnostics</span><strong>{{ analysis.display_diagnostic_count }}</strong><small class="d-block text-body-secondary">{{ analysis.display_diagnostic_question_count }} questions</small></div></div>
  <div class="col-md-4 col-xl-2"><div class="cl-stat h-100"><span>Final assessment</span><strong>{{ analysis.display_final_assessment_count }}</strong><small class="d-block text-body-secondary">{{ analysis.display_final_question_count }} questions</small></div></div>
  <div class="col-md-4 col-xl-2"><div class="cl-stat h-100"><span>Total questions</span><strong>{{ analysis.display_question_count }}</strong></div></div>
  <div class="col-md-4 col-xl-2"><div class="cl-stat h-100"><span>Format</span><strong>{{ analysis.display_format }}</strong></div></div>
</div>
{% if analysis.diagnostic_assessments %}<div class="card border-info mb-4"><div class="card-header bg-white p-4"><h2 class="h4 mb-1">Course-level diagnostics</h2><p class="text-body-secondary mb-0">These are imported as optional, recorded assessments before Module 1. They do not contribute to normal module/final grades or certificate eligibility. A source-defined diagnostic pass-out may complete the course enrolment.</p></div><div class="list-group list-group-flush">{% for diagnostic in analysis.diagnostic_assessments %}<div class="list-group-item p-4"><div class="d-flex flex-wrap justify-content-between gap-3"><div><strong>{{ diagnostic.title }}</strong><div class="text-body-secondary">Key: {{ diagnostic.assessment_key }} · {{ diagnostic.questions|length }} questions</div></div><div class="text-end"><span class="badge text-bg-info">Suggested threshold {{ diagnostic.pass_mark }}%</span>{% if diagnostic.diagnostic_pass_action == 'complete_course' %}<small class="d-block text-success mt-1">Passing completes course</small>{% endif %}</div></div></div>{% endfor %}</div></div>{% endif %}
{% if analysis.final_assessment %}<div class="card border-primary mb-4"><div class="card-header bg-white p-4"><h2 class="h4 mb-1">Final assessment detected</h2><p class="text-body-secondary mb-0">This assessment will be imported separately from the module assessments.</p></div><div class="card-body p-4"><div class="d-flex flex-wrap justify-content-between gap-3"><div><strong>{{ analysis.final_assessment.title }}</strong><div class="text-body-secondary">{{ analysis.display_final_question_count }} questions</div></div><div class="text-end"><span class="badge text-bg-primary">Pass mark {{ analysis.final_assessment.pass_mark }}%</span>{% if analysis.final_assessment.required %}<small class="d-block text-body-secondary mt-1">Required final assessment</small>{% endif %}</div></div></div></div>{% else %}<div class="card border-warning mb-4"><div class="card-body p-4"><h2 class="h4">No final assessment detected</h2><p class="mb-0">No separate final assessment will be created by this import. Confirm that this is intentional before committing the course.</p></div></div>{% endif %}
<div class="card"><div class="card-header bg-white p-4"><h2 class="h4 mb-0">Detected modules and blocks</h2></div><div class="list-group list-group-flush">{% for module in analysis.modules %}<div class="list-group-item p-4"><div class="d-flex gap-3"><span class="cl-module-number">{{ module.position }}</span><div><strong>{{ module.title }}</strong>{% if module.subtitle %}<small class="d-block text-body-secondary">{{ module.subtitle }}</small>{% endif %}<span class="badge text-bg-light mt-2">{{ module.block_count }} content blocks</span>{% if module.assessment %}<span class="badge cl-badge-soft mt-2">{{ module.question_count }} assessment questions</span>{% endif %}{% if module.is_review %}<span class="badge text-bg-light mt-2">Review module</span>{% endif %}{% if not module.assessment_required %}<span class="badge text-bg-secondary mt-2">Assessment not required</span>{% endif %}</div></div></div>{% endfor %}</div></div>
{% if analysis.parser_compatibility_count or analysis.parser_structural_count %}<div class="card mt-4 {{ analysis.parser_structural_count ? 'border-warning' : 'border-secondary' }}"><div class="card-body p-4"><h2 class="h4">HTML parser report</h2><p class="text-body-secondary small">Parser diagnostics inspect document markup only. JavaScript and CSS bodies are excluded so HTML fragments stored inside course scripts/styles cannot be misreported as broken page structure.</p>{% if analysis.parser_compatibility_count %}<p class="mb-2"><strong>{{ analysis.parser_compatibility_count }}</strong> legacy-parser compatibility notice{{ analysis.parser_compatibility_count == 1 ? '' : 's' }} were ignored. These are normally caused by valid modern HTML5 elements such as <code>&lt;section&gt;</code>, <code>&lt;details&gt;</code> and <code>&lt;summary&gt;</code>; they do not indicate lost course content.</p>{% endif %}{% if analysis.parser_structural_count %}<p class="text-warning-emphasis"><strong>{{ analysis.parser_structural_count }} structural parser warning{{ analysis.parser_structural_count == 1 ? '' : 's' }}</strong> remain and should be reviewed before import.</p><ul class="mb-0">{% for parser_message in analysis.parser_messages %}<li>{{ parser_message.message }} <small class="text-body-secondary">({{ parser_message.count }} occurrence{{ parser_message.count == 1 ? '' : 's' }}, first near line {{ parser_message.first_line }})</small></li>{% endfor %}</ul>{% else %}<div class="alert alert-success mb-0">No structural HTML parser warnings were detected.</div>{% endif %}</div></div>{% endif %}
</div><aside class="col-xl-4">{% if analysis.display_presentation_css_bytes %}<div class="card border-success mb-4"><div class="card-body p-4"><h2 class="h4">Course presentation detected</h2><p class="mb-0">The source stylesheet was isolated for this course and will be stored with it in PostgreSQL. {{ analysis.display_presentation_css_bytes }} CSS bytes will be imported.</p></div></div>{% endif %}{% if analysis.warnings %}<div class="card border-warning mb-4"><div class="card-body p-4"><h2 class="h4">Import warnings</h2><ul class="mb-0">{% for warning in analysis.warnings %}<li>{{ warning }}</li>{% endfor %}</ul></div></div>{% endif %}<div class="card"><div class="card-body p-4"><h2 class="h4">Commit import</h2><p>Create a new draft, or replace a resettable course shell.</p><form action="/admin/courses/import/commit" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="import_key" value="{{ analysis.import_key }}"><div class="mb-3" data-category-picker><label class="form-label">Category</label><div class="input-group"><select class="form-select" name="category_id" data-category-select><option value="0">Uncategorised</option>{% for category in categories %}<option value="{{ category.id }}">{{ category.name }}</option>{% endfor %}</select>{% if can_manage_categories %}<button class="btn btn-outline-secondary" type="button" data-category-create-toggle>+ New</button>{% endif %}</div>{% if can_manage_categories %}<div class="border rounded p-3 mt-2 d-none" data-category-create-panel data-create-url="/admin/courses/categories/inline" data-csrf="{{ csrf }}"><strong class="d-block mb-2">Create category without leaving this import</strong><input class="form-control mb-2" data-category-name maxlength="120" placeholder="Category name"><textarea class="form-control mb-2" data-category-description rows="2" placeholder="Description (optional)"></textarea><div class="small text-danger mb-2 d-none" data-category-error></div><div class="d-flex gap-2"><button class="btn btn-sm btn-primary" type="button" data-category-create>Create category</button><button class="btn btn-sm btn-outline-secondary" type="button" data-category-create-cancel>Cancel</button></div></div>{% endif %}</div><label class="form-label">Replace existing course shell (optional)</label><select class="form-select mb-3" name="replace_course_id"><option value="0">Create a new course</option>{% for existing in replaceable_courses %}<option value="{{ existing.id }}">{{ existing.title }}</option>{% endfor %}</select><button class="btn btn-primary w-100" type="submit">Import into PostgreSQL</button></form></div></div></aside></div></section>
{% endblock %}
