{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses/import' %}
	{% set ph_back_label = 'Import another file' %}
	{% set ph_kicker = 'Import preview' %}
	{% set ph_title = analysis.course.title %}
	{% set ph_lead = analysis.course.summary %}
	{% include '@CattoPHP/page/head.html.twig' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {})} %}
{% block body %}

			<div>
				{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {})} %}
{% block body %}

						{{ ui('data.stat-card', {label: 'Course Items', value: (analysis.statistics.course_item_count|default(analysis.display_module_count))}) }}

						{{ ui('data.stat-card', {label: 'Module assessments', value: (analysis.display_module_assessment_count), note: (analysis.display_module_question_count) ~ ' questions'}) }}

						{{ ui('data.stat-card', {label: 'Diagnostics', value: (analysis.display_diagnostic_count), note: (analysis.display_diagnostic_question_count) ~ ' questions'}) }}

						{{ ui('data.stat-card', {label: 'Final assessment', value: (analysis.display_final_assessment_count), note: (analysis.display_final_question_count) ~ ' questions'}) }}

						{{ ui('data.stat-card', {label: 'Total questions', value: (analysis.display_question_count)}) }}

						{{ ui('data.stat-card', {label: 'Format', value: (analysis.display_format)}) }}

{% endblock %}
{% endembed %}
				{% if analysis.diagnostic_assessments|default([]) %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'info'})} %}
{% block surface_body %}

						{{ ui('layout.section-head', {heading: 'Course-level diagnostics', heading_level: 2, summary: 'These are imported as optional, recorded assessments before Module 1. They do not contribute to normal module/final grades or certificate eligibility. A source-defined diagnostic pass-out may complete the course enrolment.'}) }}
						{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

							{% for diagnostic in analysis.diagnostic_assessments %}
								{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

									<div class="d-flex flex-wrap justify-content-between gap-5">
										<div>
											<strong>{{ diagnostic.title }}</strong>
											<div class="cl-text-muted">
												Key: {{ diagnostic.assessment_key }} · {{ diagnostic.questions|length }} questions
											</div>
										</div>
										<div class="text-end">
											{{ ui('feedback.badge', {label: 'Suggested threshold ' ~ (diagnostic.pass_mark) ~ '%', tone: 'info'}) }}
											<small class="d-block cl-text-muted mt-1">Guidance only; does not affect grade or completion</small>
										</div>
									</div>

{% endblock %}
{% endembed %}
							{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
				{% endif %}
				{% if analysis.final_assessment|default(null) %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'info'})} %}
{% block surface_body %}

						{{ ui('layout.section-head', {heading: 'Final assessment detected', heading_level: 2, summary: 'This assessment will be imported separately from the module assessments.'}) }}

							<div class="d-flex flex-wrap justify-content-between gap-5">
								<div>
									<strong>{{ analysis.final_assessment.title }}</strong>
									<div class="cl-text-muted">
										{{ analysis.display_final_question_count }} questions
									</div>
								</div>
								<div class="text-end">
									{{ ui('feedback.badge', {label: 'Pass mark ' ~ (analysis.final_assessment.pass_mark) ~ '%', tone: 'info'}) }}
									{% if analysis.final_assessment.required %}
										<small class="d-block cl-text-muted mt-1">Required final assessment</small>
									{% endif %}
								</div>
							</div>

{% endblock %}
{% endembed %}
				{% else %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'warning'})} %}
{% block surface_body %}

							<h2 class="h4">
								No final assessment detected
							</h2>
							<p class="mb-0">
								No separate final assessment will be created by this import. Confirm that this is intentional before committing the course.
							</p>

{% endblock %}
{% endembed %}
				{% endif %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
					{% set scale = analysis.grade_scale %}
					{{ ui('layout.section-head', {heading: 'Grading scale', heading_level: 2, summary: 'These bands become the course grade bands. You can change them on the Grades tab after import.'}) }}
					{% if scale.source == 'list' %}
						{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'success', heading: 'Grading scale read from the file'})} %}{% block body %}Taken from the scale list the file shows.{% if scale.function_agrees is same as(true) %} The file's grading script agrees with it.{% elseif scale.function_agrees is same as(false) %} The file's grading script does not match it; check the bands after import.{% endif %}{% endblock %}{% endembed %}
					{% elseif scale.source == 'function' %}
						{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'success', heading: 'Grading scale read from the file'})} %}{% block body %}Taken from the file's grading script; the file shows no scale list.{% endblock %}{% endembed %}
					{% elseif scale.source == 'default' %}
						{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'No grading scale found in the file'})} %}{% block body %}The standard five bands below will be used. Check them on the Grades tab after import.{% endblock %}{% endembed %}
					{% endif %}
					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}
						<tr>
							{% include '@CattoPHP/ui/data/sortable-header.html.twig' with {sh: {sortable: false, width: 46, label: 'Label'}} %}
							{% include '@CattoPHP/ui/data/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Code'}} %}
							{% include '@CattoPHP/ui/data/sortable-header.html.twig' with {sh: {sortable: false, width: 20, label: 'Range'}} %}
							{% include '@CattoPHP/ui/data/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Passing'}} %}
						</tr>
{% endblock %}
{% block body %}
						{% for band in analysis.display_grade_scale %}<tr><td>{{ band.grade_label }}</td><td>{{ band.grade_code }}</td><td>{{ band.range_label }}</td><td>{{ band.is_passing ? 'Yes' : 'No' }}</td></tr>{% endfor %}
{% endblock %}
{% endembed %}
					{% if scale.placeholder_inserted or scale.reset_button_removed or scale.storage_sentences_removed %}
						{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', heading: 'Course introduction changes', section_spacing: true})} %}{% block body %}<ul>{% if scale.placeholder_inserted %}<li>The static scale list is replaced with [grading-scale], which always shows the bands above.</li>{% endif %}{% if scale.reset_button_removed %}<li>The Reset all saved progress button is left out; it only worked in the standalone file.</li>{% endif %}{% if scale.storage_sentences_removed %}<li>{{ scale.storage_sentences_removed }} sentence{{ scale.storage_sentences_removed == 1 ? '' : 's' }} saying progress is kept in the browser {{ scale.storage_sentences_removed == 1 ? 'is' : 'are' }} left out; the LMS saves progress to your account.</li>{% endif %}</ul>{% endblock %}{% endembed %}
					{% endif %}
{% endblock %}
{% endembed %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

					{{ ui('layout.section-head', {heading: 'Course Item structure and keys', heading_level: 2, summary: 'Key collisions must be resolved before import; CattoLMS does not rename or guess.'}) }}
					{% if analysis.display_format == 'HTML' %}{{ ui('feedback.notice', {tone: 'info', heading: 'This course arrives with one lesson per module. When it is imported, each module becomes a numbered section holding its lesson, video, practical work and assessment, as Course Content shows them.', section_spacing: true}) }}{% endif %}
					{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}{% block body %}{% for item in analysis.course_items %}{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}{% block body %}<strong>{{ item.title }}</strong><div><code>{{ item.item_key }}</code> · {{ item.item_type|item_type_label }}</div>{% endblock %}{% endembed %}{% endfor %}{% endblock %}{% endembed %}
					{% if review.course_id and review.action != 'skip' %}{{ ui('feedback.notice', {tone: 'info', heading: 'These Course Items are ' ~ review.code ~ '\'s, the course this file updates.', section_spacing: true}) }}{% elseif review.action == 'skip' and analysis.key_conflicts|default([]) %}{{ ui('feedback.notice', {tone: 'danger', heading: 'These Course Items are already another course\'s on this site', section_spacing: true}) }}{% endif %}
					{% if analysis.modules|default([]) %}
					<h3>Legacy source components</h3>
					{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

						{% for module in analysis.modules|default([]) %}
							{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

								<div class="d-flex gap-5">
									<span class="cl-module-number">{{ module.position }}</span>
									<div>
										<strong>{{ module.title }}</strong>
										{% if module.subtitle %}
											<small class="d-block cl-text-muted">{{ module.subtitle }}</small>
										{% endif %}
										{{ ui('feedback.badge', {label: (module.content_blocks|default([])|length) ~ ' content blocks', tone: 'neutral'}) }}
										{% if module.assessment %}
											{{ ui('feedback.badge', {label: (module.assessment.questions|default([])|length) ~ ' assessment questions', tone: 'neutral'}) }}
										{% endif %}
										{% if module.is_review %}
											{{ ui('feedback.badge', {label: 'Review module', tone: 'neutral'}) }}
										{% endif %}
										{% if not module.assessment_required %}
											{{ ui('feedback.badge', {label: 'Assessment not required', tone: 'neutral'}) }}
										{% endif %}
									</div>
								</div>

{% endblock %}
{% endembed %}
						{% endfor %}

{% endblock %}
{% endembed %}
					{% endif %}

{% endblock %}
{% endembed %}
				{% if analysis.parser_compatibility_count or analysis.parser_structural_count %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

							<h2 class="h4">
								HTML parser report
							</h2>
							<p class="cl-text-muted small">
								Parser diagnostics inspect document markup only. JavaScript and CSS bodies are excluded so HTML fragments stored inside course scripts/styles cannot be misreported as broken page structure.
							</p>
							{% if analysis.parser_compatibility_count %}
								<p class="mb-3">
									<strong>{{ analysis.parser_compatibility_count }}</strong> legacy-parser compatibility notice{{ analysis.parser_compatibility_count == 1 ? '' : 's' }} were ignored. These are normally caused by valid modern HTML5 elements such as <code>&lt;section&gt;</code>, <code>&lt;details&gt;</code> and <code>&lt;summary&gt;</code>; they do not indicate lost course content.
								</p>
							{% endif %}
							{% if analysis.parser_structural_count %}
								<p class="cl-text-warning-strong">
									<strong>{{ analysis.parser_structural_count }} structural parser warning{{ analysis.parser_structural_count == 1 ? '' : 's' }}</strong> remain and should be reviewed before import.
								</p>
								<ul class="mb-0">
									{% for parser_message in analysis.parser_messages %}
										<li>
											{{ parser_message.message }} <small class="cl-text-muted">({{ parser_message.count }} occurrence{{ parser_message.count == 1 ? '' : 's' }}, first near line {{ parser_message.first_line }})</small>
										</li>
									{% endfor %}
								</ul>
							{% else %}
								{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'success', section_spacing: false})} %}
{% block body %}

									No structural HTML parser warnings were detected.

{% endblock %}
{% endembed %}
							{% endif %}

{% endblock %}
{% endembed %}
				{% endif %}
			</div>
			<aside>
				{% if analysis.display_presentation_css_bytes %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'success'})} %}
{% block surface_body %}

							<h2 class="h4">
								Course presentation detected
							</h2>
							<p class="mb-0">
								The source stylesheet was isolated for this course and will be stored with it in PostgreSQL. {{ analysis.display_presentation_css_bytes }} CSS bytes will be imported.
							</p>

{% endblock %}
{% endembed %}
				{% endif %}
				{% if analysis.warnings %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'warning'})} %}
{% block surface_body %}

							<h2 class="h4">
								Import warnings
							</h2>
							<ul class="mb-0">
								{% for warning in analysis.warnings %}
									<li>
										{{ warning }}
									</li>
								{% endfor %}
							</ul>

{% endblock %}
{% endembed %}
				{% endif %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

										{# Administration > Courses > Import by the catalogue's canonical rules (owner, 2026-11-06: "By default, what is in
										   the import file wins"): the file's code names the course it updates, each difference is the file's unless
										   Keep this site's is chosen, and nothing replaced is kept. A new course is given its code and category here. #}
										<h2 class="h4">Import</h2>
						{% if review.action == 'skip' %}
							{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger', heading: 'This file cannot be imported'})} %}{% block body %}<p class="mb-0">{{ review.reason }}</p>{% endblock %}{% endembed %}
						{% elseif review.course_id %}
							{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', heading: 'This file updates ' ~ review.code})} %}{% block body %}<p class="mb-0">An import knows a course by its code alone, so this file updates <a href="{{ course_admin_url(review.code) }}">{{ review.site_title }}</a>. {% if review.action == 'unchanged' %}Nothing in the file differs from it, so importing changes nothing.{% else %}Each difference below takes the file's version unless you choose Keep this site's. What is replaced is not kept. Nothing changes until you choose Import.{% endif %}{% if review.kind == 'html' %} An HTML course file holds no prices, related courses or other catalogue settings, so the course keeps its own.{% endif %}</p>{% if file_parts|default([]) %}<p class="mb-0">It also holds files this import cannot carry: {{ file_parts|join(', ') }}. Replacing its content from this file removes them. To keep them, use Download with its files (.zip) on its page, and import that at Import and Export Catalogue.</p>{% endif %}{% endblock %}{% endembed %}
							{% for difference in review.differences %}
								{% include '@platform/partials/admin/catalogue-difference.html.twig' with {cd: {
									name: 'choice[' ~ difference.kind ~ ']',
									form: 'course-import',
									difference: difference,
									allowed: difference.choosable and (difference.kind != 'prices' or can_price) and (difference.kind != 'status' or can_publish),
									why_not: not difference.choosable ? difference.problem : (difference.kind == 'prices' ? 'Changing prices needs the course pricing permission.' : 'Changing a course\'s status needs the course publishing permission.'),
									file_note: difference.kind == 'content' ? 'Its lessons, parts and assessments are replaced with the file\'s. Each part keeps its address, the course stays published if it is, and what is open before buying stays open.' : 'The file\'s replaces this site\'s, which is not kept.',
								}} %}
							{% endfor %}
						{% else %}
							<p>A new course, made as a draft with the file's code and the category you choose.</p>
						{% endif %}
						{% if review.action != 'skip' %}
						<form id="course-import" action="/admin/courses/import/commit" method="post"><div>{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

							<input type="hidden" name="csrf" value="{{ csrf }}">
							<input type="hidden" name="import_key" value="{{ analysis.import_key }}">
							{# What the review showed: an import after the site has changed since is refused. #}
							<input type="hidden" name="fingerprint" value="{{ review.fingerprint }}">
							{% if not review.course_id %}
							{# The course's code (owner, 2026-10-23): the file's own, else a suggestion to keep or change. #}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Course code', for: 'import-code', required: true, help: import_code_from_file ? 'From the file. Every site and catalogue file knows the course by this code.' : 'The file names no code, so one is suggested from the title. Put it in the file\'s head as <meta name="cattolms:course-code" content="' ~ import_code ~ '"> so every import knows the course by it.'})} %}
{% block control %}<input class="cl-input text-uppercase" id="import-code" name="code" value="{{ import_code }}" maxlength="20" required autocomplete="off" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Category', full_width: false, for: 'import-category'})} %}
{% block control %}

								{% include '@platform/partials/admin/course-category-field.html.twig' with {cf_id: 'import-category', cf_name: 'category_id', cf_picker: category_picker, cf_places: category_places} %}

{% endblock %}
{% endembed %}
							{% endif %}
{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Import', variant: 'primary', size: 'normal', full_width: true, type: 'submit', icon: 'action-import'}) }}
{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</div></form>
						{% endif %}

{% endblock %}
{% endembed %}
			</aside>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
