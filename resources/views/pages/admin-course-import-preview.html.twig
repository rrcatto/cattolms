{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses/import' %}
	{% set ph_back_label = 'Import another file' %}
	{% set ph_kicker = 'Import preview' %}
	{% set ph_title = analysis.course.title %}
	{% set ph_lead = analysis.course.summary %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="container-fluid cl-container-wide py-5">
		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {})} %}
{% block body %}

			<div>
				{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {})} %}
{% block body %}

						{{ ui('data.stat-card', {label: 'Modules', value: (analysis.display_module_count)}) }}

						{{ ui('data.stat-card', {label: 'Module assessments', value: (analysis.display_module_assessment_count), note: (analysis.display_module_question_count) ~ ' questions'}) }}

						{{ ui('data.stat-card', {label: 'Diagnostics', value: (analysis.display_diagnostic_count), note: (analysis.display_diagnostic_question_count) ~ ' questions'}) }}

						{{ ui('data.stat-card', {label: 'Final assessment', value: (analysis.display_final_assessment_count), note: (analysis.display_final_question_count) ~ ' questions'}) }}

						{{ ui('data.stat-card', {label: 'Total questions', value: (analysis.display_question_count)}) }}

						{{ ui('data.stat-card', {label: 'Format', value: (analysis.display_format)}) }}

{% endblock %}
{% endembed %}
				{% if analysis.diagnostic_assessments %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'info'})} %}
{% block surface_body %}

						{{ ui('layout.section-head', {heading: 'Course-level diagnostics', heading_level: 2, summary: 'These are imported as optional, recorded assessments before Module 1. They do not contribute to normal module/final grades or certificate eligibility. A source-defined diagnostic pass-out may complete the course enrolment.'}) }}
						{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

							{% for diagnostic in analysis.diagnostic_assessments %}
								{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

									<div class="d-flex flex-wrap justify-content-between gap-3">
										<div>
											<strong>{{ diagnostic.title }}</strong>
											<div class="text-body-secondary">
												Key: {{ diagnostic.assessment_key }} · {{ diagnostic.questions|length }} questions
											</div>
										</div>
										<div class="text-end">
											{{ ui('feedback.badge', {label: 'Suggested threshold ' ~ (diagnostic.pass_mark) ~ '%', tone: 'info'}) }}
											{% if diagnostic.diagnostic_pass_action == 'complete_course' %}
												<small class="d-block text-success mt-1">Passing completes course</small>
											{% endif %}
										</div>
									</div>

{% endblock %}
{% endembed %}
							{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
				{% endif %}
				{% if analysis.final_assessment %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'info'})} %}
{% block surface_body %}

						{{ ui('layout.section-head', {heading: 'Final assessment detected', heading_level: 2, summary: 'This assessment will be imported separately from the module assessments.'}) }}

							<div class="d-flex flex-wrap justify-content-between gap-3">
								<div>
									<strong>{{ analysis.final_assessment.title }}</strong>
									<div class="text-body-secondary">
										{{ analysis.display_final_question_count }} questions
									</div>
								</div>
								<div class="text-end">
									{{ ui('feedback.badge', {label: 'Pass mark ' ~ (analysis.final_assessment.pass_mark) ~ '%', tone: 'info'}) }}
									{% if analysis.final_assessment.required %}
										<small class="d-block text-body-secondary mt-1">Required final assessment</small>
									{% endif %}
								</div>
							</div>

{% endblock %}
{% endembed %}
				{% else %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'warning'})} %}
{% block surface_body %}

							<h2 class="h4">
								No final assessment detected
							</h2>
							<p class="mb-0">
								No separate final assessment will be created by this import. Confirm that this is intentional before committing the course.
							</p>

{% endblock %}
{% endembed %}
				{% endif %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

					{{ ui('layout.section-head', {heading: 'Detected modules and blocks', heading_level: 2}) }}
					{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

						{% for module in analysis.modules %}
							{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

								<div class="d-flex gap-3">
									<span class="cl-module-number">{{ module.position }}</span>
									<div>
										<strong>{{ module.title }}</strong>
										{% if module.subtitle %}
											<small class="d-block text-body-secondary">{{ module.subtitle }}</small>
										{% endif %}
										{{ ui('feedback.badge', {label: (module.block_count) ~ ' content blocks', tone: 'neutral'}) }}
										{% if module.assessment %}
											{{ ui('feedback.badge', {label: (module.question_count) ~ ' assessment questions', tone: 'neutral'}) }}
										{% endif %}
										{% if module.is_review %}
											{{ ui('feedback.badge', {label: 'Review module', tone: 'neutral'}) }}
										{% endif %}
										{% if not module.assessment_required %}
											{{ ui('feedback.badge', {label: 'Assessment not required', tone: 'neutral'}) }}
										{% endif %}
									</div>
								</div>

{% endblock %}
{% endembed %}
						{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
				{% if analysis.parser_compatibility_count or analysis.parser_structural_count %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

							<h2 class="h4">
								HTML parser report
							</h2>
							<p class="text-body-secondary small">
								Parser diagnostics inspect document markup only. JavaScript and CSS bodies are excluded so HTML fragments stored inside course scripts/styles cannot be misreported as broken page structure.
							</p>
							{% if analysis.parser_compatibility_count %}
								<p class="mb-2">
									<strong>{{ analysis.parser_compatibility_count }}</strong> legacy-parser compatibility notice{{ analysis.parser_compatibility_count == 1 ? '' : 's' }} were ignored. These are normally caused by valid modern HTML5 elements such as <code>&lt;section&gt;</code>, <code>&lt;details&gt;</code> and <code>&lt;summary&gt;</code>; they do not indicate lost course content.
								</p>
							{% endif %}
							{% if analysis.parser_structural_count %}
								<p class="text-warning-emphasis">
									<strong>{{ analysis.parser_structural_count }} structural parser warning{{ analysis.parser_structural_count == 1 ? '' : 's' }}</strong> remain and should be reviewed before import.
								</p>
								<ul class="mb-0">
									{% for parser_message in analysis.parser_messages %}
										<li>
											{{ parser_message.message }} <small class="text-body-secondary">({{ parser_message.count }} occurrence{{ parser_message.count == 1 ? '' : 's' }}, first near line {{ parser_message.first_line }})</small>
										</li>
									{% endfor %}
								</ul>
							{% else %}
								{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'success', section_spacing: false})} %}
{% block body %}

									No structural HTML parser warnings were detected.

{% endblock %}
{% endembed %}
							{% endif %}

{% endblock %}
{% endembed %}
				{% endif %}
			</div>
			<aside>
				{% if analysis.display_presentation_css_bytes %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'success'})} %}
{% block surface_body %}

							<h2 class="h4">
								Course presentation detected
							</h2>
							<p class="mb-0">
								The source stylesheet was isolated for this course and will be stored with it in PostgreSQL. {{ analysis.display_presentation_css_bytes }} CSS bytes will be imported.
							</p>

{% endblock %}
{% endembed %}
				{% endif %}
				{% if analysis.warnings %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, tone: 'warning'})} %}
{% block surface_body %}

							<h2 class="h4">
								Import warnings
							</h2>
							<ul class="mb-0">
								{% for warning in analysis.warnings %}
									<li>
										{{ warning }}
									</li>
								{% endfor %}
							</ul>

{% endblock %}
{% endembed %}
				{% endif %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

						<h2 class="h4">
							Commit import
						</h2>
						<p>
							Create a new draft, or replace a resettable course shell.
						</p>
						<form action="/admin/courses/import/commit" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

							<input type="hidden" name="csrf" value="{{ csrf }}">
							<input type="hidden" name="import_key" value="{{ analysis.import_key }}">
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Category', full_width: false, for: 'field-admin-course-import-preview-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

								<div class="input-group">
									<select class="form-select" name="category_id" data-category-select id="field-admin-course-import-preview-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}"><option value="0">Uncategorised</option>
									{% for category in categories %}
										<option value="{{ category.id }}">{{ category.name }}</option>
									{% endfor %}
									</select>
									{% if can_manage_categories %}
										{{ ui('action.button', {label: '+ New', variant: 'secondary', size: 'normal', type: 'button'}) }}
									{% endif %}
								</div>
								{% if can_manage_categories %}
									<div class="border rounded p-3 mt-2 d-none" data-category-create-panel data-create-url="/admin/courses/categories/inline" data-csrf="{{ csrf }}">
										<strong class="d-block mb-2">Create category without leaving this import</strong>
										<input class="form-control mb-2" data-category-name maxlength="120" placeholder="Category name">
										<textarea class="form-control mb-2" data-category-description rows="2" placeholder="Description (optional)"></textarea>
										<div class="small text-danger mb-2 d-none" data-category-error>
										</div>
										{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

											{{ ui('action.button', {label: 'Create category', variant: 'primary', size: 'small', type: 'button', icon: 'action-add'}) }}{{ ui('action.button', {label: 'Cancel', variant: 'secondary', size: 'small', type: 'button'}) }}

{% endblock %}
{% endembed %}
									</div>
								{% endif %}

{% endblock %}
{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Replace existing course shell (optional)', for: 'field-admin-course-import-preview', required: false})} %}
{% block control %}
<select id="field-admin-course-import-preview" class="form-select mb-3" name="replace_course_id"><option value="0">Create a new course</option>
							{% for existing in replaceable_courses %}
								<option value="{{ existing.id }}">{{ existing.title }}</option>
							{% endfor %}
							</select>
{% endblock %}
{% endembed %}{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Import into PostgreSQL', variant: 'primary', size: 'normal', full_width: true, type: 'submit'}) }}
{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
			</aside>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
