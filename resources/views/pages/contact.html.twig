{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Contact' %}
	{% set ph_title = 'Get in touch' %}
	{% set ph_lead = 'Send a message to the Catto Learning team. We will reply to the email address you provide.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="container cl-medium py-5">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

{#
				The form sits in a card-body, like every other card on the platform.

				It did not, and that is why this page had no space around its fields under Gilded
				Noir: that theme - and the platform's card pattern generally - puts the padding on
				.card-body, not on .card. Factory Reset pads the card itself, so the page looked
				correct there and flush against the border everywhere else. The fix is to use the
				structure the rest of the platform uses rather than to add a rule for this one page.
			#}

				<form action="/contact" method="post" class="contact-form">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<div class="cl-honeypot" aria-hidden="true">
						<label>Website
						<input type="text" name="website" tabindex="-1" autocomplete="off">
						</label>
					</div>
					{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Name', full_width: false, for: 'contact-name', required: true})} %}
{% block control %}

							<input id="contact-name" type="text" name="name" maxlength="120" autocomplete="name" required>

{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Email address', full_width: false, for: 'contact-email', required: true})} %}
{% block control %}

							<input id="contact-email" type="email" name="email" maxlength="254" autocomplete="email" required>

{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Subject', full_width: true, for: 'contact-subject', required: true})} %}
{% block control %}

							<input id="contact-subject" type="text" name="subject" maxlength="160" required>

{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Message', full_width: true, for: 'contact-message', required: true})} %}
{% block control %}

							<textarea id="contact-message" name="message" rows="8" maxlength="5000" required></textarea>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
					{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

						{{ ui('action.button', {label: 'Send message', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}
				</form>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
