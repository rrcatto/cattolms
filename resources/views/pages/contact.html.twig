{% extends layout %}
{% block page_body %}
	{#
		The contact form (owner, 2026-10-20; ContactService): one form whose fields follow the reason chosen.
		The reason is a row of feature cards; each reason's own fields are a fieldset marked with
		data-contact-reason. Without JavaScript every fieldset shows, each saying which reason it is for, and
		only the chosen reason's answers are read. With it, only the chosen reason's fieldset shows. A signed-in sender's name, email and account
		reference come from the account.
	#}
	{% set ph_kicker = 'Contact' %}
	{% set ph_title = 'Get in touch' %}
	{% set ph_lead = 'Tell us what your message is about, and we will reply to the email address you give.' %}
	{% set ph_hero %}{% include '@platform/partials/artwork/contact-hero.html.twig' %}{% endset %}
	{% include '@platform/partials/page-head.html.twig' %}
	{% set draft = contact.draft %}
	{% set signed_in = contact.account is not null %}
	{#
		Feature cards (owner, 2026-10-20: "replace that control with a Feature Card Radio Selector (Grid Layout) - put
		each of the choices side by side in a single row … You also have drop down selectors on for variations"): the
		reason and each reason's topic are cards with an icon, a bold title and a line saying what they cover. The
		course and order lists stay lists: they hold the catalogue and the sender's own orders.
	#}
	{% set a = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"' %}
	{% set dots = '<circle cx="7" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="17" cy="12" r="1.2"/>' %}
	{% set icons = {
		before_buying: '<svg ' ~ a ~ '><path d="M3 4h2l2.4 10.2a1.5 1.5 0 0 0 1.5 1.1h7.6a1.5 1.5 0 0 0 1.4-1l1.9-6.3H6.2"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg>',
		account: '<svg ' ~ a ~ '><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>',
		order: '<svg ' ~ a ~ '><path d="M6 3h12v18l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5-2 1.5z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>',
		course: '<svg ' ~ a ~ '><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/><path d="M12 7v5M12 15h.01"/></svg>',
		other: '<svg ' ~ a ~ '><path d="M4 5h16a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 20 17H9l-5 4v-4a1.5 1.5 0 0 1-1.5-1.5v-9A1.5 1.5 0 0 1 4 5z"/>' ~ dots ~ '</svg>',
	} %}
	{% set company_icon = '<svg ' ~ a ~ '><path d="M3 21h18"/><path d="M5 21V5l7-2v18"/><path d="M12 9h7v12"/><path d="M8 8h1M8 11h1M8 14h1M8 17h1M15 12h1M15 15h1M15 18h1"/></svg>' %}
	{% set account_icons = {
		sign_in: '<svg ' ~ a ~ '><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/><path d="M10 16l4-4-4-4M14 12H3"/></svg>',
		email: '<svg ' ~ a ~ '><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
		identity: '<svg ' ~ a ~ '><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.5"/><path d="M5.5 16.5c.6-1.6 2-2.5 3.5-2.5s2.9.9 3.5 2.5M15 10h4M15 13h3"/></svg>',
		certificates: '<svg ' ~ a ~ '><circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.5 7 21l5-2.5 5 2.5-1.5-7.5"/></svg>',
		other: '<svg ' ~ a ~ '><circle cx="12" cy="12" r="9"/>' ~ dots ~ '</svg>',
	} %}
	{% set order_icons = {
		eft: '<svg ' ~ a ~ '><path d="M3 10h18L12 4z"/><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18"/></svg>',
		card: '<svg ' ~ a ~ '><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 9.5h19"/><path d="M6 14.5h4"/></svg>',
		documents: '<svg ' ~ a ~ '><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></svg>',
		refund: '<svg ' ~ a ~ '><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4v4h4"/><circle cx="12" cy="12" r="2.5"/></svg>',
		other: '<svg ' ~ a ~ '><circle cx="12" cy="12" r="9"/>' ~ dots ~ '</svg>',
	} %}
	{% set reason_cards = [] %}{% for reason in contact.reasons %}{% set reason_cards = reason_cards|merge([{value: reason.value, label: reason.label, icon: icons[reason.value], note: reason.note}]) %}{% endfor %}
	{% set account_cards = [] %}{% for topic in contact.account_topics %}{% set account_cards = account_cards|merge([{value: topic.value, label: topic.label, icon: account_icons[topic.value], note: topic.note}]) %}{% endfor %}
	{% set order_cards = [] %}{% for topic in contact.order_topics %}{% set order_cards = order_cards|merge([{value: topic.value, label: topic.label, icon: order_icons[topic.value], note: topic.note}]) %}{% endfor %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Send us a message', summary: 'The questions people ask most are answered in the FAQ.'}) }}
			<p class="cl-contact-faq">Before you write, the <a href="/faq">FAQ</a> may already answer your question.</p>
			<form action="/contact" method="post" class="contact-form" data-contact-form>
				<input type="hidden" name="csrf" value="{{ csrf }}">
				<div class="cl-honeypot" aria-hidden="true">
					<label>Website
					<input type="text" name="website" tabindex="-1" autocomplete="off">
					</label>
				</div>
				{{ ui('form.picture-choice', {name: 'reason', legend: 'What is your message about?', id: 'contact-reason', selected: contact.reason, items: reason_cards}) }}

				<fieldset class="cl-contact-part">
					<legend>About you</legend>
					<div class="cl-contact-about">
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Name', for: 'contact-name', required: true})} %}
{% block control %}
						<input id="contact-name" type="text" name="name" maxlength="120" autocomplete="name" value="{{ draft.name ?: (contact.account.name|default('')) }}" required {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Email address', for: 'contact-email', required: true, help: 'We reply to this address.'})} %}
{% block control %}
						<input id="contact-email" type="email" name="email" maxlength="254" autocomplete="email" value="{{ draft.email ?: (contact.account.email|default('')) }}" required {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
					{% if signed_in %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Your account reference', for: 'contact-account-reference', help: 'From your account.'})} %}
{% block control %}
						<input id="contact-account-reference" type="text" value="{{ contact.account.reference }}" readonly {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
					{% else %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Account reference (optional)', for: 'contact-account-reference', help: 'If you have an account, for example CL-20261017-0001-U.'})} %}
{% block control %}
						<input id="contact-account-reference" type="text" name="account_reference" maxlength="40" value="{{ draft.account_reference }}" autocomplete="off" {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
					{% endif %}
					</div>
				</fieldset>

				{# Before you buy: who it is for first (a company's name and how many people only for a company), then which course (owner, 2026-10-20). #}
				<fieldset class="cl-contact-reason" data-contact-reason="before_buying">
					<legend>Before you buy <span class="cl-contact-reason-only">(only if your message is about this)</span></legend>
					{{ ui('form.picture-choice', {name: 'for_company', legend: 'Who is it for?', id: 'contact-buying-for', size: 'small', selected: draft.for_company ?: 'no', items: [
						{value: 'no', label: 'For myself', icon: icons.account, note: 'A course or bundle for you.'},
						{value: 'yes', label: 'For a company', icon: company_icon, note: 'Courses for your staff.'},
					]}) }}
					<div class="cl-contact-company" data-contact-company>
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Company name', for: 'contact-company'})} %}
{% block control %}
						<input id="contact-company" type="text" name="company_name" maxlength="160" value="{{ draft.company_name }}" autocomplete="organization" {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'How many people need the course?', for: 'contact-learners'})} %}
{% block control %}
						<input id="contact-learners" type="number" name="learners" min="1" max="999999" step="1" value="{{ draft.learners }}" {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
					</div>
					<fieldset class="cl-contact-subpart">
						<legend>Which course?</legend>
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Course (optional)', for: 'contact-course-buying'})} %}
{% block control %}
							<select id="contact-course-buying" name="buying_course_id" {{ ui_field_attrs(props) }}>
								<option value="">Not about one course</option>
								{% for course in contact.courses %}<option value="{{ course.id }}" {{ course.id ~ '' == (draft.buying_course_id ?: contact.course_id) ? 'selected' : '' }}>{{ course.title }}</option>{% endfor %}
							</select>
{% endblock %}
{% endembed %}
					</fieldset>
				</fieldset>

				{# Account Profile issue #}
				<fieldset class="cl-contact-reason" data-contact-reason="account">
					<legend>Account Profile issue <span class="cl-contact-reason-only">(only if your message is about this)</span></legend>
					{{ ui('form.picture-choice', {name: 'account_topic', legend: 'What is it about?', id: 'contact-account-topic', size: 'small', selected: draft.account_topic, items: account_cards}) }}
				</fieldset>

				{# Accounting issue: the topic, then the day paid, the order, the reference used and the amount (owner, 2026-10-20). #}
				<fieldset class="cl-contact-reason" data-contact-reason="order">
					<legend>Accounting issue <span class="cl-contact-reason-only">(only if your message is about this)</span></legend>
					{{ ui('form.picture-choice', {name: 'order_topic', legend: 'What is it about?', id: 'contact-order-topic', size: 'small', selected: draft.order_topic, items: order_cards}) }}
					<p class="cl-contact-eft-note">Tell us what your bank statement shows, so we can find your payment.</p>
					{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Date you paid', full_width: false, for: 'contact-eft-date'})} %}
{% block control %}
							<input id="contact-eft-date" type="date" name="eft_paid_on" value="{{ draft.eft_paid_on }}" max="{{ 'now'|date('Y-m-d') }}" {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
						{% if signed_in %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Order number', full_width: false, for: 'contact-order', help: contact.orders ? 'Your orders, newest first.' : 'You have no orders yet.'})} %}
{% block control %}
							<select id="contact-order" name="order_id" {{ ui_field_attrs(props) }}>
								<option value="">Not about one order</option>
								{% for order in contact.orders %}<option value="{{ order.value }}" {{ order.selected ? 'selected' : '' }}>{{ order.label }}</option>{% endfor %}
							</select>
{% endblock %}
{% endembed %}
						{% else %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Order number', full_width: false, for: 'contact-order-number', help: 'For example CL-00000012.'})} %}
{% block control %}
							<input id="contact-order-number" type="text" name="order_number" maxlength="20" value="{{ contact.order_number }}" autocomplete="off" {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
						{% endif %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Reference you used', full_width: false, for: 'contact-eft-reference', help: 'The payment reference you typed at your bank.'})} %}
{% block control %}
							<input id="contact-eft-reference" type="text" name="eft_reference" maxlength="80" value="{{ draft.eft_reference }}" {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Amount you paid', full_width: false, for: 'contact-eft-amount', help: 'For example R1 200.00.'})} %}
{% block control %}
							<input id="contact-eft-amount" type="text" name="eft_amount" maxlength="30" inputmode="decimal" value="{{ draft.eft_amount }}" {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
				</fieldset>

				{# Course issue #}
				<fieldset class="cl-contact-reason" data-contact-reason="course">
					<legend>Course issue <span class="cl-contact-reason-only">(only if your message is about this)</span></legend>
					{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Which course?', full_width: false, for: 'contact-course-problem'})} %}
{% block control %}
							<select id="contact-course-problem" name="course_id" {{ ui_field_attrs(props) }}>
								<option value="">Choose a course</option>
								{% for course in contact.courses %}<option value="{{ course.id }}" {{ course.id ~ '' == (draft.course_id ?: contact.course_id) ? 'selected' : '' }}>{{ course.title }}</option>{% endfor %}
							</select>
{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Where in the course? (optional)', full_width: false, for: 'contact-where', help: 'The module or page, for example Module 3.'})} %}
{% block control %}
							<input id="contact-where" type="text" name="where" maxlength="200" value="{{ draft.where }}" {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
				</fieldset>

				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Your message', full_width: true, for: 'contact-message', required: true})} %}
{% block control %}
					<textarea id="contact-message" name="message" rows="8" maxlength="5000" required {{ ui_field_attrs(props) }}>{{ draft.message }}</textarea>
{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
					{{ ui('action.button', {label: 'Send message', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-send'}) }}
{% endblock %}
{% endembed %}
			</form>
			{# Only the chosen reason's fieldset shows and is sent, and a company's name and size only for a company. Without JavaScript everything shows and the server reads only what the choices call for. #}
			<script>(()=>{const form=document.querySelector('[data-contact-form]');if(!form)return;const sync=()=>{const chosen=form.querySelector('input[name=reason]:checked')?.value;form.querySelectorAll('[data-contact-reason]').forEach((set)=>{const on=set.dataset.contactReason===chosen;set.hidden=!on;set.disabled=!on;});const company=form.querySelector('[data-contact-company]');if(company){const on=form.querySelector('input[name=for_company]:checked')?.value==='yes';company.hidden=!on;company.querySelectorAll('input').forEach((field)=>{field.disabled=!on;});}};form.querySelectorAll('input[name=reason],input[name=for_company]').forEach((card)=>card.addEventListener('change',sync));sync();})();</script>
{% endblock %}
{% endembed %}
	</section>
{% endblock %}
