{% extends layout %}

{% block page_body %}
	{% set ph_kicker = 'Contact' %}
	{% set ph_title = 'Get in touch' %}
	{% set ph_lead = 'Send a message to the Catto Learning team. We will reply to the email address you provide.' %}
	{% include '@platform/partials/page-head.html.twig' %}

	<section class="container cl-medium py-5">
		<div class="card section contact-card">
			<form action="/contact" method="post" class="contact-form">
				<input type="hidden" name="csrf" value="{{ csrf }}">

				<div class="cl-honeypot" aria-hidden="true">
					<label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
				</div>

				<div class="form-grid">
					<div class="field">
						<label for="contact-name">Name</label>
						<input id="contact-name" type="text" name="name" maxlength="120" autocomplete="name" required>
					</div>
					<div class="field">
						<label for="contact-email">Email address</label>
						<input id="contact-email" type="email" name="email" maxlength="254" autocomplete="email" required>
					</div>
					<div class="field field-wide">
						<label for="contact-subject">Subject</label>
						<input id="contact-subject" type="text" name="subject" maxlength="160" required>
					</div>
					<div class="field field-wide">
						<label for="contact-message">Message</label>
						<textarea id="contact-message" name="message" rows="8" maxlength="5000" required></textarea>
					</div>
				</div>

				<div class="cl-form-actions">
					<button class="btn btn-primary" type="submit">Send message</button>
				</div>
			</form>
		</div>
	</section>
{% endblock %}
