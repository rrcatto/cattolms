{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/people' %}
	{% set ph_back_label = 'People' %}
	{% set ph_kicker = 'Platform administration' %}
	{% set ph_title = 'Person profile' %}
	{% set ph_lead = 'Particulars, company, roles, access and sessions.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: (profile.full_name), eyebrow: 'Platform administration', summary: 'Complete profile, company, roles, learning access and sessions in one place.'})} %}
{% block section_actions %}
{{ ui('feedback.badge', {label: (profile.status), tone: profile.status=='active' ? 'success' : 'danger'}) }}
{% endblock %}
{% endembed %}
	<div class="admin-person-summary">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		<div class="profile-head">
			<div class="avatar">
				U
			</div>
			<div class="profile-meta">
				<h2>
					{{ profile.full_name }}
				</h2>
				<p>
					{{ primary_email }}
					{% if company %}
						· {{ company.name }}
					{% endif %}
				</p>
				<div class="chip-row cl-mt-2">
					{% for role in roles %}
						{{ ui('feedback.badge', {label: (role), tone: 'info'}) }}
					{% endfor %}
				</div>
			</div>
		</div>

{% endblock %}
{% endembed %}</div>
	{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: true})} %}
{% block body %}

		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

			{{ ui('layout.section-head', {heading: 'Complete profile', summary: 'Platform Administrators can edit the same profile information that the person can edit themselves, plus company and roles.'}) }}
			<form action="/admin/people/{{ target_user_id }}" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'First name', full_width: false, for: 'field-admin-person-profile-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="first_name" maxlength="120" value="{{ profile.first_name }}" id="field-admin-person-profile-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Middle names', full_width: false, for: 'field-admin-person-profile-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="middle_names" maxlength="160" value="{{ profile.middle_names }}" placeholder="Any names between the first name and the surname" id="field-admin-person-profile-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Last name', full_width: false, for: 'field-admin-person-profile-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="last_name" maxlength="120" value="{{ profile.last_name }}" id="field-admin-person-profile-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Identification number', full_width: false, for: 'field-admin-person-profile-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="identification_number" maxlength="120" value="{{ profile.identification_number }}" id="field-admin-person-profile-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Birthdate', full_width: false, for: 'field-admin-person-profile-5-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input type="date" name="birthdate" value="{{ profile.birthdate }}" id="field-admin-person-profile-5-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Gender', full_width: false, for: 'field-admin-person-profile-6-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<select name="gender" id="field-admin-person-profile-6-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="">Select</option><option {{ profile.gender=='Male' ? 'selected' : '' }}>Male</option><option {{ profile.gender=='Female' ? 'selected' : '' }}>Female</option><option {{ profile.gender=='Non-binary' ? 'selected' : '' }}>Non-binary</option><option {{ profile.gender=='Prefer not to say' ? 'selected' : '' }}>Prefer not to say</option></select>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Mobile number', full_width: false, for: 'field-admin-person-profile-7-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="mobile_number" maxlength="60" value="{{ profile.mobile_number }}" id="field-admin-person-profile-7-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Display name', full_width: true, for: 'field-admin-person-profile-8-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="display_name" maxlength="160" value="{{ profile.display_name }}" id="field-admin-person-profile-8-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Name on certificates', full_width: true, for: 'field-admin-person-profile-9-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="certificate_name" maxlength="160" value="{{ profile.certificate_name }}" id="field-admin-person-profile-9-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Primary email', full_width: true, for: 'field-admin-person-profile-10-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true, help: 'Administrator changes take effect immediately.'})} %}
{% block control %}

					<input type="email" name="primary_email" value="{{ primary_email }}" required id="field-admin-person-profile-10-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Secondary email', full_width: true, for: 'field-admin-person-profile-11-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), help: 'Leave blank to remove it. An address entered by a Platform Administrator is treated as verified.'})} %}
{% block control %}

					<input type="email" name="secondary_email" value="{{ secondary_email }}" id="field-admin-person-profile-11-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'company_id', lk_type: 'companies', lk_label: 'Company', lk_selected: selected_company, lk_required: 1, lk_empty: 'Search for the company'} %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Roles', full_width: true, for: 'profile-role-0', help: 'The platform must always retain at least one Platform Administrator. The last administrator cannot remove or disable their own administrator role.'})} %}
{% block control %}

					<div class="role-checkbox-grid">
						{% for roleOption in role_options %}
							{% embed ui_template('form.choice') with {role_field: props, props: ui_props('form.choice', {label: (roleOption.role_name) ~ (roleOption.role_key)})} %}
{% block control %}
<input type="checkbox" name="roles[]" value="{{ roleOption.role_key }}" {{ roleOption.selected ? 'checked' : '' }} id="profile-role-{{ loop.index0 }}" {{ ui_field_attrs(role_field) }}>
{% endblock %}
{% endembed %}
						{% endfor %}
					</div>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

					{{ ui('action.button', {label: 'Save complete profile', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
		<div class="admin-person-side">
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

				{{ ui('layout.section-head', {heading: 'Account status', summary: 'Created ' ~ (profile.created_at) ~ ' · Last login ' ~ (profile.last_login_at ?: 'Never')}) }}
				<form action="/admin/people/{{ target_user_id }}/status" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<input type="hidden" name="status" value="{{ profile.status=='active' ? 'disabled' : 'active' }}">
					{{ ui('action.button', {label: (profile.status=='active' ? 'Disable account' : 'Enable account'), variant: profile.status=='active' ? 'danger' : 'primary', size: 'normal', type: 'submit', confirm: (profile.status=='active' ? 'Disable this account?' : 'Enable this account?')}) }}
				</form>

{% endblock %}
{% endembed %}
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

				{{ ui('layout.section-head', {heading: 'Active sessions', summary: 'Revoke individual login sessions.'}) }}
				{% if sessions %}
					{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

						{% for session in sessions %}
							{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

									<strong>{{ session.user_agent }}</strong>
									<p>
										Last used {{ session.last_seen_at }}
									</p>

{% endblock %}
{% block actions %}

								{% embed ui_template('action.row') with {props: ui_props('action.row', {})} %}
{% block body %}

									{% if session.is_current %}
										{{ ui('feedback.badge', {label: 'Current', tone: 'success'}) }}
									{% endif %}
									<form action="/admin/people/{{ target_user_id }}/sessions/revoke" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										<input type="hidden" name="session_id" value="{{ session.public_id }}">
										{{ ui('action.button', {label: 'Revoke', variant: 'danger', size: 'small', type: 'submit', confirm: 'Revoke this session?', icon: 'action-remove'}) }}
									</form>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
						{% endfor %}

{% endblock %}
{% endembed %}
				{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

						No active sessions.

{% endblock %}
{% endembed %}
				{% endif %}

{% endblock %}
{% endembed %}
		</div>

{% endblock %}
{% endembed %}
	{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 3, section_spacing: true})} %}
{% block body %}

		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

			{{ ui('layout.section-head', {heading: 'Courses in library', summary: 'Current learner access.'}) }}
			{% if can_manage_enrolments %}
				{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'grant_courses', ds_label: 'Find a course to grant', ds_value: grant_course_search, ds_action: '/admin/people/' ~ target_user_id, ds_push_url: true} %}
				<div id="grant_courses-region"><div id="grant_courses-results">
				{% if grant_course_search|length >= 2 %}
					<form action="/admin/people/{{ target_user_id }}/courses/grant" method="post">
						<input type="hidden" name="csrf" value="{{ csrf }}">
						{% if grant_courses %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Course', for: 'person-grant-course', required: true})} %}{% block control %}<select id="person-grant-course" name="course_id" required {{ ui_field_attrs(props) }}>{% for grant_course in grant_courses %}<option value="{{ grant_course.id }}">{{ grant_course.label }} · {{ grant_course.detail }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Access days', for: 'person-grant-days', required: true, help: 'The countdown begins when access is granted.'})} %}{% block control %}<input id="person-grant-days" type="number" name="access_days" min="1" max="24855" value="30" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
						{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Grant course access', variant: 'primary', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
						{% else %}<p>No courses match this search.</p>{% endif %}
					</form>
				{% endif %}
				</div></div>
			{% endif %}
			{% if library_courses %}
				{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

					{% for course in library_courses %}
						{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

								<strong>{{ course.title }}</strong>
								<p>
									{{ course.status }} · {{ course.progress_percentage }}% progress{% if course.expires_at %} · until {{ course.expires_at|date('j M Y H:i') }}{% endif %}
								</p>

{% endblock %}
{% block actions %}

							{{ ui('action.link', {label: 'Manage', variant: 'secondary', size: 'small', href: '/admin/course/enrolments'}) }}

{% endblock %}
{% endembed %}
					{% endfor %}

{% endblock %}
{% endembed %}
			{% else %}
				{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

					No courses in this library.

{% endblock %}
{% endembed %}
			{% endif %}

{% endblock %}
{% endembed %}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

			{{ ui('layout.section-head', {heading: 'Favourites', summary: 'Courses saved for later.'}) }}
			{% if favourites %}
				{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

					{% for course in favourites %}
						{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

								<strong>{{ course.title }}</strong>

{% endblock %}
{% block actions %}

{% endblock %}
{% endembed %}
					{% endfor %}

{% endblock %}
{% endembed %}
			{% else %}
				{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

					No favourites.

{% endblock %}
{% endembed %}
			{% endif %}

{% endblock %}
{% endembed %}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

			{{ ui('layout.section-head', {heading: 'Course requests', summary: 'Current and previous requests.'}) }}
			{% if requests %}
				{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

					{% for request in requests %}
						{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

								<strong>{{ request.course_title }}</strong>
								<p>
									{{ request.status }}
								</p>

{% endblock %}
{% block actions %}

{% endblock %}
{% endembed %}
					{% endfor %}

{% endblock %}
{% endembed %}
			{% else %}
				{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

					No course requests.

{% endblock %}
{% endembed %}
			{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
{% endblock %}
