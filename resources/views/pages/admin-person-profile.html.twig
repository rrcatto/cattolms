{% extends layout %}
{% block page_body %}
	{# Built one way, as every page is (UX rule 1.7; owner, 2026-10-20: this page had its cards outside the page section and
	   no margin): the page head with the person's name, then one page section holding every card. #}
	{% set ph_back_href = '/admin/people' %}
	{% set ph_back_label = 'People' %}
	{% set ph_kicker = 'Person' %}
	{% set ph_title = profile.full_name ?: primary_email %}
	{% set ph_lead = 'Particulars, company, roles, access and sessions.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Summary', heading_level: 2}) }}
		<div class="profile-head">
			{# Their own picture when they uploaded one, else a plain placeholder (owner, 2026-10-20: never initials). #}
			{% if profile_image_url %}
				<img class="cl-person-photo" src="{{ profile_image_url }}" alt="Profile picture of {{ profile.full_name ?: primary_email }}" width="96" height="96">
			{% else %}
				<span class="cl-person-photo cl-person-photo--placeholder" role="img" aria-label="No profile picture"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg></span>
			{% endif %}
			<div class="profile-meta">
				<p>
					{{ primary_email }}
					{% if company %}
						· {{ company.name }}
					{% endif %}
				</p>
				{% if account_reference_label|default('') %}<p>Account reference: <strong>{{ account_reference_label }}</strong></p>{% endif %}
				<div class="chip-row cl-mt-2">
					{{ ui('feedback.badge', {label: profile.status == 'awaiting_approval' ? 'Awaiting approval' : (profile.status|ucfirst), tone: profile.status=='active' ? 'success' : (profile.status == 'awaiting_approval' ? 'warning' : 'danger')}) }}
					{% for role in roles %}
						{% set role_option = role_options|filter(option => option.role_key == role)|first %}
						{{ ui('feedback.badge', {label: role_option ? role_option.role_name|role_label(role) : ''|role_label(role), tone: 'info'}) }}
					{% endfor %}
				</div>
				{% if not profile_image_url %}<p class="small cl-text-muted">No profile picture.</p>{% endif %}
			</div>
		</div>

{% endblock %}
{% endembed %}
	{# The date of birth and identity verification (owner, 2026-10-19; adults only, 2026-10-20). #}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'identity'})} %}
{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Age and identity', summary: 'The date of birth they gave (the site is for adults only) and identity verification through Didit. No identity images are kept.'}) }}
		{% set document_birth = identity and identity.verification ? identity.verification.date_of_birth|default(null) : null %}
		{{ ui('data.key-value-list', {items: [
			{label: 'Date of birth', value: profile.birthdate|default(null) ? (profile.birthdate|date('j F Y')) ~ ' (' ~ date(profile.birthdate).diff(date()).y ~ ')' : 'Not given yet: asked at their next sign-in'},
		] | merge(document_birth and document_birth|date('Y-m-d') != (profile.birthdate|default(null) ? profile.birthdate|date('Y-m-d') : '') ? [{label: 'On their identity document', value: document_birth|date('j F Y') ~ ' (' ~ date(document_birth).diff(date()).y ~ '), not the date they gave'}] : []) | merge(identity and identity.minor ? [{label: 'Adults only', value: 'Under 18 on their identity document: the account stops at the adults-only page'}] : []) | merge(identity ? [{label: 'Identity', value: identity.status_words}, {label: 'Declined checks that count', value: identity.tries_used ~ ' of 3'}] : [])}) }}
		{% if identity %}
			{% if can_manage_identity and identity.blocked %}
			<form action="/admin/people/{{ target_user_id }}/identity/allow-retry" method="post" class="cl-mt-2"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: 'Allow another try', variant: 'primary', size: 'small', type: 'submit', confirm: 'Allow this person three more identity checks?', icon: 'action-refresh'}) }}</form>
			{% endif %}
			{% if identity_history %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'Identity checks, newest first'})} %}
			{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 15, label: 'Started', wide: true}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Status'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 45, label: 'Result'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 26, label: 'Didit session', wide: true}} %}</tr>{% endblock %}
			{% block body %}{% for check in identity_history %}<tr data-identity-check="{{ check.id }}">
				<td class="small">{{ check.started_at|date('j M Y H:i') }}</td>
				<td>{{ check.status_words }}</td>
				<td class="cell-text">{% if check.verified_name %}<strong>{{ check.verified_name }}</strong><br><span class="small">{{ check.document_type|default('Document') }}{{ check.document_number ? ' ' ~ check.document_number : '' }}{{ check.issuing_country ? ', ' ~ check.issuing_country : '' }}{{ check.date_of_birth ? ', born ' ~ check.date_of_birth|date('j F Y') : '' }}{{ check.decided_at ? ', decided ' ~ check.decided_at|date('j M Y H:i') : '' }}</span>{% elseif check.decline_reason %}{{ check.decline_reason }}{% else %}—{% endif %}{% if check.status == 'revoked' %}<br><span class="small">Revoked {{ check.revoked_at|date('j M Y H:i') }}{% if check.revoked_by_user_id %} by {{ ui('data.person', {name: check.revoked_by_name ?: 'User ' ~ check.revoked_by_user_id, reference: check.revoked_by_reference, href: '/admin/people/' ~ check.revoked_by_user_id}) }}{% endif %}: {{ check.revocation_reason }}</span>{% endif %}
				{% if can_manage_identity and check.status == 'approved' %}
					<form action="/admin/people/{{ target_user_id }}/identity/{{ check.id }}/revoke" method="post" class="cl-mt-2"><input type="hidden" name="csrf" value="{{ csrf }}">
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Reason for revoking', for: 'revoke-identity-' ~ check.id, required: true})} %}{% block control %}<input id="revoke-identity-{{ check.id }}" name="reason" maxlength="500" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
						{{ ui('action.button', {label: 'Revoke verification', variant: 'danger', size: 'small', type: 'submit', confirm: 'Revoke this verification? The person must verify again before a purchase or a certificate.', icon: 'action-revoke'}) }}
					</form>
				{% endif %}</td>
				<td class="small"><span class="mono">{{ check.session_id }}</span><br>{{ ui('action.link', {label: 'Open the Didit console', variant: 'quiet', size: 'small', href: identity_console, new_window: true, icon: 'action-external'}) }}</td>
			</tr>{% endfor %}{% endblock %}
			{% endembed %}
			<p class="help">Didit's console finds a check by its session id: search for it under Verifications.</p>
			{% else %}<p>No identity check yet.</p>{% endif %}
		{% endif %}
{% endblock %}
{% endembed %}
	{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: true})} %}
{% block body %}

		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

			{{ ui('layout.section-head', {heading: 'Complete profile', summary: 'Platform Administrators can edit the same profile information that the person can edit themselves, plus company and roles.'}) }}
			<form action="/admin/people/{{ target_user_id }}" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'First name', full_width: false, for: 'field-admin-person-profile-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="first_name" maxlength="120" value="{{ profile.first_name }}" id="field-admin-person-profile-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Middle names', full_width: false, for: 'field-admin-person-profile-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="middle_names" maxlength="160" value="{{ profile.middle_names }}" placeholder="Any names between the first name and the surname" id="field-admin-person-profile-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Last name', full_width: false, for: 'field-admin-person-profile-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="last_name" maxlength="120" value="{{ profile.last_name }}" id="field-admin-person-profile-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Identification number', full_width: false, for: 'field-admin-person-profile-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="identification_number" maxlength="120" value="{{ profile.identification_number }}" id="field-admin-person-profile-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Date of birth', help: '18 or older.', full_width: false, for: 'field-admin-person-profile-5-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input type="date" name="birthdate" value="{{ profile.birthdate }}" id="field-admin-person-profile-5-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Gender', full_width: false, for: 'field-admin-person-profile-6-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<select name="gender" id="field-admin-person-profile-6-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="">Select</option><option {{ profile.gender=='Male' ? 'selected' : '' }}>Male</option><option {{ profile.gender=='Female' ? 'selected' : '' }}>Female</option><option {{ profile.gender=='Non-binary' ? 'selected' : '' }}>Non-binary</option><option {{ profile.gender=='Prefer not to say' ? 'selected' : '' }}>Prefer not to say</option></select>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Mobile number', full_width: false, for: 'field-admin-person-profile-7-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="mobile_number" maxlength="60" value="{{ profile.mobile_number }}" id="field-admin-person-profile-7-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Display name', full_width: true, for: 'field-admin-person-profile-8-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

					<input name="display_name" maxlength="160" value="{{ profile.display_name }}" id="field-admin-person-profile-8-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Primary email', full_width: true, for: 'field-admin-person-profile-10-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true, help: 'Administrator changes take effect immediately.'})} %}
{% block control %}

					<input type="email" name="primary_email" value="{{ primary_email }}" required id="field-admin-person-profile-10-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Secondary email', full_width: true, for: 'field-admin-person-profile-11-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), help: 'Leave blank to remove it. An address entered by a Platform Administrator is treated as verified.'})} %}
{% block control %}

					<input type="email" name="secondary_email" value="{{ secondary_email }}" id="field-admin-person-profile-11-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{# No company is a private account (owner, 2026-10-18); a Company Administrator needs one. #}{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'company_id', lk_type: 'companies', lk_label: 'Company', lk_selected: selected_company, lk_required: 0, lk_empty: 'No company: a private account'} %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Roles', full_width: true, for: 'profile-role-0', help: 'The platform must always retain at least one Platform Administrator. The last administrator cannot remove or disable their own administrator role.'})} %}
{% block control %}

					<div class="role-checkbox-grid">
						{% for roleOption in role_options %}
							{% embed ui_template('form.choice') with {role_field: props, props: ui_props('form.choice', {label: roleOption.role_name|role_label(roleOption.role_key)})} %}
{% block control %}
<input type="checkbox" name="roles[]" value="{{ roleOption.role_key }}" {{ roleOption.selected ? 'checked' : '' }} id="profile-role-{{ loop.index0 }}" {{ ui_field_attrs(role_field) }}>
{% endblock %}
{% endembed %}
						{% endfor %}
					</div>

{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

					{{ ui('action.button', {label: 'Save complete profile', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
		<div class="admin-person-side">
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

				{{ ui('layout.section-head', {heading: 'Account status', summary: 'Created ' ~ (profile.created_at) ~ ' · Last login ' ~ (profile.last_login_at ?: 'Never')}) }}
				{% if profile.status == 'awaiting_approval' %}
					{# A demo site's new account (owner, 2026-10-21): it cannot sign in until it is approved. #}
					{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Waiting for your approval'})} %}{% block body %}<p>This account registered on the demo site and cannot sign in until you approve it. Approving it emails the person that they can sign in.</p>{% endblock %}{% endembed %}
					<form action="/admin/people/{{ target_user_id }}/approve" method="post" class="cl-mt-2">
						<input type="hidden" name="csrf" value="{{ csrf }}">
						{{ ui('action.button', {label: 'Approve account', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-approve'}) }}
					</form>
					<form action="/admin/people/{{ target_user_id }}/status" method="post" class="cl-mt-2">
						<input type="hidden" name="csrf" value="{{ csrf }}">
						<input type="hidden" name="status" value="disabled">
						{{ ui('action.button', {label: 'Disable account', variant: 'danger', size: 'normal', type: 'submit', confirm: 'Disable this account instead of approving it?', icon: 'action-disable'}) }}
					</form>
				{% else %}
				<form action="/admin/people/{{ target_user_id }}/status" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<input type="hidden" name="status" value="{{ profile.status=='active' ? 'disabled' : 'active' }}">
					{{ ui('action.button', {label: (profile.status=='active' ? 'Disable account' : 'Enable account'), variant: profile.status=='active' ? 'danger' : 'primary', size: 'normal', type: 'submit', confirm: (profile.status=='active' ? 'Disable this account?' : 'Enable this account?'), icon: (profile.status == 'active' ? 'action-disable' : 'action-enable')}) }}
				</form>
				{% endif %}

{% endblock %}
{% endembed %}
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

				{{ ui('layout.section-head', {heading: 'Active sessions', summary: 'Revoke individual login sessions.'}) }}
				{% if sessions %}
					{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

						{% for session in sessions %}
							{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

									<strong>{{ session.user_agent }}</strong>
									<p>
										Last used {{ session.last_seen_at }}
									</p>

{% endblock %}
{% block actions %}

								{% embed ui_template('action.row') with {props: ui_props('action.row', {})} %}
{% block body %}

									{% if session.is_current %}
										{{ ui('feedback.badge', {label: 'Current', tone: 'success'}) }}
									{% endif %}
									<form action="/admin/people/{{ target_user_id }}/sessions/revoke" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										<input type="hidden" name="session_id" value="{{ session.public_id }}">
										{{ ui('action.button', {label: 'Revoke', variant: 'danger', size: 'small', type: 'submit', confirm: 'Revoke this session?', icon: 'action-revoke'}) }}
									</form>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
						{% endfor %}

{% endblock %}
{% endembed %}
				{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

						No active sessions.

{% endblock %}
{% endembed %}
				{% endif %}

{% endblock %}
{% endembed %}
		</div>

{% endblock %}
{% endembed %}
	{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 3, section_spacing: true})} %}
{% block body %}

		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

			{{ ui('layout.section-head', {heading: 'Courses in library', summary: 'Current learner access.'}) }}
			{# A search of their own courses only when there are enough to need one (owner, 2026-10-20: "Only display it, if
			   they have at least 5 courses"). #}
			{% if library_total >= 5 %}
				{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'library', ds_label: 'Search their courses', ds_value: library_search, ds_action: '/admin/people/' ~ target_user_id, ds_help: 'Searches this person\'s ' ~ library_total ~ ' courses by title.'} %}
			{% endif %}
			<div id="library-region"><div id="library-results">
			{% if library_courses %}
				{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

					{% for course in library_courses %}
						{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

								{# The course opens in Administration; its access is managed here (owner, 2026-10-21: the Manage link opened the
								   whole enrolments list). #}
								<strong><a href="/admin/courses/{{ course.course_id }}">{{ course.title }}</a></strong>
								<p>
									{{ course.status|capitalize }} · {{ course.progress_percentage }}% progress{% if course.expires_at %} · until {{ course.expires_at|date('j M Y H:i') }}{% endif %}
								</p>

{% endblock %}
{% block actions %}

							{% if can_manage_enrolments %}
								<form action="/admin/course/enrolments/{{ course.id }}/{{ course.status == 'cancelled' ? 'restore' : 'remove' }}" method="post">
									<input type="hidden" name="csrf" value="{{ csrf }}">
									<input type="hidden" name="return" value="/admin/people/{{ target_user_id }}">
									{% if course.status == 'cancelled' %}
										{{ ui('action.button', {label: 'Restore access', variant: 'secondary', size: 'small', icon: 'action-restore'}) }}
									{% else %}
										{{ ui('action.button', {label: 'Remove access', variant: 'danger', size: 'small', confirm: 'Remove their access to ' ~ course.title ~ '? Their progress and results are kept, and you can restore it.', icon: 'action-remove'}) }}
									{% endif %}
								</form>
							{% endif %}

{% endblock %}
{% endembed %}
					{% endfor %}

{% endblock %}
{% endembed %}
			{% else %}
				{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

					{{ library_search ? 'None of their courses matches “' ~ library_search ~ '”.' : 'No courses in this library.' }}

{% endblock %}
{% endembed %}
			{% endif %}
			</div></div>

{% endblock %}
{% endembed %}
		{# Granting access is its own card (owner, 2026-10-20): its search finds a course in the whole catalogue, not among
		   this person's courses. #}
		{% if can_manage_enrolments %}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

			{{ ui('layout.section-head', {heading: 'Grant course access', summary: 'Find any course in the catalogue and give this person access to it.'}) }}
				{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'grant_courses', ds_label: 'Find a course to grant', ds_value: grant_course_search, ds_action: '/admin/people/' ~ target_user_id, ds_push_url: true, ds_help: 'Searches every course in the catalogue by title.'} %}
				<div id="grant_courses-region"><div id="grant_courses-results">
				{% if grant_course_search|length >= 2 %}
					<form action="/admin/people/{{ target_user_id }}/courses/grant" method="post">
						<input type="hidden" name="csrf" value="{{ csrf }}">
						{% if grant_courses %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Course', for: 'person-grant-course', required: true})} %}{% block control %}<select id="person-grant-course" name="course_id" required {{ ui_field_attrs(props) }}>{% for grant_course in grant_courses %}<option value="{{ grant_course.id }}">{{ grant_course.label }} · {{ grant_course.detail }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Access days', for: 'person-grant-days', required: true, help: 'The countdown begins when access is granted.'})} %}{% block control %}<input id="person-grant-days" type="number" name="access_days" min="1" max="24855" value="30" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
						{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Grant course access', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-grant'}) }}{% endblock %}{% endembed %}
						{% else %}<p>No courses match this search.</p>{% endif %}
					</form>
				{% endif %}
				</div></div>
			{% if test_grants %}
				<h3 class="h5">Test access grants</h3>
				{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}{% block body %}
					{% for grant in test_grants %}{% include '@platform/partials/admin-test-grant.html.twig' with {grant: grant, context: 'person'} %}{% endfor %}
				{% endblock %}{% endembed %}
			{% endif %}

{% endblock %}
{% endembed %}
