{% extends layout %}
{% block page_body %}
{#
	A course's marketing landing page under /landing/ and ADMIN's preview of it: the hero in the
	page-head band, then the shown sections in their order, each on its own card. The preview is this
	same page with a notice above it and its purchase buttons disabled.
#}
	{% if landing.preview %}
		<section class="cl-page-section" aria-label="Preview">
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', heading: 'Preview of the landing page'})} %}
{% block body %}
				This is the saved page as visitors will see it{{ landing.course.published ? '' : ' once the course is published' }}. Its buttons do nothing here and this view is not counted. <a href="{{ landing_editor_href|default('/admin/courses') }}">Back to the landing page editor</a>
{% endblock %}
{% endembed %}
		</section>
	{% endif %}
	{% include '@platform/partials/landing/hero.html.twig' with {hero: landing.hero} %}
	{#
		The sections in rows (owner, 2026-10-31): a full section alone, two half sections side by side at one height, a half
		section with no half beside it in half a row (Support\HalfRows). On a phone every section is full width.
	#}
	{% if landing.sections %}
		<div class="cl-page-section cl-landing-sections">
			{% for row in landing.rows %}
				{% if row|length > 1 or row[0].width == 'half' %}
					{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: false})} %}
{% block body %}
					{% for section in row %}{% include '@platform/partials/landing/section.html.twig' with {section: section} %}{% endfor %}
{% endblock %}
					{% endembed %}
				{% else %}
					{% include '@platform/partials/landing/section.html.twig' with {section: row[0]} %}
				{% endif %}
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}
