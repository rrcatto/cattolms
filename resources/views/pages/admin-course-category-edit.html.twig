{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses/categories' %}
	{% set ph_back_label = 'Course categories' %}
	{% set ph_kicker = 'Course metadata' %}
	{% set ph_title = category.name %}
	{% set ph_lead = (category.course_count)~' course'~(category.course_count==1 ? '' : 's')~' currently use this category.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<div class="container-fluid cl-container-wide pt-4">
		{% include '@platform/partials/admin/course-group-nav.html.twig' %}
	</div>
	<section class="container py-5 cl-medium">
		<div class="card mb-4">
			<div class="card-body p-4 p-lg-5">
				<h2 class="h4">
					Category details
				</h2>
				<form action="/admin/courses/categories/{{ category.id }}" method="post" class="vstack gap-3">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<div>
						<label class="form-label">Name</label>
						<input class="form-control" name="name" value="{{ category.name }}" maxlength="120" required>
					</div>
					<div>
						<label class="form-label">Parent category</label><select class="form-select" name="parent_id"><option value="0">None — a top-level category</option>
						{% for parent_option in parent_options %}
							<option value="{{ parent_option.id }}" {{ category.parent_id==parent_option.id ? 'selected' : '' }}>{{ parent_option.parent_name ? parent_option.parent_name ~ ' › ' : '' }}{{ parent_option.name }}</option>
						{% endfor %}
						</select>
						<div class="form-text">
							Currently at level {{ category.level }} of 3. A category cannot be moved under itself or under one of its own sub-categories.
						</div>
					</div>
					<div>
						<label class="form-label">Slug</label>
						<input class="form-control" name="slug" value="{{ category.slug }}" required>
					</div>
					<div>
						<label class="form-label">Description</label>
						<textarea class="form-control" name="description" rows="4">{{ category.description }}</textarea>
					</div>
					<div class="cl-form-actions">
					<button class="btn btn-primary" type="submit">Save category</button>
					</div>
				</form>
			</div>
		</div>
		<div class="card border-danger">
			<div class="card-body p-4 p-lg-5">
				<h2 class="h4">
					Delete category
				</h2>
				{% if category.child_count %}
					<p>
						This category has {{ category.child_count }} sub-categor{{ category.child_count==1 ? 'y' : 'ies' }} beneath it. Move or delete those first — deleting a branch would take its whole subtree with it, which is never what anybody means to do.
					</p>
					<a class="btn btn-outline-secondary" href="/admin/courses/categories">Back to categories</a>
				{% else %}
					{% if category.course_count %}
						<p>
							This category is in use. Choose another category and all {{ category.course_count }} course{{ category.course_count==1 ? '' : 's' }} will be reassigned before deletion.
						</p>
						<form action="/admin/courses/categories/{{ category.id }}/delete" method="post">
							<input type="hidden" name="csrf" value="{{ csrf }}">
							<label class="form-label">Replacement category</label><select class="form-select mb-3" name="replacement_category_id" required><option value="">Choose replacement…</option>
							{% for replacement in replacement_categories %}
								<option value="{{ replacement.id }}">{{ replacement.name }}</option>
							{% endfor %}
							</select><button class="btn btn-danger" type="submit" data-confirm="Reassign the affected courses and permanently delete this category?">Reassign courses and delete</button>
						</form>
					{% else %}
						<p>
							No courses use this category, so it can be removed directly.
						</p>
						<form action="/admin/courses/categories/{{ category.id }}/delete" method="post">
							<input type="hidden" name="csrf" value="{{ csrf }}">
							<button class="btn btn-danger" type="submit" data-confirm="Permanently delete this unused course category?">Delete category</button>
						</form>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</section>
{% endblock %}
