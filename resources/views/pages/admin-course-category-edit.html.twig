{% extends layout %}
{% block page_body %}
	{% set ph_back_href = tree_href %}
	{% set ph_back_label = 'Course categories' %}
	{% set ph_kicker = 'Course metadata' %}
	{% set ph_title = category.name %}
	{% set ph_lead = (category.course_count)~' course'~(category.course_count==1 ? '' : 's')~' currently use this category.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<div class="container-fluid cl-container-wide pt-4">
		{% include '@platform/partials/admin/course-group-nav.html.twig' %}
	</div>
	<section class="cl-page-section container py-5 cl-medium">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

				<h2 class="h4">
					Category details
				</h2>
				<form action="/admin/courses/categories/{{ category.id }}" method="post" class="vstack gap-3">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Name', full_width: false, for: 'field-admin-course-category-edit-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

						<input class="form-control" name="name" value="{{ category.name }}" maxlength="120" required id="field-admin-course-category-edit-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
					<p class="cl-category-edit-place">{{ category.level == 1 ? 'Main category' : (category.level == 2 ? 'Subcategory' : 'Sub-subcategory') }}: <strong>{{ category_path }}</strong>. To move it, drag it in the <a href="{{ tree_href }}">category tree</a> or use <a href="/admin/courses/categories/{{ category.id }}/move-into">Move into…</a>.</p>
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Slug', full_width: false, for: 'field-admin-course-category-edit-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

						<input class="form-control" name="slug" value="{{ category.slug }}" required id="field-admin-course-category-edit-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Description', full_width: false, for: 'field-admin-course-category-edit-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

						<textarea class="form-control" name="description" rows="4" id="field-admin-course-category-edit-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>{{ category.description }}</textarea>

{% endblock %}
{% endembed %}
					{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

					{{ ui('action.button', {label: 'Save category', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% block secondary_actions %}{{ ui('action.link', {label: 'Cancel', variant: 'quiet', href: tree_href}) }}{% endblock %}
{% endembed %}
				</form>

{% endblock %}
{% endembed %}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {tone: 'danger'})} %}
{% block surface_body %}

				<h2 class="h4">
					Delete category
				</h2>
				{% if category.child_count %}
					<p>
						This category has {{ category.child_count }} subcategor{{ category.child_count==1 ? 'y' : 'ies' }} beneath it. Move or delete those first — deleting a branch would take its whole subtree with it, which is never what anybody means to do.
					</p>
					{{ ui('action.link', {label: 'Back to categories', variant: 'secondary', size: 'normal', href: tree_href}) }}
				{% else %}
					{% if category.course_count %}
						<p>
							This category is in use. Choose another category and all {{ category.course_count }} course{{ category.course_count==1 ? '' : 's' }} will be reassigned before deletion.
						</p>
						<form action="/admin/courses/categories/{{ category.id }}/delete" method="post">{% embed ui_template('form.compact-action') with {props: ui_props('form.compact-action', {})} %}
{% block body %}

							<input type="hidden" name="csrf" value="{{ csrf }}">
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Replacement category', for: 'field-admin-course-category-edit', required: true})} %}
{% block control %}
<select id="field-admin-course-category-edit" class="form-select mb-3" name="replacement_category_id" required {{ ui_field_attrs(props) }}><option value="">Choose replacement…</option>
							{% for replacement in replacement_categories %}
								<option value="{{ replacement.id }}">{{ replacement.name }}</option>
							{% endfor %}
							</select>
{% endblock %}
{% endembed %}{{ ui('action.button', {label: 'Reassign courses and delete', variant: 'danger', size: 'normal', type: 'submit', confirm: 'Reassign the affected courses and permanently delete this category?', icon: 'action-remove'}) }}

{% endblock %}
{% endembed %}</form>
					{% else %}
						<p>
							No courses use this category, so it can be removed directly.
						</p>
						<form action="/admin/courses/categories/{{ category.id }}/delete" method="post">
							<input type="hidden" name="csrf" value="{{ csrf }}">
							{{ ui('action.button', {label: 'Delete category', variant: 'danger', size: 'normal', type: 'submit', confirm: 'Permanently delete this unused course category?', icon: 'action-remove'}) }}
						</form>
					{% endif %}
				{% endif %}

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
