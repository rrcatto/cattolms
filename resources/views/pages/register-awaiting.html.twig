{% extends layout %}
{% block page_body %}
	{# A new account held for the site's approval: every one on a demo site (owner, 2026-10-21), and on a live site one the
	   sign-up check held (2026-10-26), which is not told why. Nothing promises it will be approved. #}
	{% set ph_kicker = 'Register' %}
	{% set ph_title = 'Waiting for approval' %}
	{% set ph_lead = 'Your email address is confirmed.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}
			<h2 class="h4">What happens next</h2>
			<p>{{ demo_site|default(false) ? demo_notice : 'Your account is held pending approval. Its status will be processed by the site\'s administrator.' }}</p>
			{{ ui('action.link', {label: 'Browse the catalogue', variant: 'secondary', size: 'normal', href: '/courses', icon: 'nav-catalogue'}) }}
{% endblock %}
{% endembed %}
	</section>
{% endblock %}
