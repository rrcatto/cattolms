{% extends layout %}
{% block page_body %}
	{# A demo site's new account waits for the site's approval before it can sign in (owner, 2026-10-21). #}
	{% set ph_kicker = 'Register' %}
	{% set ph_title = 'Waiting for approval' %}
	{% set ph_lead = 'Your email address is confirmed.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}
			<h2 class="h4">What happens next</h2>
			<p>This is a demo site, so every new account is approved by the site's administrator before it can be used. You will receive an email as soon as yours is approved, and you can then sign in with your email address.</p>
			{{ ui('action.link', {label: 'Browse the catalogue', variant: 'secondary', size: 'normal', href: '/courses', icon: 'nav-catalogue'}) }}
{% endblock %}
{% endembed %}
	</section>
{% endblock %}
