{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Passwordless access' %}
	{% set ph_title = 'Sign in' %}
	{% set ph_lead = 'Enter the email address on your account. We will send a one-time sign-in link that expires after 30 minutes.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

				{# A follow asked for before signing in (owner, 2026-10-28, decision 8B): it is carried out once they are in. #}
				{% if follow|default('') and follow_name|default('') %}{% set fa_verb = follow starts with 'list:' ? 'join' : 'follow' %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', heading: 'You will ' ~ fa_verb ~ ' ' ~ follow_name})} %}{% block body %}<p>Once you have signed in, you {{ fa_verb }} {{ follow_name }} straight away and its news comes to you by email.</p>{% endblock %}{% endembed %}{% endif %}
				<form action="/login" method="post" novalidate>
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<input type="hidden" name="return_path" value="{{ return_path }}">
					<input type="hidden" name="follow" value="{{ follow|default('') }}">
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Email address', full_width: false, for: 'email', required: true})} %}
{% block control %}

						<input class="cl-input cl-input-lg" type="email" id="email" name="email" value="{{ email|default('') }}" autocomplete="email" required {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
					{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

					{{ ui('action.button', {label: 'Email my secure link', variant: 'primary', size: 'large', full_width: true, type: 'submit', icon: 'action-email'}) }}

{% endblock %}
{% endembed %}
				</form>
				<p class="small cl-text-secondary mt-5 mb-0">
					New here? <a href="/register{{ follow|default('') ? '?follow=' ~ follow|url_encode ~ '&return=' ~ return_path|url_encode : '' }}">Register an account</a>.
				</p>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
