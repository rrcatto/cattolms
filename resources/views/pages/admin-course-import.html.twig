{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses' %}
	{% set ph_back_label = 'Course administration' %}
	{% set ph_kicker = 'Course importer' %}
	{% set ph_title = 'Import HTML or Catto Learning JSON' %}
	{% set ph_lead = 'Both formats are analysed and previewed before PostgreSQL is changed.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section container py-5 cl-medium">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

				<h2 class="h3">
					Select course file
				</h2>
				<p>
					Upload an original self-study HTML course or a structured <code>.json</code> course export. Theme JSON is imported separately in Administration → Themes.
				</p>
				<form action="/admin/courses/import" method="post" enctype="multipart/form-data">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'HTML or JSON course file', for: 'course-file', required: true})} %}
{% block control %}
<input class="form-control form-control-lg mb-4" id="course-file" type="file" name="course_file" accept=".html,.htm,.json,text/html,application/json" required {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
					{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

					{{ ui('action.button', {label: 'Analyse course', variant: 'secondary', size: 'large', type: 'submit'}) }}

{% endblock %}
{% endembed %}
				</form>

{% endblock %}
{% endembed %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: true})} %}
{% block body %}

			<strong>JSON is the canonical course interchange format.</strong>
			<p class="mb-0 mt-2">
				It preserves modules, ordered content blocks, accordions, assessment settings, question pools, grade bands and certificate templates. HTML remains supported for existing courses.
			</p>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
