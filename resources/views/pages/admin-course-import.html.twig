{% extends layout %}

{% block page_body %}
{% set ph_back_href = '/admin/courses' %}
{% set ph_back_label = 'Course administration' %}
{% set ph_kicker = 'Course importer' %}
{% set ph_title = 'Import HTML or Catto Learning JSON' %}
{% set ph_lead = 'Both formats are analysed and previewed before PostgreSQL is changed.' %}
{% include '@platform/partials/page-head.html.twig' %}
<section class="container py-5 cl-medium">
<div class="card"><div class="card-body p-4 p-lg-5"><h2 class="h3">Select course file</h2><p>Upload an original self-study HTML course or a structured <code>.json</code> course export. Theme JSON is imported separately in Administration → Themes.</p><form action="/admin/courses/import" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label" for="course-file">HTML or JSON course file</label><input class="form-control form-control-lg mb-4" id="course-file" type="file" name="course_file" accept=".html,.htm,.json,text/html,application/json" required><button class="btn btn-outline-primary btn-lg" type="submit">Analyse course</button></form></div></div>
<div class="cl-callout mt-4"><strong>JSON is the canonical course interchange format.</strong><p class="mb-0 mt-2">It preserves modules, ordered content blocks, accordions, assessment settings, question pools, grade bands and certificate templates. HTML remains supported for existing courses.</p></div>
</section>
{% endblock %}
