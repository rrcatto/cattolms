{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses' %}
	{% set ph_back_label = 'Course administration' %}
	{% set ph_kicker = 'Course importer' %}
	{% set ph_title = 'Import Course' %}
	{% set ph_lead = 'Both formats are analysed and previewed before PostgreSQL is changed.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

				<h2 class="h3">
					Select course file
				</h2>
				<p>
					Upload a course written as one HTML file, to the course specification (<code>docs/COURSE-SPECIFICATION.md</code> in CattoLMS's code), or a <code>.json</code> course export. Theme JSON is imported separately in Administration → Themes.
				</p>
				<form action="/admin/courses/import" method="post" enctype="multipart/form-data">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'HTML or JSON course file', for: 'course-file', required: true})} %}
{% block control %}
<input class="cl-input cl-input-lg mb-7" id="course-file" type="file" name="course_file" accept=".html,.htm,.json,text/html,application/json" required {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
					{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

					{{ ui('action.button', {label: 'Analyse course', variant: 'secondary', size: 'large', type: 'submit', icon: 'action-inspect'}) }}

{% endblock %}
{% endembed %}
				</form>

{% endblock %}
{% endembed %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: true})} %}
{% block body %}

			<strong>A new course is written as one HTML file.</strong>
			<p class="mb-0 mt-3">
				The file is the whole course on its own in a browser, and imports here with every module's presentation, video, lesson, summary, flash cards, practical work and assessment. A <code>.json</code> file is a course exported from CattoLMS, to bring it back exactly as it was.
			</p>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
