{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin/courses/' ~ course.id %}{% set ph_back_label = 'Course administration' %}{% set ph_kicker = 'Structure, presentation and availability' %}{% set ph_title = course.title ~ ' · Course Content' %}{% set ph_lead = 'Course Items are reusable. These rows hold only this course’s structure, display overrides, public preview setting, assessment role and relative availability. Every move is saved at once.' %}{% include '@platform/partials/page-head.html.twig' %}
{{ importmap() }}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% embed ui_template('action.group') with {props:ui_props('action.group',{})} %}{% block body %}{{ ui('action.link',{label:'Preview as learner',href:'/admin/courses/' ~ course.id ~ '/preview'}) }}{{ ui('action.link',{label:'Preview public course',href:'/courses/' ~ course.slug ~ '/preview?preview=1'}) }}{% endblock %}{% endembed %}
{% set validation = course.publication_validation %}
{% if validation.errors %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger', heading: 'Publication errors', section_spacing: true})} %}{% block body %}<ul>{% for error in validation.errors %}<li>{{ error }}</li>{% endfor %}</ul>{% endblock %}{% endembed %}{% endif %}
{% if validation.warnings %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Publication warnings', section_spacing: true})} %}{% block body %}<ul>{% for warning in validation.warnings %}<li>{{ warning }}</li>{% endfor %}</ul><p>ADMIN may explicitly override warnings when publishing.</p>{% endblock %}{% endembed %}{% endif %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
{{ ui('layout.section-head', {heading: 'Course Content', summary: 'Availability is relative to the preceding sibling; a scheduled section controls all descendants. Every move is saved at once.'}) }}
<div class="cl-course-tree-wrap" data-controller="course-content" data-course-content-course-value="{{ course.id }}" data-action="dragstart->course-content#start dragover->course-content#over dragleave->course-content#leave drop->course-content#drop dragend->course-content#end submit->course-content#menu htmx:before:request->course-content#loading htmx:before:swap->course-content#unloading course-content-inserted->course-content#inserted">
<div class="cl-course-tree-tools" data-course-content-target="enhanced" hidden>
<p class="cl-course-tree-help" id="course-tree-keys">Drag a row by its handle. On a focused handle, ↑ and ↓ move the row, Home and End move it to the top or bottom, ← moves it out of its section and → moves it into the row above. Dragging a selected row moves every selected row.</p>
{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}{% block body %}{{ ui('action.button', {label: 'Expand all', variant: 'secondary', size: 'small', type: 'button', stimulus_action: 'course-content#expandAll', icon: 'action-chevron'}) }}{{ ui('action.button', {label: 'Collapse all', variant: 'secondary', size: 'small', type: 'button', stimulus_action: 'course-content#collapseAll', icon: 'action-chevron'}) }}{% endblock %}{% endembed %}
</div>
<p class="cl-course-tree-status" role="status" aria-live="polite" data-course-content-target="status"></p>
<p class="cl-course-tree-error" role="alert" data-course-content-target="error" hidden></p>
<form id="move-selection" class="cl-course-tree-bulk" action="/admin/courses/{{ course.id }}/content/move-selection" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><span class="cl-course-tree-bulk-label">Move selected</span>{% for move in [{direction: 'top', label: 'To top'}, {direction: 'up', label: 'Up'}, {direction: 'down', label: 'Down'}, {direction: 'bottom', label: 'To bottom'}, {direction: 'out', label: 'Out of section'}, {direction: 'into', label: 'Into section…'}] %}{{ ui('action.button', {label: move.label, aria_label: 'Move selected rows ' ~ move.label|lower, type: 'submit', size: 'small', name: 'direction', value: move.direction}) }}{% endfor %}</form>
{% include '@platform/partials/admin/course-content-tree.html.twig' %}
{# "+ Add here" loads its form into this modal; a successful insertion closes it and refreshes the tree. #}
{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'course-content-insert', title: 'Add to Course Content', size: 'wide'})} %}{% block modal_body %}<div class="cl-course-insert-body" id="course-content-insert-body" data-course-content-target="insertBody"></div>{% endblock %}{% endembed %}
</div>
{% endblock %}{% endembed %}
</section>
{% endblock %}
