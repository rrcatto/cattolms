{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin/courses/' ~ course.id %}{% set ph_back_label = 'Course administration' %}{% set ph_kicker = 'Structure, presentation and availability' %}{% set ph_title = course.title ~ ' · Course Content' %}{% set ph_lead = 'Course Items are reusable. These rows hold only this course’s structure, display overrides, public preview setting, assessment role and relative availability. Every move is saved at once.' %}{% include '@platform/partials/page-head.html.twig' %}
{{ importmap() }}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% embed ui_template('action.group') with {props:ui_props('action.group',{})} %}{% block body %}{{ ui('action.link',{label:'Preview as learner',href:'/admin/courses/' ~ course.id ~ '/preview'}) }}{{ ui('action.link',{label:'Preview public course',href:'/courses/' ~ course.slug ~ '/preview?preview=1'}) }}{% endblock %}{% endembed %}
{% set validation = course.publication_validation %}
{% if validation.errors %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger', heading: 'Publication errors', section_spacing: true})} %}{% block body %}<ul>{% for error in validation.errors %}<li>{{ error }}</li>{% endfor %}</ul>{% endblock %}{% endembed %}{% endif %}
{% if validation.warnings %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Publication warnings', section_spacing: true})} %}{% block body %}<ul>{% for warning in validation.warnings %}<li>{{ warning }}</li>{% endfor %}</ul><p>ADMIN may explicitly override warnings when publishing.</p>{% endblock %}{% endembed %}{% endif %}
{% set placing = insert.index is not null %}
{% set clear_href = '/admin/courses/' ~ course.id ~ '/content#add-item' %}
<div id="add-item">{{ ui('layout.section-head', {heading: 'Add item', heading_level: 2, summary: placing ? 'Adding at the place you chose in Course Content.' : 'Create a new Course Item for this course, place one that already exists, or add a section. Use + Add here in the tree to add at an exact place.'}) }}{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 3})} %}{% block body %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'add-new'})} %}{% block surface_body %}{{ ui('layout.section-head', {heading: 'Create new item', heading_level: 3, summary: 'Create a Course Item and add it to this course in one step. File-based items can use an existing Resource or upload a new one.'}) }}<form action="/admin/course-items/new" method="get"><input type="hidden" name="course_id" value="{{ course.id }}">{% if placing %}{% include '@platform/partials/admin/course-insert-position.html.twig' with {structure: course.structure, parent: insert.parent ?: '', index: insert.index} %}{% endif %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Item type',for:'new-item-type',required:true})} %}{% block control %}<select class="form-select" id="new-item-type" name="type" required {{ ui_field_attrs(props) }}>{% for choice in type_choices %}<option value="{{ choice.value }}">{{ choice.label }} · {{ choice.description }}</option>{% endfor %}</select>{% endblock %}{% endembed %}{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Continue', variant: 'primary', type: 'submit'}) }}{% endblock %}{% endembed %}</form>{% endblock %}{% endembed %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'add-existing'})} %}{% block surface_body %}{{ ui('layout.section-head', {heading: 'Add existing item', heading_level: 3, summary: 'Place a reusable item that already exists. It stays shared: edits to it apply wherever it is used.'}) }}<form action="/admin/courses/{{ course.id }}/content#add-existing" method="get">{% if placing %}<input type="hidden" name="insert_parent" value="{{ insert.parent ?: '' }}"><input type="hidden" name="insert_index" value="{{ insert.index }}">{% endif %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Find an existing item by title or key',for:'existing-item-search'})} %}{% block control %}<input class="form-control" id="existing-item-search" name="q" value="{{ item_search }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}{{ ui('action.button',{label:'Search items',type:'submit'}) }}</form><form class="mt-3" action="/admin/courses/{{ course.id }}/content/placements" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Existing Course Item',for:'existing-course-item',required:true})} %}{% block control %}<select class="form-select" id="existing-course-item" name="course_item_id" required {{ ui_field_attrs(props) }}><option value="">Choose a Course Item</option>{% for item in library_items %}<option value="{{ item.id }}">{{ item.title }} · {{ item.item_key }}</option>{% endfor %}</select>{% endblock %}{% endembed %}{% if placing %}{% include '@platform/partials/admin/course-insert-position.html.twig' with {structure: course.structure, parent: insert.parent ?: '', index: insert.index} %}{% else %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Parent Course Item or section',for:'existing-parent'})} %}{% block control %}<select class="form-select" id="existing-parent" name="parent_node_id" {{ ui_field_attrs(props) }}><option value="">Outer level</option>{% for node in course.structure %}{% if node.depth < 3 %}<option value="{{ node.id }}">{% for level in 2..node.depth %}{% if node.depth > 1 %}— {% endif %}{% endfor %}{{ node.node_type == 'section' ? node.section_title : (node.display_title_override ?: node.item_title) }}</option>{% endif %}{% endfor %}</select>{% endblock %}{% endembed %}{% endif %}{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Add to course', variant: 'primary', type: 'submit'}) }}{% endblock %}{% endembed %}</form>{% endblock %}{% endembed %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'add-section'})} %}{% block surface_body %}{{ ui('layout.section-head', {heading: 'Add section', heading_level: 3}) }}<form action="/admin/courses/{{ course.id }}/content/sections" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Section title',for:'new-section-title',required:true})} %}{% block control %}<input class="form-control" id="new-section-title" name="title" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Optional introduction',for:'new-section-intro'})} %}{% block control %}<textarea class="form-control" id="new-section-intro" name="introduction_html" {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}{% if placing %}{% include '@platform/partials/admin/course-insert-position.html.twig' with {structure: course.structure, parent: insert.parent ?: '', index: insert.index} %}{% else %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Parent Course Item or section',for:'new-section-parent'})} %}{% block control %}<select class="form-select" id="new-section-parent" name="parent_node_id" {{ ui_field_attrs(props) }}><option value="">Outer level</option>{% for node in course.structure %}{% if node.depth < 3 %}<option value="{{ node.id }}">{% for level in 2..node.depth %}{% if node.depth > 1 %}— {% endif %}{% endfor %}{{ node.node_type == 'section' ? node.section_title : (node.display_title_override ?: node.item_title) }}</option>{% endif %}{% endfor %}</select>{% endblock %}{% endembed %}{% endif %}{% embed ui_template('form.choice') with {props:ui_props('form.choice',{label:'Show section outline'})} %}{% block control %}<input type="checkbox" name="show_outline" value="1">{% endblock %}{% endembed %}<div class="mt-3">{% include '@platform/partials/course-availability-fields.html.twig' with {delay_total:0,delay_prefix:'new-section'} %}</div>{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save new section', variant: 'primary', type: 'submit'}) }}{% endblock %}{% endembed %}</form>{% endblock %}{% endembed %}
{% endblock %}{% endembed %}</div>
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
{{ ui('layout.section-head', {heading: 'Course Content', summary: 'Availability is relative to the preceding sibling; a scheduled section controls all descendants. Every move is saved at once.'}) }}
<div class="cl-course-tree-wrap" data-controller="course-content" data-course-content-course-value="{{ course.id }}" data-action="dragstart->course-content#start dragover->course-content#over dragleave->course-content#leave drop->course-content#drop dragend->course-content#end submit->course-content#menu">
<div class="cl-course-tree-tools" data-course-content-target="enhanced" hidden>
<p class="cl-course-tree-help" id="course-tree-keys">Drag a row by its handle. On a focused handle, ↑ and ↓ move the row, Home and End move it to the top or bottom, ← moves it out of its section and → moves it into the row above. Dragging a selected row moves every selected row.</p>
{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}{% block body %}{{ ui('action.button', {label: 'Expand all', variant: 'secondary', size: 'small', type: 'button', stimulus_action: 'course-content#expandAll', icon: 'action-chevron'}) }}{{ ui('action.button', {label: 'Collapse all', variant: 'secondary', size: 'small', type: 'button', stimulus_action: 'course-content#collapseAll', icon: 'action-chevron'}) }}{% endblock %}{% endembed %}
</div>
<p class="cl-course-tree-status" role="status" aria-live="polite" data-course-content-target="status"></p>
<p class="cl-course-tree-error" role="alert" data-course-content-target="error" hidden></p>
<form id="move-selection" class="cl-course-tree-bulk" action="/admin/courses/{{ course.id }}/content/move-selection" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><span class="cl-course-tree-bulk-label">Move selected</span>{% for move in [{direction: 'top', label: 'To top'}, {direction: 'up', label: 'Up'}, {direction: 'down', label: 'Down'}, {direction: 'bottom', label: 'To bottom'}, {direction: 'out', label: 'Out of section'}, {direction: 'into', label: 'Into section…'}] %}{{ ui('action.button', {label: move.label, aria_label: 'Move selected rows ' ~ move.label|lower, type: 'submit', size: 'small', name: 'direction', value: move.direction}) }}{% endfor %}</form>
{% include '@platform/partials/admin/course-content-tree.html.twig' %}
</div>
{% endblock %}{% endembed %}
</section>
{% endblock %}
