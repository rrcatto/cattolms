{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin/courses/' ~ course.id %}{% set ph_back_label = 'Course administration' %}{% set ph_kicker = 'Structure, presentation and availability' %}{% set ph_title = course.title ~ ' · Course Content' %}{% set ph_lead = 'Course Items are reusable. These rows contain only this course’s structure, display overrides, public preview setting, assessment role and relative availability.' %}{% set ph_action_href = arrangement_pending ? '' : '/admin/course-items/new?course_id=' ~ course.id %}{% set ph_action_label = 'Create and add Course Item' %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% embed ui_template('action.group') with {props:ui_props('action.group',{})} %}{% block body %}{{ ui('action.link',{label:'Preview as learner',href:'/admin/courses/' ~ course.id ~ '/preview'}) }}{{ ui('action.link',{label:'Preview public course',href:'/courses/' ~ course.slug ~ '/preview?preview=1'}) }}{% endblock %}{% endembed %}
{% set validation = course.publication_validation %}
{% if validation.errors %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger', heading: 'Publication errors', section_spacing: true})} %}{% block body %}<ul>{% for error in validation.errors %}<li>{{ error }}</li>{% endfor %}</ul>{% endblock %}{% endembed %}{% endif %}
{% if validation.warnings %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Publication warnings', section_spacing: true})} %}{% block body %}<ul>{% for warning in validation.warnings %}<li>{{ warning }}</li>{% endfor %}</ul><p>ADMIN may explicitly override warnings when publishing.</p>{% endblock %}{% endembed %}{% endif %}
{% if arrangement_pending %}
{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Unsaved arrangement', section_spacing: true})} %}{% block body %}<p>Moves shown below are a preview. Learners still see the saved course. Save the arrangement or cancel it before editing placement settings or adding content.</p>{% endblock %}{% endembed %}
{% else %}<p>Move controls preview changes. Nothing is reordered until you choose Save arrangement; Cancel changes restores the saved order.</p>{% endif %}
{% embed ui_template('action.group') with {props:ui_props('action.group',{})} %}{% block body %}<form action="/admin/courses/{{ course.id }}/content/save-arrangement" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button',{label:'Save arrangement',variant:'primary',type:'submit',disabled:not arrangement_pending}) }}</form><form action="/admin/courses/{{ course.id }}/content/cancel-arrangement" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button',{label:'Cancel changes',type:'submit',disabled:not arrangement_pending}) }}</form>{% endblock %}{% endembed %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
{{ ui('layout.section-head', {heading: 'Course Content', summary: 'Availability is relative to the preceding sibling; a scheduled section controls all descendants.'}) }}
<form id="move-selection" action="/admin/courses/{{ course.id }}/content/move-selection" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{% for direction in ['up','down','indent','unindent'] %}{{ ui('action.button',{label:'Move selected ' ~ direction,type:'submit',name:'direction',value:direction}) }}{% endfor %}</form>
{% if course.structure %}{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}{% block body %}
{% for node in course.structure %}{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}{% block body %}<div class="cl-course-depth-{{ node.depth }}">{% embed ui_template('form.choice') with {props:ui_props('form.choice',{label:'Select row'})} %}{% block control %}<input type="checkbox" name="node_ids[]" value="{{ node.id }}" form="move-selection">{% endblock %}{% endembed %}<strong>{{ node.node_type == 'section' ? node.section_title : (node.display_title_override ?: node.item_title) }}</strong><div>{{ node.node_type|title }}{% if node.item_key %} · <code>{{ node.item_key }}</code> · {{ node.item_type|replace({'_':' '}) }}{% endif %}{% if node.public_preview %} · Public preview{% endif %}{% if node.assessment_role and node.assessment_role != 'content' %} · {{ node.assessment_role|title }}{% endif %}{% if node.delay_label != '00 weeks 00 days 00 hours 00 minutes' %} · after {{ node.delay_label }}{% endif %}</div></div>{% endblock %}{% block actions %}
<form action="/admin/courses/{{ course.id }}/content/{{ node.id }}/move" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{% for direction in ['up','down','indent','unindent'] %}{{ ui('action.button', {label: direction|title, type: 'submit', size: 'small', name: 'direction', value: direction, disabled: not attribute(node,'can_' ~ direction)}) }}{% endfor %}</form>
{% if not arrangement_pending and node.node_type == 'section' %}<details><summary>Edit section</summary><form action="/admin/courses/{{ course.id }}/content/{{ node.id }}/section" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">
{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Section title',for:'section-title-' ~ node.id,required:true})} %}{% block control %}<input id="{{ props.for }}" name="title" value="{{ node.section_title }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Introduction',for:'section-intro-' ~ node.id})} %}{% block control %}<textarea id="{{ props.for }}" name="introduction_html" {{ ui_field_attrs(props) }}>{{ node.section_introduction_html }}</textarea>{% endblock %}{% endembed %}
{% embed ui_template('form.choice') with {props:ui_props('form.choice',{label:'Show section outline'})} %}{% block control %}<input type="checkbox" name="show_outline" value="1" {{ node.show_outline ? 'checked' : '' }}>{% endblock %}{% endembed %}
{% include '@platform/partials/course-availability-fields.html.twig' with {delay_total:node.relative_delay_minutes,delay_prefix:'section-' ~ node.id} %}
{{ ui('action.button',{label:'Save section',type:'submit'}) }}{{ ui('action.link',{label:'Cancel',href:'/admin/courses/' ~ course.id ~ '/content'}) }}</form></details>{% endif %}
{% if not arrangement_pending and node.node_type == 'item' %}{{ ui('action.link', {label: 'Edit shared item', icon: 'action-edit', href: '/admin/course-items/' ~ node.course_item_id, size: 'small'}) }}<details><summary>Placement settings</summary><form action="/admin/courses/{{ course.id }}/content/{{ node.id }}/placement" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{% for field in [{name:'display_title_override',label:'Display title override'},{name:'display_description_override',label:'Display description override'}] %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:field.label,for:field.name ~ '-' ~ node.id})} %}{% block control %}<input id="{{ props.for }}" name="{{ field.name }}" value="{{ attribute(node,field.name) }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}{% endfor %}
{% embed ui_template('form.choice') with {props:ui_props('form.choice',{label:'Public preview'})} %}{% block control %}<input type="checkbox" name="public_preview" value="1" {{ node.public_preview ? 'checked' : '' }}>{% endblock %}{% endembed %}{% if node.item_type == 'assessment' %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Assessment role',for:'assessment-role-' ~ node.id})} %}{% block control %}<select id="{{ props.for }}" name="assessment_role" {{ ui_field_attrs(props) }}><option value="content" {{ node.assessment_role == 'content' ? 'selected' : '' }}>Practice/content</option><option value="graded" {{ node.assessment_role == 'graded' ? 'selected' : '' }}>Graded</option><option value="final" {{ node.assessment_role == 'final' ? 'selected' : '' }}>Final</option></select>{% endblock %}{% endembed %}{% endif %}{% include '@platform/partials/course-availability-fields.html.twig' with {delay_total:node.relative_delay_minutes,delay_prefix:'placement-' ~ node.id} %}{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save placement', type: 'submit', size: 'small'}) }}{% endblock %}{% block secondary_actions %}{{ ui('action.link',{label:'Cancel',href:'/admin/courses/' ~ course.id ~ '/content'}) }}{% endblock %}{% endembed %}</form></details><form action="/admin/courses/{{ course.id }}/content/{{ node.id }}/remove" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: 'Remove from course', variant: 'danger', type: 'submit', size: 'small', disabled: node.has_children, confirm: 'Remove this placement? The shared Course Item will remain.'}) }}</form>{% endif %}
{% endblock %}{% endembed %}{% endfor %}
{% endblock %}{% endembed %}{% else %}{{ ui('feedback.empty', {heading: 'No Course Content yet', summary: 'Create a Course Item, add an existing one, or add a section.'}) }}{% endif %}
{% endblock %}{% endembed %}
{% if not arrangement_pending %}{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {})} %}{% block body %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}{{ ui('layout.section-head', {heading: 'Add existing Course Item', heading_level: 3}) }}<form action="/admin/courses/{{ course.id }}/content" method="get">{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Find an existing item by title or key',for:'existing-item-search'})} %}{% block control %}<input class="form-control" id="existing-item-search" name="q" value="{{ item_search }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}{{ ui('action.button',{label:'Search items',type:'submit'}) }}</form><form action="/admin/courses/{{ course.id }}/content/placements" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Existing Course Item',for:'existing-course-item',required:true})} %}{% block control %}<select class="form-select" id="existing-course-item" name="course_item_id" required {{ ui_field_attrs(props) }}><option value="">Choose a Course Item</option>{% for item in library_items %}<option value="{{ item.id }}">{{ item.title }} · {{ item.item_key }}</option>{% endfor %}</select>{% endblock %}{% endembed %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Parent Course Item or section',for:'existing-parent'})} %}{% block control %}<select class="form-select" id="existing-parent" name="parent_node_id" {{ ui_field_attrs(props) }}><option value="">Outer level</option>{% for node in course.structure %}{% if node.depth < 3 %}<option value="{{ node.id }}">{% if node.depth > 1 %}— {% endif %}{{ node.node_type == 'section' ? node.section_title : (node.display_title_override ?: node.item_title) }}</option>{% endif %}{% endfor %}</select>{% endblock %}{% endembed %}{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save placement', variant: 'primary', type: 'submit'}) }}{% endblock %}{% endembed %}</form>{% endblock %}{% endembed %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}{{ ui('layout.section-head', {heading: 'Add section', heading_level: 3}) }}<form action="/admin/courses/{{ course.id }}/content/sections" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Section title',for:'new-section-title',required:true})} %}{% block control %}<input class="form-control" id="new-section-title" name="title" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Optional introduction',for:'new-section-intro'})} %}{% block control %}<textarea class="form-control" id="new-section-intro" name="introduction_html" {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Parent Course Item or section',for:'new-section-parent'})} %}{% block control %}<select class="form-select" id="new-section-parent" name="parent_node_id" {{ ui_field_attrs(props) }}><option value="">Outer level</option>{% for node in course.structure %}{% if node.depth < 3 %}<option value="{{ node.id }}">{{ node.node_type == 'section' ? node.section_title : (node.display_title_override ?: node.item_title) }}</option>{% endif %}{% endfor %}</select>{% endblock %}{% endembed %}{% embed ui_template('form.choice') with {props:ui_props('form.choice',{label:'Show section outline'})} %}{% block control %}<input type="checkbox" name="show_outline" value="1">{% endblock %}{% endembed %}{% include '@platform/partials/course-availability-fields.html.twig' with {delay_total:0,delay_prefix:'new-section'} %}{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save new section', variant: 'primary', type: 'submit'}) }}{% endblock %}{% endembed %}</form>{% endblock %}{% endembed %}
{% endblock %}{% endembed %}{% endif %}
</section>
{% endblock %}
