{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/activity' %}
	{% set ph_back_label = 'Activity Centre' %}
	{% set ph_kicker = 'Platform administration' %}
	{% set ph_title = 'Activity event' %}
	{% set ph_lead = 'One recorded event, in full.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="container-fluid cl-container-wide py-5">
		<div class="card mt-4">
			<div class="card-header bg-white p-4">
				<div class="d-flex flex-column flex-md-row justify-content-between gap-3">
					<div>
						<span class="cl-kicker">{{ event.family_label }}</span>
						<h2 class="h3 mt-2 mb-1">
							{{ event.event_label }}
						</h2>
						<p class="text-body-secondary mb-0">
							Event #{{ event.id }} · {{ event.created_at }} · {{ event.source_label }}
						</p>
					</div>
					{% if event.result and event.result != '—' %}
						<span class="badge text-bg-light align-self-start">{{ event.result }}</span>
					{% endif %}
				</div>
			</div>
			<div class="card-body p-4">
				<div class="row g-4 mb-4">
					<div class="col-md-4">
						<strong>Actor</strong>
						<div>
							{{ event.actor_name }}
						</div>
					</div>
					<div class="col-md-4">
						<strong>Company</strong>
						<div>
							{{ event.company_name ?: '—' }}
						</div>
					</div>
					<div class="col-md-4">
						<strong>Subject</strong>
						<div>
							{{ event.subject }}
						</div>
					</div>
					<div class="col-md-4">
						<strong>IP address</strong>
						<div>
							{{ event.ip_address ?: '—' }}
						</div>
					</div>
					<div class="col-md-8">
						<strong>GeoIP location</strong>
						<div>
							{{ event.geo_location }}
						</div>
					</div>
				</div>
				{% if event.related_links %}
					<div class="d-flex flex-wrap gap-2 mb-4">
						{% for link in event.related_links %}
							<a class="btn btn-outline-primary btn-sm" href="{{ link.url }}">{{ link.label }}</a>
						{% endfor %}
					</div>
				{% endif %}
				<h2 class="h5">
					Structured metadata
				</h2>
				<pre class="p-3 bg-body-tertiary border rounded mb-0 cl-wrap-anywhere">{{ event.metadata_text }}</pre>
			</div>
		</div>
	</section>
{% endblock %}
