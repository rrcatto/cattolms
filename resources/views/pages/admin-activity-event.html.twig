{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/activity' %}
	{% set ph_back_label = 'Activity Centre' %}
	{% set ph_kicker = 'Platform administration' %}
	{% set ph_title = 'Activity event' %}
	{% set ph_lead = 'One recorded event, in full.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="container-fluid cl-container-wide py-5">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

			{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: (event.event_label), heading_level: 2, summary: 'Event #' ~ (event.id) ~ ' · ' ~ (event.created_at) ~ ' · ' ~ (event.source_label)})} %}
{% block section_actions %}
<div class="d-flex flex-column flex-md-row justify-content-between gap-3">
					<div>
						<span class="cl-kicker">{{ event.family_label }}</span>

					</div>
					{% if event.result and event.result != '—' %}
						{{ ui('feedback.badge', {label: (event.result), tone: 'neutral'}) }}
					{% endif %}
				</div>
{% endblock %}
{% endembed %}

				<div class="row g-4 mb-4">
					<div class="col-md-4">
						<strong>Actor</strong>
						<div>
							{{ event.actor_name }}
						</div>
					</div>
					<div class="col-md-4">
						<strong>Company</strong>
						<div>
							{{ event.company_name ?: '—' }}
						</div>
					</div>
					<div class="col-md-4">
						<strong>Subject</strong>
						<div>
							{{ event.subject }}
						</div>
					</div>
					<div class="col-md-4">
						<strong>IP address</strong>
						<div>
							{{ event.ip_address ?: '—' }}
						</div>
					</div>
					<div class="col-md-8">
						<strong>GeoIP location</strong>
						<div>
							{{ event.geo_location }}
						</div>
					</div>
				</div>
				{% if event.related_links %}
					{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

						{% for link in event.related_links %}
							{{ ui('action.link', {label: (link.label), variant: 'secondary', size: 'small', href: (link.url)}) }}
						{% endfor %}

{% endblock %}
{% endembed %}
				{% endif %}
				<h2 class="h5">
					Structured metadata
				</h2>
				<pre class="p-3 bg-body-tertiary border rounded mb-0 cl-wrap-anywhere">{{ event.metadata_text }}</pre>

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
