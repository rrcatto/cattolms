{# One Commerce Trail event in full (MoneyRecords::trailEvent): what was recorded, by whom, about which order. #}
{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/commerce/trail' %}{% set ph_back_label = 'Commerce Trail' %}
	{% set ph_kicker = 'Commerce Trail' %}{% set ph_title = 'Trail event ' ~ event.id %}
	{% set ph_lead = event.event_label ~ ' · ' ~ event.when %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Event', summary: 'As it was recorded. Nothing in the trail can be changed or deleted.'}) }}
		{{ ui('data.key-value-list', {items: [
			{label: 'Event', value: event.event_label ~ ' (' ~ event.event ~ ')'},
			{label: 'When', value: event.when},
			{label: 'Order', value: event.order_label ?: '—'},
			{label: 'By', value: event.actor_label ~ (event.actor_email ? ' · ' ~ event.actor_email : '')},
		]}) }}
		{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}{% block body %}
			{% if event.order_href %}{{ ui('action.link', {label: 'Open the order', variant: 'secondary', size: 'small', href: event.order_href}) }}{{ ui('action.link', {label: 'Ledger rows of this order', variant: 'secondary', size: 'small', href: event.order_ledger_href}) }}{{ ui('action.link', {label: 'Trail of this order', variant: 'secondary', size: 'small', href: event.order_trail_href}) }}{% endif %}
		{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}</section>
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Details', summary: 'Everything recorded with the event.'}) }}
		{% if event.lines %}{{ ui('data.key-value-list', {items: event.lines}) }}{% else %}{{ ui('feedback.empty', {summary: 'Nothing else was recorded.'}) }}{% endif %}
	{% endblock %}{% endembed %}</section>
{% endblock %}
