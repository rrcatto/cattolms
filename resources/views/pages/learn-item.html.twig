{% extends '@platform/layout/course-item.html.twig' %}
{% block course_item_body %}
<h1>{{ item.node_type == 'section' ? (item.section_number|default(null) is not null ? 'Module ' ~ item.section_number ~ ': ' : '') ~ item.section_title : (item.display_title_override ?: item.item_title) }}</h1>
{# A module's lesson, summary, flash cards and practical work download as PDFs (owner, 2026-10-28, decision 6A). #}
{% if item.node_type == 'item' and item.part|default('') in ['lesson', 'summary', 'review', 'flashcards', 'practical'] %}<p class="cl-course-item-pdf">{{ ui('action.link', {label: 'Download as PDF', variant: 'secondary', size: 'small', href: '/learn/' ~ course.slug ~ '/item/' ~ item.id ~ '/pdf' ~ preview_query, icon: 'action-download'}) }}</p>{% endif %}
<div class="cl-course-item-body cl-course-presentation catto-standalone">{{ item.rendered_html|raw }}</div>
{% include '@platform/partials/course-section-outline.html.twig' %}
<nav class="cl-course-item-paging" aria-label="Course Content">
{% if item.previous_node %}{% set previous_is_assessment = item.previous_node.item_type|default('') in ['assessment', 'diagnostic'] %}{{ ui('action.link', {label: 'Previous', variant: 'primary', size: 'normal', href: '/learn/' ~ course.slug ~ '/item/' ~ item.previous_node.id ~ (previous_is_assessment ? '/assessment/' ~ item.previous_node.item_key : '/content') ~ preview_query, icon: 'action-previous'}) }}{% endif %}
{% if item.next_node %}{% set next_is_assessment = item.next_node.item_type|default('') in ['assessment', 'diagnostic'] %}{{ ui('action.link', {label: 'Next', variant: 'primary', size: 'normal', href: '/learn/' ~ course.slug ~ '/item/' ~ item.next_node.id ~ (next_is_assessment ? '/assessment/' ~ item.next_node.item_key : '/content') ~ preview_query, icon: 'action-next'}) }}{% endif %}
</nav>
{% endblock %}
