{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Company' %}
	{% set ph_title = company_section.label %}
	{% set ph_lead = company_section.description %}
	{# The section's own actions belong to the page here, so they sit in the page head. #}
	{% set ph_actions %}{% include '@platform/partials/section-actions.html.twig' with {actions: company_section.actions|default([])} %}{% endset %}
	{% include '@platform/partials/page-head.html.twig' %}
	{# The company banner is a row of its own, above the section it applies to. #}
	<section class="cl-page-section" aria-label="Company">
		{% include '@platform/partials/company-context.html.twig' %}
	</section>
	<section class="cl-page-section" data-company-section="{{ company_section.key }}">
{#
		The body is wrapped so the consolidated workspace can pull exactly this part of the page
		into an accordion section when the reader opens it, without also pulling the heading and
		the company banner it already shows.
	#}
		<div class="cl-section-body">
			{{ company_section.content|raw }}
		</div>
	</section>
{% endblock %}
