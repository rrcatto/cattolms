{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses' %}
	{% set ph_back_label = 'Course administration' %}
	{% set ph_kicker = 'Course editor' %}
	{% set ph_title = form_heading %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="container py-5 cl-medium">
		<form action="{{ form_action }}" method="post">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

			<input type="hidden" name="csrf" value="{{ csrf }}">

				{% include '@platform/partials/admin-course-fields.html.twig' %}
				{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

					{{ ui('action.button', {label: 'Create course', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-add'}) }}{{ ui('action.link', {label: 'Cancel', variant: 'secondary', size: 'normal', href: '/admin/courses'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
	</section>
