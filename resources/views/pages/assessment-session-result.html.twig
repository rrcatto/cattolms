{% extends '@platform/layout/course-item.html.twig' %}
{% block course_item_body %}
	<span class="cl-kicker">{{ session.is_diagnostic ? 'Diagnostic result' : 'Assessment result' }}</span>
	<h1>{{ session.assessment_title }}</h1>
	<p>Attempt {{ session.attempt_number }} · {{ session.is_diagnostic ? 'Diagnostic' : session.attempt_mode|ucfirst }}</p>
	{# A certificate proves that the learner took the course (owner, 2026-10-19): earned by completing every
	   assessment, pass or fail, and issued only to a verified account. #}
	{% if not is_preview|default(false) and course.certificate_waiting|default(false) %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', heading: course.certificate_waiting_message})} %}{% block body %}{{ ui('action.link', {label: 'Verify my identity', variant: 'primary', size: 'small', href: '/account/verification?return=' ~ ('/learn/' ~ course.slug)|url_encode}) }}{% endblock %}{% endembed %}
	{% elseif not is_preview|default(false) and course.certificate|default(null) and session.assessment_role|default('') == 'final' %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'success', heading: 'You have completed every assessment. Your certificate and transcript are ready.'})} %}{% block body %}{{ ui('action.link', {label: 'View certificate', variant: 'primary', size: 'small', href: '/certificates/' ~ course.certificate.public_id}) }}{% if course.certificate.transcript_public_id|default(null) %} {{ ui('action.link', {label: 'View transcript', variant: 'secondary', size: 'small', href: '/transcripts/' ~ course.certificate.transcript_public_id}) }}{% endif %} {{ ui('action.link', {label: 'Who can see them', variant: 'quiet', size: 'small', href: '/account/certificates#certificate-' ~ course.certificate.id}) }}{% endblock %}{% endembed %}
	{% endif %}
		<div class="row g-7">
			<div class="lg:col-8">
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

						<div class="cl-result-score">
							<strong>{{ session.percentage }}%</strong><span>{{ session.is_diagnostic ? (session.diagnostic_passed ? 'Ready' : 'Review') : session.grade_code }}</span>
						</div>
						<p class="cl-lead mb-1">
							{{ session.earned_points }} of {{ session.maximum_points }} points.
						</p>
						<p class="cl-text-muted mb-7">
							<strong>Total time:</strong> {{ session.elapsed_label }}
						</p>
						{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {})} %}
{% block body %}

								{{ ui('data.stat-card', {label: 'Correct', value: (session.counts.correct)}) }}

								{{ ui('data.stat-card', {label: 'Incorrect', value: (session.counts.incorrect)}) }}

								{{ ui('data.stat-card', {label: 'Skipped', value: (session.counts.skipped)}) }}

								{{ ui('data.stat-card', {label: 'Unanswered', value: (session.counts.unanswered)}) }}

{% endblock %}
{% endembed %}
						{% if session.is_diagnostic %}
							{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: session.diagnostic_passed ? 'success' : 'warning'})} %}
{% block body %}

								{{ session.diagnostic_message_html|raw }}
								<p>This diagnostic does not affect your course grade, progress or certificate.</p>

{% endblock %}
{% endembed %}
							{% if session.diagnostic_remediation_items %}
								<div class="mt-7">
									<h2 class="h5">
										Suggested Course Items to review
									</h2>
									{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

										{% for item in session.diagnostic_remediation_items %}
											{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}
{% if item.node_id %}<a href="/learn/{{ session.slug }}/item/{{ item.node_id }}/content{{ is_preview ? '?preview=1' : '' }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
{% endblock %}
{% endembed %}
										{% endfor %}

{% endblock %}
{% endembed %}
								</div>
							{% endif %}
						{% else %}
							{% if session.attempt_mode == 'practice' %}
								{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

									Practice results do not affect your course grade.

{% endblock %}
{% endembed %}
							{% endif %}
						{% endif %}

{% endblock %}
{% endembed %}
				<h2 class="h3">
					Question report
				</h2>
				<div class="vstack gap-5">
					{% for response in session.responses %}
						{% set response_number = loop.index %}
						{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

								<div class="d-flex flex-wrap justify-content-between gap-3">
									<strong>Question {{ response_number }}</strong>{{ ui('feedback.badge', {label: (response.response_status|ucfirst), tone: response.is_correct ? 'success' : (response.response_status == 'answered' ? 'danger' : 'neutral')}) }}
								</div>
								<div class="mt-5">
									{{ response.question_html|raw }}
								</div>
								{{ ui('data.key-value-list', {items: [{label: 'Your answer', value: response.selected_option_html ?: 'No answer'}, {label: 'Correct answer', value: response.correct_option_html}, {label: 'Points', value: response.points_awarded ~ ' / ' ~ response.points}, {label: 'Response time', value: response.has_response_seconds ? response.response_seconds ~ ' seconds' : 'Not answered'}]}) }}
								{% if response.explanation_html %}
									{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: true})} %}
{% block body %}

										{{ response.explanation_html|raw }}

{% endblock %}
{% endembed %}
								{% endif %}

{% endblock %}
{% endembed %}
					{% endfor %}
				</div>
			</div>
			<aside class="lg:col-4">
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {sticky: true})} %}
{% block surface_body %}

						{{ ui('action.link', {label: (session.is_diagnostic ? 'Take diagnostic again' : 'Assessment options'), variant: 'primary', size: 'normal', full_width: true, href: (retake_url)}) }}{{ ui('action.link', {label: 'Course overview', variant: 'secondary', size: 'normal', full_width: true, href: (course_url)}) }}

{% endblock %}
{% endembed %}
			</aside>
		</div>
{% endblock %}
