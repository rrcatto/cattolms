{% extends '@platform/layout/course-item.html.twig' %}
{% block course_item_body %}
	<span class="cl-kicker">{{ session.is_diagnostic ? 'Diagnostic result' : 'Assessment result' }}</span>
	<h1>{{ session.assessment_title }}</h1>
	<p>Attempt {{ session.attempt_number }} · {{ session.is_diagnostic ? 'Diagnostic' : session.attempt_mode|ucfirst }}</p>
	{# A certificate proves that the learner took the course (owner, 2026-10-19): earned by completing every
	   assessment, pass or fail, and issued only to a verified account. #}
	{% if not is_preview|default(false) and course.certificate_waiting|default(false) %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', heading: course.certificate_waiting_message})} %}{% block body %}{{ ui('action.link', {label: 'Verify my identity', variant: 'primary', size: 'small', href: '/account/verification?return=' ~ ('/learn/' ~ course.slug)|url_encode, icon: 'action-verify'}) }}{% endblock %}{% endembed %}
	{% elseif not is_preview|default(false) and course.certificate|default(null) and session.assessment_role|default('') == 'final' %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'success', heading: 'You have completed every assessment. Your certificate and transcript are ready.'})} %}{% block body %}{{ ui('action.link', {label: 'View certificate', variant: 'primary', size: 'small', href: '/certificates/' ~ course.certificate.public_id, icon: 'action-view'}) }}{% if course.certificate.transcript_public_id|default(null) %} {{ ui('action.link', {label: 'View transcript', variant: 'secondary', size: 'small', href: '/transcripts/' ~ course.certificate.transcript_public_id, icon: 'action-view'}) }}{% endif %} {{ ui('action.link', {label: 'Who can see them', variant: 'quiet', size: 'small', href: '/account/certificates#' ~ certificate_anchor(course.certificate), icon: 'action-share'}) }}{% endblock %}{% endembed %}
	{% endif %}
		{# The score, and after the final assessment the course's result beside it (owner-approved mockup, 2026-11-05). #}
		{% set course_result = session.course_result|default(null) %}
		{% set this_assessment %}
			<div class="cl-result-score">
				<strong>{{ session.percentage + 0 }}%</strong><span>{{ session.is_diagnostic ? (session.diagnostic_passed ? 'Ready' : 'Review') : 'Grade ' ~ session.grade_code }}</span>
			</div>
			<p class="cl-lead mb-1">
				{{ session.earned_points + 0 }} of {{ session.maximum_points + 0 }} points.
			</p>
			<p class="cl-text-muted mb-0">
				<strong>Total time:</strong> {{ session.elapsed_label }}
			</p>
		{% endset %}
		{% if course_result %}
			{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: true})} %}
{% block body %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

					<h2 class="h5">This assessment</h2>
					{{ this_assessment }}

{% endblock %}
{% endembed %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

					<div data-course-result>
					<h2 class="h5">Your course result</h2>
					<div class="cl-result-score">
						<strong>{{ course_result.overall_percentage + 0 }}%</strong><span>Grade {{ course_result.grade_code }}</span>
					</div>
					<p class="mb-0">Half comes from your module assessments ({{ (course_result.module_percentage + 0)|round(2) }}%) and half from your final assessment ({{ (course_result.final_percentage + 0)|round(2) }}%).</p>
					</div>

{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
		{% else %}
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

				{{ this_assessment }}

{% endblock %}
{% endembed %}
		{% endif %}
		{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {columns: 4})} %}
{% block body %}

				{{ ui('data.stat-card', {label: 'Correct', value: (session.counts.correct)}) }}

				{{ ui('data.stat-card', {label: 'Incorrect', value: (session.counts.incorrect)}) }}

				{{ ui('data.stat-card', {label: 'Skipped', value: (session.counts.skipped)}) }}

				{{ ui('data.stat-card', {label: 'Unanswered', value: (session.counts.unanswered)}) }}

{% endblock %}
{% endembed %}
		{% if session.is_diagnostic %}
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: session.diagnostic_passed ? 'success' : 'warning', section_spacing: true})} %}
{% block body %}

				{{ session.diagnostic_message_html|raw }}
				<p>This diagnostic does not affect your course grade or certificate.</p>

{% endblock %}
{% endembed %}
			{% if session.diagnostic_remediation_items %}
				<div class="mt-7">
					<h2 class="h5">
						Suggested Course Items to review
					</h2>
					{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

						{% for item in session.diagnostic_remediation_items %}
							{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}
{% if item.part_name|default('') %}<a href="{{ is_public_preview|default(false) ? preview_part_url(course, item) : part_url(course, item) }}{{ item_query|default(is_preview ? '?preview=1' : '') }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
{% endblock %}
{% endembed %}
						{% endfor %}

{% endblock %}
{% endembed %}
				</div>
			{% endif %}
		{% elseif session.attempt_mode == 'practice' %}
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: true})} %}
{% block body %}

				Practice results do not affect your course grade.

{% endblock %}
{% endembed %}
		{% endif %}
				{# The moment the learner has finished the course is when they are asked for a review, here on the page (decision 8A). #}
				{% if review_prompt|default(null) %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
					<div id="review">
					{{ ui('layout.section-head', {heading: 'How did you find the course?', heading_level: 2, summary: 'Your review helps other learners choose. It is published under your first name and the initial of your surname once it has been checked.'}) }}
					<form action="/learn/{{ course.slug }}/review" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return" value="{{ review_prompt.return }}">
					{% include '@platform/partials/course-rating-input.html.twig' with {rating_value: 0} %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Your review', for: 'review-comment', full_width: true, help: 'Optional. Up to ' ~ review_prompt.max_comment ~ ' characters.'})} %}{% block control %}<textarea class="cl-input" id="review-comment" name="comment" rows="4" maxlength="{{ review_prompt.max_comment }}" {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}
					{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Submit review', variant: 'primary', type: 'submit', icon: 'action-send'}) }}{% endblock %}{% endembed %}
					</form>
					</div>
					{% endblock %}{% endembed %}
				{% endif %}
				<h2 class="h3">
					Question report
				</h2>
				<div class="vstack gap-5">
					{% for response in session.responses %}
						{% set response_number = loop.index %}
						{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

								<div class="d-flex flex-wrap justify-content-between gap-3">
									<strong>Question {{ response_number }}</strong>{{ ui('feedback.badge', {label: (response.response_status|ucfirst), tone: response.is_correct ? 'success' : (response.response_status == 'answered' ? 'danger' : 'neutral')}) }}
								</div>
								<div class="mt-5">
									{{ response.question_html|raw }}
								</div>
								{{ ui('data.key-value-list', {items: [{label: 'Your answer', value: response.selected_option_html ?: 'No answer'}, {label: 'Correct answer', value: response.correct_option_html}, {label: 'Points', value: (response.points_awarded + 0) ~ ' / ' ~ (response.points + 0)}, {label: 'Response time', value: response.has_response_seconds ? response.response_time : 'Not answered'}]}) }}
								{% if response.explanation_html %}
									{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: true})} %}
{% block body %}

										{{ response.explanation_html|raw }}

{% endblock %}
{% endembed %}
								{% endif %}

{% endblock %}
{% endembed %}
					{% endfor %}
				</div>
		{# A result's way on is at the bottom, after the question report (owner, 2026-11-05). After practice, only Assessment
		   options, which leads to the graded assessment (a practice-only assessment has none to lead to, so it goes on too).
		   Otherwise Assessment options and the next part, or back to the course after the last. After the final assessment,
		   the learner's next step for the certificate comes last, with the course overview in the middle (approved mockup). #}
		{% set public_preview = is_public_preview|default(false) %}
		{% set options_only = session.attempt_mode == 'practice' and not session.practice_only|default(false) %}
		{% set overview_link = {href: course_url, label: 'Course overview', icon: 'action-back'} %}
		{% set next_step = null %}
		{% if session.assessment_role|default('') == 'final' and session.attempt_mode == 'graded' and not is_preview|default(false) and not public_preview %}
			{% if course.certificate|default(null) %}
				{% set next_step = {href: '/certificates/' ~ course.certificate.public_id, label: 'View certificate', icon: 'action-view'} %}
			{% elseif course.certificate_waiting|default(false) %}
				{% set next_step = {href: '/account/verification?return=' ~ ('/learn/' ~ course.slug)|url_encode, label: 'Verify my identity', icon: 'action-verify'} %}
			{% endif %}
		{% endif %}
		{% set stop_after = options_only or next_step ? null : session.next_node|default(null) %}
		{% include '@platform/partials/course-item-paging.html.twig' with {
			paging_label: public_preview ? 'Public Course Content' : 'Course Content',
			paging_public: public_preview,
			paging_query: public_preview ? course.public_preview_query|default('') : preview_query,
			paging_previous: null,
			paging_previous_link: options_only ? null : {href: retake_url, label: session.is_diagnostic ? 'Take diagnostic again' : 'Assessment options', icon: session.is_diagnostic ? 'action-refresh' : 'action-back'},
			paging_centre_link: next_step ? overview_link : null,
			paging_next: stop_after,
			paging_next_link: options_only ? {href: retake_url, label: 'Assessment options', icon: 'action-next'} : (next_step ?: (stop_after ? null : overview_link)),
		} %}
{% endblock %}
