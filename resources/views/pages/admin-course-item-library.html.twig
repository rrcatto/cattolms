{% extends layout %}
{% block page_body %}
{% set ph_kicker = 'Administration' %}{% set ph_title = 'Course Item Library' %}{% set ph_lead = 'Edit Course Items, which can be shared by several courses, and see where each is placed. Items without placements remain available under Not currently in use.' %}{% set ph_actions %}{{ ui('action.link', {label: 'Create item', variant: 'primary', href: '/admin/course-items/new', icon: 'action-add'}) }}{% endset %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section">
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
{{ ui('layout.section-head', {heading: 'Find a course item', eyebrow: 'Course Item Library', summary: 'Search by title or key, or show one type.'}) }}
<form method="get">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Search', for: 'course-item-search', help: 'By name, title or key, such as GDN-101 Module 1.'})} %}{% block control %}<input class="cl-input" id="course-item-search" name="q" value="{{ item_library.search }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Type', for: 'course-item-type'})} %}{% block control %}<select class="cl-select" id="course-item-type" name="type" {{ ui_field_attrs(props) }}><option value="">All types</option>{% for type in item_types %}<option value="{{ type }}" {{ item_library.type == type ? 'selected' : '' }}>{{ type|item_type_label }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Filter library', type: 'submit', variant: 'primary', icon: 'action-filter'}) }}{% endblock %}{% block secondary_actions %}{{ ui('action.link', {label: 'Resource Library', href: '/admin/resources', icon: 'action-open'}) }}{% endblock %}{% endembed %}
{% endblock %}{% endembed %}</form>
{% endblock %}{% endembed %}
{% for group in item_library.groups %}
{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {id: 'course-items-' ~ group.course.id, heading: group.course.title, summary: group.items|length ~ ' Course Items', open: false})} %}{% block body %}
{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}{% block body %}{% for item in group.items %}{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}{% block body %}<strong>{{ item.name }}</strong><div>{{ item.title }} · {{ item.item_type|item_type_label }} · <code>{{ item.item_key }}</code></div>{% endblock %}{% block actions %}{{ ui('action.link', {label: 'Edit Course Item', href: '/admin/course-items/' ~ item.id, size: 'small', icon: 'action-edit'}) }}{% endblock %}{% endembed %}{% endfor %}{% endblock %}{% endembed %}
{% endblock %}{% endembed %}
{% endfor %}
{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {id: 'course-items-unused', heading: 'Not currently in use', summary: item_library.unused|length ~ ' Course Items', open: true})} %}{% block body %}
{% if item_library.unused %}{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}{% block body %}{% for item in item_library.unused %}{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}{% block body %}<strong>{{ item.name }}</strong><div>{{ item.title }} · {{ item.item_type|item_type_label }} · <code>{{ item.item_key }}</code></div>{% endblock %}{% block actions %}{{ ui('action.link', {label: 'Edit Course Item', href: '/admin/course-items/' ~ item.id, size: 'small', icon: 'action-edit'}) }}{% endblock %}{% endembed %}{% endfor %}{% endblock %}{% endembed %}{% else %}{{ ui('feedback.empty', {heading: 'Every Course Item is placed', summary: 'There are no unused Course Items.'}) }}{% endif %}
{% endblock %}{% endembed %}
</section>
{% endblock %}
