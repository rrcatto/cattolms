{# The catalogue reads top to bottom: choose a category (optional), then the bundles and the courses, the courses' search
   at the head of their own section, where what it finds shows as it is typed (owner, 2026-11-09). #}
{% extends layout %}
{% block page_body %}
	{% set catalogue_hero %}{% include '@platform/partials/artwork/catalogue-hero.html.twig' %}{% endset %}
	{% include '@CattoPHP/page/head.html.twig' with {ph_hero: catalogue_hero, ph_kicker: 'Course catalogue', ph_title: 'Browse by category', ph_lead: 'Choose a category, search, or both.', ph_action_href: '/courses/tags', ph_action_label: 'Browse by tag', ph_action_icon: 'action-tags'} %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
			<form id="catalogue-category" class="cl-catalogue-category" method="get" action="/courses" data-named-pages="/courses/category/">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Category', for: 'catalogue-category-picker', help: 'Every course in the category you choose and in all its subcategories is shown below.'})} %}
{% block control %}{{ ui('form.tree-select', {id: 'catalogue-category-picker', name: 'category', items: category_picker.items, selected: category_picker.selected, placeholder: 'All categories', list_label: 'Course categories'}) }}{% endblock %}
{% endembed %}
			</form>
{% endblock %}
{% endembed %}
		{{ ui('catalogue.workspace', {workspace: workspace, courses: courses, catalogue_pagination: catalogue_pagination, search: {value: catalogue_search, action: catalogue_pagination.base}}) }}
	</section>
{% endblock %}
