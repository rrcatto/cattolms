{#
Generated by: Claude Code CLI
Date time: 2026/09/06 22:45 SAST
Version: 0.6
Description:
  The public course catalogue, and every category page: the same body, told which branch it is
  showing.

  Browsing a category shows the whole branch beneath it, so the breadcrumb is the way back up and
  the rail of child categories is the way further down. Each child carries the count of what
  choosing it will actually return, because a branch offering twelve courses that turns out to hold
  three is worse than a branch offering no figure at all.

  A category page is a destination people link to, not a filter state, which is why the branch is in
  the path rather than the query string and why the pagination base follows it.

  Comments here are plain prose only: no angle brackets, no comment delimiters, no template tokens
  and no code. Each of those is read as markup rather than as text.

Changelog:
  2026/09/07 01:45 SAST
  - The rails became facets: each option carries the number of courses choosing it would return, tags toggle rather than replace, and each facet's counts are taken with that facet relaxed.
  2026/09/06 22:45 SAST
  - Category breadcrumb, category heading and the narrowing rail of child categories with their branch counts.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Course catalogue' %}
	{% set ph_title = browse_category ? browse_category.name : (browse_tag ? 'Courses tagged '~browse_tag.name : 'Find your next course') %}
	{% set ph_lead = browse_category ? (browse_category.description ?: 'Every course in this part of the catalogue, including the levels beneath it.') : 'Browse published self-study courses and compare their access options.' %}
	{% set ph_action_href = '/courses/tags' %}
	{% set ph_action_label = 'Browse by tag' %}
	{% include '@platform/partials/page-head.html.twig' %}
	{% if browse_trail %}
		<nav class="cl-breadcrumb" aria-label="Category">
			<a href="/courses">All courses</a>
			{% for crumb in browse_trail %}
				<span class="cl-breadcrumb-sep" aria-hidden="true">/</span>
				<a href="/courses/category/{{ crumb.slug }}" {{ crumb.slug == browse_category.slug ? 'aria-current="page"' : '' }}>{{ crumb.name }}</a>
			{% endfor %}
		</nav>
	{% endif %}
	{% if universe_switch %}
		{% include '@platform/partials/universe-switch.html.twig' with {us: universe_switch, ct: universe_counts} %}
	{% endif %}
	{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'catalogue', ds_label: 'Search courses', ds_value: catalogue_search, ds_action: catalogue_pagination.base} %}
{#
	The cloud is the whole taxonomy weighted, and the rail below it is the tags of the branch the
	reader is standing in. They answer different questions - find a subject, and narrow this list -
	so both are shown, and the cloud is capped because the full set is a page of its own.
#}
	{% if tag_cloud %}
		<div class="cl-facet section">
			<div class="cl-facet-head">
				<span class="cl-facet-label">Explore by tag</span>
				<a class="btn btn-soft btn-sm" href="/courses/tags{{ universe_query }}">All tags</a>
			</div>
			{% include '@platform/partials/tag-cloud.html.twig' with {cloud_tags: tag_cloud} %}
		</div>
	{% endif %}
{#
	A tag is offered only where choosing it would return something, or where it is already chosen -
	so the facet has to be built before it is headed. Guarding the heading on browse_tags and the
	chips on their own counts printed a Tags heading above an empty rail whenever every tag in the
	branch held nothing, which is the state a new catalogue starts in.
#}
	{% set rail_tags = browse_tags|filter(rail_tag => rail_tag.course_count > 0 or rail_tag.is_selected) %}
	{% if rail_tags is not empty %}
		<div class="cl-facet section">
			<div class="cl-facet-head">
				<span class="cl-facet-label">Tags</span>
				{% if browse_selected_tags %}
					<a class="btn btn-soft btn-sm" href="{{ browse_clear_href }}">Clear tags</a>
				{% endif %}
			</div>
			<div class="cl-category-rail" aria-label="Narrow by tag">
				{% for rail_tag in rail_tags %}
					<a class="cl-tag-chip {{ rail_tag.is_selected ? 'is-selected' : '' }}" href="{{ rail_tag.href }}"
				   aria-pressed="{{ rail_tag.is_selected ? 'true' : 'false' }}">
					<span>{{ rail_tag.name }}</span>
					<span class="cl-category-count">{{ rail_tag.course_count }}</span>
					</a>
				{% endfor %}
			</div>
		</div>
	{% endif %}
	{#
		Categories are accordions, not a rail of chips.

		A chip rail can only offer one level, so a three-level taxonomy arrived as a flat row that
		said nothing about what contained what. The accordions carry the shape: a category holds the
		courses filed directly in it, and its sub-categories are accordions inside it.

		Only a branch that holds a course is here. An empty category, however many sub-categories it
		has, is still empty - only a course makes one worth opening - and keeping a category because
		its branch is non-empty also keeps every ancestor of every non-empty one.
	#}
	{% if category_tree %}
		<div class="cl-facet section">
			<div class="cl-facet-head">
				<span class="cl-facet-label">Categories</span>
			</div>
			<div class="cl-category-tree">
				{% for node in category_tree %}
					{% include '@platform/partials/category-branch.html.twig' with {node: node, depth: 0, universe_query: universe_query} %}
				{% endfor %}
			</div>
		</div>
	{% endif %}
	<div id="catalogue-region" data-server-search-target>
		<div id="catalogue-results">
			{% if catalogue_pagination %}
				{% include '@platform/partials/pagination.html.twig' with {pg: catalogue_pagination} %}
			{% endif %}
			{% if courses %}
				<div class="grid grid-3 section">
					{% for course in courses %}
						<article class="course-card card" data-course-card>
							<div class="course-cover">
								<span class="course-level">{{ course.category_name ?: 'COURSE' }}</span>
							</div>
							<div class="course-body">
								<div class="cl-row-between">
									<div class="course-title">
										{{ course.title }}
									</div>
									{% if is_authenticated %}
										<form action="/courses/favourite" method="post">
											<input type="hidden" name="csrf" value="{{ csrf }}">
											<input type="hidden" name="course_id" value="{{ course.id }}">
											<input type="hidden" name="return" value="/courses">
											<button class="btn btn-sm btn-ghost favourite" type="submit" title="Favourite">{{ course.is_favourite ? '★' : '☆' }}</button>
										</form>
									{% endif %}
								</div>
								<div class="course-meta">
									{{ course.level ?: 'Self-study' }} · {{ course.module_count }} modules
								</div>
								<p class="muted small">
									{{ course.summary }}
								</p>
								{% if course.tags %}
									<div class="cl-course-tags">
										{% for course_tag in course.tags %}
											<a class="cl-tag-chip" href="/courses/tag/{{ course_tag.slug }}">{{ course_tag.name }}</a>
										{% endfor %}
									</div>
								{% endif %}
								{% if course.has_price %}
									<div class="course-price">
										<strong>{{ course.default_price_label }}</strong><span class="muted small"> · {{ course.default_access_label }}</span>
										{% if course.has_alternative_prices %}
											<span class="badge info">More options</span>
										{% endif %}
									</div>
								{% endif %}
								<div class="course-footer">
									<a class="btn btn-primary btn-sm" href="/courses/{{ course.slug }}">View course</a>
								</div>
							</div>
						</article>
					{% endfor %}
				</div>
			{% else %}
				<div class="empty section">
					<h3>
						No courses are published yet
					</h3>
				</div>
			{% endif %}
			<div class="container">
{# The public catalogue is the only paginated surface using bare page and page size query
       names, because it carries a single principal dataset and those names are public URLs.
       The control itself is the shared one, built by the shared payload builder. #}
				{% include '@platform/partials/pagination.html.twig' with {pg: catalogue_pagination} %}
			</div>
		</div>
	</div>
{% endblock %}
