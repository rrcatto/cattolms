{% endblock %}
{% endembed %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'diagnostics'})} %}
{% block surface_body %}

						<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
							<div>
								<h2 class="h4 mb-1">
									Course diagnostics
