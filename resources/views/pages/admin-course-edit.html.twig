{% block body %}

								<strong>Publication checks:</strong> assessments are optional. Any module or final assessment explicitly marked required must contain questions. The course must also have at least one active access/price option and exactly one active default price; a free course may use a zero price.

{% endblock %}
{% endembed %}
							<form action="/admin/courses/{{ course.id }}/status" method="post">{% embed ui_template('form.compact-action') with {props: ui_props('form.compact-action', {})} %}
