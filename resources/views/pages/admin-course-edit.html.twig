									Readiness and revision checks are non-graded and managed independently from module and final assessments.
								</p>
							</div>
							{{ ui('action.link', {label: 'Add diagnostic', variant: 'secondary', size: 'small', href: '/admin/courses/' ~ (course.id) ~ '/diagnostics/new', icon: 'action-add'}) }}
						</div>
						{% if course.diagnostic_assessments %}
							<div class="vstack gap-3">
								{% for diagnostic_index, diagnostic in course.diagnostic_assessments %}
									<div class="border rounded p-3">
										<div class="d-flex flex-wrap justify-content-between gap-2">
											<div>
												<strong>{{ diagnostic.title }}</strong>
												<div>
													<small>{{ diagnostic.question_count }} questions · threshold {{ diagnostic.pass_mark }}% · key {{ diagnostic.assessment_key }}</small>
												</div>
												<div class="d-flex flex-wrap gap-1 mt-2">
													{{ ui('feedback.badge', {label: (diagnostic.is_visible ? 'Visible' : 'Hidden'), tone: diagnostic.is_visible ? 'success' : 'neutral'}) }}{{ ui('feedback.badge', {label: (diagnostic.maximum_attempts ? diagnostic.maximum_attempts~' attempt'~(diagnostic.maximum_attempts == 1 ? '' : 's') : 'Unlimited attempts'), tone: 'neutral'}) }}{{ ui('feedback.badge', {label: (diagnostic.diagnostic_pass_action == 'complete_course' ? 'Pass completes course' : 'Guidance only'), tone: diagnostic.diagnostic_pass_action == 'complete_course' ? 'warning' : 'neutral'}) }}
												</div>
											</div>
											{% embed ui_template('action.row') with {props: ui_props('action.row', {})} %}
{% block body %}

												{{ ui('action.link', {label: 'Edit', variant: 'secondary', size: 'small', href: '/admin/courses/' ~ (course.id) ~ '/diagnostics/' ~ (diagnostic.id)}) }}
												<form action="/admin/courses/{{ course.id }}/diagnostics/{{ diagnostic.id }}/move" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													<input type="hidden" name="direction" value="up">
													{{ ui('action.button', {label: '↑', variant: 'secondary', size: 'small', type: 'submit', disabled: diagnostic_index == 0}) }}
												</form>
												<form action="/admin/courses/{{ course.id }}/diagnostics/{{ diagnostic.id }}/move" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													<input type="hidden" name="direction" value="down">
													{{ ui('action.button', {label: '↓', variant: 'secondary', size: 'small', type: 'submit', disabled: diagnostic_index + 1 == course.diagnostic_assessments|length}) }}
												</form>
												<form action="/admin/courses/{{ course.id }}/diagnostics/{{ diagnostic.id }}/delete" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													{{ ui('action.button', {label: 'Delete', variant: 'danger', size: 'small', type: 'submit', confirm: 'Delete this diagnostic and all of its questions?', icon: 'action-remove'}) }}
												</form>

{% endblock %}
{% endembed %}
										</div>
									</div>
								{% endfor %}
							</div>
						{% else %}
