{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses' %}
	{% set ph_back_label = 'Course administration' %}
	{% set ph_kicker = course.status %}
	{% set ph_title = course.title %}
	{% set ph_lead = '/'~(course.slug) %}
	{% set ph_action_href = '/admin/courses/'~(course.id)~'/content' %}
	{% set ph_action_label = 'Edit Course Content' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section container-fluid cl-container-wide py-5">
		<nav aria-label="Course administration sections">{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

			{{ ui('action.link', {label: 'Overview', href: '#overview', size: 'small'}) }}
			{% if can_manage_course_ownership %}
				{{ ui('action.link', {label: 'Owner & Editors', href: '#people', size: 'small'}) }}
			{% endif %}
			{% if can_manage_course_pricing %}
				{{ ui('action.link', {label: 'Pricing', href: '#pricing', size: 'small'}) }}
			{% endif %}
			{{ ui('action.link', {label: 'Course Content', href: '#course-content', size: 'small'}) }}{{ ui('action.link', {label: 'Presentation', href: '#presentation', size: 'small'}) }}{{ ui('action.link', {label: 'Grades', href: '#grading', size: 'small'}) }}{{ ui('action.link', {label: 'History', href: '#history', size: 'small'}) }}{{ ui('action.link', {label: 'Reset / delete', href: '#danger', size: 'small'}) }}

{% endblock %}
{% endembed %}</nav>
		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {})} %}
{% block body %}

			<div>
				<form action="/admin/courses/{{ course.id }}" method="post">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'overview'})} %}
{% block surface_body %}

					<input type="hidden" name="csrf" value="{{ csrf }}">
					{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Course details', heading_level: 2, summary: 'Owning company: ' ~ (course.owner_company_name ?: 'Not assigned') ~ ' · owning person: ' ~ (course.owner_person_name ?: 'Not assigned') ~ ' · approval: ' ~ (course.publication_approval_status)})} %}
{% block section_actions %}
{{ ui('feedback.badge', {label: 'JSON schema ' ~ (course.interchange_schema_version), tone: 'neutral'}) }}
{% endblock %}
{% endembed %}

						{% include '@platform/partials/admin-course-fields.html.twig' %}{{ ui('action.button', {label: 'Save course details', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}</form>
				{% if can_manage_course_ownership %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'people'})} %}
{% block surface_body %}

						{{ ui('layout.section-head', {heading: 'Course ownership and Course Editors', heading_level: 2, summary: 'Every course has both an owning company and an owning person. Editors may work only on courses assigned to them.'}) }}

							<form action="/admin/courses/{{ course.id }}/people" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

								<input type="hidden" name="csrf" value="{{ csrf }}">
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Owning company', full_width: false, for: 'field-admin-course-edit-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true, help: 'Newly imported courses default to the System Company.'})} %}
{% block control %}

									<select name="owner_company_id" required id="field-admin-course-edit-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>
									{% for ownerCompany in owner_companies %}
										<option value="{{ ownerCompany.id }}" {{ ownerCompany.id==course.owner_company_id ? 'selected' : '' }}>{{ ownerCompany.name }}</option>
									{% endfor %}
									</select>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Owning person', full_width: false, for: 'field-admin-course-edit-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true, help: 'Newly imported courses default to the administrator who performed the import.'})} %}
{% block control %}

									<select name="owner_user_id" required id="field-admin-course-edit-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>
									{% for ownerPerson in owner_people %}
										<option value="{{ ownerPerson.id }}" {{ ownerPerson.id==course.owner_user_id ? 'selected' : '' }}>{{ ownerPerson.name }} · {{ ownerPerson.email }}</option>
									{% endfor %}
									</select>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Course Editors', full_width: true, for: 'field-admin-course-edit-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

									<div class="editor-choice-grid">
										{% for editorPerson in owner_people %}
											{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: (editorPerson.name) ~ (editorPerson.email) ~ ' · ' ~ (editorPerson.company_name)})} %}
{% block control %}
<input type="checkbox" name="editor_user_ids[]" value="{{ editorPerson.id }}" {{ editorPerson.selected_editor ? 'checked' : '' }} id="field-admin-course-edit-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}">
{% endblock %}
{% endembed %}
										{% endfor %}
									</div>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

									{{ ui('action.button', {label: 'Save ownership and editors', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
				{% endif %}
				{% if can_manage_course_pricing %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'pricing'})} %}
{% block surface_body %}

						{{ ui('layout.section-head', {heading: 'Pricing and access periods', heading_level: 2, summary: 'Define the access periods customers can buy. The active default is the catalogue price.'}) }}

							{% if course.price_variants %}
								<div class="vstack gap-3 mb-4">
									{% for price_index, price in course.price_variants %}
										<div class="border rounded p-3">
											<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
												<div>
													<strong>{{ price.price_label }}</strong> · {{ price.access_period_label }}
													{% if price.label %}
														<span class="text-body-secondary"> · {{ price.label }}</span>
													{% endif %}
												</div>
												<div class="d-flex gap-2">
													{% if price.is_default %}
														{{ ui('feedback.badge', {label: 'Default', tone: 'info'}) }}
													{% endif %}
													{{ ui('feedback.badge', {label: (price.is_active ? 'Active' : 'Inactive'), tone: price.is_active ? 'success' : 'neutral'}) }}
												</div>
											</div>
											<form action="/admin/courses/{{ course.id }}/pricing/{{ price.id }}" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

												<input type="hidden" name="csrf" value="{{ csrf }}">
												{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Period', full_width: false, for: 'field-admin-course-edit-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

													<input class="form-control" type="number" min="1" name="access_period_value" value="{{ price.access_period_value }}" required id="field-admin-course-edit-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
												{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Unit', full_width: false, for: 'field-admin-course-edit-5-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

													<select class="form-select" name="access_period_unit" id="field-admin-course-edit-5-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="days" {{ price.access_period_unit=='days' ? 'selected' : '' }}>Days</option><option value="weeks" {{ price.access_period_unit=='weeks' ? 'selected' : '' }}>Weeks</option><option value="months" {{ price.access_period_unit=='months' ? 'selected' : '' }}>Months</option><option value="years" {{ price.access_period_unit=='years' ? 'selected' : '' }}>Years</option></select>

{% endblock %}
{% endembed %}
												{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Price', full_width: false, for: 'field-admin-course-edit-6-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

													<input class="form-control" name="price" value="{{ price.price_input }}" inputmode="decimal" required id="field-admin-course-edit-6-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
												{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Currency', full_width: false, for: 'field-admin-course-edit-7-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

													<input class="form-control text-uppercase" name="currency_code" value="{{ price.currency_code }}" maxlength="3" required id="field-admin-course-edit-7-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
												{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Label', full_width: false, for: 'field-admin-course-edit-8-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

													<input class="form-control" name="label" value="{{ price.label }}" maxlength="120" id="field-admin-course-edit-8-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
												<div>
													{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Active'})} %}
{% block control %}
<input class="form-check-input" type="checkbox" name="is_active" value="1" {{ price.is_active ? 'checked' : '' }}>
{% endblock %}
{% endembed %}
												</div>
												<div>
													{{ ui('action.button', {label: 'Save', variant: 'secondary', size: 'normal', full_width: true, type: 'submit'}) }}
												</div>

{% endblock %}
{% endembed %}</form>
											<div class="d-flex flex-wrap gap-2 mt-3">
												{% if not price.is_default %}
													<form action="/admin/courses/{{ course.id }}/pricing/{{ price.id }}/default" method="post">
														<input type="hidden" name="csrf" value="{{ csrf }}">
														{{ ui('action.button', {label: 'Make default', variant: 'secondary', size: 'small', type: 'submit'}) }}
													</form>
												{% endif %}
												<form action="/admin/courses/{{ course.id }}/pricing/{{ price.id }}/move" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													<input type="hidden" name="direction" value="up">
													{{ ui('action.button', {label: '↑', variant: 'secondary', size: 'small', type: 'submit', disabled: price_index==0}) }}
												</form>
												<form action="/admin/courses/{{ course.id }}/pricing/{{ price.id }}/move" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													<input type="hidden" name="direction" value="down">
													{{ ui('action.button', {label: '↓', variant: 'secondary', size: 'small', type: 'submit', disabled: price_index+1==course.price_variants|length}) }}
												</form>
												<form action="/admin/courses/{{ course.id }}/pricing/{{ price.id }}/delete" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													{{ ui('action.button', {label: 'Delete', variant: 'danger', size: 'small', type: 'submit', confirm: 'Delete this price option?', icon: 'action-remove'}) }}
												</form>
											</div>
										</div>
									{% endfor %}
								</div>
							{% endif %}
							<div class="border-top pt-4">
								<h3 class="h5">
									Add price option
								</h3>
								<form action="/admin/courses/{{ course.id }}/pricing" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

									<input type="hidden" name="csrf" value="{{ csrf }}">
									{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Period', full_width: false, for: 'field-admin-course-edit-9-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

										<input class="form-control" type="number" min="1" name="access_period_value" value="12" required id="field-admin-course-edit-9-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
									{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Unit', full_width: false, for: 'field-admin-course-edit-10-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

										<select class="form-select" name="access_period_unit" id="field-admin-course-edit-10-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="months" selected>Months</option><option value="days">Days</option><option value="weeks">Weeks</option><option value="years">Years</option></select>

{% endblock %}
{% endembed %}
									{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Price', full_width: false, for: 'field-admin-course-edit-11-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

										<input class="form-control" name="price" placeholder="5000.00" inputmode="decimal" required id="field-admin-course-edit-11-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
									{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Currency', full_width: false, for: 'field-admin-course-edit-12-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

										<input class="form-control text-uppercase" name="currency_code" value="ZAR" maxlength="3" required id="field-admin-course-edit-12-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
									{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Label', full_width: false, for: 'field-admin-course-edit-13-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

										<input class="form-control" name="label" placeholder="12-month access" maxlength="120" id="field-admin-course-edit-13-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
									<div>
										{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Active'})} %}
{% block control %}
<input class="form-check-input" type="checkbox" name="is_active" value="1" checked>
{% endblock %}
{% endembed %}
									</div>
									<div>
										{{ ui('action.button', {label: 'Add', variant: 'primary', size: 'normal', full_width: true, type: 'submit'}) }}
									</div>
									<div>
										{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Make this the default catalogue price'})} %}
{% block control %}
<input class="form-check-input" type="checkbox" name="is_default" value="1">
{% endblock %}
{% endembed %}
									</div>

{% endblock %}
{% endembed %}</form>
							</div>

{% endblock %}
{% endembed %}
				{% endif %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'course-content'})} %}
{% block surface_body %}
					{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Course Content', heading_level: 2, summary: 'Build the nested course structure from reusable Course Items and course-specific placements.'})} %}
{% block section_actions %}
{{ ui('action.link', {label: 'Open Course Content editor', variant: 'primary', size: 'small', href: '/admin/courses/' ~ (course.id) ~ '/content'}) }}
{% endblock %}
{% endembed %}
					<p>{{ course.structure|length }} structure rows. Assessments and diagnostics use the same Course Item lifecycle and sharing model as every other item.</p>

{% endblock %}
{% endembed %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'presentation'})} %}
{% block surface_body %}

					{{ ui('layout.section-head', {heading: 'Course presentation', heading_level: 2, summary: 'Preserve the visual styling from the original self-contained HTML course without allowing it to restyle the LMS navigation or theme.'}) }}

						{% if course.presentation_css %}
							{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'success', section_spacing: false})} %}
{% block body %}

								<strong>Presentation stylesheet installed.</strong> A course-specific stylesheet is currently stored for this course.

{% endblock %}
{% endembed %}
						{% else %}
							{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', section_spacing: false})} %}
{% block body %}

								<strong>No imported presentation stylesheet is stored.</strong> Imported HTML classes will therefore use only the standard LMS styling.

{% endblock %}
{% endembed %}
						{% endif %}
						<p>
							For an already imported course, upload its original HTML file here. Only its presentation CSS and authored stylesheet imports are refreshed; modules, assessments, grades, enrolments and course IDs are not changed.
						</p>
						<form action="/admin/courses/{{ course.id }}/presentation" method="post" enctype="multipart/form-data">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

							<input type="hidden" name="csrf" value="{{ csrf }}">
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Original HTML course file', full_width: false, for: 'field-admin-course-edit-14-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

								<input class="form-control" type="file" name="course_html" accept=".html,.htm,text/html" required id="field-admin-course-edit-14-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
							{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

								{{ ui('action.button', {label: 'Import / refresh presentation', variant: 'secondary', size: 'normal', full_width: true, type: 'submit'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'grading'})} %}
{% block surface_body %}

					{{ ui('layout.section-head', {heading: 'Overall grade bands', heading_level: 2, summary: 'The learner receives the highest grade whose minimum percentage was reached.'}) }}

						<form action="/admin/courses/{{ course.id }}/grade-bands" method="post">
							<input type="hidden" name="csrf" value="{{ csrf }}">

								{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

										<tr>
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Code'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 52, label: 'Label'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Minimum'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Passing'}} %}
										</tr>

{% endblock %}
{% block body %}

										{% for band_index, band in course.grade_bands %}
											<tr>
												<td>
													<input class="form-control" name="grade_code[{{ band_index }}]" value="{{ band.grade_code }}" maxlength="24" required>
												</td>
												<td>
													<input class="form-control" name="grade_label[{{ band_index }}]" value="{{ band.grade_label }}" maxlength="120" required>
												</td>
												<td>
													<div class="input-group">
														<input class="form-control" type="number" min="0" max="100" step="0.01" name="minimum_percentage[{{ band_index }}]" value="{{ band.minimum_percentage }}" required>
														<span class="input-group-text">%</span>
													</div>
												</td>
												<td class="text-center">
													<input class="form-check-input" type="checkbox" name="is_passing[{{ band_index }}]" value="1" {{ band.is_passing ? 'checked' : '' }}>
												</td>
											</tr>
										{% endfor %}

{% endblock %}
{% endembed %}

							{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

							{{ ui('action.button', {label: 'Save grade bands', variant: 'secondary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}
						</form>

{% endblock %}
{% endembed %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, id: 'history'})} %}
{% block surface_body %}

					{{ ui('layout.section-head', {heading: 'Edit history', heading_level: 2}) }}
					{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

						{% for event in course.history %}
							{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

								<strong>{{ event.summary }}</strong>
								<br>
								<small>{{ event.created_at }} · {{ event.user_email ? event.user_email : 'System' }}</small>

{% endblock %}
{% endembed %}
						{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
				{% if can_manage_enrolments %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'danger', tone: 'danger'})} %}
{% block surface_body %}

						{{ ui('layout.section-head', {heading: 'Reset or delete course', heading_level: 2, summary: 'During development, Platform Administrator actions are deliberately direct. No title typing or backup is required.'}) }}

							{% if course.has_started_learners %}
								{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', section_spacing: false})} %}
{% block body %}

									Learners currently have or have used access to this course. Reset or deletion will remove their course data. The confirmation below is the only override required.

{% endblock %}
{% endembed %}
							{% endif %}
							<div class="row g-3">
								<div class="col-lg-6">
									<form action="/admin/courses/{{ course.id }}/reset" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										{{ ui('action.button', {label: 'Reset course content', variant: 'danger', size: 'normal', type: 'submit', confirm: 'Reset this course now? Course content and learner test data will be removed, but the empty course shell will remain for re-import.', icon: 'action-remove'}) }}
									</form>
								</div>
								<div class="col-lg-6">
									<form action="/admin/courses/{{ course.id }}/delete" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										{{ ui('action.button', {label: 'Delete course permanently', variant: 'danger', size: 'normal', type: 'submit', confirm: 'Permanently delete this course and scrub all associated learner access, progress, attempts and results?', icon: 'action-remove'}) }}
									</form>
								</div>
							</div>

{% endblock %}
{% endembed %}
				{% endif %}
			</div>
			<aside>
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true, sticky: true})} %}
{% block surface_body %}

						<h2 class="h4">
							Student-view preview
						</h2>
						<p>
							Use the real course player, quizzes, grades and progress bar without affecting real learner records.
						</p>
						{{ ui('action.link', {label: 'Preview as student', variant: 'primary', size: 'normal', full_width: true, href: '/admin/courses/' ~ (course.id) ~ '/preview'}) }}
						<form action="/admin/courses/{{ course.id }}/preview/reset" method="post">
							<input type="hidden" name="csrf" value="{{ csrf }}">
							{{ ui('action.button', {label: 'Reset preview progress', variant: 'secondary', size: 'normal', full_width: true, type: 'submit'}) }}
						</form>

{% endblock %}
{% endembed %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

						<h2 class="h4">
							Import and portability
						</h2>
						<p>
							Export the complete course as structured JSON, or replace an unstarted course through the import screen.
						</p>
						{{ ui('action.link', {label: 'Export course JSON', variant: 'secondary', size: 'normal', full_width: true, href: '/admin/courses/' ~ (course.id) ~ '/export'}) }}{{ ui('action.link', {label: 'Import or re-import', variant: 'secondary', size: 'normal', full_width: true, href: '/admin/courses/import'}) }}

{% endblock %}
{% endembed %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

						<h2 class="h4">
							Certificate
						</h2>
						<p>
							Edit the certificate HTML and CSS, insert placeholders and preview the result.
						</p>
						{{ ui('action.link', {label: 'Edit certificate template', variant: 'secondary', size: 'normal', full_width: true, href: '/admin/courses/' ~ (course.id) ~ '/certificate'}) }}

{% endblock %}
{% endembed %}
				{% if not can_publish_courses %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

							<h2 class="h4">
								Publication approval
							</h2>
							<p>
								Submit the course to the platform administrator when it is ready for publication.
							</p>
							{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

								<strong>Publication checks:</strong> Courses may omit assessments. Assessed courses require exactly one final assessment and valid question banks. Unresolved Course Item references, missing Resources and invalid availability schedules block publication. The course must also have at least one active access/price option and exactly one active default price; a free course may use a zero price.

{% endblock %}
{% endembed %}
							<p>
								<strong>Current approval:</strong> {{ course.publication_approval_status|ucfirst }}
							</p>
							<form action="/admin/courses/{{ course.id }}/submit-for-approval" method="post">
								<input type="hidden" name="csrf" value="{{ csrf }}">
								{{ ui('action.button', {label: 'Submit for approval', variant: 'primary', size: 'normal', full_width: true, type: 'submit'}) }}
							</form>

{% endblock %}
{% endembed %}
				{% endif %}
				{% if can_publish_courses %}
					{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

							<h2 class="h4">
								Publication status
							</h2>
							<p>
								Course Editors submit work for approval; only a platform administrator changes publication status.
							</p>
							{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

								<strong>Publication checks:</strong> Courses may omit assessments. Assessed courses require exactly one final assessment and valid question banks. Unresolved Course Item references, missing Resources and invalid availability schedules block publication. The course must also have at least one active access/price option and exactly one active default price; a free course may use a zero price.

{% endblock %}
{% endembed %}
							<form action="/admin/courses/{{ course.id }}/status" method="post">{% embed ui_template('form.compact-action') with {props: ui_props('form.compact-action', {})} %}
{% block body %}

								<input type="hidden" name="csrf" value="{{ csrf }}">
								{% for error in course.publication_validation.errors %}<p>{{ error }}</p>{% endfor %}{% for warning in course.publication_validation.warnings %}<p>{{ warning }}</p>{% endfor %}
{% embed ui_template('form.choice') with {props:ui_props('form.choice',{label:'Override publication warnings'})} %}{% block control %}<input type="checkbox" name="override_publication_warnings" value="1">{% endblock %}{% endembed %}
<select class="form-select mb-3" name="status">
								{% for state in course_states %}
									<option value="{{ state }}" {{ state == course.status ? 'selected' : '' }}>{{ state|ucfirst }}</option>
								{% endfor %}
								</select>{{ ui('action.button', {label: 'Change status', variant: 'primary', size: 'normal', full_width: true, type: 'submit'}) }}

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
				{% endif %}
				{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

						<h2 class="h4">
							Full learner test
						</h2>
						<p>
							Add the course to your own normal library for a persistent non-preview enrolment.
						</p>
						<form action="/admin/courses/{{ course.id }}/grant-self" method="post">
							<input type="hidden" name="csrf" value="{{ csrf }}">
							{{ ui('action.button', {label: 'Add to my library', variant: 'secondary', size: 'normal', full_width: true, type: 'submit', icon: 'action-add'}) }}
						</form>

{% endblock %}
{% endembed %}
			</aside>

{% endblock %}
{% endembed %}
	</section>
