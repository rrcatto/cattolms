{% extends layout %}
{% block page_body %}
	{#
		Home has a hero rather than a page head, so it includes the identity band directly. It is
		still the same band in the same place - first thing under the top of the page.
	#}
	{% include '@platform/partials/account/identity-head.html.twig' %}
	<section class="cl-hero" style="--cl-hero-image:url('/img/hero-learning.svg')">
		<div class="cl-container py-12 py-lg-6">
			<div class="row align-items-center min-vh-hero">
				<div class="lg:col-7 py-12">
					<span class="cl-kicker">Practical self-study learning</span>
					<h1 class="cl-display-2 fw-bold mt-5">
						Learn useful things. Prove what you know.
					</h1>
					<p class="cl-lead mt-7">
						Structured modules, meaningful assessments and a course library that remembers your progress securely.
					</p>
					{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

						{{ ui('action.link', {label: 'Browse courses', variant: 'primary', size: 'large', href: '/courses', icon: 'nav-catalogue'}) }}
						{% if is_authenticated %}
							{{ ui('action.link', {label: 'Open my library', variant: 'secondary', size: 'large', href: '/account/courses', icon: 'nav-learning'}) }}
						{% else %}
							{{ ui('action.link', {label: 'Create an account', variant: 'secondary', size: 'large', href: '/register', icon: 'action-register'}) }}
						{% endif %}

{% endblock %}
{% endembed %}
				</div>
				<div class="lg:col-5 d-none lg:d-block">
					<div class="cl-hero-panel">
						<span class="cl-kicker cl-text-warning">Built for real learning</span>
						<h2>
							Read. Practise. Assess. Complete.
						</h2>
						<ul>
							<li>
								Course content split into clear modules
							</li>
							<li>
								Server-recorded progress and grades
							</li>
							<li>
								Secure passwordless access
							</li>
							<li>
								Certificates for completed courses
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="cl-page-section">
		{# The catalogue introduction is text, so it sits on a surface like every other block. #}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		<div class="row align-items-end">
			<div class="lg:col-8">
				<span class="cl-kicker cl-text-primary">Course catalogue</span>
				<h2 class="cl-display-5 fw-bold mb-3">
					Choose your next practical skill
				</h2>
				<p class="cl-lead cl-text-muted mb-0">
					Courses are designed for independent study, with module assessments and recorded results.
				</p>
			</div>
			<div class="lg:col-4 lg:text-end mt-5 lg:mt-0">
				{{ ui('action.link', {label: 'View all courses', variant: 'secondary', size: 'normal', href: '/courses', icon: 'nav-catalogue'}) }}
			</div>
		</div>

{% endblock %}
{% endembed %}
		{#
			Popular Courses: every group of the pool arrives with the page and the popular-courses
			controller shows one at a time. Groups after the first are `hidden`, so they are neither
			seen nor reachable by keyboard or assistive technology until shown; without JavaScript
			the first group, the highest ranked, simply stays. Pause and Resume are rendered hidden
			and the controller reveals whichever applies: without it there is no rotation to pause.
		#}
		{% if popular_groups %}
			{{ importmap() }}
			<section class="cl-popular-courses" id="popular-courses" aria-roledescription="carousel" aria-label="Popular courses"
			         data-controller="popular-courses" data-popular-courses-interval-value="{{ popular_rotation_seconds }}">
				{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Popular courses', summary: 'A changing selection of the courses learners are choosing.'})} %}
{% block section_actions %}{% if popular_groups|length > 1 %}{{ ui('action.button', {label: 'Pause rotation', type: 'button', icon: 'action-pause', hidden: true, id: 'popular-courses-pause', controls: 'popular-courses-groups', stimulus_action: 'popular-courses#pause'}) }}{{ ui('action.button', {label: 'Resume rotation', type: 'button', icon: 'action-play', hidden: true, id: 'popular-courses-resume', controls: 'popular-courses-groups', stimulus_action: 'popular-courses#resume'}) }}{% endif %}{% endblock %}
{% endembed %}
				<div id="popular-courses-groups" aria-live="polite"
				     data-action="mouseenter->popular-courses#suspend mouseleave->popular-courses#release focusin->popular-courses#suspend focusout->popular-courses#release">
					{% for group in popular_groups %}
						<div class="cl-popular-courses-group" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ popular_groups|length }}" data-popular-courses-target="group"{% if not loop.first %} hidden{% endif %}>
							{{ ui('catalogue.course-grid', {courses: group}) }}
						</div>
					{% endfor %}
				</div>
			</section>
		{% else %}
			{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {heading: 'Courses are being prepared', summary: 'Published courses will appear here as soon as they are ready.'})} %}
{% block actions %}

				<div class="cl-empty-icon">
					01
				</div>

{% endblock %}
{% endembed %}
		{% endif %}
	</section>
	<section class="cl-feature-band py-12 py-lg-6">
		<div class="cl-container">
			<div class="row g-7">
				<div class="md:col-4">
					<div class="cl-feature">
						<span>01</span>
						<h3>
							Structured content
						</h3>
						<p>
							Each course is broken into individual modules with its own learning material and assessment.
						</p>
					</div>
				</div>
				<div class="md:col-4">
					<div class="cl-feature">
						<span>02</span>
						<h3>
							Recorded progress
						</h3>
						<p>
							Your progress and grades are stored by the LMS, not left in one browser’s local storage.
						</p>
					</div>
				</div>
				<div class="md:col-4">
					<div class="cl-feature">
						<span>03</span>
						<h3>
							Clear results
						</h3>
						<p>
							See module grades, an overall course result and a certificate where the course provides one.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
