{% extends layout %}
{% block page_body %}
	{#
		Home has a hero rather than a page head, so it includes the identity band directly. It is
		still the same band in the same place - first thing under the top of the page.
	#}
	{% include '@platform/partials/account/identity-head.html.twig' %}
	<section class="cl-hero" style="--cl-hero-image:url('/img/hero-learning.svg')">
		<div class="container py-5 py-lg-6">
			<div class="row align-items-center min-vh-hero">
				<div class="col-lg-7 py-5">
					<span class="cl-kicker">Practical self-study learning</span>
					<h1 class="display-2 fw-bold mt-3">
						Learn useful things. Prove what you know.
					</h1>
					<p class="lead mt-4">
						Structured modules, meaningful assessments and a course library that remembers your progress securely.
					</p>
					{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

						{{ ui('action.link', {label: 'Browse courses', variant: 'primary', size: 'large', href: '/courses'}) }}
						{% if is_authenticated %}
							{{ ui('action.link', {label: 'Open my library', variant: 'secondary', size: 'large', href: '/account/library'}) }}
						{% else %}
							{{ ui('action.link', {label: 'Create an account', variant: 'secondary', size: 'large', href: '/register', icon: 'action-add'}) }}
						{% endif %}

{% endblock %}
{% endembed %}
				</div>
				<div class="col-lg-5 d-none d-lg-block">
					<div class="cl-hero-panel">
						<span class="cl-kicker text-warning">Built for real learning</span>
						<h2>
							Read. Practise. Assess. Complete.
						</h2>
						<ul>
							<li>
								Course content split into clear modules
							</li>
							<li>
								Server-recorded progress and grades
							</li>
							<li>
								Secure passwordless access
							</li>
							<li>
								Certificates for completed courses
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="container py-5 py-lg-6">
		{# The catalogue introduction is text, so it sits on a surface like every other block. #}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		<div class="row align-items-end">
			<div class="col-lg-8">
				<span class="cl-kicker text-primary">Course catalogue</span>
				<h2 class="display-5 fw-bold mb-2">
					Choose your next practical skill
				</h2>
				<p class="lead text-body-secondary mb-0">
					Courses are designed for independent study, with module assessments and recorded results.
				</p>
			</div>
			<div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
				{{ ui('action.link', {label: 'View all courses', variant: 'secondary', size: 'normal', href: '/courses'}) }}
			</div>
		</div>

{% endblock %}
{% endembed %}
		{% if published_course_count > 0 %}
			{% include '@platform/partials/course-showcase.html.twig' %}
		{% else %}
			{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {heading: 'Courses are being prepared', summary: 'Published courses will appear here as soon as they are ready.'})} %}
{% block actions %}

				<div class="cl-empty-icon">
					01
				</div>

{% endblock %}
{% endembed %}
		{% endif %}
	</section>
	<section class="cl-feature-band py-5 py-lg-6">
		<div class="container">
			<div class="row g-4">
				<div class="col-md-4">
					<div class="cl-feature">
						<span>01</span>
						<h3>
							Structured content
						</h3>
						<p>
							Each course is broken into individual modules with its own learning material and assessment.
						</p>
					</div>
				</div>
				<div class="col-md-4">
					<div class="cl-feature">
						<span>02</span>
						<h3>
							Recorded progress
						</h3>
						<p>
							Your progress and grades are stored by the LMS, not left in one browser’s local storage.
						</p>
					</div>
				</div>
				<div class="col-md-4">
					<div class="cl-feature">
						<span>03</span>
						<h3>
							Clear results
						</h3>
						<p>
							See module grades, an overall course result and a certificate where the course provides one.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
