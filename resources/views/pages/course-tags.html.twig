{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/courses' %}
	{% set ph_back_label = 'Course catalogue' %}
	{% set ph_kicker = 'Browse' %}
	{% set ph_title = 'Browse by tag' %}
	{% set ph_lead = 'Every label in the catalogue. The larger a tag, the more courses carry it.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="container-fluid cl-container-wide py-5">
		{% if universe_switch %}
			{% include '@platform/partials/universe-switch.html.twig' with {us: universe_switch, ct: null} %}
		{% endif %}
		{% if tag_index %}
			{% include '@platform/partials/tag-cloud.html.twig' with {cloud_tags: tag_index} %}
		{% else %}
			<div class="empty section">
				<h3>
					No tags have been created yet
				</h3>
			</div>
		{% endif %}
	</section>
{% endblock %}
