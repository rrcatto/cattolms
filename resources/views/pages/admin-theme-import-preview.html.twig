{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/themes' %}
	{% set ph_back_label = 'Themes' %}
	{% set ph_kicker = 'Administration · Themes' %}
	{% set ph_title = 'Inspect theme package' %}
	{% set ph_lead = 'The Theme Package 3.0 ZIP has been validated but has not yet been installed.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

		<span>✓</span>
		<div>
			<strong>{{ inspection.summary.name }}</strong> · version {{ inspection.summary.version }}
			<br>
			{{ inspection.summary.description }}
			{% if inspection.summary.child %}
				<br>
				<span class="small muted">Child of {{ inspection.summary.parent_name }} {{ inspection.summary.parent_version }}</span>
			{% endif %}
		</div>

{% endblock %}
{% endembed %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {})} %}
{% block body %}

			<div>
				<strong>Install identity</strong>
				<div class="mono">
					{{ inspection.install_key }}
				</div>
			</div>
			<div>
				<strong>Author</strong>
				<div>
					{{ inspection.summary.author }}
				</div>
			</div>
			<div>
				<strong>Package files</strong>
				<div>
					{{ inspection.summary.files }}
				</div>
			</div>
			<div>
				<strong>Additional stylesheets</strong>
				<div>
					{{ inspection.summary.additional_styles }}
				</div>
			</div>
			<div>
				<strong>Scripts</strong>
				<div>
					{{ inspection.summary.scripts }}
				</div>
			</div>
			<div>
				<strong>Colour palettes</strong>
				<div>
					{{ inspection.summary.palettes }}
					{% if inspection.summary.palettes > 5 %}
						· {{ ui('feedback.badge', {label: 'High palette count', tone: 'warning'}) }}
					{% endif %}
				</div>
			</div>
			<div>
				<strong>Package contract</strong>
				<div>
					Theme Package 3.0 · Template API 1.0
				</div>
			</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
	{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: true})} %}
{% block body %}

		<span>i</span>
		<div>
			The installed theme is immutable to the LMS. A future version installs alongside this release rather than replacing it.
		</div>

{% endblock %}
{% endembed %}
	<form action="/admin/themes/import/confirm" method="post" class="section">
		<input type="hidden" name="csrf" value="{{ csrf }}">
		<input type="hidden" name="token" value="{{ inspection.token }}">
		{{ ui('action.button', {label: 'Install theme package', variant: 'primary', size: 'normal'}) }}
	</form>
{% endblock %}
