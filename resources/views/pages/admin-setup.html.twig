{#
	Setup (owner, 2026-10-20; SetupChecklist): every step a new installation needs, in order, each a closed
	accordion like the FAQ (its group above its title, Done or To do beside it), the next step open. A step the
	site can tell is done by what it holds; the others are marked done here.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Administration' %}{% set ph_title = 'Set up your site' %}
	{% set ph_lead = progress.done == progress.total ? 'Every step is done.' : progress.done ~ ' of ' ~ progress.total ~ ' steps done. Next: ' ~ progress.next.title ~ '.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	{% set a = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"' %}
	{% set done_icon = '<svg ' ~ a ~ '><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>' %}
	{% set todo_icon = '<svg ' ~ a ~ '><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'The steps', summary: 'Work down the list. Each step says what it is for and opens the page where it is done.'}) }}
			{{ ui('feedback.progress', {value: progress.done, max: progress.total, label: progress.done ~ ' of ' ~ progress.total ~ ' done'}) }}
			<div class="cl-faq cl-setup-steps">
			{% for step in steps %}
				{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {id: 'setup-' ~ step.key, eyebrow: 'Step ' ~ loop.index ~ ' · ' ~ step.group, icon: step.done ? done_icon : todo_icon, heading: step.title, summary: step.done ? 'Done' : 'To do', open: progress.next is not null and progress.next.key == step.key})} %}{% block body %}
					<p>{{ step.summary }}</p>
					<p><strong>Now:</strong> {{ step.state }}</p>
					{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}{% block body %}
						{{ ui('action.link', {label: step.link, variant: 'secondary', size: 'small', href: step.href, icon: (step.href ends with '/import' ? 'action-import' : 'action-open')}) }}
						{% if can_manage and step.action %}
							<form action="/admin/setup/catalogue" method="post" class="cl-setup-action"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="step" value="{{ step.key }}">{{ ui('action.button', {label: 'Load the starter categories and tags', variant: 'primary', size: 'small', type: 'submit', icon: 'action-import'}) }}</form>
						{% endif %}
						{% if can_manage and step.manual %}
							<form action="/admin/setup/{{ step.key }}/mark" method="post" class="cl-setup-action"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="done" value="{{ step.done ? 'no' : 'yes' }}">{{ ui('action.button', {label: step.done ? 'Mark not done' : 'Mark done', variant: step.done ? 'quiet' : 'primary', size: 'small', type: 'submit', icon: (step.done ? 'action-restore' : 'action-done')}) }}</form>
						{% endif %}
					{% endblock %}{% endembed %}
				{% endblock %}{% endembed %}
			{% endfor %}
			</div>
		{% endblock %}{% endembed %}
	</section>
{% endblock %}
