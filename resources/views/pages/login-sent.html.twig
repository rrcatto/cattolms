{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Sign in' %}
	{% set ph_title = 'Check your email' %}
	{% set ph_lead = 'The sign-in link is on its way.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

				<p>
					If the address can receive email, a secure one-time link has been sent. Opening that link completes registration or signs you in.
				</p>
				{# After a registration on a demo site (owner, 2026-10-26). #}
				{% if hold_notice|default('') %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Your account will be held for approval'})} %}{% block body %}<p>{{ hold_notice }}</p>{% endblock %}{% endembed %}{% endif %}
				{{ ui('action.link', {label: 'Send another link', variant: 'secondary', size: 'normal', href: '/login', icon: 'action-email'}) }}

{% endblock %}
{% endembed %}
	</section>
{% endblock %}
