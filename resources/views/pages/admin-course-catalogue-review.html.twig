{% extends layout %}
{% block page_body %}
	{#
		The review of a catalogue import (owner, 2026-10-23): what the package would do, course by course, before anything
		changes. Each new course or course already here can be left out. The import is canonical (owner, 2026-11-06: "By
		default, what is in the import file wins"): every difference between the file and this site, a course's, a file's or
		a bundle's, is said in words and is a choice of two feature cards, the file's version (chosen) or this site's. A
		course's content is never replaced once a learner has started it, prices change only with the pricing permission
		and statuses only with the publishing permission.
	#}
	{% set ph_back_href = '/admin/courses/catalogue' %}
	{% set ph_back_label = 'Import & Export Catalogue' %}
	{% set ph_kicker = 'Courses' %}
	{% set ph_title = 'Review catalogue import' %}
	{% set ph_lead = plan.filename ~ ': nothing has changed yet. Check what the import would do, then choose Import.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	{% set counts = plan.counts %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'What the import would do', heading_level: 2, summary: plan.kind == 'json' ? 'A catalogue file holds categories and tags, and any bundles of courses already here.' : 'Courses and bundles are matched by their codes.'}) }}
			{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {density: 'compact', columns: 4})} %}{% block body %}
				{{ ui('data.stat-card', {label: 'New courses', value: counts.new}) }}
				{{ ui('data.stat-card', {label: 'Courses that differ', value: counts.update}) }}
				{{ ui('data.stat-card', {label: 'No change', value: counts.unchanged}) }}
				{{ ui('data.stat-card', {label: 'Left out', value: counts.skip}) }}
			{% endblock %}{% endembed %}
			{% if plan.bundles|default([]) %}{% set bundle_counts = plan.bundle_counts %}
			{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {density: 'compact', columns: 4})} %}{% block body %}
				{{ ui('data.stat-card', {label: 'New bundles', value: bundle_counts.new}) }}
				{{ ui('data.stat-card', {label: 'Bundles that differ', value: bundle_counts.update}) }}
				{{ ui('data.stat-card', {label: 'Bundles with no change', value: bundle_counts.unchanged}) }}
				{{ ui('data.stat-card', {label: 'Bundles left out', value: bundle_counts.skip}) }}
			{% endblock %}{% endembed %}
			{% endif %}
			{{ ui('data.key-value-list', {items: [
				{label: 'Categories', value: (plan.catalogue.categories_new ? plan.catalogue.categories_new|length ~ ' new: ' ~ plan.catalogue.categories_new|join(', ') : 'None new') ~ (plan.catalogue.categories_kept ? ' · ' ~ plan.catalogue.categories_kept ~ ' already here' : '')},
				{label: 'Site presentation', value: plan.site_presentation == 'new' ? 'It will be added, and the front page will link to it' : (plan.site_presentation == 'here' ? 'This site keeps its own' : 'None in the package')},
				{label: 'Tags', value: (plan.catalogue.tags_new ? plan.catalogue.tags_new|length ~ ' new: ' ~ plan.catalogue.tags_new|join(', ') : 'None new') ~ (plan.catalogue.tags_kept ? ' · ' ~ plan.catalogue.tags_kept ~ ' already here' : '')},
				{label: 'Resource Library files', value: (plan.files_new ? plan.files_new ~ ' new' : 'None new') ~ (plan.files_different ? ' · ' ~ plan.files_different ~ ' different from this site\'s, listed below' : '')},
			]}) }}
{% endblock %}
{% endembed %}
	</section>
	{# Every choice belongs to the import form in the last card (the form attribute), so Import and Cancel sit side by side. #}
		{% if plan.courses %}
		<section class="cl-page-section">
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
				{{ ui('layout.section-head', {heading: 'Courses', heading_level: 2, summary: 'Untick a course to leave it out. A course already on this site takes everything from the file: its content, category, tags, prices, cover, position, page layout, related courses and status. Each difference is listed below, where you can keep this site\'s instead.'}) }}
				{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'The package\'s courses and what the import would do with each'})} %}
{% block header %}
					<tr>
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 10, label: 'Import'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 10, label: 'Code'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 27, label: 'Course'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'What happens'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 41, label: 'Details'}} %}
					</tr>
{% endblock %}
{% block body %}
					{% for row in plan.courses %}
					<tr>
						<td>
							{% if row.action != 'skip' %}
							{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: row.action == 'new' ? 'Import' : 'Update'})} %}{% block control %}<input type="checkbox" form="catalogue-import" name="courses[]" value="{{ row.code }}" checked>{% endblock %}{% endembed %}
							{% else %}—{% endif %}
						</td>
						<td>{% if row.code %}<code class="cl-course-code">{{ row.code }}</code>{% else %}—{% endif %}</td>
						<td class="cell-text"><strong>{% if row.course_id %}<a href="{{ course_admin_url(row.code) }}">{{ row.title }}</a>{% else %}{{ row.title }}{% endif %}</strong>{% if row.site_title|default('') and row.site_title != row.title %}<br><small class="cl-text-muted">Here: {{ row.site_title }}</small>{% endif %}</td>
						<td>{{ ui('feedback.badge', {label: {new: 'New', update: 'Differs', unchanged: 'No change', skip: 'Left out'}[row.action], tone: {new: 'success', update: 'info', unchanged: 'neutral', skip: 'warning'}[row.action]}) }}</td>
						<td class="cell-text">
							{% if row.action == 'skip' %}{{ row.reason }}
							{% elseif row.action == 'new' %}{{ (row.changes|merge(row.notes))|join(' · ') }}{% if row.status == 'published' %} · Published where it came from{% endif %}{% if row.differences %} · {{ row.differences|length }} {{ row.differences|length == 1 ? 'file differs' : 'files differ' }} from this site's, below{% endif %}
							{% elseif row.differences %}{{ row.differences|length }} {{ row.differences|length == 1 ? 'difference' : 'differences' }}, below{% if row.notes %} · {{ row.notes|join(' · ') }}{% endif %}
							{% else %}As the file has it.{% endif %}
						</td>
					</tr>
					{% endfor %}
{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
		</section>
		{% set differing = plan.courses|filter(row => row.action != 'skip' and row.differences) %}
		{% if differing %}
		<section class="cl-page-section" id="course-differences">
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
				{{ ui('layout.section-head', {heading: 'Where the courses differ', heading_level: 2, summary: 'Each difference takes the file\'s version unless you choose Keep this site\'s. What is replaced is not kept. Nothing changes until you choose Import.'}) }}
				{% for row in differing %}
				<div>
					<h3>{{ row.code }} · {% if row.course_id %}<a href="{{ course_admin_url(row.code) }}">{{ row.site_title|default(row.title) }}</a>{% else %}{{ row.title }}{% endif %}</h3>
					{% for difference in row.differences %}
						{% include '@platform/partials/admin/catalogue-difference.html.twig' with {cd: {
							name: difference.kind starts with 'file:' ? 'file_choice[' ~ difference.kind|slice(5) ~ ']' : 'choice[' ~ row.code ~ '][' ~ difference.kind ~ ']',
							difference: difference,
							allowed: difference.choosable and (difference.kind != 'prices' or can_price) and (difference.kind != 'status' or can_publish),
							why_not: not difference.choosable ? difference.problem : (difference.kind == 'prices' ? 'Changing prices needs the course pricing permission.' : 'Changing a course\'s status needs the course publishing permission.'),
							file_note: difference.kind == 'content' ? 'Its lessons, parts and assessments are replaced with the file\'s.' : (difference.kind starts with 'file:' ? 'Every course that uses it gets the file\'s. The old file is not kept.' : 'The file\'s replaces this site\'s, which is not kept.'),
						}} %}
					{% endfor %}
				</div>
				{% endfor %}
{% endblock %}
{% endembed %}
		</section>
		{% endif %}
		{% endif %}
		{# The package's bundles (owner, 2026-11-06: bundles "backed up as part of the catalogue"), each known by its code, after the courses they hold. #}
		{% if plan.bundles|default([]) %}
		<section class="cl-page-section">
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
				{{ ui('layout.section-head', {heading: 'Bundles', heading_level: 2, summary: 'Imported after the courses. Untick a bundle to leave it out. A new bundle comes with the package\'s price and status, published only if it was published where it came from and all its courses are published here. A bundle already on this site takes everything from the file: its words, cover, courses, price, status, sale dates and address. Each difference is listed below, where you can keep this site\'s instead.'}) }}
				{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'The package\'s bundles and what the import would do with each'})} %}
{% block header %}
					<tr>
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 10, label: 'Import'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 13, label: 'Code'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 25, label: 'Bundle'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 11, label: 'What happens'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 41, label: 'Details'}} %}
					</tr>
{% endblock %}
{% block body %}
					{% for row in plan.bundles %}
					<tr>
						<td>
							{% if row.action in ['new', 'update'] %}
							{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: row.action == 'new' ? 'Import' : 'Update'})} %}{% block control %}<input type="checkbox" form="catalogue-import" name="bundles[]" value="{{ row.code }}"{% if can_bundle %} checked{% else %} disabled{% endif %}>{% endblock %}{% endembed %}
							{% else %}—{% endif %}
						</td>
						<td>{% if row.code %}<code class="cl-course-code">{{ row.code }}</code>{% else %}—{% endif %}</td>
						<td class="cell-text"><strong>{{ row.title }}</strong>{% if row.site_title|default('') and row.site_title != row.title %}<br><small class="cl-text-muted">Here: {{ row.site_title }}</small>{% endif %}</td>
						<td>{{ ui('feedback.badge', {label: {new: 'New', update: 'Differs', unchanged: 'No change', skip: 'Left out'}[row.action], tone: {new: 'success', update: 'info', unchanged: 'neutral', skip: 'warning'}[row.action]}) }}</td>
						<td class="cell-text">
							{% if row.action == 'skip' %}{{ row.reason }}
							{% elseif row.action == 'new' %}{{ row.changes|join(' · ') }}{% if row.status == 'published' %} · Published where it came from{% elseif row.status == 'retired' %} · Retired where it came from{% endif %}
							{% elseif row.differences|default([]) %}{{ row.differences|length }} {{ row.differences|length == 1 ? 'difference' : 'differences' }}, below
							{% else %}As the file has it.{% endif %}
						</td>
					</tr>
					{% endfor %}
{% endblock %}
{% endembed %}
				{% if not can_bundle %}<p class="help">Importing bundles needs the bundle management permission: they are left out.</p>{% endif %}
				{% for row in plan.bundles|filter(row => row.action == 'update' and row.differences|default([])) %}
				<div>
					<h3>{{ row.code }} · {{ row.site_title|default(row.title) }}</h3>
					{% for difference in row.differences %}
						{% include '@platform/partials/admin/catalogue-difference.html.twig' with {cd: {
							name: 'bundle_choice[' ~ row.code ~ '][' ~ difference.kind ~ ']',
							difference: difference,
							allowed: difference.choosable and can_bundle,
							why_not: not difference.choosable ? difference.problem : 'Importing bundles needs the bundle management permission.',
							file_note: 'The file\'s replaces this site\'s, which is not kept.',
						}} %}
					{% endfor %}
				</div>
				{% endfor %}
{% endblock %}
{% endembed %}
		</section>
		{% endif %}
		<section class="cl-page-section">
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
				{{ ui('layout.section-head', {heading: 'Import', heading_level: 2, summary: 'Each course is imported on its own: if one fails, the result page says why and the rest still go in. Importing the same package again changes nothing.'}) }}
				{% if counts.new > 0 %}
				{{ ui('form.picture-choice', {multiple: true, legend: 'New courses', size: 'small', form: 'catalogue-import', selected: (can_price ? ['prices'] : [])|merge(can_publish ? ['publish'] : []), items: [
					{value: 'prices', label: 'Give them the package\'s prices', icon: lucide('badge-percent'), note: (can_price ? 'Untick it and new courses arrive with no price.' : 'Setting prices needs the course pricing permission.'), disabled: not can_price},
					{value: 'publish', label: 'Publish those that are published where they came from', icon: lucide('rocket'), note: (can_publish ? 'Their publication warnings were accepted where they were published. One with an error, such as no price, stays a draft, and the result page says why. Untick it and they stay drafts.' : 'Publishing needs the course publishing permission: they stay drafts.'), disabled: not can_publish},
				]}) }}
				{% endif %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}<form id="catalogue-import" action="/admin/courses/catalogue/review" method="post" autocomplete="off"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ plan.key }}"><input type="hidden" name="fingerprint" value="{{ plan.fingerprint }}">{{ ui('action.button', {label: 'Import', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-import'}) }}</form>{% endblock %}
{% block secondary_actions %}<form action="/admin/courses/catalogue/cancel" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ plan.key }}">{{ ui('action.button', {label: 'Cancel this import', variant: 'quiet', size: 'normal', type: 'submit', icon: 'action-cancel'}) }}</form>{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
		</section>
{% endblock %}
