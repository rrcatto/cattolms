{#
	Orders & Payments: every order, newest first, filtered by dates, state and kind of buyer, searched by
	order number, name, email or account reference, sorted and paged (MoneyRecords::orders). Each row is one
	order: whose account first, what was bought, the amount and where it stands in words (owner, 2026-10-18).
	A row opens the order, which tells what happened and what to do.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Administration' %}{% set ph_title = 'Orders & Payments' %}
	{% set ph_lead = 'Every order, newest first. Each row is one order: whose it is, what was bought, how much, and whether it has been paid. Open an order to see what happened and what, if anything, you need to do.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Find orders', summary: 'Search by account reference, name, email or order number. Both dates are included.'}) }}
		<form action="/admin/commerce/orders" method="get">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Search', full_width: true, for: 'orders-q'})} %}{% block control %}<input id="orders-q" name="q" value="{{ filters.q }}" maxlength="120" placeholder="Account reference, name, email or order number" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Placed from', full_width: false, for: 'orders-from'})} %}{% block control %}<input type="date" id="orders-from" name="from" value="{{ filters.from }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Placed to', full_width: false, for: 'orders-to'})} %}{% block control %}<input type="date" id="orders-to" name="to" value="{{ filters.to }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Status', full_width: false, for: 'orders-state'})} %}{% block control %}<select id="orders-state" name="state" {{ ui_field_attrs(props) }}><option value="">Any status</option>{% for key, label in states %}<option value="{{ key }}" {{ filters.state == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Bought by', full_width: false, for: 'orders-account'})} %}{% block control %}<select id="orders-account" name="account" {{ ui_field_attrs(props) }}><option value="">People and companies</option><option value="person" {{ filters.account == 'person' ? 'selected' : '' }}>People</option><option value="company" {{ filters.account == 'company' ? 'selected' : '' }}>Companies</option></select>{% endblock %}{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Filter', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-filter'}) }}{{ ui('action.link', {label: 'Clear', variant: 'secondary', size: 'normal', href: '/admin/commerce/orders', icon: 'action-clear'}) }}{% endblock %}{% endembed %}
		{% endblock %}{% endembed %}</form>
	{% endblock %}{% endembed %}</section>
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Orders', summary: filtered ? 'The orders that match.' : 'All orders.'}) }}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'orders', pagination: orders_pagination})} %}{% block results %}
			{% if rows %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr>{% for sh in orders_sort_headers %}{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: orders_region, sort_results: orders_results} %}{% endfor %}</tr>{% endblock %}
			{% block body %}
				{% for order in rows %}
					<tr data-order-id="{{ order.id }}">
						<td class="cell-text"><strong>{{ order.reference_label }}</strong><br><span class="small">{% if order.company_id %}{{ order.company_name }} (company){% elseif order.purchaser_person %}{{ ui('data.person', order.purchaser_person) }}{% else %}{{ order.purchaser_name ?: order.purchaser_email }}{% endif %}</span></td>
						<td>{{ order.number }}<br><span class="small">{{ order.when }}</span></td>
						<td class="cell-text">{{ order.bought }}</td>
						<td>{{ order.total_label }}</td>
						<td>{{ ui('feedback.badge', {label: order.status_label, tone: order.status_tone}) }}{% if order.status_note %}<br><span class="small">{{ order.status_note }}</span>{% endif %}</td>
						<td class="cell-actions">{{ ui('action.link', {label: 'Open', variant: 'secondary', size: 'small', href: order.href, aria_label: 'Open order ' ~ order.number, icon: 'action-open'}) }}</td>
					</tr>
				{% endfor %}
			{% endblock %}
			{% endembed %}
			{% else %}{{ ui('feedback.empty', {summary: filtered ? 'No order matches these filters.' : 'No orders yet.'}) }}{% endif %}
		{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}</section>
{% endblock %}
