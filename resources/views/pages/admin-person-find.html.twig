{% extends layout %}
{% block page_body %}
	{#
		Find a person (owner, 2026-10-21: "enter their name or their email or their account reference and get back a link to
		their profile or in the case of partial matches, a list of all matches with links to their profiles"). One person found
		opens their profile at once (AdminController::findPerson); here are the rest: each name opens its profile, beside the
		email address and account reference the search matched.
	#}
	{% set ph_kicker = 'Administration' %}
	{% set ph_title = 'Find a person' %}
	{% set ph_lead = 'Type a name, an email address or an account reference. One person found opens their profile.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Search', eyebrow: 'People'}) }}
			<form action="/admin/people/find" method="get">
				{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Name, email address or account reference', for: 'find-person-q', full_width: true, help: 'Part of one is enough, such as a surname, a domain or the last digits of a reference.'})} %}{% block control %}<input id="find-person-q" name="q" value="{{ query }}" maxlength="120" autocomplete="off" autofocus {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
				{% endblock %}{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Find', variant: 'primary', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
			</form>
		{% endblock %}{% endembed %}
		{% if query %}
			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
				{{ ui('layout.section-head', {heading: matches ? (matches|length == 1 ? '1 person' : matches|length ~ ' people') ~ ' found' : 'Nobody found', summary: matches ? 'Open a name to see their profile.' : 'Nobody\'s name, email address or account reference contains "' ~ query ~ '".'}) }}
				{% if matches %}
					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
						{% block header %}<tr>
							{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 30, label: 'Person'}} %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 32, label: 'Email'}} %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 20, label: 'Account reference'}} %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Company', wide: true}} %}
						</tr>{% endblock %}
						{% block body %}{% for person in matches %}<tr>
							<td>{{ ui('data.person', {name: person.name ?: person.email, href: '/admin/people/' ~ person.id}) }}{% if person.status != 'active' %} {{ ui('feedback.badge', {label: person.status|replace({'_': ' '})|capitalize, tone: 'warning'}) }}{% endif %}</td>
							<td>{{ person.email }}</td>
							<td class="mono">{{ person.account_reference|account_reference }}</td>
							<td>{{ person.company_name ?: 'Private' }}</td>
						</tr>{% endfor %}{% endblock %}
					{% endembed %}
				{% endif %}
			{% endblock %}{% endembed %}
		{% endif %}
	</section>
{% endblock %}
