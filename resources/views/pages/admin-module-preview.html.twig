{% extends layout %}
{% block page_body %}
	{% set ph_compact = 1 %}
	{% set ph_back_href = '/admin/courses/'~course.id %}
	{% set ph_back_label = 'Course editor' %}
	{% set ph_title = module.title %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-preview-banner">
		<div class="container-fluid cl-container-course py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
			<div>
				<strong>Administrator preview</strong> — no learner progress or results are recorded.
			</div>
			<div class="d-flex gap-2">
				<a class="btn btn-sm btn-light" href="/admin/courses/{{ course.id }}/preview">Course preview</a><a class="btn btn-sm btn-light" href="/admin/courses/{{ course.id }}/modules/{{ module.id }}">Edit module</a>
			</div>
		</div>
	</section>
	{% if course.presentation_css %}
		<style data-course-presentation>{{ course.presentation_css|raw }}</style>
	{% endif %}
	<section class="container-fluid cl-container-course py-5">
		<article>
			<header class="cl-module-header">
				<span class="cl-kicker text-primary">Module {{ module.position }}</span>
				<h1 class="display-5 fw-bold">
					{{ module.title }}
				</h1>
				{% if module.subtitle %}
					<p class="lead">
						{{ module.subtitle }}
					</p>
				{% endif %}
			</header>
			<div class="cl-course-presentation">
				{% if module.learning_outcomes_html %}
					<section class="cl-outcomes outcomes">
						<span class="cl-kicker text-primary eyebrow">Learning outcomes</span>{{ module.learning_outcomes_html|raw }}
					</section>
				{% endif %}
				<div class="cl-course-content">
					<div class="module-body">
						{{ module.content_html|raw }}
						{% if module.summary_html %}
							<section class="cl-module-summary sub s-summary">
								<h2>
									Module summary
								</h2>
								<div class="sub-inner">
									{{ module.summary_html|raw }}
								</div>
							</section>
						{% endif %}
					</div>
				</div>
			</div>
			{% if assessment %}
				<section class="cl-assessment-section">
					<span class="cl-kicker text-primary">Assessment preview</span>
					<h2>
						{{ assessment.title }}
					</h2>
					<p class="text-body-secondary">
						Correct answers are highlighted for administrator quality assurance. Answers cannot be submitted from this preview.
					</p>
					{% for question_index, question in assessment.questions %}
						<div class="card mb-3">
							<div class="card-body">
								<h3 class="h6">
									Question {{ question_index + 1 }}
								</h3>
								{{ question.question_html|raw }}
								<div class="list-group mt-3">
									{% for option in question.options %}
										<div class="list-group-item d-flex justify-content-between align-items-start gap-3 {{ option.is_correct ? 'border-success bg-success-subtle' : '' }}">
											<div>
												{{ option.option_html|raw }}
											</div>
											{% if option.is_correct %}
												<span class="badge text-bg-success flex-shrink-0">✓ Correct answer</span>
											{% endif %}
										</div>
									{% endfor %}
								</div>
								{% if question.explanation_html %}
									<div class="alert alert-light border mt-3 mb-0">
										<strong>Answer explanation</strong>
										<div class="mt-1">
											{{ question.explanation_html|raw }}
										</div>
									</div>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</section>
			{% endif %}
			<div class="cl-module-actions">
				{% if previous_module %}
					<a class="btn btn-outline-primary" href="/admin/courses/{{ course.id }}/preview/modules/{{ previous_module.id }}">← Previous</a>
				{% endif %}
				<a class="btn btn-outline-secondary" href="/admin/courses/{{ course.id }}/preview">Course overview</a>
				{% if next_module %}
					<a class="btn btn-primary ms-auto" href="/admin/courses/{{ course.id }}/preview/modules/{{ next_module.id }}">Next module →</a>
				{% endif %}
			</div>
		</article>
	</section>
{% endblock %}
