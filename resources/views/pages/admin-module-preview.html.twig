{% extends layout %}
{% block page_body %}
	{% set ph_compact = 1 %}
	{% set ph_back_href = '/admin/courses/'~course.id %}
	{% set ph_back_label = 'Course editor' %}
	{% set ph_title = module.title %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-preview-banner">
		<div class="container-fluid cl-container-course py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
			<div>
				<strong>Administrator preview</strong> — no learner progress or results are recorded.
			</div>
			{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

				{{ ui('action.link', {label: 'Course preview', variant: 'secondary', size: 'small', href: '/admin/courses/' ~ (course.id) ~ '/preview'}) }}{{ ui('action.link', {label: 'Edit module', variant: 'secondary', size: 'small', href: '/admin/courses/' ~ (course.id) ~ '/modules/' ~ (module.id)}) }}

{% endblock %}
{% endembed %}
		</div>
	</section>
	{% if course.presentation_css %}
		<style data-course-presentation>{{ course.presentation_css|raw }}</style>
	{% endif %}
	<section class="cl-page-section container-fluid cl-container-course py-5">
		<article>
			<header class="cl-module-header">
				<span class="cl-kicker text-primary">Module {{ module.position }}</span>
				<h1 class="display-5 fw-bold">
					{{ module.title }}
				</h1>
				{% if module.subtitle %}
					<p class="lead">
						{{ module.subtitle }}
					</p>
				{% endif %}
			</header>
			<div class="cl-course-presentation">
				{% if module.learning_outcomes_html %}
					<section class="cl-outcomes outcomes">
						<span class="cl-kicker text-primary cl-ui-eyebrow">Learning outcomes</span>{{ module.learning_outcomes_html|raw }}
					</section>
				{% endif %}
				<div class="cl-course-content">
					<div class="module-body">
						{{ module.content_html|raw }}
						{% if module.summary_html %}
							<section class="cl-module-summary sub s-summary">
								<h2>
									Module summary
								</h2>
								<div class="sub-inner">
									{{ module.summary_html|raw }}
								</div>
							</section>
						{% endif %}
					</div>
				</div>
			</div>
			{% if assessment %}
				<section class="cl-assessment-section">
					<span class="cl-kicker text-primary">Assessment preview</span>
					<h2>
						{{ assessment.title }}
					</h2>
					<p class="text-body-secondary">
						Correct answers are highlighted for administrator quality assurance. Answers cannot be submitted from this preview.
					</p>
					{% for question_index, question in assessment.questions %}
						{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

								<h3 class="h6">
									Question {{ question_index + 1 }}
								</h3>
								{{ question.question_html|raw }}
								{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

									{% for option in question.options %}
										{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

											<div>
												{{ option.option_html|raw }}
											</div>
											{% if option.is_correct %}
												{{ ui('feedback.badge', {label: '✓ Correct answer', tone: 'success'}) }}
											{% endif %}
										{% if option.is_correct %}{{ ui('feedback.badge', {label: 'Correct', tone: 'success'}) }}{% endif %}
{% endblock %}
{% endembed %}
									{% endfor %}

{% endblock %}
{% endembed %}
								{% if question.explanation_html %}
									{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

										<strong>Answer explanation</strong>
										<div class="mt-1">
											{{ question.explanation_html|raw }}
										</div>

{% endblock %}
{% endembed %}
								{% endif %}

{% endblock %}
{% endembed %}
					{% endfor %}
				</section>
			{% endif %}
			<div class="cl-module-actions">
				{% if previous_module %}
					{{ ui('action.link', {label: '← Previous', variant: 'secondary', size: 'normal', href: '/admin/courses/' ~ (course.id) ~ '/preview/modules/' ~ (previous_module.id)}) }}
				{% endif %}
				{{ ui('action.link', {label: 'Course overview', variant: 'secondary', size: 'normal', href: '/admin/courses/' ~ (course.id) ~ '/preview'}) }}
				{% if next_module %}
					{{ ui('action.link', {label: 'Next module →', variant: 'primary', size: 'normal', href: '/admin/courses/' ~ (course.id) ~ '/preview/modules/' ~ (next_module.id)}) }}
				{% endif %}
			</div>
		</article>
	</section>
{% endblock %}
