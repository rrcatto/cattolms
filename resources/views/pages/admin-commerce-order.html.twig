{#
	One order for ADMIN (owner, 2026-10-18: "Nothing tells me in plain English what happened"). The page
	head names the order and, first, the buyer's account reference. Then: what happened, in sentences,
	with where the order stands and what to do next (OrderStory); the form for that next step, when there
	is one; what was bought; the money; everything recorded for the order together (owner, 2026-10-19):
	its Money Ledger lines, Payment Events and Commerce Trail, each linking to its own page; the documents;
	the customer; and refunds, whose forms stay folded until opened.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/commerce/orders' %}{% set ph_back_label = 'Orders & Payments' %}
	{% set ph_title = 'Order CL-' ~ '%08d'|format(order.id) %}
	{% set ph_lead = 'Account ' ~ account_reference ~ ' · ' ~ (snapshot.company_name|default('') ?: snapshot.purchaser_name) %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'What happened', heading_level: 2}) }}
			{% if snapshot.simulation|default(false) %}{{ ui('feedback.notice', {tone: 'warning', heading: site_simulation}) }}{% endif %}
			<p data-order-status>{{ ui('feedback.badge', {label: story.status.label, tone: story.status.tone}) }}{% if story.status.note %} {{ story.status.note }}{% endif %}</p>
			{% for sentence in story.summary %}
				<p>{{ sentence }}</p>
			{% endfor %}
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: story.next.tone, heading: story.next.heading})} %}{% block body %} {{ story.next.text }}{% endblock %}{% endembed %}
		{% endblock %}{% endembed %}
	</section>
	{% if can_confirm and payment_method == 'eft' and order.state in ['awaiting_payment','cancelled'] %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Record the EFT payment', heading_level: 2, summary: 'Fill this in when the money shows on your bank statement with the reference ' ~ account_reference ~ '. If more than ' ~ due_label ~ ' arrived, the order is paid and the rest goes to the customer’s wallet. If less arrived, it is recorded and the order waits for the rest.'}) }}
			<form action="/admin/commerce/orders/{{ order.id }}/confirm-bank" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ confirmation_key }}">
				{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 2})} %}{% block body %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Amount that arrived (' ~ order.currency ~ ')', for: 'bank-amount', required: true})} %}{% block control %}<input id="bank-amount" name="amount" inputmode="decimal" value="{{ '%d.%02d'|format(due_minor // 100, due_minor % 100) }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Date it arrived', for: 'bank-received-on', required: true})} %}{% block control %}<input id="bank-received-on" type="date" name="received_on" value="{{ today }}" max="{{ today }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Time it arrived', for: 'bank-received-time', help: 'Optional, such as 14:30.'})} %}{% block control %}<input id="bank-received-time" type="time" name="received_time" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'The bank’s reference for it', for: 'bank-reference', required: true})} %}{% block control %}<input id="bank-reference" name="bank_reference" maxlength="200" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Where you saw it', for: 'bank-reason', required: true, help: 'Such as: FNB business account statement, 18 October.'})} %}{% block control %}<textarea id="bank-reason" name="reason" maxlength="2000" required {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}
				{% endblock %}{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Record the EFT payment', variant: 'primary', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
			</form>
		{% endblock %}{% endembed %}
	</section>
	{% endif %}
	{% if can_reconcile and order.state == 'manual_review' %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Release the order', heading_level: 2, summary: 'Release it once you have checked the payment and who it is for. Access opens when you do.'}) }}
			<form action="/admin/commerce/orders/{{ order.id }}/release-review" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'What you checked', for: 'review-reason', required: true})} %}{% block control %}<textarea id="review-reason" name="reason" maxlength="2000" required {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Release paid order', variant: 'primary', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
			</form>
		{% endblock %}{% endembed %}
	</section>
	{% endif %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'What was bought', heading_level: 2}) }}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 40, label: 'Item'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 15, label: 'Access', wide: true}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 15, label: 'Price'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 15, label: 'Discount'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 15, label: 'Refunded', wide: true}} %}</tr>{% endblock %}
			{% block body %}{% for item in items %}<tr><td class="cell-text">{{ item.product_type == 'company_credit' ? item.quantity ~ ' course credits: ' : '' }}{{ item.title }}{% if item.is_bundle %}{% if item.grants %}{% for grant in item.grants %}<br><span class="small">{{ grant.title }}: {{ grant.outcome }}{{ grant.state == 'revoked' ? ' (withdrawn)' : '' }}</span>{% endfor %}{% else %}<br><span class="small">Includes {{ item.includes }}</span>{% endif %}{% endif %}</td><td>{{ item.access_period_seconds // 86400 }} days</td><td>{{ item.amount_label }}</td><td>{{ item.discount_label ?: '—' }}</td><td>{{ item.refunded_minor > 0 ? item.refunded_label : '—' }}</td></tr>{% endfor %}{% endblock %}
			{% endembed %}
			{{ ui('data.key-value-list', {items: totals}) }}
			{% if snapshot.promotion|default(null) %}<p class="help">Promotion {{ snapshot.promotion.code }} ({{ snapshot.promotion.name }}) took {{ snapshot.promotion.label }} off {{ promotion_eligible_label }} of courses. Each course can be refunded up to what was paid for it.</p>{% endif %}
		{% endblock %}{% endembed %}
	</section>
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Money', heading_level: 2, summary: 'What was paid, refunded and charged for this order. Each movement is under Everything recorded for this order.'}) }}
			{% set money_items = [{label: 'Order total', value: total_label}, {label: 'Paid', value: paid_label}] %}
			{% if due_minor > 0 and order.state == 'awaiting_payment' %}{% set money_items = money_items|merge([{label: 'Still due', value: due_label}]) %}{% endif %}
			{% if story.refunded_label %}{% set money_items = money_items|merge([{label: 'Refunded', value: story.refunded_label}]) %}{% endif %}
			{% if story.fees_label %}{% set money_items = money_items|merge([{label: 'Payment fees', value: story.fees_label}]) %}{% endif %}
			{% if wallet_balance_label is not null %}{% set money_items = money_items|merge([{label: 'Wallet credit the customer holds now', value: wallet_balance_label}]) %}{% endif %}
			{{ ui('data.key-value-list', {items: money_items}) }}
			{% if wallet_balance_label is not null %}
			{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}{% block body %}
				{{ ui('action.link', {label: 'Open the customer’s wallet', variant: 'secondary', size: 'small', href: wallet_href}) }}
			{% endblock %}{% endembed %}
			{% endif %}
		{% endblock %}{% endembed %}
	</section>
	<section class="cl-page-section" id="order-records">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Everything recorded for this order', heading_level: 2, summary: 'Its Money Ledger lines, its Payment Events and its Commerce Trail, oldest first. Open one to see it on its own page.'}) }}
			{% if can_view_payments %}
			<h3 class="h5">Money Ledger</h3>
			{% if story.ledger %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'When', wide: true}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 42, label: 'What happened'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 13, label: 'Money in'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 13, label: 'Money out'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Wallet credit', wide: true}} %}</tr>{% endblock %}
			{% block body %}{% for line in story.ledger %}<tr data-order-record="ledger"><td class="small">{{ line.when }}</td><td class="cell-text"><a href="{{ line.href }}">{{ line.sentence }}</a></td><td>{{ line.money_in }}</td><td>{{ line.money_out }}</td><td>{{ line.wallet }}</td></tr>{% endfor %}{% endblock %}
			{% endembed %}
			{% else %}<p>No money has moved for this order yet.</p>{% endif %}
			<h3 class="h5">Payment Events</h3>
			{% if story.payment_events %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'When', wide: true}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 64, label: 'What happened'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Amount'}} %}</tr>{% endblock %}
			{% block body %}{% for event in story.payment_events %}<tr data-order-record="payment"><td class="small">{{ event.when }}</td><td class="cell-text"><a href="{{ event.href }}">{{ event.sentence }}</a></td><td>{{ event.amount }}</td></tr>{% endfor %}{% endblock %}
			{% endembed %}
			{% else %}<p>No payment has been started for this order yet.</p>{% endif %}
			{% endif %}
			<h3 class="h5">Commerce Trail</h3>
			{% if story.timeline %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'When'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 62, label: 'What happened'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 20, label: 'By', wide: true}} %}</tr>{% endblock %}
			{% block body %}{% for step in story.timeline %}<tr data-order-step data-order-record="trail"><td class="small">{{ step.when }}</td><td class="cell-text"><a href="{{ step.href }}">{{ step.text }}</a></td><td class="small">{{ step.by }}</td></tr>{% endfor %}{% endblock %}
			{% endembed %}
			{% else %}<p>Nothing has been recorded for this order yet.</p>{% endif %}
		{% endblock %}{% endembed %}
	</section>
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Documents', heading_level: 2, summary: 'Each document stays exactly as it was issued.'}) }}
			{% for document in documents %}
				<p data-document-kind="{{ document.kind }}" data-design-version="{{ document.template_version_number }}">{{ ui('action.link', {label: document.kind|replace({'_':' '})|capitalize ~ ' ' ~ document.number, variant: 'secondary', size: 'small', href: '/admin/commerce/orders/' ~ order.id ~ '/documents/' ~ document.id, new_window: true}) }} <a href="/admin/commerce/orders/{{ order.id }}/documents/{{ document.id }}?download=1">Download the PDF</a> <span class="small">issued {{ document.issued_at|date('j M Y \\a\\t H:i') }}</span></p>
			{% else %}
				<p>No document has been issued yet. The invoice is issued when the order is placed.</p>
			{% endfor %}
		{% endblock %}{% endembed %}
	</section>
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Customer', heading_level: 2, summary: 'As they were when the order was placed.'}) }}
			{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: false})} %}{% block body %}
				<div>{{ ui('data.key-value-list', {items: [{label: 'Account reference', value: account_reference}, {label: 'Name', value: snapshot.purchaser_name}, {label: 'Email', value: snapshot.purchaser_email}]|merge(snapshot.company_name|default('') ? [{label: 'Bought for', value: snapshot.company_name}] : [])}) }}</div>
				<div><h3 class="h5">Billed to</h3>{% include '@platform/partials/billing-address.html.twig' %}</div>
			{% endblock %}{% endembed %}
		{% endblock %}{% endembed %}
	</section>
	{% if refunds or (can_refund and order.state in ['paid','fulfilled','manual_review','partially_refunded']) %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Refunds', heading_level: 2, summary: 'The Refund Policy refunds a course only before it has started, within ' ~ refund_window ~ ' of the purchase. Every course starts when it is paid, so a refund outside the policy needs a written reason.'}) }}
			{% for refund in refunds %}
				<p data-refund-id="{{ refund.id }}"><strong>{{ refund.approved_at|date('j M Y') }}:</strong> {{ refund.actor_name }} refunded {{ refund.amount_label }} as {{ refund.destination == 'money_back' ? 'money back' : 'wallet credit' }}{% if refund.wallet_part_minor > 0 %}, {{ refund.wallet_part_label }} of it back to the wallet it was paid from{% endif %}{% for line in refund.deduction_lines %}, less {{ line }}{% endfor %}. {% if refund.payout_paid_at %}Paid back on {{ refund.payout_paid_at|date('j M Y') }}, reference {{ refund.payout_reference }}.{% elseif refund.to_pay %}{{ ui('feedback.badge', {label: 'To pay by ' ~ refund.payout_due_at|date('j M Y'), tone: 'warning', size: 'small'}) }}{% endif %}<br><span class="small">Reason: {{ refund.reason }}{% if refund.override_reason %} · Outside the Refund Policy ({{ refund.policy_refusal }}) · Override reason: {{ refund.override_reason }}{% endif %}</span></p>
				{% if refund.to_pay and can_refund %}
				<form action="/admin/commerce/refunds/{{ refund.id }}/payout" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">
					<p>{{ refund.payout_instruction }}</p>
					{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 2})} %}{% block body %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Date you paid it', for: 'payout-date-' ~ refund.id, required: true})} %}{% block control %}<input id="payout-date-{{ refund.id }}" type="date" name="paid_on" max="{{ today }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Stitch or bank reference', for: 'payout-reference-' ~ refund.id, required: true})} %}{% block control %}<input id="payout-reference-{{ refund.id }}" name="reference" maxlength="200" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
					{% endblock %}{% endembed %}
					{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Record the refund payment', variant: 'primary', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
				</form>
				{% endif %}
			{% endfor %}
			{% if can_refund and order.state in ['paid','fulfilled','manual_review','partially_refunded'] %}
			{% for item in items %}
				{% if item.refunded_minor < item.paid_minor %}
				{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Refund ' ~ item.title, summary: item.remaining_label ~ ' can be refunded' ~ (item.rule_refusals ? ', outside the Refund Policy' : ''), id: 'refund-item-' ~ item.id})} %}{% block body %}
					{% if order.company_id and not item.unissued and (not item.latest_refundable or item.latest_refundable.commerce_order_item_id != item.id) %}<p>Refund the newer unused credits for this course and period first.</p>{% else %}
					{% if item.rule_refusals %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Outside the Refund Policy'})} %}{% block body %} {{ item.rule_refusals|join(' ') }} Approving it overrides the policy, so give your reason below.{% endblock %}{% endembed %}{% else %}<p>Within the Refund Policy: not started, and within {{ refund_window }} of the purchase.</p>{% endif %}
					{% for quote in item.quotes %}<p class="help"><strong>{{ quote.label }}, if all of it is refunded:</strong> {{ quote.text }}</p>{% endfor %}
					<form action="/admin/commerce/orders/{{ order.id }}/refund" method="post">
						<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ item.refund_key }}"><input type="hidden" name="item_id" value="{{ item.id }}">
						{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 2})} %}{% block body %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Why the refund is given', for: 'refund-basis-' ~ item.id, required: true})} %}{% block control %}<select id="refund-basis-{{ item.id }}" name="basis" required {{ ui_field_attrs(props) }}><option value="voluntary">The customer asked</option><option value="statutory">A legal right</option><option value="service_failure">The course failed</option><option value="goodwill">Goodwill</option></select>{% endblock %}{% endembed %}
							{% if order.company_id %}{% embed ui_template('form.field') with {props: ui_props('form.field', {label: item.unissued ? 'Credits not yet issued to refund' : 'Unused credits to refund', for: 'refund-quantity-' ~ item.id, required: true})} %}{% block control %}<input id="refund-quantity-{{ item.id }}" type="number" name="quantity" min="1" max="{{ item.refundable_quantity }}" value="1" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}{% else %}
							<input type="hidden" name="quantity" value="1">{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Amount to refund (' ~ order.currency ~ ')', for: 'refund-amount-' ~ item.id, required: true, help: 'Before fees are taken off. Enter less to give a smaller refund.'})} %}{% block control %}<input id="refund-amount-{{ item.id }}" name="amount" inputmode="decimal" value="{{ '%d.%02d'|format((item.paid_minor - item.refunded_minor) // 100, (item.paid_minor - item.refunded_minor) % 100) }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Refund it as', for: 'refund-destination-' ~ item.id, required: true})} %}{% block control %}<select id="refund-destination-{{ item.id }}" name="destination" required {{ ui_field_attrs(props) }}><option value="wallet">Wallet credit</option><option value="money_back">Money back</option></select>{% endblock %}{% endembed %}{% endif %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Your reason', for: 'refund-reason-' ~ item.id, required: true})} %}{% block control %}<textarea id="refund-reason-{{ item.id }}" name="reason" maxlength="2000" required {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}
							{% if item.rule_refusals %}{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Why you override the Refund Policy', for: 'refund-override-' ~ item.id, required: true, help: 'Kept with the refund and shown only to ADMIN.'})} %}{% block control %}<textarea id="refund-override-{{ item.id }}" name="override_reason" minlength="5" maxlength="2000" required {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}{% endif %}
						{% endblock %}{% endembed %}
						{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: item.rule_refusals ? 'Override the Refund Policy and approve refund' : 'Approve refund and issue credit note', variant: 'danger', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
					</form>
					{% endif %}
				{% endblock %}{% endembed %}
				{% endif %}
			{% endfor %}
			{% endif %}
		{% endblock %}{% endembed %}
	</section>
	{% endif %}
{% endblock %}
