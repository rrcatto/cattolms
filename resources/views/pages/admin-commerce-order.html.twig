{% extends layout %}
{% block page_body %}
    {% set ph_back_href = '/admin/commerce/orders' %}{% set ph_back_label = 'Orders and payments' %}
    {% set ph_kicker = 'Payment administration' %}{% set ph_title = 'Order CL-' ~ '%08d'|format(order.id) %}
    {% set ph_lead = snapshot.billing.name ~ ' · ' ~ total_label ~ ' · ' ~ order.state|replace({'_':' '}) %}
    {% include '@platform/partials/page-head.html.twig' %}
    <section class="cl-page-section">
        {% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
            {{ ui('layout.section-head', {heading: 'Order history', heading_level: 2, summary: 'The invoice and payment records remain intact when a refund is approved.'}) }}
            {% if snapshot.simulation|default(false) %}{{ ui('feedback.notice', {tone: 'warning', heading: site_simulation}) }}{% endif %}
            {% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: false})} %}{% block body %}
                <div><h3 class="h5">Billed to</h3>{% include '@platform/partials/billing-address.html.twig' %}</div>
                <div><h3 class="h5">Purchaser</h3><p>{{ snapshot.purchaser_name }}<br>{{ snapshot.purchaser_email }}{% if snapshot.company_name|default('') %}<br>For {{ snapshot.company_name }}{% endif %}</p></div>
            {% endblock %}{% endembed %}
            <p class="help">Billing and purchaser details are the order's immutable snapshot from placement.</p>
            <p><strong>Placed:</strong> {{ order.placed_at|date('d M Y H:i') }} · <strong>Payment due:</strong> {{ order.payment_due_at|date('d M Y H:i') }} · <strong>Method:</strong> {{ payment_method|upper }}</p>
            <p><strong>Account reference:</strong> {{ account_reference }} · <strong>Paid:</strong> {{ paid_label }}{% if due_minor > 0 and order.state == 'awaiting_payment' %} · <strong>Still due:</strong> {{ due_label }}{% endif %}{% if wallet_balance_label is not null %} · <strong>Wallet:</strong> <a href="{{ wallet_href }}">{{ wallet_balance_label }}</a>{% endif %}</p>
            {% for item in items %}<p><strong>{{ item.title }}</strong> · {{ item.access_period_seconds / 86400 }} days · {{ item.quantity }} {{ item.product_type == 'company_credit' ? 'credits' : 'course access' }} · {{ item.amount_label }}{% if item.discount_label %} · Promotion share {{ item.discount_label }} · Paid {{ item.paid_label }}{% endif %} · Refunded: {{ item.refunded_label }}</p>{% if item.is_bundle %}<p class="help">Includes: {{ item.includes }}</p>{% if item.grants %}<ul class="help">{% for grant in item.grants %}<li>{{ grant.title }}: {{ grant.outcome }} ({{ grant.state|replace({'_': ' '}) }})</li>{% endfor %}</ul>{% endif %}{% endif %}{% endfor %}
            {{ ui('data.key-value-list', {items: totals}) }}
            {% if snapshot.promotion|default(null) %}<p class="help">Promotion {{ snapshot.promotion.code }} ({{ snapshot.promotion.name }}, {{ snapshot.promotion.label }}) was applied to {{ promotion_eligible_label }} of eligible courses. Its discount is shared across those courses in proportion to their prices; each course can be refunded up to what was paid for it.</p>{% endif %}
            <h3 class="h5">Financial documents</h3>
            {% for document in documents %}<p>{{ ui('action.link', {label: document.kind|replace({'_':' '})|capitalize ~ ' ' ~ document.number, variant: 'secondary', size: 'small', href: '/admin/commerce/orders/' ~ order.id ~ '/documents/' ~ document.id, new_window: true}) }} <a href="/admin/commerce/orders/{{ order.id }}/documents/{{ document.id }}?download=1">Download (PDF)</a><br><span class="help">Issued {{ document.issued_at|date('d M Y H:i') }} · drawn in the {{ document.template_name|lower }} design, version {{ document.template_version_number }}</span></p>{% endfor %}
            {% if documents %}<p class="help">Each document is drawn from the values it was issued with, in the design version named on it; a later design, billing profile, course, bundle or promotion does not change it.</p>{% endif %}
            {% if can_view_payments %}<h3 class="h5">Payments and evidence</h3>
            {% if payments %}{% for payment in payments %}<p><strong>{{ payment.gateway == 'wallet' ? 'Wallet' : (payment.gateway == 'manual_bank' ? 'EFT' : 'Card') }}</strong> · {{ '%d.%02d'|format(payment.amount_minor // 100, payment.amount_minor % 100) }} {{ payment.currency }} · {{ payment.state }} · {{ payment.created_at|date('d M Y H:i') }}{% if payment.provider_reference %} · {{ payment.provider_reference }}{% endif %}{% if payment.evidence %}<br>Received {{ payment.evidence.received_at|date('d M Y H:i') }}; ADMIN reason: {{ payment.evidence.reason }}{% endif %}</p>{% endfor %}{% else %}<p>No payment has been confirmed.</p>{% endif %}{% endif %}
            {% if refunds %}<h3 class="h5">Approved refunds</h3>{% for refund in refunds %}<p>{{ refund.amount_label }} · {{ refund.quantity }} unit(s) · {{ refund.basis }} · {{ refund.actor_name }} · {{ refund.approved_at|date('d M Y H:i') }}<br>{{ refund.reason }}<br><strong>{{ refund.destination == 'money_back' ? 'Money back' : 'Wallet credit' }}:</strong> {{ refund.net_label }}{% if refund.wallet_part_minor > 0 %} · {{ refund.wallet_part_label }} back to the wallet it was paid from{% endif %}{% for line in refund.deduction_lines %} · less {{ line }}{% endfor %}{% if refund.payout_paid_at %} · Paid {{ refund.payout_paid_at|date('d M Y') }}, reference {{ refund.payout_reference }}{% elseif refund.to_pay %} · {{ ui('feedback.badge', {label: 'To pay by ' ~ refund.payout_due_at|date('d M Y'), tone: 'warning', size: 'small'}) }}{% endif %}{% if refund.override_reason %}<br>{{ ui('feedback.badge', {label: 'Refund Policy override', tone: 'warning', size: 'small'}) }} The Refund Policy refused this refund: {{ refund.policy_refusal }} Override reason: {{ refund.override_reason }}{% endif %}</p>
            {% if refund.to_pay and can_refund %}<form action="/admin/commerce/refunds/{{ refund.id }}/payout" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><p>{{ refund.payout_instruction }}</p>
                {% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 2})} %}{% block body %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Date paid', for: 'payout-date-' ~ refund.id, required: true})} %}{% block control %}<input id="payout-date-{{ refund.id }}" type="date" name="paid_on" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Stitch or bank reference', for: 'payout-reference-' ~ refund.id, required: true})} %}{% block control %}<input id="payout-reference-{{ refund.id }}" name="reference" maxlength="200" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
                {% endblock %}{% endembed %}
                {% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Record the refund payment', variant: 'primary', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
            </form>{% endif %}{% endfor %}{% endif %}
        {% endblock %}{% endembed %}
        {% if can_confirm and payment_method == 'eft' and order.state in ['awaiting_payment','cancelled'] %}
        {% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
            {{ ui('layout.section-head', {heading: 'Confirm bank payment', heading_level: 2, summary: 'Record the amount the bank shows, from independent bank evidence. The payer quotes the account reference ' ~ account_reference ~ '. An amount above what is due pays the order and the rest goes to the payer’s wallet; an amount below it is recorded and the order waits for the rest.'}) }}
            <form action="/admin/commerce/orders/{{ order.id }}/confirm-bank" method="post">
                <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ confirmation_key }}">
                {% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 2})} %}{% block body %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Amount received (' ~ order.currency ~ ')', for: 'bank-amount', required: true})} %}{% block control %}<input id="bank-amount" name="amount" inputmode="decimal" value="{{ '%d.%02d'|format(due_minor // 100, due_minor % 100) }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Bank reference', for: 'bank-reference', required: true})} %}{% block control %}<input id="bank-reference" name="bank_reference" maxlength="200" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Date/time received with timezone', for: 'bank-received', required: true, help: 'Example: 2026-09-23T14:30+02:00'})} %}{% block control %}<input id="bank-received" name="received_at" placeholder="2026-09-23T14:30+02:00" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'ADMIN reason and evidence source', for: 'bank-reason', required: true})} %}{% block control %}<textarea id="bank-reason" name="reason" maxlength="2000" required {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}
                {% endblock %}{% endembed %}
                {% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Confirm received payment', variant: 'primary', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
            </form>
        {% endblock %}{% endembed %}
        {% endif %}
        {% if can_reconcile and order.state == 'manual_review' %}
        {% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
            {{ ui('layout.section-head', {heading: 'Manual review', heading_level: 2, summary: 'Release only after verifying the paid order and its learner or company relationship.'}) }}
            <form action="/admin/commerce/orders/{{ order.id }}/release-review" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">
                {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Reconciliation reason', for: 'review-reason', required: true})} %}{% block control %}<textarea id="review-reason" name="reason" maxlength="2000" required {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}
                {% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Release paid order', variant: 'primary', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
            </form>
        {% endblock %}{% endembed %}
        {% endif %}
        {% if can_refund and order.state in ['paid','fulfilled','manual_review','partially_refunded'] %}
        {% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
            {{ ui('layout.section-head', {heading: 'Approve a refund', heading_level: 2, summary: 'Each refund creates a credit note. What was paid from the wallet goes back to the wallet; the rest goes as wallet credit or as money back, which you pay outside the LMS and then record.'}) }}
            <p>The <a href="/refunds">Refund Policy</a> gives no refund once a course has started, and every course starts when its payment is confirmed. A course that has not started is refundable within {{ refund_window }} of the purchase. Company credits are refundable within {{ refund_window }} of their purchase, unused credits only, as wallet credit. A refund outside that rule needs a written override reason, which is kept with the refund and shown only here.</p>
            <p>Deductions from what was paid by card or EFT: card, wallet credit, the Stitch transaction fee; card, money back, the Stitch transaction fee and refund fee; EFT, money back, the EFT refund fee; EFT, wallet credit, nothing.</p>
            <p>Record the legal or discretionary basis and a specific decision reason. Full individual item refunds revoke that course access immediately; learning history remains. Refunding all that was paid for a bundle revokes only the access that bundle granted and no other bundle still covers; courses the learner had from another source are kept.</p>
            {% for item in items %}
                {% if item.refunded_minor < item.paid_minor %}
                <h3 class="h5">{{ item.title }} · {{ item.remaining_label }} remaining</h3>
                {% if order.company_id and not item.unissued and (not item.latest_refundable or item.latest_refundable.commerce_order_item_id != item.id) %}<p>Refund newer unused credits for this course and period first.</p>{% else %}
                {% if item.rule_refusals %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Outside the Refund Policy'})} %}{% block body %} {{ item.rule_refusals|join(' ') }} Approving this refund overrides the rule and needs an override reason.{% endblock %}{% endembed %}{% else %}<p class="help">Within the Refund Policy: not started, and within {{ refund_window }} of the purchase.</p>{% endif %}
                {% for quote in item.quotes %}<p class="help"><strong>{{ quote.label }}, if refunded in full:</strong> {{ quote.text }}</p>{% endfor %}
                <form action="/admin/commerce/orders/{{ order.id }}/refund" method="post">
                    <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ item.refund_key }}"><input type="hidden" name="item_id" value="{{ item.id }}">
                    {% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 2})} %}{% block body %}
                        {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Refund basis', for: 'refund-basis-' ~ item.id, required: true})} %}{% block control %}<select id="refund-basis-{{ item.id }}" name="basis" required {{ ui_field_attrs(props) }}><option value="voluntary">Voluntary</option><option value="statutory">Statutory right</option><option value="service_failure">Service failure</option><option value="goodwill">Goodwill</option></select>{% endblock %}{% endembed %}
                        {% if order.company_id %}{% embed ui_template('form.field') with {props: ui_props('form.field', {label: item.unissued ? 'Unissued credit units' : 'Unused credit units', for: 'refund-quantity-' ~ item.id, required: true})} %}{% block control %}<input id="refund-quantity-{{ item.id }}" type="number" name="quantity" min="1" max="{{ item.refundable_quantity }}" value="1" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}{% else %}
                        <input type="hidden" name="quantity" value="1">{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Amount (' ~ order.currency ~ ')', for: 'refund-amount-' ~ item.id, required: true, help: 'Before deductions. Enter less than the full amount to give a smaller refund.'})} %}{% block control %}<input id="refund-amount-{{ item.id }}" name="amount" inputmode="decimal" value="{{ '%d.%02d'|format((item.paid_minor - item.refunded_minor) // 100, (item.paid_minor - item.refunded_minor) % 100) }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
                        {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Refund goes to', for: 'refund-destination-' ~ item.id, required: true})} %}{% block control %}<select id="refund-destination-{{ item.id }}" name="destination" required {{ ui_field_attrs(props) }}><option value="wallet">Wallet credit</option><option value="money_back">Money back</option></select>{% endblock %}{% endembed %}{% endif %}
                        {% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Decision reason', for: 'refund-reason-' ~ item.id, required: true})} %}{% block control %}<textarea id="refund-reason-{{ item.id }}" name="reason" maxlength="2000" required {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}
                        {% if item.rule_refusals %}{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Override reason', for: 'refund-override-' ~ item.id, required: true, help: 'Why this refund is approved although the Refund Policy refuses it. Kept with the refund.'})} %}{% block control %}<textarea id="refund-override-{{ item.id }}" name="override_reason" minlength="5" maxlength="2000" required {{ ui_field_attrs(props) }}></textarea>{% endblock %}{% endembed %}{% endif %}
                    {% endblock %}{% endembed %}
                    {% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: item.rule_refusals ? 'Override the Refund Policy and approve refund' : 'Approve refund and issue credit note', variant: 'danger', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}
                </form>
                {% endif %}
                {% endif %}
            {% endfor %}
        {% endblock %}{% endembed %}
        {% endif %}
    </section>
{% endblock %}
