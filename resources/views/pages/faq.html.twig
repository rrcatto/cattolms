{% extends layout %}
{% block page_body %}
	{#
		Frequently asked questions (owner, 2026-10-20: "the grading belongs elsewhere, in a FAQ … Use the <details>
		<summary> tags … Leave the answers concealed so the user has to click the question … style the tags to
		look like an accordion … an svg icon to the left of it. Have a Question category with the actual question
		on a second line"). Each question is the canonical accordion, closed until it is opened; a link to its
		id (/faq#grading) opens it. The answers state the site's own rules and link to the pages that hold them.
	#}
	{% set ph_kicker = 'Help' %}
	{% set ph_title = 'Frequently asked questions' %}
	{% set ph_lead = 'Short answers about buying, paying, access, grading, certificates and refunds. Choose a question to see its answer.' %}
	{% set ph_hero %}{% include '@platform/partials/artwork/faq-hero.html.twig' %}{% endset %}
	{% include '@CattoPHP/page/head.html.twig' %}
	{% set icon_attributes = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' %}
	{% set icons = {
		buying: '<svg ' ~ icon_attributes ~ '><path d="M3 4h2l2.4 10.2a1.5 1.5 0 0 0 1.5 1.1h7.6a1.5 1.5 0 0 0 1.4-1l1.9-6.3H6.2"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg>',
		paying: '<svg ' ~ icon_attributes ~ '><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 9.5h19"/><path d="M6 14.5h4"/></svg>',
		access: '<svg ' ~ icon_attributes ~ '><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
		grading: '<svg ' ~ icon_attributes ~ '><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>',
		certificates: '<svg ' ~ icon_attributes ~ '><circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.5 7 21l5-2.5 5 2.5-1.5-7.5"/></svg>',
		refunds: '<svg ' ~ icon_attributes ~ '><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4v4h4"/><circle cx="12" cy="12" r="2.5"/></svg>',
		account: '<svg ' ~ icon_attributes ~ '><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>',
	} %}
	<section class="cl-page-section">
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
			{{ ui('layout.section-head', {heading: 'Questions and answers', summary: 'Not answered here? The Help page explains how the site works, and the Terms and Conditions and the Refund Policy hold the rules.'}) }}
			<div class="cl-faq">
				{# The questions are Help\Faq's, which the FAQPage structured data reads too (owner, 2026-11-06), so the two never differ. #}
				{% for question in faq_questions %}
				{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {id: question.id, eyebrow: question.eyebrow, icon: icons[question.icon], heading: question.question})} %}{% block body %}
					{% for paragraph in question.paragraphs %}
					<p>{{ paragraph|raw }}</p>
					{% endfor %}
					{% if question.scale is defined %}
					{{ ui('data.key-value-list', {items: question.scale}) }}
					{% endif %}
				{% endblock %}{% endembed %}
				{% endfor %}
			</div>
{% endblock %}
{% endembed %}
	</section>
{% endblock %}
