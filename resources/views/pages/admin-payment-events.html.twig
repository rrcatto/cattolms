{#
	Payment Events (owner, 2026-10-18): every state a payment reached, as its gateway or ADMIN reported it
	(commerce_payment_events), filtered by dates, state, gateway, payment and order, searched, sorted and
	paged. Each row is whose account first, then the step as one sentence (MoneyRecords::paymentEventSentence,
	owner 2026-10-18). A row opens its own page.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Administration' %}{% set ph_title = 'Payment Events' %}
	{% set ph_lead = 'Every card, EFT and wallet payment goes through steps: it is started, it waits, and then it goes through or fails. Later it may be refunded. Each line is one step, newest first. What the money did afterwards is in the Money Ledger.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Find steps', summary: 'Search by account reference, name, order number or bank or Stitch reference. Both dates are included.'}) }}
		<form action="/admin/commerce/payment-events" method="get">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
			{% if filters.order_id %}<input type="hidden" name="order" value="{{ filters.order_id }}">{% endif %}
			{% if filters.payment_id %}<input type="hidden" name="payment" value="{{ filters.payment_id }}">{% endif %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Search', full_width: true, for: 'payments-q'})} %}{% block control %}<input id="payments-q" name="q" value="{{ filters.q }}" maxlength="120" placeholder="Account reference, name, order number or reference" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'From', full_width: false, for: 'payments-from'})} %}{% block control %}<input type="date" id="payments-from" name="from" value="{{ filters.from }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'To', full_width: false, for: 'payments-to'})} %}{% block control %}<input type="date" id="payments-to" name="to" value="{{ filters.to }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Step', full_width: false, for: 'payments-state'})} %}{% block control %}<select id="payments-state" name="state" {{ ui_field_attrs(props) }}><option value="">Any step</option>{% for key, label in states %}<option value="{{ key }}" {{ filters.state == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'How it was paid', full_width: false, for: 'payments-gateway'})} %}{% block control %}<select id="payments-gateway" name="gateway" {{ ui_field_attrs(props) }}><option value="">Any way</option>{% for gateway, label in gateways %}<option value="{{ gateway }}" {{ filters.gateway == gateway ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Filter', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-filter'}) }}{{ ui('action.link', {label: 'Clear', variant: 'secondary', size: 'normal', href: '/admin/commerce/payment-events', icon: 'action-clear'}) }}{% endblock %}{% endembed %}
		{% endblock %}{% endembed %}</form>
	{% endblock %}{% endembed %}</section>
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Steps', summary: filtered ? 'The steps that match.' : 'All steps.'}) }}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'payments', pagination: payments_pagination})} %}{% block results %}
			{% if rows %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr>{% for sh in payments_sort_headers %}{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: payments_region, sort_results: payments_results} %}{% endfor %}</tr>{% endblock %}
			{% block body %}
				{% for row in rows %}
					<tr data-payment-event-id="{{ row.id }}" data-payment-state="{{ row.state }}">
						<td class="cell-text">{% if row.account_reference_label %}<strong>{% if row.account_href %}<a href="{{ row.account_href }}">{{ row.account_reference_label }}</a>{% else %}{{ row.account_reference_label }}{% endif %}</strong><br>{% endif %}<span class="small">{% if row.account_person %}{{ ui('data.person', row.account_person) }}{% else %}{{ row.account_label ?: '—' }}{% endif %}</span></td>
						<td class="small">{{ row.when }}</td>
						<td class="cell-text">{% include '@platform/partials/admin/money-sentence.html.twig' with {ms_parts: row.sentence_parts} only %}</td>
						<td>{{ row.amount_label }}</td>
						<td class="cell-actions">{{ ui('action.link', {label: 'Open', variant: 'secondary', size: 'small', href: row.href, aria_label: 'Open payment step ' ~ row.id, icon: 'action-open'}) }}</td>
					</tr>
				{% endfor %}
			{% endblock %}
			{% endembed %}
			{% else %}{{ ui('feedback.empty', {summary: filtered ? 'No event matches these filters.' : 'Nothing has been recorded yet.'}) }}{% endif %}
		{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}</section>
{% endblock %}
