{#
	Payment Events (owner, 2026-10-18): every state a payment reached, as its gateway or ADMIN reported it
	(commerce_payment_events), filtered by dates, state, gateway, payment and order, searched, sorted and
	paged. A row opens its own page.
#}
{% extends layout %}
{% block page_body %}
	{% set ph_kicker = 'Administration' %}{% set ph_title = 'Payment Events' %}
	{% set ph_lead = 'Every state each payment reached, newest first: created, pending, paid, failed, refunded and the rest.' %}
	{% include '@platform/partials/page-head.html.twig' %}
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Find events', summary: 'Both dates are included. Search by order number, payment, reference or detail.'}) }}
		<form action="/admin/commerce/payment-events" method="get">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
			{% if filters.order_id %}<input type="hidden" name="order" value="{{ filters.order_id }}">{% endif %}
			{% if filters.payment_id %}<input type="hidden" name="payment" value="{{ filters.payment_id }}">{% endif %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'From', full_width: false, for: 'payments-from'})} %}{% block control %}<input type="date" id="payments-from" name="from" value="{{ filters.from }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'To', full_width: false, for: 'payments-to'})} %}{% block control %}<input type="date" id="payments-to" name="to" value="{{ filters.to }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'State', full_width: false, for: 'payments-state'})} %}{% block control %}<select id="payments-state" name="state" {{ ui_field_attrs(props) }}><option value="">Every state</option>{% for key, label in states %}<option value="{{ key }}" {{ filters.state == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Gateway', full_width: false, for: 'payments-gateway'})} %}{% block control %}<select id="payments-gateway" name="gateway" {{ ui_field_attrs(props) }}><option value="">Every gateway</option>{% for gateway in gateways %}<option value="{{ gateway }}" {{ filters.gateway == gateway ? 'selected' : '' }}>{{ gateway }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Search', full_width: true, for: 'payments-q'})} %}{% block control %}<input id="payments-q" name="q" value="{{ filters.q }}" maxlength="120" placeholder="Order number, payment, reference or detail" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Filter', variant: 'primary', size: 'normal', type: 'submit'}) }}{{ ui('action.link', {label: 'Clear', variant: 'secondary', size: 'normal', href: '/admin/commerce/payment-events'}) }}{% endblock %}{% endembed %}
		{% endblock %}{% endembed %}</form>
	{% endblock %}{% endembed %}</section>
	<section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
		{{ ui('layout.section-head', {heading: 'Events'}) }}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'payments', pagination: payments_pagination})} %}{% block results %}
			{% if rows %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr>{% for sh in payments_sort_headers %}{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: payments_region, sort_results: payments_results} %}{% endfor %}</tr>{% endblock %}
			{% block body %}
				{% for row in rows %}
					<tr data-payment-event-id="{{ row.id }}">
						<td class="small">{{ row.when }}</td>
						<td>{{ row.state_label }}</td>
						<td><a href="{{ row.order_href }}">{{ row.order_label }}</a></td>
						<td>{{ row.method_label }}</td>
						<td>{{ row.amount_label }}</td>
						<td class="small">{{ row.provider_reference ?: row.payment_short }}</td>
						<td class="cell-actions">{{ ui('action.link', {label: 'Open', variant: 'secondary', size: 'small', href: row.href, aria_label: 'Open payment event ' ~ row.id}) }}</td>
					</tr>
				{% endfor %}
			{% endblock %}
			{% endembed %}
			{% else %}{{ ui('feedback.empty', {summary: filtered ? 'No event matches these filters.' : 'Nothing has been recorded yet.'}) }}{% endif %}
		{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}</section>
{% endblock %}
