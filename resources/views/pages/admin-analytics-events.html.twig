{% extends layout %}
{% block page_body %}
{% set ph_back_href = '/admin/reports' %}{% set ph_back_label = 'Course Performance' %}{% set ph_kicker = 'Reports' %}{% set ph_title = 'Analytics events' %}{% set ph_lead = 'The first-party event stream, newest first, for confirming what is recorded. Counts are for the last 30 days.' %}{% include '@platform/partials/page-head.html.twig' %}
<section class="cl-page-section container-fluid cl-container-wide py-5">
{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {density: 'compact'})} %}{% block body %}{% for type in event_types %}{{ ui('data.stat-card', {label: type|replace({'_': ' '}), value: counts[type]|default(0)}) }}{% endfor %}{% endblock %}{% endembed %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}{% block surface_body %}
<form class="cl-analytics-filter" action="/admin/analytics/events" method="get">
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Event type', for: 'analytics-type'})} %}{% block control %}<select class="form-select" id="analytics-type" name="type" {{ ui_field_attrs(props) }}><option value="">All event types</option>{% for type in event_types %}<option value="{{ type }}"{% if filter.type == type %} selected{% endif %}>{{ type }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Course id', for: 'analytics-course'})} %}{% block control %}<input class="form-control" id="analytics-course" name="course_id" inputmode="numeric" value="{{ filter.course_id }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{{ ui('action.button', {label: 'Show events', type: 'submit'}) }}
</form>
<p>{{ total }} event{{ total == 1 ? '' : 's' }}{% if filter.type or filter.course_id %} match{{ total == 1 ? 'es' : '' }} this filter{% endif %}.</p>
{% if events %}{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'Analytics events, newest first', density: 'compact'})} %}{% block header %}<tr><th>Time (UTC)</th><th>Event</th><th>Source</th><th>Course</th><th>Person</th><th>Order</th><th>Details</th></tr>{% endblock %}{% block body %}{% for event in events %}<tr><td>{{ event.occurred_at|date('Y-m-d H:i:s', 'UTC') }}</td><td><code>{{ event.event_type }}</code></td><td>{{ event.source|replace({'_': ' '}) }}</td><td>{% if event.course_id %}{{ event.course_title }} <small>#{{ event.course_id }}</small>{% else %}—{% endif %}</td><td>{% if event.user_id %}{{ event.user_name }} <small>#{{ event.user_id }}</small>{% elseif event.visitor_id %}Visitor <small>{{ event.visitor_id|slice(0, 8) }}</small>{% else %}—{% endif %}</td><td>{% if event.order_id %}#{{ event.order_id }}{% if event.order_item_id %} · line #{{ event.order_item_id }}{% endif %}{% else %}—{% endif %}</td><td>{% for pair in event.metadata_pairs %}<div><small>{{ pair }}</small></div>{% else %}—{% endfor %}</td></tr>{% endfor %}{% endblock %}{% endembed %}{% else %}{{ ui('feedback.empty', {heading: 'No events', summary: 'Nothing matching has been recorded yet.'}) }}{% endif %}
{% if newer_href or older_href %}{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}{% block body %}{% if newer_href %}{{ ui('action.link', {label: 'Newer events', href: newer_href}) }}{% endif %}{% if older_href %}{{ ui('action.link', {label: 'Older events', href: older_href}) }}{% endif %}{% endblock %}{% endembed %}{% endif %}
{% endblock %}{% endembed %}
</section>
{% endblock %}
