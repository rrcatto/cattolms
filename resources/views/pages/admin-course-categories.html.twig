{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses' %}
	{% set ph_back_label = 'Course administration' %}
	{% set ph_kicker = 'Course metadata' %}
	{% set ph_title = 'Course categories' %}
	{% set ph_lead = 'Arrange the catalogue taxonomy: main categories, subcategories and sub-subcategories, three levels at most.' %}
	{% set ph_action_href = '/admin/courses' %}
	{% set ph_action_label = 'Courses' %}
	{% include '@platform/partials/page-head.html.twig' %}
	{# Loads the Stimulus app for the category-tree controller. After the page head: themes style the page head as the first element of main. #}
	{{ importmap() }}
	<section class="cl-page-section section">
		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

				{% include '@platform/partials/admin/course-group-nav.html.twig' %}
				{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'The catalogue taxonomy', eyebrow: 'Course Categories', summary: 'The categories a course can be filed under. Open a category to see its subcategories; drag a category by its handle, or use its ⋯ menu, to put it somewhere else.'})} %}
{% block section_actions %}
{{ ui('action.link', {label: 'Add category', variant: 'primary', href: '/admin/courses/categories/new', get: '/admin/courses/categories/new', target: '#category-create-body', modal: 'category-create', icon: 'action-add'}) }}
{% endblock %}
{% endembed %}

				<div class="cl-tree-wrap" data-controller="category-tree" data-action="dragstart->category-tree#start dragover->category-tree#over dragleave->category-tree#leave drop->category-tree#drop dragend->category-tree#end submit->category-tree#menu htmx:before:request->category-tree#loading">
					{% include '@platform/partials/admin/category-statistics.html.twig' %}
					<div class="cl-tree-tools" data-category-tree-target="enhanced" hidden>
						<p class="cl-tree-help" id="category-tree-keys">Drag a category by its handle: drop it on the upper or lower part of another category to put it before or after it, or on the middle to put it inside. On a focused handle, ↑ and ↓ move it, Home and End move it to the top or bottom, ← moves it out to its parent's level and → moves it into the category above.</p>
						{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}{{ ui('action.button', {label: 'Expand all', variant: 'secondary', size: 'small', type: 'button', stimulus_action: 'category-tree#expandAll', icon: 'action-chevron'}) }}{{ ui('action.button', {label: 'Collapse all', variant: 'secondary', size: 'small', type: 'button', stimulus_action: 'category-tree#collapseAll', icon: 'action-chevron'}) }}{% endblock %}
{% endembed %}
					</div>
					<p class="cl-tree-status" role="status" aria-live="polite" data-category-tree-target="status"></p>
					<p class="cl-tree-error" role="alert" data-category-tree-target="error" hidden></p>
					{# The disclosure buttons submit this form without JavaScript: open[] keeps the branches already open, toggle opens or closes one more. #}
					<form id="category-tree-view" action="/admin/courses/categories" method="get">{% for id in open_ids %}<input type="hidden" name="open[]" value="{{ id }}">{% endfor %}</form>
					{% include '@platform/partials/admin/category-tree.html.twig' %}
				</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
	</section>
	{# + Add category and Add subcategory load their form into this modal; without JavaScript the main-category form shows here and the links open their own pages. #}
	{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'category-create', title: 'Add a category'})} %}
{% block modal_body %}<div class="cl-category-create-body" id="category-create-body">{% include '@platform/partials/admin/category-create-form.html.twig' with {in_modal: true} %}</div>{% endblock %}
{% endembed %}
{% endblock %}
