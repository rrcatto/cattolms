{% extends layout %}
{% block page_body %}
	{% set ph_back_href = '/admin/courses' %}
	{% set ph_back_label = 'Course administration' %}
	{% set ph_kicker = 'Course metadata' %}
	{% set ph_title = 'Course categories' %}
	{% set ph_lead = 'Create and maintain the catalogue taxonomy used by courses.' %}
	{% set ph_action_href = '/admin/courses' %}
	{% set ph_action_label = 'Courses' %}
	{% include '@platform/partials/page-head.html.twig' %}
	{#
		The wrapper Courses, Requests and Enrolments use, which is the plain section that
		admin-section.html.twig puts round a section body - no container of its own.

		It used to be container-fluid cl-container-wide py-5, which imposes a different maximum
		width and its own padding, so the card sat at a different place on the page from every
		other Courses page and appeared to jump when moving between them.
	#}
	<section class="cl-page-section section">
		{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

			{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

				{% include '@platform/partials/admin/course-group-nav.html.twig' %}
				{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'The catalogue taxonomy', eyebrow: 'Course Categories', summary: 'The categories a course can be filed under. A course is named after its category and tagged with the branch it belongs to.'})} %}
{% block section_actions %}
{{ ui('action.button', {label: '＋ Create category', variant: 'primary', size: 'normal', type: 'button', modal: 'createCategoryModal', icon: 'action-add'}) }}
{% endblock %}
{% endembed %}

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 52, label: 'Category'}} %}
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'Courses'}} %}
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'With sub-categories'}} %}
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Order'}} %}
								{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Actions'}} %}
							</tr>

{% endblock %}
{% block body %}

							{% for category_index, category in categories %}
								<tr data-category-row>
									<td>
										<span class="cl-category-depth cl-category-depth-{{ category.level }}"><span class="cl-category-level" title="Level {{ category.level }}">L{{ category.level }}</span>{{ category.name }}</span>
										{% if category.parent_name %}
											<div class="small text-body-secondary cl-category-depth cl-category-depth-{{ category.level }}" style="border:0">
												in {{ category.grandparent_name ? category.grandparent_name ~ ' › ' : '' }}{{ category.parent_name }}
											</div>
										{% endif %}
										{% if category.description %}
											<div class="small text-body-secondary mt-1">
												{{ category.description }}
											</div>
										{% endif %}
									</td>
									<td>
										{{ category.course_count }}
									</td>
									<td>
										{{ category.descendant_course_count }}
										{% if category.child_count %}
											<div class="small text-body-secondary">
												{{ category.child_count }} sub
											</div>
										{% endif %}
									</td>
									<td class="cell-actions">
										{% embed ui_template('action.row') with {props: ui_props('action.row', {})} %}
{% block body %}

											<form action="/admin/courses/categories/{{ category.id }}/move" method="post">
												<input type="hidden" name="csrf" value="{{ csrf }}">
												<input type="hidden" name="direction" value="up">
												{{ ui('action.button', {label: '↑', variant: 'secondary', size: 'small', type: 'submit', disabled: category_index==0}) }}
											</form>
											<form action="/admin/courses/categories/{{ category.id }}/move" method="post">
												<input type="hidden" name="csrf" value="{{ csrf }}">
												<input type="hidden" name="direction" value="down">
												{{ ui('action.button', {label: '↓', variant: 'secondary', size: 'small', type: 'submit', disabled: category_index+1==categories|length}) }}
											</form>

{% endblock %}
{% endembed %}
									</td>
									<td class="cell-actions">
										{{ ui('action.link', {label: 'Manage', variant: 'primary', size: 'small', href: '/admin/courses/categories/' ~ (category.id)}) }}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
	</section>
	{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'createCategoryModal', title: 'Create category', action: '/admin/courses/categories', method: 'post'})} %}
{% block modal_body %}

					<p class="text-body-secondary">
						The slug is generated from the name unless you supply one.
					</p>
					<div class="vstack gap-3">
						<input type="hidden" name="csrf" value="{{ csrf }}">
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Name', full_width: false, for: 'field-admin-course-categories-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

							<input class="form-control" name="name" maxlength="120" required id="field-admin-course-categories-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Parent category', full_width: false, for: 'field-admin-course-categories-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), help: 'Categories go three levels deep, so a sub-sub-category cannot hold children of its own.'})} %}
{% block control %}

							<select class="form-select" name="parent_id" id="field-admin-course-categories-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="0">None — a top-level category</option>
							{% for parent_option in parent_options %}
								<option value="{{ parent_option.id }}">{{ parent_option.parent_name ? parent_option.parent_name ~ ' › ' : '' }}{{ parent_option.name }}</option>
							{% endfor %}
							</select>

{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Slug optional', full_width: false, for: 'field-admin-course-categories-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

							<input class="form-control" name="slug" placeholder="generated-from-name" id="field-admin-course-categories-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Description', full_width: false, for: 'field-admin-course-categories-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

							<textarea class="form-control" name="description" rows="4" id="field-admin-course-categories-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}></textarea>

{% endblock %}
{% endembed %}
					</div>

{% endblock %}
{% block modal_actions %}

					{{ ui('action.button', {label: 'Cancel', variant: 'quiet', size: 'normal', type: 'button', close_modal: true}) }}
					{{ ui('action.button', {label: 'Create category', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-add'}) }}

{% endblock %}
{% endembed %}
{% endblock %}
