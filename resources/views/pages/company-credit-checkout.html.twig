{% extends layout %}
{% block page_body %}
    {% set ph_back_href = '/company/credits/buy' %}{% set ph_back_label = 'Edit credits' %}
    {% set ph_kicker = 'Company purchasing' %}{% set ph_title = 'Review company credit order' %}
    {% include '@CattoPHP/page/head.html.twig' %}
    <section class="cl-page-section">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}{% block surface_body %}
        <h2 class="h4">{{ basket.company.name }}</h2>
        {% if basket.request_id %}<p>When the payment is confirmed, one matching credit is allocated to the learner's request and the learner is enrolled. For an EFT, that is when we record your payment.</p>{% endif %}
        {% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}{% block body %}
            {% for item in basket.items %}{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}{% block body %}
                {% if item.fulfilment_type|default('') == 'bundle_credit' %}
                <strong>{{ ui('feedback.badge', {label: 'Bundle credits', tone: 'info', size: 'small'}) }} {{ item.bundle_title }}</strong><p>Includes {{ item.courses|map(c => c.title)|join(', ', ' and ') }} · {{ item.access_period_seconds / 86400 }} days · {{ item.quantity }} × {{ item.unit_label }} = {{ item.line_label }}</p>
                <p class="cl-bundle-credit-rule">{{ item.quantity == 1 ? 'This credit is for one person, who gets every course in the bundle.' : 'Each of these ' ~ item.quantity ~ ' credits is for one person, who gets every course in the bundle.' }}</p>
                {% else %}
                <strong>{{ item.course_title }}</strong><p>{{ item.access_period_seconds / 86400 }} days · {{ item.quantity }} × {{ item.unit_label }} = {{ item.line_label }}</p>
                {% endif %}
            {% endblock %}{% endembed %}{% endfor %}
        {% endblock %}{% endembed %}
        <p class="h4">Total: {{ basket.total_label }}</p>
        <form action="/company/credits/checkout" method="post">
            <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="purchase_key" value="{{ basket.purchase_key }}"><input type="hidden" name="quote" value="{{ basket.quote }}">
            <h3 class="h5">Company billing details</h3>
            <p>The invoice is made out to {{ basket.company.name }}, not to you. {{ billing.saved ? 'The company’s saved billing details are filled in; a correction here also updates them.' : 'These become the company’s saved billing details.' }}</p>
            {% include '@platform/partials/billing-fields.html.twig' with {billing_prefix: 'company-checkout-billing'} %}
            {% if wallet_balance_minor > 0 %}
            {{ ui('form.picture-choice', {multiple: true, legend: 'Company wallet', legend_hidden: true, size: 'small', tick_value: 'yes', selected: ['use_wallet'], items: [
                {value: 'use_wallet', label: 'Use the company wallet (' ~ wallet_balance_label ~ ' available)', icon: lucide('wallet'), note: 'Untick it to keep the credit and pay the whole order another way.'},
            ]}) }}
            <p>The company wallet pays as much of the order as it holds, oldest credit first. The payment method below pays anything left.</p>
            {% endif %}
            {% include '@platform/partials/commerce-payment-method.html.twig' with {selected_method: ''} %}
            {{ ui('form.picture-choice', {multiple: true, legend: 'Invoice', legend_hidden: true, size: 'small', tick_value: 'yes', selected: [], items: [
                {value: 'invoice_email', label: 'Email the invoice to ' ~ user_email, icon: lucide('receipt'), note: 'As a PDF. An EFT order gets it with the payment details anyway.'},
            ]}) }}
            <p>Credits are specific to the course and access period shown. They are issued only after confirmed full payment. An order not paid in full within {{ payment_due }} is cancelled, and anything paid towards it goes to the company wallet. No VAT is charged. Credits are refunded only within {{ refund_window }} of purchase, only while no learner has started them, and only as wallet credit.</p>
            {% include '@platform/partials/commerce-terms-acceptance.html.twig' %}
            {# How a bundle credit is used, said and ticked before buying (owner, 2026-11-11: "this needs to be made clear to them
               when they buy it, so they understand how they must use it"). Placement refuses without it. #}
            {% if basket.has_bundles|default(false) %}
            {{ ui('feedback.notice', {tone: 'warning', heading: bundle_rule}) }}
            {{ ui('form.picture-choice', {multiple: true, legend: 'How bundle credits are used', legend_hidden: true, size: 'small', tick_value: 'yes', required: true, selected: [], items: [
                {value: 'accept_bundle_use', label: bundle_accept, icon: lucide('package')},
            ]}) }}
            {% endif %}
            {% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Place company order', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-buy'}) }}{{ ui('action.link', {label: 'Edit credits', variant: 'secondary', size: 'normal', href: '/company/credits/buy', icon: 'action-edit'}) }}{% endblock %}{% endembed %}
        </form>
    {% endblock %}{% endembed %}</section>
{% endblock %}
