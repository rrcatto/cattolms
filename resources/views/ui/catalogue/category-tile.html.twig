{% set item = props.item %}
<a class="cl-category-tile{% if item.is_active %} is-active{% endif %}" href="{{ item.href }}"
   {% if item.is_active %}aria-current="true"{% endif %}
   hx-get="{{ item.href }}" hx-target="#catalogue-region" hx-select="#catalogue-results"
   hx-select-oob="#catalogue-categories,#catalogue-search" hx-swap="innerHTML" hx-push-url="true">
	{% if item.icon_svg %}<span class="cl-category-tile-icon" aria-hidden="true">{{ item.icon_svg|raw }}</span>{% endif %}
	<span class="cl-category-tile-name">{{ item.name }}</span>
	{% if item.description %}<span class="cl-category-tile-description">{{ item.description }}</span>{% endif %}
</a>
