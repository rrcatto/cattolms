{% set tag = props.tag %}
{% set selected = props.selected %}
{% set compact = props.compact %}
<a class="cl-tag-chip{% if compact|default(false) %} cl-tag-chip-compact{% else %} cl-tag-weight-{{ tag.weight|default(1) }}{% endif %}{% if selected|default(false) %} is-selected{% endif %}"
   href="/courses/tag/{{ tag.slug }}" title="{{ tag.name }}" data-tag-label="{{ tag.name }}"{% if not compact|default(false) %} data-tag-weight="{{ tag.weight|default(1) }}" data-tag-count="{{ tag.course_count|default(0) }}"{% endif %}
   {% if selected|default(false) %}aria-current="page"{% endif %}>
	{# Every tag shows its icon, on cards too (owner, 2026-10-20: "each tag also needs a custom svg icon"). #}
	{% if tag.icon_svg|default('') %}<span class="cl-tag-icon" aria-hidden="true">{{ tag.icon_svg|raw }}</span>{% endif %}<span>{{ tag.name }}</span>
	{% if not compact|default(false) and tag.course_count is defined %}<span class="cl-category-count">{{ tag.course_count }}</span>{% endif %}
</a>
