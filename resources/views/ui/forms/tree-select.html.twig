{# A one-row control that opens a native popover holding a hierarchy: each option with its children nested under it, and beside an option that has children a disclosure button, which only opens or closes that branch and never chooses.
   submit mode: each option is a submit button carrying its value, so choosing one submits the enclosing form.
   field mode: each option is a radio input, so the choice is stored and sent with the form's own Save; core script closes the list and shows the chosen path.
   Branches are rendered open and the disclosure buttons hidden, so without JavaScript the whole tree is listed and every option can be chosen. Core script shows the buttons and, each time the list opens, closes every branch except those around the chosen option. #}
{% import _self as tree %}
{% macro branch(items, props) %}{% import _self as tree %}{% for item in items %}{% set chosen = item.value == props.selected %}{% set children = item.children|default([]) %}<li class="cl-ui-tree-select-item"><div class="cl-ui-tree-select-row">{% if children is not empty %}<button type="button" class="cl-ui-tree-select-expand" aria-expanded="true" aria-controls="{{ props.id }}-branch-{{ item.value }}" aria-label="Show what is inside {{ item.path }}" hidden>{{ ui('icon', {name: 'action-chevron', decorative: true}) }}</button>{% else %}<span class="cl-ui-tree-select-spacer" aria-hidden="true"></span>{% endif %}{% if props.mode == 'field' %}<label class="cl-ui-tree-select-option" data-depth="{{ item.depth }}"><input type="radio" name="{{ props.name }}" value="{{ item.value }}" data-tree-select-path="{{ item.path }}"{% if item.depth > 1 %} aria-label="{{ item.path }}"{% endif %}{% if chosen %} checked autofocus{% endif %}><span>{{ item.label }}</span></label>{% else %}<button type="submit" class="cl-ui-tree-select-option{% if chosen %} is-selected{% endif %}" name="{{ props.name }}" value="{{ item.value }}" data-depth="{{ item.depth }}"{% if item.depth > 1 %} aria-label="{{ item.path }}"{% endif %}{% if chosen %} aria-current="true" autofocus{% endif %}>{{ item.label }}</button>{% endif %}</div>{% if children is not empty %}<ul class="cl-ui-tree-select-branch" id="{{ props.id }}-branch-{{ item.value }}" role="group" aria-label="{{ item.path }}">{{ tree.branch(children, props) }}</ul>{% endif %}</li>{% endfor %}{% endmacro %}
<div class="cl-ui-tree-select" data-tree-select="{{ props.mode }}">
<button type="button" class="form-select cl-ui-tree-select-toggle" id="{{ props.id }}" popovertarget="{{ props.id }}-options" aria-haspopup="true"><span class="cl-ui-tree-select-value">{{ props.selected_path ?: props.placeholder }}</span></button>
<div class="cl-ui-tree-select-panel" id="{{ props.id }}-options" popover>
<ul class="cl-ui-tree-select-list"{% if props.mode == 'field' %} role="radiogroup"{% endif %} aria-label="{{ props.list_label }}">{{ tree.branch(props.items, props) }}</ul>
</div>
</div>
