<fieldset class="cl-ui-picture-choice"{% if props.id %} id="{{ props.id }}"{% endif %}><legend class="cl-ui-picture-choice-legend">{{ props.legend }}</legend>{% if props.help %}<div class="cl-ui-field-help">{{ props.help }}</div>{% endif %}<div class="cl-ui-picture-choice-grid">{% for item in props.items %}<label class="cl-ui-picture-choice-item"><input type="radio" name="{{ props.name }}" value="{{ item.value }}"{% if (item.value ~ '') == (props.selected ~ '') %} checked{% endif %}><img src="{{ item.image }}" alt="" loading="lazy"><span class="cl-ui-picture-choice-text"><span class="cl-ui-picture-choice-label">{{ item.label }}</span>{% if item.note|default('') %}<span class="cl-ui-picture-choice-note">{{ item.note }}</span>{% endif %}</span></label>{% endfor %}</div></fieldset>
