{#
	A native radio group whose options are pictures (a certificate look) or feature cards: an SVG icon, a bold
	label and a description (owner, 2026-10-20, the Register page's account type). size 'small' draws smaller cards,
	icon beside the title, for a choice that sits under a larger one (the contact form's topics). columns 4 puts at
	most four cards in a row, further rows beneath, left-aligned (the catalogue's categories). An option may be a drawn
	slide (owner, 2026-10-30: a presentation's layouts and looks chosen by what they look like). form ties the radios to a
	form elsewhere on the page (a layout window's choice sent with the slide's own form). Every option is a labelled
	native radio, so the choice works without JavaScript.
#}
{% set cards = props.items|filter(item => item.icon is defined)|length == props.items|length %}
<fieldset class="cl-ui-picture-choice{{ cards ? ' cl-ui-picture-choice--cards' : '' }}{{ props.size == 'small' ? ' cl-ui-picture-choice--small' : '' }}{{ props.columns == 4 ? ' cl-ui-picture-choice--four' : '' }}"{% if props.id %} id="{{ props.id }}"{% endif %}><legend class="cl-ui-picture-choice-legend">{{ props.legend }}</legend>{% if props.help %}<div class="cl-ui-field-help">{{ props.help }}</div>{% endif %}<div class="cl-ui-picture-choice-grid">{% for item in props.items %}<label class="cl-ui-picture-choice-item{{ item.icon is defined ? ' cl-ui-picture-choice-item--icon' : '' }}{{ item.drawing is defined ? ' cl-ui-picture-choice-item--drawing' : '' }}"><input type="radio" name="{{ props.name }}" value="{{ item.value }}"{% if props.form %} form="{{ props.form }}"{% endif %}{% if (item.value ~ '') == (props.selected ~ '') %} checked{% endif %}>{% if item.icon is defined %}<span class="cl-ui-picture-choice-icon" aria-hidden="true">{{ item.icon|raw }}</span>{% elseif item.drawing is defined %}<span class="cl-ui-picture-choice-drawing">{{ item.drawing|raw }}</span>{% else %}<img src="{{ item.image }}" alt="" loading="lazy">{% endif %}<span class="cl-ui-picture-choice-text"><span class="cl-ui-picture-choice-label">{{ item.label }}</span>{% if item.note|default('') %}<span class="cl-ui-picture-choice-note">{{ item.note }}</span>{% endif %}</span></label>{% endfor %}</div></fieldset>
