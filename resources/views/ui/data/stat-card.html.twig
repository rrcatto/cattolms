{# size 'large': the one figure a page is opened for, such as a wallet's balance (owner, 2026-10-21: "much bigger, bolded and surrounded with a border so that the eye does not have to hunt"). #}
{% set card_class = 'cl-ui-stat-card' ~ (props.size == 'large' ? ' cl-ui-stat-card--large' : '') %}
{% if props.href %}<a class="{{ card_class }} cl-ui-stat-link" href="{{ props.href }}"><div class="cl-ui-stat-value">{{ props.value }}</div><div class="cl-ui-stat-label">{{ props.label }}</div>{% if props.note %}<div class="cl-ui-stat-note">{{ props.note }}</div>{% endif %}</a>{% else %}<div class="{{ card_class }}"><div class="cl-ui-stat-value">{{ props.value }}</div><div class="cl-ui-stat-label">{{ props.label }}</div>{% if props.note %}<div class="cl-ui-stat-note">{{ props.note }}</div>{% endif %}</div>{% endif %}
