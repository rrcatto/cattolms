{# size 'large': the one figure a page is opened for, such as a wallet's balance (owner, 2026-10-21: "much bigger, bolded and surrounded with a border so that the eye does not have to hunt"). #}
{# size 'small': a money amount in a row of figures, its value 0.88 of the theme's own size (owner, 2026-10-21: money amounts overflowed, "reducing the size of the font for money amount by about -2pt, possibly -4pt"). #}
{# icon: a sprite symbol above the value (owner, 2026-10-21: "Dashboard cards also need svg icons"). #}
{% set card_class = 'cl-ui-stat-card' ~ (props.size != 'normal' ? ' cl-ui-stat-card--' ~ props.size : '') %}
{% set card_body %}{% if props.icon %}<span class="cl-ui-stat-icon">{{ ui('icon', {name: props.icon, decorative: true}) }}</span>{% endif %}<div class="cl-ui-stat-value">{% if props.size == 'small' %}<span>{{ props.value }}</span>{% else %}{{ props.value }}{% endif %}</div><div class="cl-ui-stat-label">{{ props.label }}</div>{% if props.note %}<div class="cl-ui-stat-note">{{ props.note }}</div>{% endif %}{% endset %}
{% if props.href %}<a class="{{ card_class }} cl-ui-stat-link" href="{{ props.href }}">{{ card_body }}</a>{% else %}<div class="{{ card_class }}">{{ card_body }}</div>{% endif %}
