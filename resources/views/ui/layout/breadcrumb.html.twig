{% if props.items %}<nav class="cl-ui-breadcrumb" aria-label="{{ props.aria_label }}">{% for item in props.items %}{% if not loop.first %}<span class="cl-ui-breadcrumb-separator" aria-hidden="true">/</span>{% endif %}{% if item.href|default(null) %}<a href="{{ item.href }}"{% if item.current|default(false) %} aria-current="page"{% endif %}>{{ item.label }}</a>{% else %}<span{% if item.current|default(false) %} aria-current="page"{% endif %}>{{ item.label }}</span>{% endif %}{% endfor %}</nav>{% endif %}
