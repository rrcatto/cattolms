<details class="cl-ui-accordion-section"{% if props.id %} id="{{ props.id }}"{% endif %}{% if props.workspace == 'admin' %} data-admin-section="{{ props.section_key }}"{% elseif props.workspace == 'account' %} data-account-section="{{ props.section_key }}"{% elseif props.workspace == 'company' %} data-company-section="{{ props.section_key }}"{% elseif props.workspace == 'library' %} data-library-section="{{ props.section_key }}"{% endif %}{% if props.load_url %} hx-get="{{ props.load_url }}" hx-trigger="toggle once" hx-target="find .cl-ui-accordion-lazy" hx-select=".cl-section-body" hx-swap="innerHTML"{% endif %}{% if props.open %} open{% endif %}>
{# picture: a small picture on this site before the title in place of an icon, such as the site logo on Settings > Site Owner (owner, 2026-11-09). #}
<summary class="cl-ui-accordion-summary{% if props.eyebrow or props.icon or props.picture %} cl-ui-accordion-summary--labelled{% endif %}">{% if props.eyebrow or props.icon or props.picture %}{% if props.picture %}<span class="cl-ui-accordion-picture" aria-hidden="true"><img src="{{ props.picture }}" alt=""></span>{% elseif props.icon %}<span class="cl-ui-accordion-icon" aria-hidden="true">{{ props.icon|raw }}</span>{% endif %}<span class="cl-ui-accordion-label">{% if props.eyebrow %}<span class="cl-ui-accordion-eyebrow">{{ props.eyebrow }}</span>{% endif %}<span class="cl-ui-accordion-title">{{ props.heading }}</span></span>{% else %}<span class="cl-ui-accordion-title">{{ props.heading }}</span>{% endif %}{% if props.summary %}<span class="cl-ui-accordion-description{% if props.summary_tone %} cl-ui-accordion-status cl-ui-accordion-status--{{ props.summary_tone }}{% endif %}">{% if props.summary_tone %}{{ ui('icon', {name: {success: 'action-approve', danger: 'notice-warning', neutral: 'status-off'}[props.summary_tone]}) }}{% endif %}{{ props.summary }}</span>{% endif %}<span class="cl-ui-accordion-toggle" aria-hidden="true">⌄</span></summary>
<div class="cl-ui-accordion-content">{% set actions %}{% block actions %}{% endblock %}{% endset %}{% if actions|trim %}<div class="cl-ui-accordion-actions">{{ actions }}</div>{% endif %}{% block body %}{% endblock %}</div></details>
