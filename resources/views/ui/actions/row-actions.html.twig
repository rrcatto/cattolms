{% if props.menu %}<details class="cl-ui-row-menu{{ props.compact ? ' cl-ui-row-menu--compact' : '' }}" data-cl-dropdown><summary class="cl-ui-row-trigger" aria-label="{{ props.aria_label ?: props.label }}">{{ ui('icon', {name: props.icon}) }}{% if not props.compact %}<span class="cl-ui-row-label">{{ props.label }}</span> <span aria-hidden="true">▾</span>{% endif %}</summary><div class="cl-ui-row-panel">{% block body %}{% endblock %}</div></details>{% else %}<div class="cl-ui-row-actions">{{ block('body') }}</div>{% endif %}
