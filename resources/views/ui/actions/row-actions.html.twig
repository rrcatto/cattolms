{% if props.menu %}<details class="cl-ui-row-menu{{ props.compact ? ' cl-ui-row-menu--compact' : '' }}" data-cl-dropdown><summary class="cl-ui-row-trigger" aria-label="{{ props.aria_label ?: props.label }}">{{ ui('icon', {name: props.icon}) }}{% if not props.compact %}<span class="cl-ui-row-label">{{ props.label }}</span> <span aria-hidden="true">▾</span>{% endif %}</summary><div class="cl-ui-row-panel">{% block body %}{% endblock %}</div></details>{% elseif props.narrow_menu %}{# Several actions kept in a row: the buttons on a wide screen, one Actions menu on a phone (Core CSS shows one of the two). #}<div class="cl-ui-row-actions cl-ui-row-actions--wide">{{ block('body') }}</div><details class="cl-ui-row-menu cl-ui-row-menu--narrow" data-cl-dropdown><summary class="cl-ui-row-trigger" aria-label="{{ props.aria_label ?: props.label }}">{{ ui('icon', {name: props.icon}) }}<span class="cl-ui-row-label">{{ props.label }}</span> <span aria-hidden="true">▾</span></summary><div class="cl-ui-row-panel">{{ block('body') }}</div></details>{% else %}<div class="cl-ui-row-actions">{{ block('body') }}</div>{% endif %}
