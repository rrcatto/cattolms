<div id="catalogue-workspace">
	<div id="catalogue-region" data-server-search-target>
		<div id="catalogue-results">
			{% embed '@platform/ui/surface.html.twig' %}
				{% block surface_body %}
					{{ ui('section-head', {heading: workspace.heading, summary: workspace.summary}) }}
					{% if navigation.trail|default([]) %}
						<nav class="cl-breadcrumb" aria-label="Category path">
							<a href="/courses">All categories</a>
							{% for crumb in navigation.trail %}
								<span class="cl-breadcrumb-sep" aria-hidden="true">/</span>
								<a href="{{ crumb.href }}" {% if loop.last %}aria-current="page"{% endif %}>{{ crumb.name }}</a>
							{% endfor %}
						</nav>
					{% endif %}
					{{ ui('filter-rail', {label: 'Subcategories', items: navigation.tier_2|default([])}) }}
					{{ ui('filter-rail', {label: 'Topics', items: navigation.tier_3|default([])}) }}
					{% if workspace.paginated %}{% include '@platform/partials/pagination.html.twig' with {pg: catalogue_pagination} %}{% endif %}
					{% if courses %}
						{{ ui('course-grid', {courses: courses}) }}
					{% else %}
						{{ ui('empty-state', {heading: workspace.empty_heading, summary: workspace.empty_summary}) }}
					{% endif %}
					{% if workspace.paginated %}{% include '@platform/partials/pagination.html.twig' with {pg: catalogue_pagination} %}{% endif %}
				{% endblock %}
			{% endembed %}
		</div>
	</div>
</div>
