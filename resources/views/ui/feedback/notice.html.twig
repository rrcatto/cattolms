<div class="cl-ui-notice cl-ui-notice--{{ props.tone }}{% if props.solid %} cl-ui-notice--solid{% endif %}{% if props.section_spacing %} cl-ui-spaced{% endif %}"{% if props.flash %} data-flash-message data-flash-type="{{ props.tone }}"{% endif %} role="{{ props.tone == 'danger' ? 'alert' : 'status' }}">{% if props.icon %}<span class="cl-ui-notice-icon">{{ ui('icon', {name: props.icon}) }}</span>{% endif %}<div>{% if props.heading %}<strong class="cl-ui-notice-heading">{{ props.heading }}</strong>{% endif %}{% block body %}{% endblock %}</div>{% if props.flash %}<button type="button" class="cl-ui-close" data-flash-close aria-label="Dismiss message">×</button>{% endif %}</div>
