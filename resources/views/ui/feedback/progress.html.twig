<div class="cl-ui-progress-group"><div class="cl-ui-progress cl-ui-progress--{{ props.size }}" role="progressbar" aria-label="{{ props.label }}" aria-valuenow="{{ props.value }}" aria-valuemin="{{ props.min }}" aria-valuemax="{{ props.max }}"><div class="cl-ui-progress-bar" style="width:{{ ((props.value - props.min) / (props.max - props.min) * 100)|number_format(2, '.', '') }}%"></div></div>{% if props.show_value %}<span>{{ props.value }} / {{ props.max }}</span>{% endif %}</div>
