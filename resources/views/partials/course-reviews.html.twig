{#
	The approved reviews of a course, newest first and a page at a time. Only the published version of
	each review is shown, under the reviewer's first name and initial: never an email address, an id or
	a moderation note.
#}
{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'reviews', pagination: reviews_pagination})} %}
{% block results %}
{% if reviews %}
{% include '@platform/partials/course-review-list.html.twig' %}
{% else %}
{{ ui('feedback.empty', {heading: 'No reviews yet', summary: 'Reviews from learners who have taken this course appear here once they have been checked.'}) }}
{% endif %}
{% endblock %}
{% endembed %}
