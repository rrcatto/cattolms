<footer class="cl-footer">
	<div class="cl-footer-inner">
		<span class="cl-footer-mark">© {{ "now"|date("Y") }} {{ app.name }}</span>
		<nav class="cl-footer-nav" aria-label="Footer navigation">
			{% for footer_link in footer_navigation %}
				<a href="{{ footer_link.href }}">{{ footer_link.label }}</a>
			{% endfor %}
		</nav>
		{% if footer_social is defined and footer_social %}
			<ul class="cl-footer-social" aria-label="Social media">
				{% for mark in footer_social %}
					<li>
						{% if mark.href %}
							<a href="{{ mark.href }}" aria-label="{{ mark.label }}" rel="noopener noreferrer" target="_blank">
								<svg class="cl-footer-social-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#social-{{ mark.key }}"></use></svg>
							</a>
						{% else %}
							<span title="{{ mark.label }}">
								<svg class="cl-footer-social-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#social-{{ mark.key }}"></use></svg>
								<span class="cl-visually-hidden">{{ mark.label }}</span>
							</span>
						{% endif %}
					</li>
				{% endfor %}
			</ul>
		{% endif %}
	</div>
</footer>
