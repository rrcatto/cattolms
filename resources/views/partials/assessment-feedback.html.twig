{# How a practice answer went: on the next question's page, or on the last answer's own page before the result. #}
{% if feedback %}
	{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: feedback.is_correct ? 'success' : 'warning'})} %}
{% block body %}

		<strong>{{ feedback.is_correct ? 'Correct.' : 'Not correct.' }}</strong>
		{% if not feedback.is_correct %}
			<div class="mt-3">
				<strong>Correct answer:</strong> {{ feedback.correct_option_html|authored }}
			</div>
		{% endif %}
		{% if feedback.explanation_html %}
			<div class="mt-3">
				{{ feedback.explanation_html|authored }}
			</div>
		{% endif %}

{% endblock %}
{% endembed %}
{% endif %}
