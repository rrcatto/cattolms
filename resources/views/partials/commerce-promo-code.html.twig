{#
	The promo code on the checkout review. The browser sends only a code; the discount, the totals and
	whether the code applies are all calculated by the server. One promotion applies to an order: applying
	another code replaces the one typed once it has been accepted, and a rejected code leaves the current
	one in place. A promotion that applies automatically (owner, 2026-10-20) is shown as such, with no
	Remove button; a code the purchaser types is used instead only when it saves them more.
#}
<section class="cl-checkout-promo" aria-labelledby="checkout-promo-heading">
	<h3 class="h5" id="checkout-promo-heading">Promo code</h3>
	{% if cart.promo.code %}
		{% if cart.promo.applied %}
			<p class="cl-checkout-promo-applied"><strong>{{ cart.promo.code }}</strong> · {{ cart.promo.label }} · {{ cart.promo.discount_label }}{% if cart.promo.automatic %} · applied automatically{% endif %}</p>
			{% if cart.promo.note %}<p class="help">{{ cart.promo.note }}</p>{% endif %}
		{% else %}
			{{ ui('feedback.notice', {tone: 'warning', heading: cart.promo.code ~ ' no longer applies. ' ~ cart.promo.rejection}) }}
		{% endif %}
	{% endif %}
	{% if cart.promo.typed_code %}
		<form action="/checkout/promo/remove" method="post">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			{{ ui('action.button', {label: 'Remove', variant: 'quiet', size: 'small', type: 'submit', aria_label: 'Remove promo code ' ~ cart.promo.typed_code, icon: 'action-remove'}) }}
		</form>
	{% endif %}
	<form action="/checkout/promo" method="post">
		<input type="hidden" name="csrf" value="{{ csrf }}">
		{% embed ui_template('form.compact-action') with {props: ui_props('form.compact-action', {})} %}
{% block body %}
<label for="promo-code">{{ cart.promo.code ? 'Use a different code' : 'Enter a promo code' }}</label><input id="promo-code" name="promo_code" maxlength="40" autocomplete="off" autocapitalize="characters" spellcheck="false" required>{{ ui('action.button', {label: 'Apply', type: 'submit', icon: 'action-done'}) }}
{% endblock %}
{% endembed %}
		{% if cart.promo.automatic %}<p class="help">One promotion applies to an order. A code you apply is used instead of {{ cart.promo.code }} only when it saves you more.</p>
		{% elseif cart.promo.code %}<p class="help">One promo code applies to an order. A code you apply replaces {{ cart.promo.code }} once it is accepted.</p>{% endif %}
	</form>
</section>
