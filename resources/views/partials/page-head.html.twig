<section class="cl-page-head {{ ph_compact|default(false) ? 'cl-page-head-compact' : '' }}">
	<div class="cl-page-head-inner">
		<div class="cl-page-head-content">
			{% if ph_back_href|default('') %}<a class="cl-back-link" href="{{ ph_back_href }}">← {{ ph_back_label|default('Back', true) }}</a>{% endif %}
			{% if ph_kicker|default('') %}<span class="cl-kicker d-block">{{ ph_kicker }}</span>{% endif %}
			<h1 class="{{ ph_compact|default(false) ? 'h5 mb-0' : 'cl-display-5 fw-bold' }}">{{ ph_title }}</h1>
			{% if ph_lead|default('') %}<p class="cl-lead mb-0">{{ ph_lead }}</p>{% endif %}
		</div>
		{#
			The page's actions: ph_actions is captured markup (a {% set %} block of ui() actions) for a
			page whose main actions are its own; ph_action_href is the single secondary link a sub-page
			may have. A section's own actions arrive as ph_actions from its page template.
		#}
		{% if ph_actions|default('')|trim %}
			<div class="cl-page-head-actions">{{ ph_actions }}</div>
		{% elseif ph_action_href|default('') %}
			<div class="cl-page-head-actions">{{ ui('action.link', {label: ph_action_label|default('Back', true), variant: 'secondary', href: ph_action_href}) }}</div>
		{% endif %}
	</div>
</section>
{% include '@platform/partials/account/identity-head.html.twig' %}
