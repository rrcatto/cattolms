{% if not lookup_searched %}
	<p class="help lookup-hint">
		Type at least {{ lookup_min_length }} characters to search.
	</p>
{% else %}
	{% if lookup_results %}
		<ul class="lookup-results" role="listbox" aria-label="Search results">
			{% for result in lookup_results %}
				<li role="option">
					<button type="button"
                      class="lookup-result"
                      data-lookup-target="{{ lookup_target }}"
                      data-lookup-id="{{ result.id }}"
                      data-lookup-label="{{ result.label }}">
					<span class="lookup-result-label">{{ result.label }}</span>
					<span class="lookup-result-detail">{{ result.detail }}</span>
					</button>
				</li>
			{% endfor %}
		</ul>
{# The cap is stated rather than hidden: a silently truncated result list is the
             same defect this release removes from the data tables. #}
		{% if lookup_results|length >= lookup_max_results %}
			<p class="help lookup-hint">
				Showing the first {{ lookup_max_results }} matches. Refine your search to narrow them.
			</p>
		{% endif %}
	{% else %}
		<p class="help lookup-hint">
			No matches for “{{ lookup_query }}”.
		</p>
	{% endif %}
{% endif %}
