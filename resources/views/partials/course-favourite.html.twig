{#
	The favourite star of a course, or of a bundle (owner, 2026-11-06: "Allow bundles to be added to favourites"): the same
	star, sent to its own address. favourite_kind 'bundle' takes the bundle's id from course.bundle_id.
#}
{% set fav_bundle = favourite_kind|default('course') == 'bundle' %}
{% set fav_id = fav_bundle ? course.bundle_id : course.id %}
{% set fav_action = fav_bundle ? '/bundles/favourite' : '/courses/favourite' %}
<form class="cl-favourite-form" action="{{ fav_action }}" method="post"
      hx-post="{{ fav_action }}" hx-swap="outerHTML" hx-target="this" id="favourite-{{ fav_bundle ? 'bundle-' : '' }}{{ fav_id }}">
	<input type="hidden" name="csrf" value="{{ csrf }}">
	<input type="hidden" name="{{ fav_bundle ? 'bundle_id' : 'course_id' }}" value="{{ fav_id }}">
	{# The state this button asks for, so a repeated or double-submitted request changes nothing. #}
	<input type="hidden" name="favourite" value="{{ course.is_favourite is defined and course.is_favourite ? '0' : '1' }}">
	<input type="hidden" name="return" value="{{ favourite_return|default('/courses') }}">
	<button class="cl-favourite {{ course.is_favourite is defined and course.is_favourite ? 'is-on' : '' }}" type="submit"
	        aria-pressed="{{ course.is_favourite is defined and course.is_favourite ? 'true' : 'false' }}"
	        title="{{ course.is_favourite is defined and course.is_favourite ? 'Remove from favourites' : 'Add to favourites' }}">
		<span aria-hidden="true">{{ course.is_favourite is defined and course.is_favourite ? '★' : '☆' }}</span>
		<span class="cl-visually-hidden">{{ course.is_favourite is defined and course.is_favourite ? 'Remove from favourites' : 'Add to favourites' }}</span>
	</button>
</form>
