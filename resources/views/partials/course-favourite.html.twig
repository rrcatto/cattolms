{#
Generated by: Claude Code CLI
Date time: 2026/09/10 08:30 SAST
Version: 0.7
Description:
  The favourite star, on its own, so the toggle can swap just itself.

  A form rather than a link, because it changes something. With htmx it posts and swaps this button
  for the one the server sends back, so the star fills or empties where it stands; without htmx the
  same form posts normally and the server returns the reader to the page they were on. Neither path
  knows about the other - the only difference is which attributes the browser happens to honour.

  aria-pressed is what tells a screen reader this is a toggle and which way it currently sits, so it
  is stated on both states rather than only on the filled one.
Changelog:
  2026/09/10 08:30 SAST
  - Created so the star toggles in place instead of reloading the page.
#}
<form class="cl-favourite-form" action="/courses/favourite" method="post"
      hx-post="/courses/favourite" hx-swap="outerHTML" hx-target="this" id="favourite-{{ course.id }}">
	<input type="hidden" name="csrf" value="{{ csrf }}">
	<input type="hidden" name="course_id" value="{{ course.id }}">
	<input type="hidden" name="return" value="{{ favourite_return|default('/courses') }}">
	<button class="cl-favourite {{ course.is_favourite is defined and course.is_favourite ? 'is-on' : '' }}" type="submit"
	        aria-pressed="{{ course.is_favourite is defined and course.is_favourite ? 'true' : 'false' }}"
	        title="{{ course.is_favourite is defined and course.is_favourite ? 'Remove from favourites' : 'Add to favourites' }}">
		<span aria-hidden="true">{{ course.is_favourite is defined and course.is_favourite ? '★' : '☆' }}</span>
		<span class="cl-visually-hidden">{{ course.is_favourite is defined and course.is_favourite ? 'Remove from favourites' : 'Add to favourites' }}</span>
	</button>
</form>
