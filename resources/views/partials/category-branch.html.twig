{#
Generated by: Claude Code CLI
Date time: 2026/09/09 05:00 SAST
Version: 0.7
Description:
  One category in the browser: its heading, its own courses, and its sub-categories beneath.

  It includes itself for each child, which is what makes the depth of the taxonomy the template's
  business rather than the controller's. The indent comes from the depth it is given, so a
  sub-category reads as belonging to its parent without the tree needing a rule per level.

  The generated icon is emitted raw because it is SVG the platform produced itself, from a fixed
  generator with no caller-supplied markup in it. It is not user input and must never be given a
  path that would make it so.

Changelog:
  2026/09/09 05:00 SAST
  - Created.
#}
{#
	The request attributes sit on the details element, which is the element that fires the toggle
	event. An earlier version put them on the inner placeholder and listened through a from
	selector, and the request never fired at all - every category sat on "Loading N courses" for
	ever. The Company control centre carries the same note, because this is the second time.
#}
<details class="cl-category-branch cl-category-depth-{{ depth + 1 }}" {{ node.is_open or node.has_open_descendant ? 'open' : '' }} id="category-{{ node.slug }}"
	{% if node.course_count > 0 and not node.is_open %}
		hx-get="/courses/categories/{{ node.slug }}/courses"
		hx-trigger="toggle once"
		hx-target="find .cl-category-lazy"
		hx-swap="outerHTML"
	{% endif %}>
	<summary class="cl-category-summary">
		<span class="cl-category-icon" aria-hidden="true">{{ node.icon_svg|raw }}</span>
		<span class="cl-category-heading">
			<span class="cl-category-name">{{ node.name }}</span>
			{% if node.description %}
				<span class="cl-category-blurb">{{ node.description }}</span>
			{% endif %}
		</span>
		<span class="cl-category-counts">
			{% if node.course_count > 0 %}
				<span class="cl-category-count">{{ node.course_count }} here</span>
			{% endif %}
			{% if node.descendant_course_count != node.course_count %}
				<span class="cl-category-count cl-category-count-branch">{{ node.descendant_course_count }} in branch</span>
			{% endif %}
		</span>
	</summary>

	<div class="cl-category-body">
		{% if node.course_count > 0 %}
			{% if node.is_open %}
				{% include '@platform/partials/category-courses.html.twig' with {slug: node.slug, courses: node.courses, pagination: node.pagination} %}
			{% else %}
				<div class="cl-category-lazy">
					<noscript>
						<a class="btn btn-soft btn-sm" href="/courses?open={{ node.slug }}">Open {{ node.name }}</a>
					</noscript>
					<p class="text-body-secondary mb-0">Loading {{ node.course_count }} courses…</p>
				</div>
			{% endif %}
		{% endif %}

		{% for child in node.children %}
			{% include '@platform/partials/category-branch.html.twig' with {node: child, depth: depth + 1} %}
		{% endfor %}
	</div>
</details>
