{% if can_select_company %}
	<div class="company-context" data-company-context="{{ company_context_mode }}">
		<div>
			<h2>{{ company_context_name }}</h2>
			<p>Administering this company. Every action on this page applies to it.</p>
		</div>
		<span class="badge info">{{ company_context_domain }}</span>
		<span class="badge {{ company_context_universe=='seed' ? 'warn' : 'info' }}">{{ company_context_universe=='seed' ? 'SEED' : 'REAL' }}</span>
		<div class="company-context-actions">
			<button class="btn btn-soft btn-sm" type="button" data-open-modal="company-switch">Switch company</button>
			<noscript><a class="btn btn-soft btn-sm" href="/company/picker">Switch company</a></noscript>
		</div>
	</div>

	<div class="modal-backdrop" id="company-switch" role="dialog" aria-modal="true" aria-labelledby="company-switch-title" aria-hidden="true" hidden>
		<div class="modal-card modal-card-wide">

			<div class="modal-head">
				<h3 id="company-switch-title">Switch company</h3>
				<button class="close-btn" type="button" data-close-modal aria-label="Close">×</button>
			</div>

			<div class="modal-body">
				{% if company_switcher.universe_switch is defined and company_switcher.universe_switch %}
					{% include '@platform/partials/universe-switch.html.twig' with {us: company_switcher.universe_switch, ct: company_switcher.universe_counts|default(0)} %}
				{% endif %}

				{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'picker', ds_label: 'Search companies', ds_value: company_switcher.picker_search, ds_action: '/company/picker', universe: company_switcher.universe|default('')} %}

				<div id="picker-region" data-server-search-target>
				{% include '@platform/partials/company-picker-results.html.twig' with {picker_companies: company_switcher.picker_companies, picker_pagination: company_switcher.picker_pagination, picker_search: company_switcher.picker_search} %}
				</div>
			</div>

			<div class="modal-foot">
				<button class="btn btn-soft" type="button" data-close-modal>Close</button>
			</div>

		</div>
	</div>
{% endif %}
