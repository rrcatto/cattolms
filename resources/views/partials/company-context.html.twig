{# Server-validated company context, with a canonical picker and a plain GET fallback. #}
{% if can_select_company %}
	<div class="company-context" data-company-context="{{ company_context_mode }}">
		<div>
			<h2>
				{{ company_context_name }}
			</h2>
			<p>
				Administering this company. Every action on this page applies to it.
			</p>
		</div>
		{{ ui('feedback.badge', {label: (company_context_domain), tone: 'info'}) }}
		<div class="company-context-actions">
			{{ ui('action.button', {label: 'Switch company', variant: 'secondary', size: 'small', type: 'button', modal: 'company-switch'}) }}
			<noscript>
				{{ ui('action.link', {label: 'Switch company', variant: 'secondary', size: 'small', href: '/company/picker'}) }}
			</noscript>
		</div>
	</div>
	{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'company-switch', title: 'Switch company', size: 'wide'})} %}
{% block modal_body %}

					{% include '@platform/partials/company-picker-results.html.twig' with {picker_companies: company_switcher.picker_companies, picker_pagination: company_switcher.picker_pagination, picker_search: company_switcher.picker_search} %}

{% endblock %}
{% block modal_actions %}

				{{ ui('action.button', {label: 'Close', variant: 'secondary', size: 'normal', type: 'button', close_modal: true}) }}

{% endblock %}
{% endembed %}
{% endif %}
