<article class="cl-course-card">
{#
	The header carries the course name and the favourite star, over the artwork. The owner's
	instruction, 2026/09/10: the band at the top of a card was a picture and nothing else, so the
	one thing a reader is looking for - which course is this - was below it in the body, and the
	star was at the very bottom of the card.

	A course bundle is shown with this same card: it supplies its own href, link_label and facts
	(the key-value rows) and its saving_badge, so a bundle looks like a catalogue item in every theme
	without a second card of its own. A bundle has the same favourite star, by its bundle_id (owner, 2026-11-06), and one
	whose sale starts later says when in its availability_badge.

	The artwork is a background rather than content: it is decoration behind the two things that
	matter, and a scrim keeps the title legible whatever colours the artwork happens to use.
#}
	<header class="cl-course-card-header">
		<div class="cl-course-card-art" aria-hidden="true">
			{% if course.cover_media_public_id %}
				<img src="/course-media/{{ course.cover_media_public_id }}" class="cl-course-cover" alt="">
			{% elseif course.cover_svg is defined and course.cover_svg starts with '<svg' %}
				{{ course.cover_svg|authored }}
			{% else %}
				<div class="cl-course-cover-placeholder">
					<span>{{ course.cover_initial|default(course.title|slice(0, 1)|upper) }}</span>
				</div>
			{% endif %}
		</div>
		<div class="cl-course-card-headline">
			<h3 class="cl-course-card-title">
				<a href="{{ course.href|default('/courses/' ~ course.slug) }}">{{ course.title }}</a>
			</h3>
			{% if can_favourite is defined and can_favourite and course.id is defined %}
				{% include '@platform/partials/course-favourite.html.twig' with {course: course, favourite_return: favourite_return|default('/courses')} %}
			{% elseif can_favourite is defined and can_favourite and course.bundle_id is defined %}
				{% include '@platform/partials/course-favourite.html.twig' with {course: course, favourite_kind: 'bundle', favourite_return: favourite_return|default('/bundles')} %}
			{% endif %}
		</div>
	</header>
	<div class="cl-course-card-body">
		{% if course.category_path is defined and course.category_path %}
			{% set course_path_items = [] %}{% for step in course.category_path %}{% set course_path_items = course_path_items|merge([{label: step.name, href: '/courses/category/' ~ step.slug, current: false}]) %}{% endfor %}{{ ui('layout.breadcrumb', {items: course_path_items, aria_label: 'Category'}) }}
		{% endif %}
		{% if course.rating is defined and course.rating.count > 0 %}
			{% include '@platform/partials/course-rating-summary.html.twig' with {rating: course.rating, rating_compact: true} %}
		{% endif %}
		{% if course.summary %}
			<p class="cl-course-card-summary">
				{{ course.summary }}
			</p>
		{% endif %}
		{% if course.tags is defined and course.tags %}
			<div class="cl-course-card-tags">
				<span class="cl-course-card-tags-label">Tags</span>
				{% for course_tag in course.tags|slice(0, 4) %}
					{{ ui('catalogue.tag-chip', {tag: course_tag, compact: true}) }}
				{% endfor %}
			</div>
		{% endif %}
		{# A marked-down course is flagged as a special (owner, 2026-10-20), its was price struck through in the Price row. A bundle says what it saves under its price instead. #}
		{# A short course says so with its time in minutes (Course Specification 4.13, section 15; owner, 2026-11-11). #}
		{% set card_short = course.course_type|default('full') == 'short' %}
		{% if course.saving_percent|default(null) or card_short %}<p class="cl-course-card-special">{% if card_short %}{{ ui('feedback.badge', {label: 'Short course' ~ (course.estimated_minutes|default(0) ? ' · about ' ~ ((course.estimated_minutes / 5)|round * 5) ~ ' minutes' : ''), tone: 'info'}) }}{% endif %}{% if course.saving_percent|default(null) %} {{ ui('feedback.badge', {label: 'Special: save ' ~ course.saving_percent ~ '%', tone: 'success'}) }}{% endif %}</p>{% endif %}
		{{ ui('data.key-value-list', {items: course.facts is defined ? course.facts : [{label: 'Level', value: (course.level)}, {label: 'Course Items', value: (course.item_count)}, {label: 'Price', value: (course.default_price_label), was: course.default_was_label|default(null)}]}) }}
		{# A bundle says what it saves under its price (owner, 2026-11-06, the approved mockup), and its percentage (2026-11-09). #}
		{# One whose sale starts later says when (owner, 2026-11-06: "show me WHEN the bundle will be available to purchase"). #}
		{% if course.saving_badge|default(null) or course.availability_badge|default(null) %}<p class="cl-course-card-saving">{% if course.saving_badge|default(null) %}{{ ui('feedback.badge', {label: course.saving_badge, tone: 'success'}) }}{% endif %}{% if course.saving_percent_badge|default(null) %} {{ ui('feedback.badge', {label: course.saving_percent_badge, tone: 'success'}) }}{% endif %}{% if course.availability_badge|default(null) %} {{ ui('feedback.badge', {label: course.availability_badge, tone: 'info'}) }}{% endif %}</p>{% endif %}
		<div class="cl-course-card-foot">
			{{ ui('action.link', {label: course.link_label|default('View course'), variant: 'primary', size: 'small', href: course.href|default('/courses/' ~ (course.slug)), icon: 'action-view'}) }}
		</div>
	</div>
</article>
