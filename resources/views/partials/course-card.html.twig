{#
Generated by: Claude Code CLI
Date time: 2026/09/09 05:00 SAST
Version: 0.7
Description:
  One course, as a card.

  Three covers in order of preference: an uploaded image, the artwork the platform generated when
  the course was created, and - only if a caller supplies neither - the initial. The generated cover
  is emitted raw because it is SVG this platform produced from a fixed generator; it is never
  caller-supplied markup, and it must never be given a path that would make it so.

  The whole card is the link. The title is a heading rather than an anchor so that a screen reader
  announces it as the card's name, and the stretched link at the foot carries the destination.

Changelog:
  2026/09/09 05:00 SAST
  - Draws the generated cover where no image has been uploaded.
#}
<article class="card h-100 cl-course-card overflow-hidden">
	{% if course.cover_media_public_id %}
		<img src="/course-media/{{ course.cover_media_public_id }}" class="cl-course-cover" alt="">
	{% elseif course.cover_svg is defined and course.cover_svg %}
		<div class="cl-course-cover cl-course-cover-generated">{{ course.cover_svg|raw }}</div>
	{% else %}
		<div class="cl-course-cover cl-course-cover-placeholder">
			<span>{{ course.cover_initial }}</span>
		</div>
	{% endif %}
	<div class="card-body p-4 d-flex flex-column">
		<div class="d-flex flex-wrap gap-2 mb-3">
			{% if course.category_name is defined and course.category_name %}
				<span class="badge cl-badge-soft">{{ course.category_name }}</span>
			{% endif %}
			{% if course.level %}
				<span class="badge text-bg-light">{{ course.level }}</span>
			{% endif %}
		</div>
		<h3 class="h4">
			{{ course.title }}
		</h3>
		<p class="text-body-secondary flex-grow-1">
			{{ course.summary }}
		</p>
		<div class="d-flex justify-content-between align-items-center border-top pt-3 mt-2">
			<small>
				{{ course.module_count }} modules{% if course.question_count is defined %} · {{ course.question_count }} questions{% endif %}
			</small><a class="stretched-link fw-semibold" href="/courses/{{ course.slug }}">View course</a>
		</div>
	</div>
</article>
