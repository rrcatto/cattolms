{#
Generated by: Claude Code CLI
Date time: 2026/09/09 17:10 SAST
Version: 0.7
Description:
  One course, as a card. The single card used by every surface that lists courses.

  Three covers in order of preference: an uploaded image, the artwork the platform generated when
  the course was created, and - only if a caller supplies neither - the initial. The generated cover
  is emitted raw because it is SVG this platform produced from a fixed generator; it is never
  caller-supplied markup, and it must never be given a path that would make it so.

  The category is shown as its full path, outermost first, and every step is a link back to the
  category page with that category open. Tags link to the tag page.

  What is deliberately NOT shown is the access period. A card reading "1 year" beside a price reads
  as the length of the course rather than the length of the licence, so it belongs on the course's
  own page where there is room to say which it is.

  The card is no longer one big stretched link: it carries several real links now, and a stretched
  link would swallow every one of them.
Changelog:
  2026/09/09 17:10 SAST
  - Rebuilt to the owner's specification: cover, name, description, category breadcrumb, tags, price, level, module count, favourite and an explicit View course action. Access period removed.
  2026/09/09 05:00 SAST
  - Draws the generated cover where no image has been uploaded.
#}
<article class="card h-100 cl-course-card overflow-hidden">
	{% if course.cover_media_public_id %}
		<img src="/course-media/{{ course.cover_media_public_id }}" class="cl-course-cover" alt="">
	{% elseif course.cover_svg is defined and course.cover_svg %}
		<div class="cl-course-cover cl-course-cover-generated">{{ course.cover_svg|raw }}</div>
	{% else %}
		<div class="cl-course-cover cl-course-cover-placeholder">
			<span>{{ course.cover_initial }}</span>
		</div>
	{% endif %}
	<div class="card-body cl-course-card-body">
		{% if course.category_path is defined and course.category_path %}
			<nav class="cl-course-crumbs" aria-label="Category">
				{% for step in course.category_path %}
					{% if not loop.first %}<span class="cl-course-crumb-sep" aria-hidden="true">/</span>{% endif %}
					<a href="/courses?open={{ step.slug }}{{ universe_amp|default('') }}#category-{{ step.slug }}">{{ step.name }}</a>
				{% endfor %}
			</nav>
		{% endif %}
		<h3 class="cl-course-card-title">
			<a href="/courses/{{ course.slug }}{{ universe_query|default('') }}">{{ course.title }}</a>
		</h3>
		{% if course.summary %}
			<p class="cl-course-card-summary">
				{{ course.summary }}
			</p>
		{% endif %}
		{% if course.tags is defined and course.tags %}
			<div class="cl-course-card-tags">
				{% for course_tag in course.tags|slice(0, 4) %}
					<a class="cl-tag-chip" href="/courses/tag/{{ course_tag.slug }}{{ universe_query|default('') }}">{{ course_tag.name }}</a>
				{% endfor %}
			</div>
		{% endif %}
		<dl class="cl-course-facts">
			{% if course.level %}
				<div>
					<dt>
						Level
					</dt>
					<dd>
						{{ course.level }}
					</dd>
				</div>
			{% endif %}
			<div>
				<dt>
					Modules
				</dt>
				<dd>
					{{ course.module_count }}
				</dd>
			</div>
			{% if course.default_price_label is defined and course.default_price_label %}
				<div>
					<dt>
						Price
					</dt>
					<dd>
						{{ course.default_price_label }}
					</dd>
				</div>
			{% endif %}
		</dl>
		<div class="cl-course-card-foot">
			{% if can_favourite is defined and can_favourite %}
				<form action="/courses/favourite" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<input type="hidden" name="course_id" value="{{ course.id }}">
					<input type="hidden" name="return" value="{{ favourite_return|default('/courses') }}">
					<button class="cl-favourite {{ course.is_favourite is defined and course.is_favourite ? 'is-on' : '' }}" type="submit"
					        aria-pressed="{{ course.is_favourite is defined and course.is_favourite ? 'true' : 'false' }}"
					        title="{{ course.is_favourite is defined and course.is_favourite ? 'Remove from favourites' : 'Add to favourites' }}">
						<span aria-hidden="true">{{ course.is_favourite is defined and course.is_favourite ? '★' : '☆' }}</span>
						<span class="cl-visually-hidden">{{ course.is_favourite is defined and course.is_favourite ? 'Remove from favourites' : 'Add to favourites' }}</span>
					</button>
				</form>
			{% endif %}
			<a class="btn btn-primary btn-sm" href="/courses/{{ course.slug }}{{ universe_query|default('') }}">View course</a>
		</div>
	</div>
</article>
