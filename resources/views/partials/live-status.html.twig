{#
	A page that shows live data refreshes itself in place (owner, 2026-11-05: "I want htmx to be used as the default way to
	construct pages which display live data"; UX rule 8.6b). This is what refreshes it, and what says so, with Pause. It asks for
	the address in use, so it follows every change of card, search or page, and window.cattoLive holds it back while the reader is
	reading or typing. It is shown only with JavaScript. The controller calls liveRefreshIsNotAVisit().
	live_seconds: 15 for a list of what is happening now, 30 for figures and for records that a job changes once a minute.
#}
<div id="catto-live" class="cl-live-status small" data-live-status hidden hx-morph-skip
     hx-get="" hx-trigger="every {{ live_seconds }}s [cattoLive.mayRefresh()], catto-live-refresh"
     hx-target="#cl-main" hx-select="#cl-main" hx-swap="outerMorph" hx-sync="#cl-main:drop"
     hx-headers='{"X-Live-Refresh":"1"}' hx-status:4xx="swap:none" hx-status:5xx="swap:none">
	<span class="cl-live-dot" aria-hidden="true"></span>
	<span data-live-running>Updates by itself every {{ live_seconds }} seconds.</span>
	<span data-live-paused hidden>Paused. It stays as it is until you press Resume.</span>
	<span data-live-when></span>
	{{ ui('action.button', {label: 'Pause', type: 'button', icon: 'action-pause', id: 'live-pause', variant: 'secondary', size: 'small'}) }}
	{{ ui('action.button', {label: 'Resume', type: 'button', icon: 'action-play', id: 'live-resume', variant: 'secondary', size: 'small', hidden: true}) }}
</div>
