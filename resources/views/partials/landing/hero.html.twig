{#
	The top of a landing page, built as the course page's head is (owner, 2026-10-30: "limit it to the boxed container -
	full width of that. The svg cover image needs to cover the whole page header ... The add to cart block does not need
	to be in the page header"): the hero picture (the course's cover or a Resource Library picture) fills the head, the
	width of the cards below, and over it the category and level, the headline (the course title unless the author wrote
	one), the supporting text, the rating and the optional second button. Buying is in the Price and access and Call to
	action sections. A hero without a picture, hidden or removed, shows the same words in the page-head band.
#}
{% set hero_copy %}
	{% if landing.course.category_name or landing.course.level %}
		<div class="d-flex flex-wrap gap-3 mb-5">
			{% if landing.course.category_name %}{{ ui('feedback.badge', {label: landing.course.category_name, tone: 'neutral'}) }}{% endif %}
			{% if landing.course.level %}{{ ui('feedback.badge', {label: landing.course.level, tone: 'neutral'}) }}{% endif %}
		</div>
	{% endif %}
	<h1 class="cl-landing-headline" id="landing-title">{{ hero ? hero.headline : landing.course.title }}</h1>
	{% if hero %}
		{% include '@platform/partials/landing/paragraphs.html.twig' with {paragraphs: hero.paragraphs, paragraph_class: 'cl-lead'} %}
		{% if hero.rating and hero.rating.count > 0 %}
			{% include '@platform/partials/course-rating-summary.html.twig' with {rating: hero.rating} %}
		{% endif %}
		{% if hero.secondary %}
			<p class="cl-landing-secondary">{{ ui('action.link', {label: hero.secondary.label, variant: 'secondary', size: 'normal', href: hero.secondary.href, icon: (hero.secondary.href starts with '#' ? 'action-jump-down' : 'action-preview')}) }}</p>
		{% endif %}
	{% endif %}
{% endset %}
<section class="cl-page-head cl-landing-hero" aria-labelledby="landing-title">
	<div class="cl-container py-12">
		{% if hero and hero.picture %}
			<div class="cl-picture-head cl-landing-picture-head">
				{% if hero.picture.kind == 'resource' %}
					<div class="cl-picture-head-art"><img src="{{ hero.picture.src }}" alt="{{ hero.picture.alt }}" width="960" height="640" decoding="async"></div>
				{% else %}
					<div class="cl-picture-head-art" aria-hidden="true">{{ landing.course.cover_svg|raw }}</div>
				{% endif %}
				<div class="cl-picture-head-text cl-landing-hero-copy">{{ hero_copy }}</div>
			</div>
		{% else %}
			<div class="cl-landing-hero-copy">{{ hero_copy }}</div>
		{% endif %}
	</div>
</section>
