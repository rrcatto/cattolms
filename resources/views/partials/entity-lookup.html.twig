<div class="entity-lookup">{% embed ui_template('form.field') with {props: ui_props('form.field', {label: (lk_label), full_width: true, for: (lk_name) ~ '-search'})} %}
{% block control %}

{# Keep this note outside the tag below. A comment opened inside a start tag is not treated
       as a comment: the browser reads it as attribute text and ends the element early, which
       silently drops every attribute written after it. The value expression below guards the
       selection before reading its id, because the "nothing selected" default is a falsy
       scalar and cannot be dereferenced. #}
	<input type="hidden"
         id="{{ lk_name }}-value"
         name="{{ lk_name }}"
         value="{{ lk_selected ? lk_selected.id : '' }}"
         {{ lk_required ? 'required' : '' }}>
	<p class="lookup-selected" id="{{ lk_name }}-selected" aria-live="polite">
		{% if lk_selected %}
			<strong>{{ lk_selected.label }}</strong> <span class="muted">{{ lk_selected.detail }}</span>
		{% else %}
			<span class="muted">{{ lk_empty ?: 'Nothing selected' }}</span>
		{% endif %}
	</p>
	<input type="search"
         id="{{ lk_name }}-search"
         class="lookup-search"
         placeholder="Search {{ lk_type }}…"
         autocomplete="off"
         maxlength="120"
         aria-controls="{{ lk_name }}-results"
         hx-get="{{ lk_base is defined and lk_base ? lk_base : '/admin/lookup' }}/{{ lk_type }}"
         hx-trigger="keyup changed delay:250ms, search"
         hx-target="#{{ lk_name }}-results"
         hx-vals='{"target": "{{ lk_name }}"}'
         name="q" {{ ui_field_attrs(props) }}>
	<div class="lookup-results-panel" id="{{ lk_name }}-results" role="region" aria-live="polite">
		<p class="help lookup-hint">
			Type at least 2 characters to search.
		</p>
	</div>
	{% if lk_selected %}
		{{ ui('action.button', {label: 'Clear selection', variant: 'quiet', size: 'small', type: 'button', lookup_clear: (lk_name)}) }}
	{% endif %}

{% endblock %}
{% endembed %}
</div>
