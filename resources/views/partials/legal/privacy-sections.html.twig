{#
  The numbered sections of the Privacy Policy, each a closed accordion with its icon (owner, 2026-10-20). One source for the page and its PDF
  (partials/legal/document-pdf.html.twig), which prints each section open under its heading. The text is the
  legal text: change its date in CattoLearning\Legal\LegalDocuments whenever it changes.
#}
{% set a = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"' %}
{% set icons = {
	'responsible-party': '<svg ' ~ a ~ '><path d="M3 21h18"/><path d="M5 21V5l7-2v18"/><path d="M12 9h7v12"/><path d="M8 8h1M8 11h1M8 14h1M8 17h1M15 12h1M15 15h1M15 18h1"/></svg>',
	'what-we-collect': '<svg ' ~ a ~ '><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg>',
	'why': '<svg ' ~ a ~ '><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5V14M12 17h.01"/></svg>',
	'age': '<svg ' ~ a ~ '><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>',
	'identity': '<svg ' ~ a ~ '><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.5"/><path d="M5.5 16.5c.6-1.6 2-2.5 3.5-2.5s2.9.9 3.5 2.5M15 10h4M15 13h3"/></svg>',
	'cookies': '<svg ' ~ a ~ '><path d="M21 12a9 9 0 1 1-9-9 3 3 0 0 0 3 3 3 3 0 0 0 3 3 3 3 0 0 0 3 3z"/><circle cx="8.5" cy="10" r="1"/><circle cx="12" cy="15" r="1"/><circle cx="15.5" cy="12" r="1"/></svg>',
	'who-receives': '<svg ' ~ a ~ '><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6"/></svg>',
	'retention': '<svg ' ~ a ~ '><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
