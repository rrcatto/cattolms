{#
Generated by: Claude Code CLI
Date time: 2026/09/09 05:00 SAST
Version: 0.7
Description:
  One category's courses: the shared pagination control above and below a grid of cards.

  It is a partial rather than markup inside the browser because the same thing is rendered twice -
  server-side for the category a reader arrived on, and as the fragment every other accordion
  fetches when it is opened. One template means opening a category and linking straight to it
  cannot produce two different pages.
Changelog:
  2026/09/09 05:00 SAST
  - Created.
#}
<div id="category-{{ slug }}-region" data-server-search-target>
	<div id="category-{{ slug }}-results">
		{% include '@platform/partials/pagination.html.twig' with {pg: pagination} %}
		{% if courses %}
			<div class="cl-course-cards">
				{% for course in courses %}
					{% include '@platform/partials/course-card.html.twig' with {course: course} %}
				{% endfor %}
			</div>
			{% include '@platform/partials/pagination.html.twig' with {pg: pagination} %}
		{% else %}
			<p class="text-body-secondary mb-0">Nothing is filed directly in this category. Its sub-categories may still hold courses.</p>
		{% endif %}
	</div>
</div>
