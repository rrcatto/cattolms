{#
	A course's modules, numbered as the course numbers them, each with its study time and, for one in the free preview,
	a link to it (owner, 2026-10-30), then what follows the modules. Used by a course's page and by its landing page's
	contents. Expects modules_view: CoursePageView::view(), course_slug and list_label_id: the id of the heading it
	belongs to.
#}
<ol class="cl-course-modules" aria-labelledby="{{ list_label_id }}">
	{% for module in modules_view.modules %}
		<li>
			<span class="cl-course-module-number">{{ module.number }}</span>
			<span class="cl-course-module-text">
				<span class="cl-course-module-title">{{ module.title }}</span>
				<span class="cl-course-module-time">{{ module.time }}{% if module.preview %} · <a href="/courses/{{ course_slug }}/preview">Free preview</a>{% endif %}</span>
			</span>
		</li>
	{% endfor %}
</ol>
{% if modules_view.after %}<p class="cl-course-modules-after">{{ modules_view.after }}</p>{% endif %}
