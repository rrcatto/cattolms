<nav class="cl-navigation" id="cl-primary-navigation" aria-label="Primary navigation">
{% for item in navigation %}
	{% if item.children|length > 0 %}
		<details class="cl-nav-menu {{ item.active ? 'is-active' : '' }}" data-cl-dropdown data-nav-item="{{ item.key }}">
			<summary class="cl-nav-link">
				<svg class="cl-nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ item.icon_id }}"></use></svg><span>{{ item.label }}</span><span class="cl-nav-group-caret" aria-hidden="true">⌄</span>
			</summary>
			<div class="cl-nav-panel">
				<nav aria-label="{{ item.label }} navigation">
			{% for child in item.children %}
				{% if child.children|length > 0 %}
					<div class="cl-nav-group cl-nav-flyout-edge {{ child.active ? 'cl-nav-group-current' : '' }}" data-nav-item="{{ child.key }}">
						<button class="cl-nav-group-label" type="button" aria-haspopup="true">
							<svg class="cl-nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg><span>{{ child.label }}</span><span class="cl-nav-group-caret" aria-hidden="true">›</span>
						</button>
						<div class="cl-nav-subpanel">
						{% for grandchild in child.children %}
							<a class="cl-nav-sublink {{ grandchild.active ? 'is-active' : '' }}" href="{{ grandchild.href }}" data-nav-item="{{ grandchild.key }}">
								<svg class="cl-nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ grandchild.icon_id }}"></use></svg><span>{{ grandchild.label }}</span>
							</a>
						{% endfor %}
						</div>
					</div>
				{% else %}
					<a class="cl-nav-sublink {{ child.active ? 'is-active' : '' }}" href="{{ child.href }}" data-nav-item="{{ child.key }}">
						<svg class="cl-nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ child.icon_id }}"></use></svg><span>{{ child.label }}</span>
					</a>
				{% endif %}
			{% endfor %}
				</nav>
			</div>
		</details>
	{% elseif item.method == 'POST' %}
		{% if identity_placement == 'navigation' and user.logged_in %}{% include '@platform/partials/account/identity-compact.html.twig' %}{% endif %}
		<form class="cl-nav-form" action="{{ item.href }}" method="post" data-nav-item="{{ item.key }}">
			<input type="hidden" name="csrf" value="{{ item.csrf }}">
			<button class="cl-nav-link" type="submit"><svg class="cl-nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ item.icon_id }}"></use></svg><span>{{ item.label }}</span></button>
		</form>
	{% else %}
		<a class="cl-nav-link {{ item.active ? 'is-active' : '' }}" href="{{ item.href }}" data-nav-item="{{ item.key }}">
			<svg class="cl-nav-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><use href="{{ platform.icon_sprite }}#{{ item.icon_id }}"></use></svg><span>{{ item.label }}</span>
		</a>
	{% endif %}
{% endfor %}
</nav>
