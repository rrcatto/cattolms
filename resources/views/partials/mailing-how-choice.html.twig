{#
	How a person gets updates (owner, 2026-10-28, round two 2A and 4C: "choose to receive updates as they occur, or each
	list collated into its own digest, or one big digest containing all their subscriptions, sent out according to a
	frequency they choose: daily, weekly or monthly"), for My Subscriptions and the first Follow. Weekly is chosen when
	nothing was. mh: {delivery, frequency, deliveries, frequencies, days, id}.
#}
{% set mh_notes = {instant: 'An email whenever there is news, within our sending hours.', per_list: 'A separate digest for each course, category, tag or list you follow.', combined: 'Everything you follow together, in one email.'} %}
{% set mh_icons = {instant: 'zap', per_list: 'layers', combined: 'mails', daily: 'calendar-days', weekly: 'calendar-range', monthly: 'calendar'} %}
<div class="cl-mailing-lists">
	{{ ui('form.picture-choice', {name: 'delivery', legend: 'Send me updates', size: 'small', selected: mh.delivery, items: mh.deliveries|keys|map(value => {value: value, label: mh.deliveries[value], icon: lucide(mh_icons[value]|default('mail')), note: mh_notes[value]|default('')})}) }}
</div>
<div class="cl-mailing-lists">
	{{ ui('form.picture-choice', {name: 'frequency', legend: 'How often a digest comes', size: 'small', selected: mh.frequency, items: mh.frequencies|keys|map(value => {value: value, label: mh.frequencies[value], icon: lucide(mh_icons[value]|default('calendar')), note: mh.days[value] is defined ? 'It comes ' ~ mh.days[value] ~ '.' : ''})}) }}
</div>
