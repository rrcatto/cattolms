{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Assessment title', full_width: false, for: 'field-assessment-editor-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

		<input class="form-control" name="assessment_title" value="{{ assessment.title }}" required id="field-assessment-editor-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Pass mark', full_width: false, for: 'field-assessment-editor-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

		<div class="input-group">
			<input class="form-control" type="number" min="0" max="100" step="0.01" name="pass_mark" value="{{ assessment.pass_mark ?: 50 }}" id="field-assessment-editor-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>
			<span class="input-group-text">%</span>
		</div>

{% endblock %}
{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Instructions', full_width: true, for: 'field-assessment-editor-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

		<textarea class="form-control cl-rich-editor" name="instructions_html" rows="4" id="field-assessment-editor-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>{{ assessment.instructions_html }}</textarea>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		<h3 class="h5">
			Attempt and question-selection rules
		</h3>
		{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Graded questions drawn', full_width: false, for: 'field-assessment-editor-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input class="form-control" type="number" min="1" name="graded_question_count" value="{{ assessment.graded_question_count ?: editor_question_count }}" id="field-assessment-editor-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Maximum graded attempts', full_width: false, for: 'field-assessment-editor-5-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input class="form-control" type="number" min="1" name="maximum_attempts" value="{{ assessment.maximum_attempts }}" placeholder="Unlimited" id="field-assessment-editor-5-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Time limit (seconds)', full_width: false, for: 'field-assessment-editor-6-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input class="form-control" type="number" min="1" name="time_limit_seconds" value="{{ assessment.time_limit_seconds ?: 1800 }}" id="field-assessment-editor-6-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Recorded result', full_width: false, for: 'field-assessment-editor-7-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<select class="form-select" name="score_policy" id="field-assessment-editor-7-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="highest" {{ assessment.score_policy == 'highest' ? 'selected' : '' }}>Highest score</option><option value="average" {{ assessment.score_policy == 'average' ? 'selected' : '' }}>Average score</option><option value="latest" {{ assessment.score_policy == 'latest' ? 'selected' : '' }}>Latest score</option></select>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Introductory questions', full_width: false, for: 'field-assessment-editor-8-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input class="form-control" type="number" min="0" name="difficulty_introductory" value="{{ assessment.difficulty_introductory ?: 0 }}" id="field-assessment-editor-8-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Standard questions', full_width: false, for: 'field-assessment-editor-9-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input class="form-control" type="number" min="0" name="difficulty_standard" value="{{ assessment.difficulty_standard ?: 0 }}" id="field-assessment-editor-9-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Advanced questions', full_width: false, for: 'field-assessment-editor-10-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input class="form-control" type="number" min="0" name="difficulty_advanced" value="{{ assessment.difficulty_advanced ?: 0 }}" id="field-assessment-editor-10-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			<div class="col-12 d-flex flex-wrap gap-4">
				{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Randomise questions'})} %}
{% block control %}
<input class="form-check-input" type="checkbox" name="randomise_questions" value="1" {{ assessment.randomise_questions ? 'checked' : '' }}>
{% endblock %}
{% endembed %}{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Randomise answers'})} %}
{% block control %}
<input class="form-check-input" type="checkbox" name="randomise_options" value="1" {{ assessment.randomise_options ? 'checked' : '' }}>
{% endblock %}
{% endembed %}{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Use negative marking'})} %}
{% block control %}
<input class="form-check-input" type="checkbox" name="negative_marking" value="1" {{ assessment.negative_marking ? 'checked' : '' }}>
{% endblock %}
{% endembed %}
			</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		<h3 class="h5">
			Practice assessment
		</h3>
		{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			<div class="col-md-3">
				{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Enable unlimited practice'})} %}
{% block control %}

					<input id="practice-enabled" type="checkbox" name="practice_enabled" value="1" {{ assessment.practice_enabled ? 'checked' : '' }}>

{% endblock %}
{% endembed %}
			</div>
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Practice questions drawn', full_width: false, for: 'field-assessment-editor-11-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input class="form-control" type="number" min="1" name="practice_question_count" value="{{ assessment.practice_question_count ?: 5 }}" id="field-assessment-editor-11-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Practice pool', full_width: false, for: 'field-assessment-editor-12-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<select class="form-select" name="practice_pool_mode" id="field-assessment-editor-12-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="separate" {{ assessment.practice_pool_mode == 'separate' ? 'selected' : '' }}>Separate practice-only questions</option><option value="graded" {{ assessment.practice_pool_mode == 'graded' ? 'selected' : '' }}>Reuse graded questions</option><option value="both" {{ assessment.practice_pool_mode == 'both' ? 'selected' : '' }}>Both practice and graded eligible questions</option></select>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
{% include '@platform/partials/question-editor.html.twig' with {diagnostic: false, modules: []} %}
{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

	{{ ui('action.button', {label: 'Add question', variant: 'secondary', size: 'normal', type: 'button', id: 'add-question', icon: 'action-add'}) }}{{ ui('action.button', {label: 'Save assessment', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}
