	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'requests', pagination: requests_pagination, search: {ds_name: 'requests', ds_label: 'Search requests', ds_value: requests_search, ds_action: '/company/requests'}})} %}
{% block results %}

				{{ ui('layout.section-head', {heading: 'Course requests', eyebrow: 'Course Requests', summary: 'Approval uses an exact matching credit where available.'}) }}
				{% if requests %}

						{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

								<tr>
									{% for sh in requests_sort_headers %}
										{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: requests_region, sort_results: requests_results} %}
									{% endfor %}
								</tr>

{% endblock %}
{% block body %}

								{% for request in requests %}
									<tr>
										<td>
											{# The name and account reference, linked to the person's page (owner, 2026-10-21). #}
											<strong>{{ ui('data.person', {name: request.learner_name, reference: request.learner_reference, href: '/company/people/' ~ request.user_id}) }}</strong>
										</td>
										<td>
											{{ request.course_title }}
										</td>
										<td class="small">
											{{ request.requested_at }}
										</td>
										<td>
											{{ ui('feedback.badge', {label: (request.status_label), tone: request.status_tone}) }}
										</td>
										<td class="cell-actions">
											{% if request.status=='pending' %}
												{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true, icon: 'action-more'})} %}
{% block body %}

														<form action="/company/requests/{{ request.id }}/decision" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															{{ ui('action.button', {label: 'Approve', variant: 'primary', size: 'small', name: 'decision', value: 'approve', icon: 'action-approve'}) }}
															{{ ui('action.button', {label: 'Reject', variant: 'danger', size: 'small', name: 'decision', value: 'reject', confirm: 'Reject this course request? The learner is told it was declined.', icon: 'action-reject'}) }}
														</form>

{% endblock %}
{% endembed %}
											{% endif %}
										</td>
									</tr>
								{% endfor %}

{% endblock %}
{% endembed %}

				{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

						There are no course requests.

{% endblock %}
{% endembed %}
				{% endif %}

{% endblock %}
{% block preview %}

					{% if requests_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} requests.</span>
							{{ ui('action.link', {label: 'View all requests', variant: 'secondary', size: 'small', href: '/company/requests', icon: 'action-view-all'}) }}
						</div>
					{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
