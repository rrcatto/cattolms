{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'How your people are progressing', eyebrow: 'Performance', summary: 'How this company\'s people are progressing through their courses.'}) }}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

			<div>
				Every figure below counts your own staff only. A course appears once at least one of your people is enrolled in it.
			</div>

{% endblock %}
{% endembed %}

		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'company_performance', pagination: company_performance_pagination, search: {ds_name: 'company_performance', ds_label: 'Search courses', ds_value: company_performance_search, ds_action: '/company/performance'}})} %}
{% block results %}

				{% if company_performance %}

						{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

								<tr>
									{% for sh in company_performance_sort_headers %}
										{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: company_performance_region, sort_results: company_performance_results} %}
									{% endfor %}
								</tr>

{% endblock %}
{% block body %}

								{% for row in company_performance %}
									<tr>
										<td title="{{ row.title }}">
											<strong>{{ row.title }}</strong>
										</td>
										<td>
											{{ ui('feedback.badge', {label: (row.status), tone: 'info'}) }}
										</td>
										<td>
											{{ row.enrolments }}
										</td>
										<td>
											{{ row.started }}
										</td>
										<td>
											{{ row.completed }}
										</td>
										<td>
											{{ row.completion_rate }}%
										</td>
										<td>
											{{ row.average_result }}%
										</td>
									</tr>
								{% endfor %}

{% endblock %}
{% endembed %}

				{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

						No courses match this search.

{% endblock %}
{% endembed %}
				{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
