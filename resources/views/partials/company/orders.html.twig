{#
	Company › Orders (owner, 2026-10-26: "A company admin sees only its own company's orders"): every order the company
	placed, newest first, whoever of its administrators placed it, with what is still owed. Each opens its order page,
	where any of the company's administrators can pay it, see its documents and ask about a refund.
#}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Orders', eyebrow: 'Orders', summary: 'The credits the company bought, paid or waiting for payment.'}) }}
	{# All sections shows each section without its list: Orders opens its own page there. #}
	{% if company_orders is not defined %}
		{{ ui('action.link', {label: 'Open Orders', variant: 'secondary', size: 'small', href: '/company/orders', icon: 'action-open'}) }}
	{% else %}
	{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'company_orders', pagination: company_orders_pagination|default(null)})} %}
{% block results %}
		{% if company_orders %}
			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
			{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Order'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Placed'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 22, label: 'Placed by'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Status'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Total'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Still owed'}} %}</tr>{% endblock %}
			{% block body %}{% for order in company_orders %}<tr>
				<td><a href="/account/orders/{{ order.id }}">{{ order.number }}</a></td>
				<td>{{ order.placed_at|date('j M Y') }}</td>
				<td class="cell-text">{{ ui('data.person', {name: order.purchaser_name|default('') ?: 'Someone', reference: order.purchaser_reference|default(''), href: '/company/people/' ~ order.purchaser_user_id}) }}</td>
				<td>{{ order.state_label }}</td>
				<td>{{ order.total_label }}</td>
				<td>{{ order.due_label ? order.due_label ~ ' by ' ~ order.payment_due_at|date('j M Y') : 'Nothing' }}</td>
			</tr>{% endfor %}{% endblock %}
			{% endembed %}
		{% else %}
			{{ ui('feedback.empty', {heading: 'No orders yet', summary: 'Credits the company buys appear here.'}) }}
		{% endif %}
{% endblock %}
	{% endembed %}
	{% endif %}
{% endblock %}
{% endembed %}
