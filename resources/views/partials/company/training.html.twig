{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Courses bought for staff', eyebrow: 'Courses Bought', summary: 'Courses this company has bought access to for its staff.'}) }}

		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'training', pagination: training_pagination, search: {ds_name: 'training', ds_label: 'Search training courses', ds_value: training_search, ds_action: '/company/training'}})} %}
{% block results %}

				{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

					<div>
						<strong>Courses this company has bought access to.</strong> Each row shows how many seats were purchased and how many are still free to assign. Courses this company owns are under <a href="/company/courses">Courses Created</a> and cost nothing to train staff on.
					</div>

{% endblock %}
{% endembed %}
				{% if training %}

						{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

								<tr>
									{% for sh in training_sort_headers %}
										{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: training_region, sort_results: training_results} %}
									{% endfor %}
								</tr>

{% endblock %}
{% block body %}

								{% for course in training %}
									<tr>
										<td>
											<strong>{{ course.title }}</strong>
											<div class="muted small">
												{{ course.owner_company_name ?: 'Platform course' }}
											</div>
										</td>
										<td>
											{{ course.category_name ?: '—' }}
										</td>
										<td>
											{{ course.credits_bought }}
										</td>
										<td>
											<strong>{{ course.credits_bought - course.credits_used }}</strong>
										</td>
										<td>
											{{ course.staff_enrolled }}
										</td>
										<td>
											{{ course.staff_completed }}
										</td>
									</tr>
								{% endfor %}

{% endblock %}
{% endembed %}

				{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

						<h3>
							No training courses yet
						</h3>
						<p>
							When this company buys access to a course it does not own, it appears here with the seats it holds.
						</p>

{% endblock %}
{% endembed %}
				{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
