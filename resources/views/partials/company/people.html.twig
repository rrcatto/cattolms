{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'people', pagination: people_pagination, search: {ds_name: 'people', ds_label: 'Search people', ds_value: people_search, ds_action: '/company/people'}})} %}
{% block results %}

		{% embed ui_template('layout.toolbar') with {props: ui_props('layout.toolbar', {})} %}
{% block toolbar_primary %}

				<div class="cl-ui-eyebrow">
					People
				</div>
				<h2>
					People
				</h2>
				<p class="muted small">
					People in the company you are administering.
				</p>

{% endblock %}
{% block toolbar_actions %}

			{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: '＋ Add person'})} %}
{% block body %}

				<form class="popover-form" action="/company/people" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

					<input type="hidden" name="csrf" value="{{ csrf }}">
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'First name', full_width: false, for: 'field-people-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

						<input name="first_name" required id="field-people-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Last name', full_width: false, for: 'field-people-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

						<input name="last_name" required id="field-people-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Company email', full_width: true, for: 'field-people-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

						<input type="email" name="email" required id="field-people-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Role', full_width: true, for: 'field-people-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

						<select name="role" id="field-people-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="STUDENT">Student</option><option value="COURSE_EDITOR">CourseEditor</option><option value="COURSE_OWNER">CourseOwner</option><option value="COMPANY_ADMIN">CompanyAdministrator</option></select>

{% endblock %}
{% endembed %}
					<div class="cl-ui-field--full">
						{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Create account', variant: 'primary', size: 'normal', icon: 'action-add'}) }}
{% endblock %}
{% endembed %}
					</div>

{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% for sh in people_sort_headers %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: people_region, sort_results: people_results} %}
						{% endfor %}
					</tr>

{% endblock %}
{% block body %}

					{% for person in people %}
						<tr>
							<td>
								<strong>{{ person.name }}</strong>
								<div class="small muted">
									{{ person.email }}
								</div>
							</td>
							<td>
								{{ person.company_role ?: person.roles_label }}
							</td>
							<td>
								{{ person.course_count }}
							</td>
							<td>
								{{ ui('feedback.badge', {label: (person.status=='active' ? 'Active' : 'Disabled'), tone: person.status=='active' ? 'success' : 'danger'}) }}
							</td>
							<td class="cell-actions">
								{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true})} %}
{% block body %}

										{{ ui('action.button', {label: 'Edit', variant: 'secondary', size: 'small', type: 'button', modal: 'company-person-' ~ (person.id)}) }}
										{% if person.status=='active' %}
											<form action="/company/people/{{ person.id }}/status" method="post">
												<input type="hidden" name="csrf" value="{{ csrf }}">
												<input type="hidden" name="status" value="disabled">
												{{ ui('action.button', {label: 'Disable', variant: 'secondary', size: 'small', confirm: 'Disable this account? They will be signed out and cannot sign in again until enabled. Their membership and learning history are kept.'}) }}
											</form>
										{% else %}
											<form action="/company/people/{{ person.id }}/status" method="post">
												<input type="hidden" name="csrf" value="{{ csrf }}">
												<input type="hidden" name="status" value="active">
												{{ ui('action.button', {label: 'Enable', variant: 'primary', size: 'small'}) }}
											</form>
										{% endif %}
										<form action="/company/people/{{ person.id }}/remove" method="post">
											<input type="hidden" name="csrf" value="{{ csrf }}">
											{{ ui('action.button', {label: 'Remove', variant: 'danger', size: 'small', confirm: 'Remove this person from the company? Course access this company granted them ends. Their account and learning history are kept, and this does not stop them signing in.', icon: 'action-remove'}) }}
										</form>

{% endblock %}
{% endembed %}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}

		{% for person in people %}
			{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'company-person-' ~ (person.id), title: 'Edit ' ~ (person.name), action: '/company/people/' ~ (person.id), method: 'post'})} %}
{% block modal_body %}

						<input type="hidden" name="csrf" value="{{ csrf }}">

							{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'First name', full_width: false, for: 'field-people-5-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

									<input name="first_name" value="{{ person.first_name }}" id="field-people-5-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Middle names', full_width: false, for: 'field-people-6-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

									<input name="middle_names" maxlength="160" value="{{ person.middle_names }}" id="field-people-6-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Last name', full_width: false, for: 'field-people-7-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

									<input name="last_name" value="{{ person.last_name }}" id="field-people-7-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Certificate name', full_width: true, for: 'field-people-8-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), help: 'The name printed on certificates. Left blank, the person\'s ordinary name is used.'})} %}
{% block control %}

									<input name="certificate_name" value="{{ person.certificate_name }}" id="field-people-8-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Mobile number', full_width: true, for: 'field-people-9-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

									<input name="mobile_number" value="{{ person.mobile_number }}" id="field-people-9-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								<div class="cl-ui-field--full">
									<p class="help">
										Email address, roles and account status are changed elsewhere: the address is part of the sign-in identity, and the account status has its own Disable and Enable action.
									</p>
								</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% block modal_actions %}

							{{ ui('action.button', {label: 'Cancel', variant: 'secondary', size: 'normal', type: 'button', close_modal: true}) }}
							{{ ui('action.button', {label: 'Save person', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}
		{% endfor %}

{% endblock %}
{% block preview %}

			{% if people_preview_has_more %}
				<div class="pagination-row">
					<span class="pagination-summary">Showing the first {{ preview_page_size }} people.</span>
					{{ ui('action.link', {label: 'View all people', variant: 'secondary', size: 'small', href: '/company/people'}) }}
				</div>
			{% endif %}

{% endblock %}
{% endembed %}
