{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'people', ds_label: 'Search people', ds_value: people_search, ds_action: '/company/people'} %}
<div id="people-region" data-server-search-target>
	<div id="people-results">
		{% if people_pagination %}
			{% include '@platform/partials/pagination.html.twig' with {pg: people_pagination} %}
		{% endif %}
		<div class="toolbar">
			<div>
				<div class="eyebrow">
					People
				</div>
				<h2>
					People
				</h2>
				<p class="muted small">
					People in the company you are administering.
				</p>
			</div>
			<details>
				<summary class="btn btn-primary">
					＋ Add person
				</summary>
				<form action="/company/people" method="post" class="card form-grid popover-form">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<div class="field">
						<label>First name</label>
						<input name="first_name" required>
					</div>
					<div class="field">
						<label>Last name</label>
						<input name="last_name" required>
					</div>
					<div class="field full">
						<label>Company email</label>
						<input type="email" name="email" required>
					</div>
					<div class="field full">
						<label>Role</label><select name="role"><option value="STUDENT">Student</option><option value="COURSE_EDITOR">CourseEditor</option><option value="COURSE_OWNER">CourseOwner</option><option value="COMPANY_ADMIN">CompanyAdministrator</option></select>
					</div>
					<div class="field full">
						<button class="btn btn-primary">Create account</button>
					</div>
				</form>
			</details>
		</div>
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						{% for sh in people_sort_headers %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: people_region, sort_results: people_results} %}
						{% endfor %}
					</tr>
				</thead>
				<tbody>
					{% for person in people %}
						<tr>
							<td>
								<strong>{{ person.name }}</strong>
								<div class="small muted">
									{{ person.email }}
								</div>
							</td>
							<td>
								{{ person.company_role ?: person.roles_label }}
							</td>
							<td>
								{{ person.course_count }}
							</td>
							<td>
								<span class="badge {{ person.status=='active' ? 'good' : 'danger' }}">{{ person.status=='active' ? 'Active' : 'Disabled' }}</span>
							</td>
							<td class="cell-actions">
								<details class="row-menu" data-cl-dropdown>
									<summary class="btn btn-soft btn-sm row-menu-trigger">
										Actions ▾
									</summary>
									<div class="row-menu-panel">
										<button class="btn btn-soft btn-sm" type="button" data-open-modal="company-person-{{ person.id }}">Edit</button>
										{% if person.status=='active' %}
											<form action="/company/people/{{ person.id }}/status" method="post">
												<input type="hidden" name="csrf" value="{{ csrf }}">
												<input type="hidden" name="status" value="disabled">
												<button class="btn btn-soft btn-sm" data-confirm="Disable this account? They will be signed out and cannot sign in again until enabled. Their membership and learning history are kept.">Disable</button>
											</form>
										{% else %}
											<form action="/company/people/{{ person.id }}/status" method="post">
												<input type="hidden" name="csrf" value="{{ csrf }}">
												<input type="hidden" name="status" value="active">
												<button class="btn btn-primary btn-sm">Enable</button>
											</form>
										{% endif %}
										<form action="/company/people/{{ person.id }}/remove" method="post">
											<input type="hidden" name="csrf" value="{{ csrf }}">
											<button class="btn btn-danger btn-sm" data-confirm="Remove this person from the company? Course access this company granted them ends. Their account and learning history are kept, and this does not stop them signing in.">Remove</button>
										</form>
									</div>
								</details>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		{% for person in people %}
			<div class="modal-backdrop" id="company-person-{{ person.id }}" role="dialog" aria-modal="true" aria-labelledby="company-person-title-{{ person.id }}" aria-hidden="true" hidden>
				<div class="modal-card">
					<form action="/company/people/{{ person.id }}" method="post">
						<input type="hidden" name="csrf" value="{{ csrf }}">
						<div class="modal-head">
							<h3 id="company-person-title-{{ person.id }}">
								Edit {{ person.name }}
							</h3>
							<button class="close-btn" type="button" data-close-modal aria-label="Close">×</button>
						</div>
						<div class="modal-body">
							<div class="form-grid">
								<div class="field">
									<label>First name</label>
									<input name="first_name" value="{{ person.first_name }}">
								</div>
								<div class="field">
									<label>Middle names</label>
									<input name="middle_names" maxlength="160" value="{{ person.middle_names }}">
								</div>
								<div class="field">
									<label>Last name</label>
									<input name="last_name" value="{{ person.last_name }}">
								</div>
								<div class="field full">
									<label>Certificate name</label>
									<input name="certificate_name" value="{{ person.certificate_name }}">
									<div class="help">
										The name printed on certificates. Left blank, the person's ordinary name is used.
									</div>
								</div>
								<div class="field full">
									<label>Mobile number</label>
									<input name="mobile_number" value="{{ person.mobile_number }}">
								</div>
								<div class="field full">
									<p class="help">
										Email address, roles and account status are changed elsewhere: the address is part of the sign-in identity, and the account status has its own Disable and Enable action.
									</p>
								</div>
							</div>
						</div>
						<div class="modal-foot">
							<button class="btn btn-soft" type="button" data-close-modal>Cancel</button>
							<button class="btn btn-primary" type="submit">Save person</button>
						</div>
					</form>
				</div>
			</div>
		{% endfor %}
		{% if people_pagination %}
			{% include '@platform/partials/pagination.html.twig' with {pg: people_pagination} %}
		{% else %}
			{% if people_preview_has_more %}
				<div class="pagination-row">
					<span class="pagination-summary">Showing the first {{ preview_page_size }} people.</span>
					<a class="btn btn-soft btn-sm" href="/company/people">View all people</a>
				</div>
			{% endif %}
		{% endif %}
	</div>
</div>
