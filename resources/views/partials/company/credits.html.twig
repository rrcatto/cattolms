<div class="grid section">
	<div class="card">
		<div class="section-head">
			<div>
				<div class="eyebrow">
					Credits
				</div>
				<h2>
					Credit pools
				</h2>
				<p>
					Course and access-period credit pools.
				</p>
			</div>
		</div>
		{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'credits', ds_label: 'Search credits', ds_value: credits_search, ds_action: '/company/credits'} %}
		<div id="credits-region" data-server-search-target>
			<div id="credits-results">
				{% if credits_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: credits_pagination} %}
				{% endif %}
				<div class="notice">
					<span>ⓘ</span>
					<div>
						Credits are tied to a course and access period and are consumed when the learner starts the course.
					</div>
				</div>
				<div class="table-wrap section">
					<table>
						<thead>
							<tr>
								{% for sh in credits_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: credits_region, sort_results: credits_results} %}
								{% endfor %}
							</tr>
						</thead>
						<tbody>
							{% for credit in credits %}
								<tr>
									<td>
										{{ credit.course_title }}
									</td>
									<td>
										{{ credit.access_period_label }}
									</td>
									<td>
										{{ credit.quantity }}
									</td>
									<td>
										{{ credit.available_count }}
									</td>
									<td>
										{{ credit.assigned_count }}
									</td>
									<td>
										{{ credit.consumed_count }}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% if credits_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: credits_pagination} %}
				{% else %}
					{% if credits_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} credit records.</span>
							<a class="btn btn-soft btn-sm" href="/company/credits">View all credit records</a>
						</div>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</div>
</div>
