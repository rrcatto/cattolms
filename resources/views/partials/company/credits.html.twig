{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Credit pools', eyebrow: 'Credits', summary: 'Course and access-period credit pools.'})} %}{% block section_actions %}{{ ui('action.link', {label: 'Buy credits', variant: 'primary', size: 'small', href: '/company/credits/buy'}) }}{% endblock %}{% endembed %}

		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'credits', pagination: credits_pagination, search: {ds_name: 'credits', ds_label: 'Search credits', ds_value: credits_search, ds_action: '/company/credits'}})} %}
{% block results %}

				{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

					<div>
						Credits are tied to a course and access period and are consumed when the learner starts the course.
					</div>

{% endblock %}
{% endembed %}

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% for sh in credits_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: credits_region, sort_results: credits_results} %}
								{% endfor %}
							</tr>

{% endblock %}
{% block body %}

							{% for credit in credits %}
								<tr>
									<td>
										{{ credit.course_title }}
									</td>
									<td>
										{{ credit.access_period_label }}
									</td>
									<td>
										{{ credit.quantity }}
									</td>
									<td>
										{{ credit.available_count }}
									</td>
									<td>
										{{ credit.assigned_count }}
									</td>
									<td>
										{{ credit.consumed_count }}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

					{% if credits_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} credit records.</span>
							{{ ui('action.link', {label: 'View all credit records', variant: 'secondary', size: 'small', href: '/company/credits'}) }}
						</div>
					{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
