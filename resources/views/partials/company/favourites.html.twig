{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Courses saved for later', eyebrow: 'Favourites', summary: 'Courses this company may want for its staff but has not bought.'}) }}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'company_favourites', pagination: company_favourites_pagination})} %}
{% block results %}

				{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

					<div>
						Courses this company is interested in for its staff. Adding one here buys nothing and enrols nobody. What individual staff favourite for themselves is their own list and never changes this one.
					</div>

{% endblock %}
{% endembed %}
				{% if company_favourites %}

						{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

								<tr>
									{% for sh in company_favourites_sort_headers %}
										{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: company_favourites_region, sort_results: company_favourites_results} %}
									{% endfor %}
								</tr>

{% endblock %}
{% block body %}

								{% for favourite in company_favourites %}
									<tr>
										<td>
											<strong>{{ favourite.title }}</strong>
										</td>
										<td>
											{{ favourite.owner_company_name ?: 'Platform course' }}
										</td>
										<td>
											{{ favourite.category_name ?: '—' }}
										</td>
										<td>
											{% if favourite.is_company_owned %}
												{{ ui('feedback.badge', {label: 'Owned — free for staff', tone: 'success'}) }}
											{% else %}
												{% if favourite.has_company_credits %}
													{{ ui('feedback.badge', {label: 'Credits held', tone: 'info'}) }}
												{% else %}
													{{ ui('feedback.badge', {label: 'Not bought', tone: 'neutral'}) }}
												{% endif %}
											{% endif %}
										</td>
										<td class="small">
											{{ favourite.created_at }}
										</td>
										<td class="cell-actions">
											{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true})} %}
{% block body %}

													{{ ui('action.link', {label: 'View', variant: 'secondary', size: 'small', href: '/courses/' ~ (favourite.slug)}) }}
													{% if can_manage_company_favourites %}
														<form action="/company/favourites/{{ favourite.id }}/toggle" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															{{ ui('action.button', {label: 'Remove', variant: 'danger', size: 'small', type: 'submit', confirm: 'Remove this course from the company favourites?', icon: 'action-remove'}) }}
														</form>
													{% endif %}

{% endblock %}
{% endembed %}
										</td>
									</tr>
								{% endfor %}

{% endblock %}
{% endembed %}

				{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

						<h3>
							No favourites yet
						</h3>
						<p>
							Mark a course as a favourite from the catalogue to keep it here for later.
						</p>

{% endblock %}
{% endembed %}
				{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
