{#
Generated by: Claude Code CLI
Date time: 2026/09/07 20:30 SAST
Version: 0.6
Description:
  Company favourites: courses this company may want for its staff but has not bought.

  A company-to-course relationship in its own right. It is not a favourite belonging to whoever
  happens to administer the company today, and it is not affected by what individual staff members
  favourite for themselves - those are their own list, on their own account. Owner decision,
  2026/09/07.

  Each row says where the course already stands with this company, because the useful question on
  this screen is what is left to do: a favourite the company already owns needs nothing, and one it
  already holds credits for is ready to assign rather than to buy.

  Core owns this markup. Themes style it through the ordinary platform table and button classes.

  Comments here are plain prose only: no angle brackets, no comment delimiters, no template tokens
  and no code. Each of those is read as markup rather than as text.

Changelog:
  2026/09/07 20:30 SAST
  - Created with the company favourites table.
#}
<div class="grid section">
	<div class="card">
		<div class="section-head">
			<div>
				<div class="eyebrow">
					Favourites
				</div>
				<h2>
					Courses saved for later
				</h2>
				<p>
					Courses this company may want for its staff but has not bought.
				</p>
			</div>
		</div>
		<div id="company_favourites-region" data-server-search-target>
			<div id="company_favourites-results">
				{% if company_favourites_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: company_favourites_pagination} %}
				{% endif %}
				<div class="notice">
					<span>ⓘ</span>
					<div>
						Courses this company is interested in for its staff. Adding one here buys nothing and enrols nobody. What individual staff favourite for themselves is their own list and never changes this one.
					</div>
				</div>
				{% if company_favourites %}
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									{% for sh in company_favourites_sort_headers %}
										{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: company_favourites_region, sort_results: company_favourites_results} %}
									{% endfor %}
								</tr>
							</thead>
							<tbody>
								{% for favourite in company_favourites %}
									<tr>
										<td>
											<strong>{{ favourite.title }}</strong>
										</td>
										<td>
											{{ favourite.owner_company_name ?: 'Platform course' }}
										</td>
										<td>
											{{ favourite.category_name ?: '—' }}
										</td>
										<td>
											{% if favourite.is_company_owned %}
												<span class="badge good">Owned — free for staff</span>
											{% else %}
												{% if favourite.has_company_credits %}
													<span class="badge info">Credits held</span>
												{% else %}
													<span class="badge">Not bought</span>
												{% endif %}
											{% endif %}
										</td>
										<td class="small">
											{{ favourite.created_at }}
										</td>
										<td class="cell-actions">
											<details class="row-menu" data-cl-dropdown>
												<summary class="btn btn-soft btn-sm row-menu-trigger">
													Actions ▾
												</summary>
												<div class="row-menu-panel">
													<a class="btn btn-soft btn-sm" href="/courses/{{ favourite.slug }}">View</a>
													{% if can_manage_company_favourites %}
														<form action="/company/favourites/{{ favourite.id }}/toggle" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															<button class="btn btn-outline-danger btn-sm" type="submit" data-confirm="Remove this course from the company favourites?">Remove</button>
														</form>
													{% endif %}
												</div>
											</details>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% else %}
					<div class="empty">
						<h3>
							No favourites yet
						</h3>
						<p>
							Mark a course as a favourite from the catalogue to keep it here for later.
						</p>
					</div>
				{% endif %}
				{% if company_favourites_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: company_favourites_pagination} %}
				{% endif %}
			</div>
		</div>
	</div>
</div>
