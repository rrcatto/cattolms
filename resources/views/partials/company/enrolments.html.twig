{% if can_manage_enrolments %}
	<div class="card section">
		<div class="section-head">
			<div>
				<h2>
					Assign a course
				</h2>
				<p>
					Put a staff member on a course now. A course this company owns costs nothing; any other course uses one credit seat.
				</p>
			</div>
		</div>
		<form class="form-grid" action="/company/enrolments/assign" method="post">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% include '@platform/partials/entity-lookup.html.twig' with {lk_base: '/company/lookup', lk_name: 'user_id', lk_type: 'people', lk_label: 'Staff member', lk_selected: 0, lk_required: 1, lk_empty: 'Nobody selected'} %}
			{% include '@platform/partials/entity-lookup.html.twig' with {lk_base: '/company/lookup', lk_name: 'course_id', lk_type: 'assignable_courses', lk_label: 'Course', lk_selected: 0, lk_required: 1, lk_empty: 'No course selected'} %}
			<div class="field">
				<label for="assign-access-days">Access period (days)</label>
				<input id="assign-access-days" name="access_days" type="number" min="1" max="3650" value="365" required>
				<div class="help">
					The period starts now, not when they first open the course.
				</div>
			</div>
			<div class="field full">
				<button class="btn btn-primary" type="submit">Assign course</button>
			</div>
		</form>
	</div>
{% endif %}
{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'enrolments', ds_label: 'Search enrolments', ds_value: enrolments_search, ds_action: '/company/enrolments'} %}
<div id="enrolments-region" data-server-search-target>
	<div id="enrolments-results">
		{% if enrolments_pagination %}
			{% include '@platform/partials/pagination.html.twig' with {pg: enrolments_pagination} %}
		{% endif %}
		<div class="section-head">
			<div>
				<h2>
					Company enrolments
				</h2>
				<p>
					Company learner enrolments and progress.
				</p>
			</div>
		</div>
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						{% for sh in enrolments_sort_headers %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: enrolments_region, sort_results: enrolments_results} %}
						{% endfor %}
					</tr>
				</thead>
				<tbody>
					{% for enrolment in enrolments %}
						<tr>
							<td>
								{{ enrolment.learner_name }}
							</td>
							<td>
								{{ enrolment.course_title }}
							</td>
							<td>
								{{ enrolment.status }}
							</td>
							<td>
								{{ enrolment.progress_percentage }}%
							</td>
							<td class="cell-actions">
								{% if enrolment.status=='cancelled' %}
									<form action="/company/enrolments/{{ enrolment.id }}/restore" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										<button class="btn btn-soft btn-sm" title="Restore this learner's course access">Restore</button>
									</form>
								{% else %}
									<form action="/company/enrolments/{{ enrolment.id }}/remove" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										<button class="btn btn-danger btn-sm" title="Remove this learner's course access" data-confirm="Remove this learner’s course access?">Remove</button>
									</form>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		{% if enrolments_pagination %}
			{% include '@platform/partials/pagination.html.twig' with {pg: enrolments_pagination} %}
		{% else %}
			{% if enrolments_preview_has_more %}
				<div class="pagination-row">
					<span class="pagination-summary">Showing the first {{ preview_page_size }} enrolments.</span>
					<a class="btn btn-soft btn-sm" href="/company/enrolments">View all enrolments</a>
				</div>
			{% endif %}
		{% endif %}
	</div>
</div>
