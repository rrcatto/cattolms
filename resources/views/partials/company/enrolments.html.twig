{% include '@platform/partials/company/assign-course.html.twig' %}

{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Enrolments', eyebrow: 'Enrolments', summary: 'Each staff member on each course, and how far they have got.'}) }}
{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'enrolments', pagination: enrolments_pagination, search: {ds_name: 'enrolments', ds_label: 'Search enrolments', ds_value: enrolments_search, ds_action: '/company/enrolments'}})} %}
{% block results %}

		{{ ui('layout.section-head', {heading: 'Company enrolments', summary: 'Company learner enrolments and progress.'}) }}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% for sh in enrolments_sort_headers %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: enrolments_region, sort_results: enrolments_results} %}
						{% endfor %}
					</tr>

{% endblock %}
{% block body %}

					{% for enrolment in enrolments %}
						<tr>
							<td>
								{# The name and account reference, linked to the person's page (owner, 2026-10-21). #}
								{{ ui('data.person', {name: enrolment.learner_name, reference: enrolment.learner_reference, href: '/company/people/' ~ enrolment.user_id}) }}
							</td>
							<td>
								{{ enrolment.course_title }}
							</td>
							<td>
								{{ enrolment.status }}
							</td>
							<td>
								{{ enrolment.progress_percentage }}%
							</td>
							<td class="cell-actions">
								{% if enrolment.status=='cancelled' %}
									<form action="/company/enrolments/{{ enrolment.id }}/restore" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										{{ ui('action.button', {label: 'Restore', variant: 'secondary', size: 'small', title: 'Restore this learner\'s course access', icon: 'action-restore'}) }}
									</form>
								{% else %}
									<form action="/company/enrolments/{{ enrolment.id }}/remove" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										{{ ui('action.button', {label: 'Remove', variant: 'danger', size: 'small', title: 'Remove this learner\'s course access', confirm: 'Remove this learner’s course access?', icon: 'action-remove'}) }}
									</form>
								{% endif %}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

			{% if enrolments_preview_has_more %}
				<div class="pagination-row">
					<span class="pagination-summary">Showing the first {{ preview_page_size }} enrolments.</span>
					{{ ui('action.link', {label: 'View all enrolments', variant: 'secondary', size: 'small', href: '/company/enrolments', icon: 'action-view-all'}) }}
				</div>
			{% endif %}

{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
