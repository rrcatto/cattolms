{% if can_manage_enrolments %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Assign a course', eyebrow: 'Enrolments', summary: 'Put a staff member on a course now. A course this company owns costs nothing; any other course uses one credit seat.'}) }}
		<form action="/company/enrolments/assign" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% include '@platform/partials/entity-lookup.html.twig' with {lk_base: '/company/lookup', lk_name: 'user_id', lk_type: 'people', lk_label: 'Staff member', lk_selected: 0, lk_required: 1, lk_empty: 'Nobody selected'} %}
			{% include '@platform/partials/entity-lookup.html.twig' with {lk_base: '/company/lookup', lk_name: 'course_id', lk_type: 'assignable_courses', lk_label: 'Course', lk_selected: 0, lk_required: 1, lk_empty: 'No course selected'} %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Access period (days)', full_width: false, for: 'assign-access-days', required: true, help: 'The period starts now, not when they first open the course.'})} %}
{% block control %}

				<input id="assign-access-days" name="access_days" type="number" min="1" max="3650" value="365" required {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

				{{ ui('action.button', {label: 'Assign course', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
{% endif %}

{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'enrolments', pagination: enrolments_pagination, search: {ds_name: 'enrolments', ds_label: 'Search enrolments', ds_value: enrolments_search, ds_action: '/company/enrolments'}})} %}
{% block results %}

		{{ ui('layout.section-head', {heading: 'Company enrolments', summary: 'Company learner enrolments and progress.'}) }}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% for sh in enrolments_sort_headers %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: enrolments_region, sort_results: enrolments_results} %}
						{% endfor %}
					</tr>

{% endblock %}
{% block body %}

					{% for enrolment in enrolments %}
						<tr>
							<td>
								{{ enrolment.learner_name }}
							</td>
							<td>
								{{ enrolment.course_title }}
							</td>
							<td>
								{{ enrolment.status }}
							</td>
							<td>
								{{ enrolment.progress_percentage }}%
							</td>
							<td class="cell-actions">
								{% if enrolment.status=='cancelled' %}
									<form action="/company/enrolments/{{ enrolment.id }}/restore" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										{{ ui('action.button', {label: 'Restore', variant: 'secondary', size: 'small', title: 'Restore this learner\'s course access'}) }}
									</form>
								{% else %}
									<form action="/company/enrolments/{{ enrolment.id }}/remove" method="post">
										<input type="hidden" name="csrf" value="{{ csrf }}">
										{{ ui('action.button', {label: 'Remove', variant: 'danger', size: 'small', title: 'Remove this learner\'s course access', confirm: 'Remove this learner’s course access?', icon: 'action-remove'}) }}
									</form>
								{% endif %}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

			{% if enrolments_preview_has_more %}
				<div class="pagination-row">
					<span class="pagination-summary">Showing the first {{ preview_page_size }} enrolments.</span>
					{{ ui('action.link', {label: 'View all enrolments', variant: 'secondary', size: 'small', href: '/company/enrolments'}) }}
				</div>
			{% endif %}

{% endblock %}
{% endembed %}
