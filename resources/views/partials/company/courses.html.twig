{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Courses this company owns', eyebrow: 'Courses Created', summary: 'Courses this company owns and offers.'}) }}

		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'courses', pagination: courses_pagination, search: {ds_name: 'courses', ds_label: 'Search courses', ds_value: courses_search, ds_action: '/company/courses'}})} %}
{% block results %}

				{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

					<div>
						<strong>Courses this company owns.</strong> Training its own staff on them costs nothing and needs no credits. Courses bought for staff are under <a href="/company/training">Courses Bought</a>.
					</div>

{% endblock %}
{% endembed %}

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% for sh in courses_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: courses_region, sort_results: courses_results} %}
								{% endfor %}
							</tr>

{% endblock %}
{% block body %}

							{% for course in courses %}
								<tr>
									<td>
										<strong>{{ course.title }}</strong>
									</td>
									<td>
										{{ course.status }}
									</td>
									<td>
										{{ course.category_name ?: '—' }}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

					{% if courses_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} courses.</span>
							{{ ui('action.link', {label: 'View all courses', variant: 'secondary', size: 'small', href: '/company/courses'}) }}
						</div>
					{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
