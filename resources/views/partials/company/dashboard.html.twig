{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: (company.name), eyebrow: 'Dashboard', summary: (company_platform_wide ? 'Platform-wide company overview for ADMIN.' : 'Company enrolments and account overview.')})} %}
{% block section_actions %}
{{ ui('feedback.badge', {label: (company.domain), tone: 'info'}) }}
{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {})} %}
{% block body %}

	{{ ui('data.stat-card', {value: (people_count), label: 'People'}) }}
	{{ ui('data.stat-card', {value: (courses_count), label: 'Courses'}) }}
	{{ ui('data.stat-card', {value: (requests_count), label: 'Requests'}) }}
	{{ ui('data.stat-card', {value: (enrolments_count), label: 'Enrolments'}) }}
	{{ ui('data.stat-card', {value: (credits_count), label: 'Credit pools'}) }}

{% endblock %}
{% endembed %}
{% if company_platform_wide %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		<h3>
			All companies
		</h3>

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 52, label: 'Company'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 24, label: 'Domain'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'People'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'Courses'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'Enrolments'}} %}
					</tr>

{% endblock %}
{% block body %}

					{% for co in companies %}
						<tr>
							<td>
								{{ co.name }}
							</td>
							<td>
								{{ co.domain }}
							</td>
							<td>
								{{ co.people_count }}
							</td>
							<td>
								{{ co.owned_course_count }}
							</td>
							<td>
								{{ co.enrolment_count }}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}

		<p>
			{{ ui('action.link', {label: 'Manage company records', variant: 'secondary', size: 'small', href: '/admin/companies'}) }}
		</p>

{% endblock %}
{% endembed %}
{% endif %}
