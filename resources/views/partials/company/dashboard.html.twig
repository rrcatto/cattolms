	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: (company.name), eyebrow: 'Dashboard', summary: (company_platform_wide ? 'Platform-wide company overview for ADMIN.' : 'Company enrolments and account overview.')})} %}
{% block section_actions %}
{# The company's logo, large, beside its name (owner, 2026-10-26), opening its profile. #}
{% if company_logo|default(null) %}<a class="cl-company-dashboard-logo" href="/company/profile" aria-label="The company profile"><img src="{{ company_logo.url }}" alt="{{ company_logo.uploaded ? 'The logo of ' ~ company.name : '' }}" width="96" height="96"></a>{% endif %}
{% endblock %}
{% endembed %}
		{% if company.domain|default('') %}<p class="cl-company-dashboard-domain">{{ company.domain }}</p>{% endif %}
		{% if company.account_reference|default('') %}<p>Company account reference: <strong>{{ company.account_reference|account_reference }}</strong>. Quote it when the company pays by EFT or writes to us.</p>{% endif %}
		{# The figures sit in the card they summarise, five to a row, each with its icon and opening what it counts (owner,
		   2026-10-21: "Dashboard cards also need svg icons"). #}
		{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {columns: 5})} %}
		{% block body %}

			{{ ui('data.stat-card', {value: (people_count), label: 'People', icon: 'figure-people', href: '/company/people'}) }}
			{{ ui('data.stat-card', {value: (courses_count), label: 'Courses', icon: 'figure-courses', href: '/company/courses'}) }}
			{{ ui('data.stat-card', {value: (requests_count), label: 'Requests', icon: 'figure-requests', href: '/company/requests'}) }}
			{{ ui('data.stat-card', {value: (enrolments_count), label: 'Enrolments', icon: 'figure-enrolments', href: '/company/enrolments'}) }}
			{{ ui('data.stat-card', {value: (credits_count), label: 'Credit pools', icon: 'figure-credits', href: '/company/credits'}) }}

		{% endblock %}
		{% endembed %}

{% endblock %}
{% endembed %}
{% if company_platform_wide %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		<h3>
			All companies
		</h3>

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 52, label: 'Company'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 24, label: 'Domain', wide: true}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'People'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'Courses', wide: true}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'Enrolments'}} %}
					</tr>

{% endblock %}
{% block body %}

					{% for co in companies %}
						<tr>
							<td>
								{{ co.name }}
							</td>
							<td>
								{{ co.domain }}
							</td>
							<td>
								{{ co.people_count }}
							</td>
							<td>
								{{ co.owned_course_count }}
							</td>
							<td>
								{{ co.enrolment_count }}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}

		<p>
			{{ ui('action.link', {label: 'Manage company records', variant: 'secondary', size: 'small', icon: 'action-manage', href: '/admin/companies'}) }}
		</p>

{% endblock %}
{% endembed %}
{% endif %}
