<div class="field">
    <label for="payment-method">Payment method</label>
    <select id="payment-method" name="payment_method" required>
        <option value="dummy" {{ selected_method == 'dummy' ? 'selected' : '' }}>Card (simulated)</option>
        <option value="eft" {{ selected_method == 'eft' ? 'selected' : '' }}>EFT / bank transfer</option>
    </select>
</div>
