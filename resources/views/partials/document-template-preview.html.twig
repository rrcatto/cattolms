{#
	A document template preview: exactly the HTML the shared document renderer produced, shown in a
	sandboxed frame. The empty sandbox allows no scripts, forms or same-origin access, so nothing a
	template contains can run here, and the document's own CSS cannot reach the page around it. The
	frame is the page's size; its box scrolls on narrow screens rather than the page.
#}
{% if preview %}
	{% if dp_unsaved|default(false) %}{{ ui('feedback.notice', {tone: 'info', heading: 'This preview shows your unsaved changes. Save the draft to keep them.'}) }}{% endif %}
	<p class="help">{{ dp_caption|default('Sample data, rendered by the document renderer documents use.') }} Page: {{ preview.label }}.{% if dp_pdf_href|default('') %} <a href="{{ dp_pdf_href }}" target="_blank" rel="noopener">Open a sample PDF</a>{% endif %}</p>
	<div class="cl-document-preview">
		<iframe class="cl-document-preview-frame" title="{{ dp_title|default('Document preview') }}" sandbox="" srcdoc="{{ preview.html }}" width="{{ preview.width }}" height="{{ preview.height }}"></iframe>
	</div>
{% elseif dp_error|default('') %}
	{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger', heading: 'This version cannot be rendered'})} %}{% block body %}<p>{{ dp_error }}</p>{% endblock %}{% endembed %}
{% else %}
	{{ ui('feedback.empty', {heading: 'No preview', summary: 'Fix the problems listed above, then preview again.'}) }}
{% endif %}
