{#
Generated by: Claude Code CLI
Date time: 2026/09/07 13:30 SAST
Version: 0.6
Description:
  Administration Enrolments.

  Every learner who currently holds access to a course, with their progress and the state of that access.

  Split out of the combined Enrolments and Requests screen. The two lists had shared one route and
  one page, switched by in-page tab buttons, which meant neither could be linked to, bookmarked or
  reloaded on its own and the browser's back button could not return to the one the reader was on.
  They are separate screens now, reached from the shared Courses tab strip that every screen in the
  group renders in the same place.

  Core owns this markup. Themes style it through the ordinary platform table, form and button
  classes.

  Comments here are plain prose only: no angle brackets, no comment delimiters, no template tokens
  and no code. Each of those is read as markup rather than as text.

Changelog:
  2026/09/07 13:30 SAST
  - Course requests moved to their own screen and route; this one is enrolments alone.
#}
<div class="grid section">
	<div class="card">
		{% include '@platform/partials/admin/course-group-nav.html.twig' %}
		<div class="section-head">
			<div>
				<div class="eyebrow">
					Enrolments
				</div>
				<h2>
					Enrolments
				</h2>
				<p>
					Learner access to courses, and how far each has got.
				</p>
			</div>
		</div>
		{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'enrolments', ds_label: 'Search enrolments', ds_value: enrolments_search, ds_action: '/admin/course/enrolments'} %}
		<div id="enrolments-region" data-server-search-target>
			<div id="enrolments-results">
				{% if enrolments_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: enrolments_pagination} %}
				{% endif %}
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								{% for sh in enrolments_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: enrolments_region, sort_results: enrolments_results} %}
								{% endfor %}
							</tr>
						</thead>
						<tbody>
							{% for enrolment in enrolments %}
								<tr>
									<td title="{{ enrolment.learner_name }} · {{ enrolment.email }}">
										{{ enrolment.learner_name }}
									</td>
									<td title="{{ enrolment.course_title }}">
										{{ enrolment.course_title }}
									</td>
									<td>
										<span class="badge {{ enrolment.status=='cancelled' ? 'danger' : 'info' }}">{{ enrolment.status }}</span>
									</td>
									<td>
										{{ enrolment.progress_percentage }}%
									</td>
									<td class="cell-actions">
										<div class="row-actions">
											{% if enrolment.status=='cancelled' %}
												<form action="/admin/course/enrolments/{{ enrolment.id }}/restore" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													<button class="btn btn-soft btn-sm" title="Restore this learner's course access">Restore</button>
												</form>
											{% else %}
												<form action="/admin/course/enrolments/{{ enrolment.id }}/remove" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													<input type="hidden" name="reason" value="Removed by platform administrator">
													<button class="btn btn-danger btn-sm" title="Remove this learner's course access" data-confirm="Remove this learner’s course access?">Remove</button>
												</form>
											{% endif %}
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% if enrolments_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: enrolments_pagination} %}
				{% else %}
					{% if enrolments_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} enrolments.</span>
							<a class="btn btn-soft btn-sm" href="/admin/enrolments">View all enrolments</a>
						</div>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</div>
</div>
