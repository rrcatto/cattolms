{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{% include '@platform/partials/admin/course-group-nav.html.twig' %}
		{{ ui('layout.section-head', {heading: 'Enrolments', eyebrow: 'Enrolments', summary: 'Learner access to courses, and how far each has got.'}) }}

		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'enrolments', pagination: enrolments_pagination, search: {ds_name: 'enrolments', ds_label: 'Search enrolments', ds_value: enrolments_search, ds_action: '/admin/course/enrolments'}})} %}
{% block results %}

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% for sh in enrolments_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: enrolments_region, sort_results: enrolments_results} %}
								{% endfor %}
							</tr>

{% endblock %}
{% block body %}

							{% for enrolment in enrolments %}
								<tr>
									<td title="{{ enrolment.learner_name }} · {{ enrolment.email }}">
										{{ enrolment.learner_name }}
									</td>
									<td title="{{ enrolment.course_title }}">
										{{ enrolment.course_title }}
									</td>
									<td>
										{{ ui('feedback.badge', {label: (enrolment.status), tone: enrolment.status=='cancelled' ? 'danger' : 'info'}) }}
									</td>
									<td>
										{{ enrolment.progress_percentage }}%
									</td>
									<td class="cell-actions">
										{% embed ui_template('action.row') with {props: ui_props('action.row', {})} %}
{% block body %}

											{% if enrolment.status=='cancelled' %}
												<form action="/admin/course/enrolments/{{ enrolment.id }}/restore" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													{{ ui('action.button', {label: 'Restore', variant: 'secondary', size: 'small', title: 'Restore this learner\'s course access'}) }}
												</form>
											{% else %}
												<form action="/admin/course/enrolments/{{ enrolment.id }}/remove" method="post">
													<input type="hidden" name="csrf" value="{{ csrf }}">
													<input type="hidden" name="reason" value="Removed by platform administrator">
													{{ ui('action.button', {label: 'Remove', variant: 'danger', size: 'small', title: 'Remove this learner\'s course access', confirm: 'Remove this learner’s course access?', icon: 'action-remove'}) }}
												</form>
											{% endif %}

{% endblock %}
{% endembed %}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

					{% if enrolments_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} enrolments.</span>
							{{ ui('action.link', {label: 'View all enrolments', variant: 'secondary', size: 'small', href: '/admin/enrolments'}) }}
						</div>
					{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
