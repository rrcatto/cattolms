{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Theme Manager', eyebrow: 'Themes', summary: 'Install immutable Theme Package 4.0 ZIP releases, preview them, switch the live theme, or uninstall an inactive theme.'})} %}
{% block section_actions %}
<p>Theme authors: see <code>docs/THEME-SDK.md</code> in the source package for schema 4.0 and Template API 2.0.</p>
{% endblock %}
{% endembed %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

			<span>i</span>
			<div>
				<strong>The LMS does not edit or export themes.</strong>
				<br>
				Theme authors maintain source externally and publish each update as a new version. Installed name + version releases remain side-by-side. Factory Reset is the default theme, not a fallback for unrelated themes.
			</div>

{% endblock %}
{% endembed %}
		{% embed ui_template('layout.toolbar') with {props: ui_props('layout.toolbar', {})} %}
{% block toolbar_primary %}

				<h3 style="margin:0">
					Installed themes
				</h3>
				<p class="muted small">
					The filesystem is authoritative. PostgreSQL keeps a rebuildable metadata registry so parent/child relationships and theme status can be presented clearly.
				</p>

{% endblock %}
{% block toolbar_actions %}

			{% embed ui_template('action.row') with {props: ui_props('action.row', {})} %}
{% block body %}

				<form action="/admin/themes/resync" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					{{ ui('action.button', {label: 'Re-sync themes', variant: 'secondary', size: 'normal', type: 'submit'}) }}
				</form>
				{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Import theme ZIP'})} %}
{% block body %}

					<form class="theme-popover-form" action="/admin/themes/import" method="post" enctype="multipart/form-data">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

						<input type="hidden" name="csrf" value="{{ csrf }}">
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Theme Package 4.0 ZIP', full_width: false, for: 'field-themes-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true, help: 'The package is validated and inspected before installation. A repaired theme may reuse the same name and version after the defective installed copy has been uninstalled.'})} %}
{% block control %}

							<input type="file" name="theme_file" accept=".zip,application/zip" required id="field-themes-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
						{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Inspect package', variant: 'primary', size: 'normal'}) }}
{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
{% if theme_registry_out_of_sync %}
	{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', section_spacing: true})} %}
{% block body %}

		<span>!</span>
		<div>
			<strong>Theme registry is out of sync.</strong>
			<br>
			The filesystem remains authoritative. Use Re-sync themes to rebuild the PostgreSQL metadata index.
		</div>

{% endblock %}
{% endembed %}
{% endif %}

	{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

			<tr>
				{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 50, label: 'Theme'}} %}
				{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 11, label: 'Version'}} %}
				{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 10, label: 'Status'}} %}
				{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 29, label: 'Actions'}} %}
			</tr>

{% endblock %}
{% block body %}

			{% for themeItem in themes %}
				<tr>
					<td>
						<div style="padding-left:{{ themeItem.is_child ? '28px' : '0' }}">
							{% if themeItem.is_child %}
								<span class="muted" aria-hidden="true">↳ </span>
							{% endif %}
							<strong>{{ themeItem.label }}</strong>
							{% if themeItem.is_parent %}
								{{ ui('feedback.badge', {label: 'parent', tone: 'neutral'}) }}
							{% endif %}
							{% if themeItem.is_child %}
								{{ ui('feedback.badge', {label: 'child', tone: 'neutral'}) }}
							{% endif %}
							{% if not themeItem.registry_synced %}
								{{ ui('feedback.badge', {label: 'registry', tone: 'warning'}) }}
							{% endif %}
							<div class="small muted">
								{{ themeItem.description }}
							</div>
							{% if themeItem.is_child %}
								<div class="small muted">
									Child of {{ themeItem.parent_name }} {{ themeItem.parent_version }}
								</div>
							{% endif %}
							{% if themeItem.is_default %}
								<div class="small muted">
									Default theme
								</div>
							{% endif %}
							{% if themeItem.palette_warning %}
								<div class="small">
									{{ ui('feedback.badge', {label: (themeItem.palette_count) ~ ' palettes', tone: 'warning'}) }} <span class="muted">3–5 recommended</span>
								</div>
							{% endif %}
						</div>
					</td>
					<td>
						{{ themeItem.version }}
					</td>
					<td>
						{% if themeItem.active %}
							{{ ui('feedback.badge', {label: 'LIVE', tone: 'success'}) }}
						{% else %}
							{{ ui('feedback.badge', {label: 'installed', tone: 'neutral'}) }}
						{% endif %}
					</td>
					<td class="cell-actions" data-no-row-menu="the control that recovers from a broken theme must not itself depend on that theme rendering a menu">
						{% embed ui_template('action.row') with {props: ui_props('action.row', {})} %}
{% block body %}

							{{ ui('action.link', {label: 'Preview', variant: 'secondary', size: 'small', href: '/?theme_preview=' ~ (themeItem.key|urlencode), new_window: true}) }}
							{% if not themeItem.active %}
								<form action="/admin/themes/activate" method="post">
									<input type="hidden" name="csrf" value="{{ csrf }}">
									<input type="hidden" name="theme" value="{{ themeItem.key }}">
									{{ ui('action.button', {label: 'Activate', variant: 'primary', size: 'small'}) }}
								</form>
							{% endif %}
							{% if not themeItem.is_default and not themeItem.active %}
								<form action="/admin/themes/{{ themeItem.key }}/delete" method="post">
									<input type="hidden" name="csrf" value="{{ csrf }}">
									{{ ui('action.button', {label: 'Uninstall', variant: 'danger', size: 'small', confirm: 'Uninstall this theme release and remove its files?', icon: 'action-remove'}) }}
								</form>
							{% endif %}

{% endblock %}
{% endembed %}
					</td>
				</tr>
			{% endfor %}

{% endblock %}
{% endembed %}

{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

	Theme source is stored on the filesystem. Catto Learning keeps only the selected active-theme identifier in application settings.

{% endblock %}
{% endembed %}
