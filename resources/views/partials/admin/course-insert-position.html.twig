{# The exact place "+ Add here" chose in Course Content, shown as text and carried as hidden fields: the parent (empty for the outer level) and the position among that parent's rows. #}
{% set parent_row = parent ? structure|filter(row => row.id == parent)|first : null %}
<div class="cl-course-insert-position"><input type="hidden" name="parent_node_id" value="{{ parent }}"><input type="hidden" name="insert_index" value="{{ index }}">
<p>Adds {% if parent_row %}inside “{{ parent_row.node_type == 'section' ? parent_row.section_title : (parent_row.display_title_override ?: parent_row.item_title) }}”{% else %}at the outer level{% endif %}, as row {{ index + 1 }}.</p>{{ ui('action.link', {label: 'Choose another place', href: clear_href, size: 'small', variant: 'quiet'}) }}</div>
