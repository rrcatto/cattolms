{#
	One course's row in Administration > Courses as a form, edited in place (owner, 2026-11-01: "a clickable edit icon for
	each row which changes the row into editable form fields, with clickable save / cancel icons"): the position in the
	catalogue, the code, the title,
	the price, was price and access period while the course's only price option is its default (else its prices as they
	are, with Manage prices), and the category. The form sits in the last cell, every field tied to it by its form
	attribute. With JavaScript, Save sends it and the row comes back as it now is (or as it was typed, with why it was
	refused), and Cancel draws the row again unchanged; only this row changes. Without JavaScript the same buttons send it
	and the list comes back. Variables: course, course_edit (CourseQuickEdit::form), course_error, arrange,
	courses_list_href, csrf.
#}
{% set cq = course_edit %}
{% set cq_form = 'course-quick-' ~ course.id %}
<tr id="{{ course_anchor(course) }}" data-order-code="{{ course.code }}" data-order-url="{{ course_admin_url(course, '/catalogue-move') }}" data-order-title="{{ course.title }}" class="cl-course-quick" data-course-code="{{ course.code }}" data-course-url="{{ course_admin_url(course) }}" data-course-title="{{ course.title }}">
	<td class="cl-course-position"><input class="cl-input" form="{{ cq_form }}" type="number" min="1" step="1" name="catalogue_position" value="{{ cq.position }}" autocomplete="off" aria-label="Position in the catalogue"></td>
	<td><input class="cl-input" form="{{ cq_form }}" name="code" value="{{ cq.code }}" required maxlength="20" autocomplete="off" aria-label="Course code" autofocus></td>
	<td class="cell-text">
		<input class="cl-input" form="{{ cq_form }}" name="title" value="{{ cq.title }}" required maxlength="240" autocomplete="off" aria-label="Course title">
		{% if course_error|default('') %}<p class="cl-course-quick-error" role="alert">{{ course_error }}</p>{% endif %}
	</td>
	<td class="cl-course-quick-price">
		{% if cq.price.editable %}
			<label class="cl-course-quick-field"><span>Now</span><input class="cl-input" form="{{ cq_form }}" name="price" value="{{ cq.price.now }}" inputmode="decimal" autocomplete="off" placeholder="1200.00"></label>
			<label class="cl-course-quick-field"><span>Was</span><input class="cl-input" form="{{ cq_form }}" name="was_price" value="{{ cq.price.was }}" inputmode="decimal" autocomplete="off"></label>
			<span class="cl-course-quick-period"><input class="cl-input" form="{{ cq_form }}" type="number" min="1" name="access_period_value" value="{{ cq.price.period_value }}" aria-label="Access period"><select class="cl-select" form="{{ cq_form }}" name="access_period_unit" aria-label="Unit">{% for unit in cq.price.units %}<option value="{{ unit }}"{% if unit == cq.price.period_unit %} selected{% endif %}>{{ unit|capitalize }}</option>{% endfor %}</select></span>
		{% else %}
			{% if course.price %}<strong class="cl-price-now">{{ course.price.price_label }}</strong><br><small class="cl-text-muted">{% if course.price.was_label %}<s class="cl-price-was"><span class="visually-hidden">Was </span>{{ course.price.was_label }}</s> · {% endif %}{{ course.price.period_label }}</small>{% endif %}
			{% if cq.price.shown %}<br><a href="{{ course_admin_url(course, '?tab=pricing') }}">Manage prices</a><br><small class="cl-text-muted">It has other price options.</small>{% endif %}
		{% endif %}
	</td>
	<td>{{ ui('feedback.badge', {label: (course.status|ucfirst), tone: {published: 'success', draft: 'neutral', retired: 'warning', archived: 'neutral'}[course.status]|default('neutral')}) }}</td>
	<td>{{ course.learner_count }}</td>
	<td>{{ course.updated_at }}</td>
	<td>{{ ui('form.tree-select', {id: 'course-quick-category-' ~ course.id, name: 'category_id', mode: 'field', items: cq.category.items, selected: cq.category.selected, placeholder: 'Uncategorised', list_label: 'Course categories', form: cq_form}) }}</td>
	<td title="{{ course.owner_company_name }}">
		<strong>{{ course.owner_company_name ?: '—' }}</strong>
		<br>
		<small class="cl-text-muted">{% if course.owner_user_id %}{{ ui('data.person', {name: course.owner_person_name, reference: course.owner_person_reference|default(''), href: person_url(course.owner_person_reference)}) }}{% else %}—{% endif %}</small>
	</td>
	<td class="cell-actions">
		<form id="{{ cq_form }}" class="cl-course-quick-actions" action="{{ course_admin_url(course, '/row') }}" method="post" hx-post="{{ course_admin_url(course, '/row') }}" hx-target="closest tr" hx-swap="outerHTML">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			<input type="hidden" name="view" value="list">
			<input type="hidden" name="arrange" value="{{ arrange ? '1' : '' }}">
			<input type="hidden" name="return" value="{{ courses_list_href }}">
			{{ ui('action.button', {label: 'Save', aria_label: 'Save ' ~ course.title, title: 'Save', icon: 'action-save-changes', icon_only: true, variant: 'primary', size: 'small'}) }}
			{{ ui('action.link', {label: 'Cancel', aria_label: 'Cancel editing ' ~ course.title, title: 'Cancel', icon: 'action-cancel', icon_only: true, variant: 'quiet', size: 'small', href: courses_list_href|trim('?&', 'right') ~ '#' ~ course_anchor(course), get: course_admin_url(course, '/row?view=list') ~ (arrange ? '&arrange=1' : ''), target: 'closest tr', swap: 'outerHTML'}) }}
		</form>
	</td>
</tr>
