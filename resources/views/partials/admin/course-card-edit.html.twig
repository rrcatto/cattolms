{#
	One course's card in Administration > Courses' grid as a form, edited in place (owner, 2026-11-01: "I should be able to
	edit the list of courses in both list and grid views"): the same fields as its row (course-row-edit.html.twig), one
	under another, Save and Cancel at the card's foot. With JavaScript only this card changes. Variables as the row's.
#}
{% set cq = course_edit %}
{% set cq_form = 'course-quick-' ~ course.id %}
{% embed ui_template('data.card') with {props: ui_props('data.card', {title: course.title, picture: 'wide'})} %}
{% block picture %}{% if course.cover_svg|default('') starts with '<svg' %}{{ course.cover_svg|raw }}{% endif %}{% endblock %}
{% block title %}Editing <code class="cl-course-code">{{ course.code }}</code>{% endblock %}
{% block details %}
	<span id="course-{{ course.id }}" class="cl-course-anchor"></span>
	<form id="{{ cq_form }}" class="cl-course-quick-card" action="/admin/courses/{{ course.id }}/row" method="post" hx-post="/admin/courses/{{ course.id }}/row" hx-target="closest li" hx-swap="outerHTML">
		<input type="hidden" name="csrf" value="{{ csrf }}">
		<input type="hidden" name="view" value="grid">
		<input type="hidden" name="return" value="{{ courses_list_href }}">
		{% if course_error|default('') %}<p class="cl-course-quick-error" role="alert">{{ course_error }}</p>{% endif %}
		<label class="cl-course-quick-field"><span>Position</span><input class="cl-input" type="number" min="1" step="1" name="catalogue_position" value="{{ cq.position }}" autocomplete="off"></label>
		<label class="cl-course-quick-field"><span>Code</span><input class="cl-input" name="code" value="{{ cq.code }}" required maxlength="20" autocomplete="off" autofocus></label>
		<label class="cl-course-quick-field"><span>Title</span><input class="cl-input" name="title" value="{{ cq.title }}" required maxlength="240" autocomplete="off"></label>
		{% if cq.price.editable %}
			<label class="cl-course-quick-field"><span>Now price</span><input class="cl-input" name="price" value="{{ cq.price.now }}" inputmode="decimal" autocomplete="off" placeholder="1200.00"></label>
			<label class="cl-course-quick-field"><span>Was price</span><input class="cl-input" name="was_price" value="{{ cq.price.was }}" inputmode="decimal" autocomplete="off"></label>
			<span class="cl-course-quick-field"><span>Access period</span><span class="cl-course-quick-period"><input class="cl-input" type="number" min="1" name="access_period_value" value="{{ cq.price.period_value }}" aria-label="Access period"><select class="cl-select" name="access_period_unit" aria-label="Unit">{% for unit in cq.price.units %}<option value="{{ unit }}"{% if unit == cq.price.period_unit %} selected{% endif %}>{{ unit|capitalize }}</option>{% endfor %}</select></span></span>
		{% else %}
			<p class="cl-ui-card-line">{% if course.price %}<strong class="cl-price-now">{{ course.price.price_label }}</strong>{% if course.price.was_label %} <s class="cl-price-was"><span class="visually-hidden">Was </span>{{ course.price.was_label }}</s>{% endif %} <span class="cl-ui-card-quiet">· {{ course.price.period_label }}</span>{% endif %}{% if cq.price.shown %} <a href="/admin/courses/{{ course.id }}?tab=pricing">Manage prices</a>{% endif %}</p>
		{% endif %}
		<span class="cl-course-quick-field"><span>Category</span>{{ ui('form.tree-select', {id: 'course-quick-category-' ~ course.id, name: 'category_id', mode: 'field', items: cq.category.items, selected: cq.category.selected, placeholder: 'Uncategorised', list_label: 'Course categories'}) }}</span>
	</form>
{% endblock %}
{% block actions %}
	{{ ui('action.button', {label: 'Save', aria_label: 'Save ' ~ course.title, title: 'Save', icon: 'action-save-changes', icon_only: true, variant: 'primary', size: 'small', form: cq_form}) }}
	{{ ui('action.link', {label: 'Cancel', aria_label: 'Cancel editing ' ~ course.title, title: 'Cancel', icon: 'action-cancel', icon_only: true, variant: 'quiet', size: 'small', href: courses_list_href|trim('?&', 'right') ~ '#course-' ~ course.id, get: '/admin/courses/' ~ course.id ~ '/row?view=grid', target: 'closest li', swap: 'outerHTML'}) }}
{% endblock %}
{% endembed %}
