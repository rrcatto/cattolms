{% include '@platform/partials/admin/course-group-nav.html.twig' %}

<div class="section-head">
	<div>
		<h2>Course Requests</h2>
		<p>Approve or reject learner requests for course access.</p>
	</div>
</div>



	{% if universe_switch %}
		{% include '@platform/partials/universe-switch.html.twig' with {us: universe_switch, ct: requests_universe_counts} %}
	{% endif %}

	{% if requests_status_filters %}
	<nav class="cl-filter-chips" aria-label="Filter by status">
		{% for chip in requests_status_filters %}
			<a class="cl-filter-chip {{ chip.active ? 'is-current' : '' }}" href="{{ chip.href }}" {{ chip.active ? 'aria-current="true"' : '' }}>{{ chip.label }}</a>
		{% endfor %}
	</nav>
{% endif %}

{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'requests', ds_label: 'Search course requests', ds_value: requests_search, ds_action: '/admin/course/requests'} %}

	<div id="requests-region" data-server-search-target>
	<div id="requests-results">

	{% if requests_pagination %}
		{% include '@platform/partials/pagination.html.twig' with {pg: requests_pagination} %}
	{% endif %}

		{% if requests %}
			<div class="table-wrap">
					<table>
						<thead><tr>{% for sh in requests_sort_headers %}{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: requests_region, sort_results: requests_results} %}{% endfor %}</tr></thead>
						<tbody>
							{% for request in requests %}
								<tr>
									<td title="{{ request.learner_name }} · {{ request.email }}">{{ request.learner_name }}</td>
									<td title="{{ request.course_title }}">{{ request.course_title }}</td>
									<td>{{ request.company_name ?: 'System Company' }}</td>
									<td class="small">{{ request.requested_at }}</td>
									<td><span class="badge {{ request.status_tone }}">{{ request.status_label }}</span></td>
									<td class="cell-actions">
										{% if request.status=='pending' %}
											<details class="row-menu" data-cl-dropdown>
												<summary class="btn btn-soft btn-sm row-menu-trigger">Actions ▾</summary>
												<div class="row-menu-panel">
													<form action="/admin/course/requests/{{ request.id }}/decision" method="post">
														<input type="hidden" name="csrf" value="{{ csrf }}">
														<button class="btn btn-primary btn-sm" name="decision" value="approve">Approve</button>
														<button class="btn btn-danger btn-sm" name="decision" value="reject" data-confirm="Reject this course request? The learner is told it was declined.">Reject</button>
													</form>
												</div>
											</details>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>{% else %}
				<div class="empty">No course requests.</div>
		{% endif %}

		{% if requests_pagination %}
			{% include '@platform/partials/pagination.html.twig' with {pg: requests_pagination} %}{% else %}
				{% if requests_preview_has_more %}
					<div class="pagination-row">
						<span class="pagination-summary">Showing the first {{ preview_page_size }} requests.</span>
						<a class="btn btn-soft btn-sm" href="/admin/requests{{ universe_query }}">View all requests</a>
					</div>
				{% endif %}
		{% endif %}

	</div>
	</div>
