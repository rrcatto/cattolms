{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{% include '@platform/partials/admin/course-group-nav.html.twig' %}
		{{ ui('layout.section-head', {heading: 'Course Requests', eyebrow: 'Course Requests', summary: 'Approve or reject learner requests for course access.'}) }}
		{% if requests_status_filters %}
			<nav class="cl-filter-chips" aria-label="Filter by status">
				{% for chip in requests_status_filters %}
					<a class="cl-filter-chip {{ chip.active ? 'is-current' : '' }}" href="{{ chip.href }}" {% if chip.active %}aria-current="true"{% endif %}>{{ chip.label }}</a>
				{% endfor %}
			</nav>
		{% endif %}

		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'requests', pagination: requests_pagination, search: {ds_name: 'requests', ds_label: 'Search course requests', ds_value: requests_search, ds_action: '/admin/course/requests'}})} %}
{% block results %}

				{% if requests %}

						{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

								<tr>
									{% for sh in requests_sort_headers %}
										{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: requests_region, sort_results: requests_results} %}
									{% endfor %}
								</tr>

{% endblock %}
{% block body %}

								{% for request in requests %}
									<tr>
										<td title="{{ request.learner_name }} · {{ request.email }}">
											{{ request.learner_name }}
										</td>
										<td title="{{ request.course_title }}">
											{{ request.course_title }}
										</td>
										<td>
											{{ request.company_name ?: 'System Company' }}
										</td>
										<td class="small">
											{{ request.requested_at }}
										</td>
										<td>
											{{ ui('feedback.badge', {label: (request.status_label), tone: request.status_tone}) }}
										</td>
										<td class="cell-actions">
											{% if request.status=='pending' %}
												{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true})} %}
{% block body %}

														<form action="/admin/course/requests/{{ request.id }}/decision" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															{{ ui('action.button', {label: 'Approve', variant: 'primary', size: 'small', name: 'decision', value: 'approve'}) }}
															{{ ui('action.button', {label: 'Reject', variant: 'danger', size: 'small', name: 'decision', value: 'reject', confirm: 'Reject this course request? The learner is told it was declined.', icon: 'action-remove'}) }}
														</form>

{% endblock %}
{% endembed %}
											{% endif %}
										</td>
									</tr>
								{% endfor %}

{% endblock %}
{% endembed %}

				{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

						No course requests.

{% endblock %}
{% endembed %}
				{% endif %}

{% endblock %}
{% block preview %}

					{% if requests_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} requests.</span>
							{{ ui('action.link', {label: 'View all requests', variant: 'secondary', size: 'small', href: '/admin/requests'}) }}
						</div>
					{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
