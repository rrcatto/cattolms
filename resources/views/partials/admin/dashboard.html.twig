{#
	The platform at a glance. Its figures sit in a card with a heading, as every section's content does;
	the section's actions (Manage courses, View activity) are in the page head on the Dashboard's own
	page and in this card's head on the "All sections" page.
#}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

	{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Overview', eyebrow: 'Dashboard', summary: 'The health of the learning platform, the work that needs attention, and the way to each part of Administration.'})} %}{% block section_actions %}{% if not section_standalone|default(false) %}{% include '@platform/partials/section-actions.html.twig' with {actions: section_actions|default([])} %}{% endif %}{% endblock %}{% endembed %}
	{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {})} %}
	{% block body %}

		{{ ui('data.stat-card', {value: (overview.people), label: 'People', note: 'Active platform accounts'}) }}
		{{ ui('data.stat-card', {value: (overview.published_courses), label: 'Published courses', note: (overview.draft_courses) ~ ' drafts'}) }}
		{{ ui('data.stat-card', {value: (overview.enrolments), label: 'Enrolments', note: 'Assigned, active or completed'}) }}
		{{ ui('data.stat-card', {value: (overview.completion_rate) ~ '%', label: 'Completion rate', note: 'Across learner enrolments'}) }}

	{% endblock %}
	{% endembed %}

{% endblock %}
{% endembed %}
{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Needs attention', summary: 'Administrative work waiting for action.'}) }}
		{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

			{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

					<strong>{{ overview.pending_requests }} pending course requests</strong>
					<p>
						Approve or reject learner requests and allocate matching credits where available.
					</p>

{% endblock %}
{% block actions %}

				{{ ui('action.link', {label: 'Review', variant: 'primary', size: 'small', href: '/admin/course/enrolments'}) }}

{% endblock %}
{% endembed %}
			{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

					<strong>{{ overview.draft_courses }} course drafts</strong>
					<p>
						Review course content, ownership and publication readiness.
					</p>

{% endblock %}
{% block actions %}

				{{ ui('action.link', {label: 'Review', variant: 'primary', size: 'small', href: '/admin/courses'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Recent activity', summary: 'The latest audited actions across the site.'})} %}
{% block section_actions %}
{{ ui('action.link', {label: 'View all', variant: 'secondary', size: 'small', href: '/admin/activity'}) }}
{% endblock %}
{% endembed %}
		<div class="timeline">
			{% for event in recent_activity_events %}
				<div class="timeline-item">
					<div class="timeline-dot">
					</div>
					<div>
						<strong>{{ event.event_label }}</strong>
						<p>
							{{ event.actor_name }} · {{ event.subject }} · {{ event.created_at }}
						</p>
					</div>
				</div>
			{% endfor %}
		</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
{% if attention_items is defined and attention_items is not null %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Transactions that need attention', eyebrow: 'Recent activity', summary: 'Money matters waiting for you, oldest first. Open one to see it and to email the person.'}) }}
	{% if attention_items %}
	{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
	{% block body %}
		{% for entry in attention_items %}
		{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
		{# The title is the link, so each says where it goes (a list of links all named Open does not). #}
		{% block body %}<strong><a href="{{ entry.href }}">{{ entry.title }}</a></strong><p>{{ entry.summary }}</p>{% endblock %}
		{% endembed %}
		{% endfor %}
	{% endblock %}
	{% endembed %}
	{% else %}{{ ui('feedback.empty', {summary: 'Nothing needs your attention.'}) }}{% endif %}
{% endblock %}
{% endembed %}
{% endif %}
{# The money of a period (MoneyRecords::dashboard, owner 2026-10-18): each figure opens the list it adds up, for the same period. #}
{% if money is defined and money is not null %}
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Money', eyebrow: money.period.label, summary: money.period.from ~ ' to ' ~ money.period.to ~ '. What came in and went out, what the wallets hold, and the orders placed. Open a figure for what it adds up.'}) }}
	<form action="/admin/dashboard" method="get">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Period', full_width: false, for: 'money-period'})} %}{% block control %}<select id="money-period" name="money_period" {{ ui_field_attrs(props) }}>{% for key, label in money.periods %}<option value="{{ key }}" {{ money.period.key == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'From (with Dates)', full_width: false, for: 'money-from'})} %}{% block control %}<input type="date" id="money-from" name="money_from" value="{{ money.period.key == 'custom' ? money.period.from : '' }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'To (with Dates)', full_width: false, for: 'money-to'})} %}{% block control %}<input type="date" id="money-to" name="money_to" value="{{ money.period.key == 'custom' ? money.period.to : '' }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
		{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Show', variant: 'primary', size: 'normal', type: 'submit'}) }}{{ ui('action.link', {label: 'Open the Money Ledger for this period', variant: 'secondary', size: 'normal', href: money.ledger_href}) }}{% endblock %}{% endembed %}
	{% endblock %}{% endembed %}</form>
	{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {})} %}{% block body %}
		{% for figure in money.figures %}{{ ui('data.stat-card', figure) }}{% endfor %}
	{% endblock %}{% endembed %}
	{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: false})} %}{% block body %}
		<div>
			<h3 class="h5">Money in by {{ money.chart_unit }}</h3>
			{% if money.chart %}{% include '@platform/partials/distribution-chart.html.twig' with {dc_rows: money.chart, dc_label: 'Money in by ' ~ money.chart_unit} %}{% else %}<p>No money came in during this period.</p>{% endif %}
		</div>
		<div>
			<h3 class="h5">Money received by method</h3>
			{% if money.by_method %}{% include '@platform/partials/distribution-chart.html.twig' with {dc_rows: money.by_method, dc_label: 'Money received by method'} %}{% else %}<p>No payment was received during this period.</p>{% endif %}
		</div>
	{% endblock %}{% endembed %}
{% endblock %}
{% endembed %}
{% endif %}
