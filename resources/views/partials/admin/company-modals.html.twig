{% if can_manage_companies %}
	<div class="modal-backdrop" id="company-add" role="dialog" aria-modal="true" aria-labelledby="company-add-title" aria-hidden="true" hidden>
		<div class="modal-card">
			<form action="/admin/companies" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				<div class="modal-head">
					<h3 id="company-add-title">
						Add Company
					</h3>
					<button class="close-btn" type="button" data-close-modal aria-label="Close">×</button>
				</div>
				<div class="modal-body">
					<div class="form-grid">
						<div class="field full">
							<label>Company name</label>
							<input name="name" required>
						</div>
						<div class="field full">
							<label>Registered email domain</label>
							<input name="domain" placeholder="example.co.za" required>
						</div>
						<div class="field field-wide">
							<span class="cl-inferred-label">Company type</span>
							<p class="help">
								A company is a client once it holds course credits or has staff, and a course provider once it owns a course. It can be both. Nothing is chosen here because nothing needs to be: the type follows from what the company does.
							</p>
						</div>
					</div>
				</div>
				<div class="modal-foot">
					<button class="btn btn-soft" type="button" data-close-modal>Cancel</button><button class="btn btn-primary" type="submit">Create Company</button>
				</div>
			</form>
		</div>
	</div>
	{% for company in cm_rows %}
		<div class="modal-backdrop" id="company-edit-{{ company.id }}" role="dialog" aria-modal="true" aria-labelledby="company-edit-title-{{ company.id }}" aria-hidden="true" hidden>
			<div class="modal-card">
				<form action="/admin/companies/{{ company.id }}" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<div class="modal-head">
						<h3 id="company-edit-title-{{ company.id }}">
							Edit {{ company.name }}
						</h3>
						<button class="close-btn" type="button" data-close-modal aria-label="Close">×</button>
					</div>
					<div class="modal-body">
						<div class="form-grid">
							<div class="field full">
								<label>Company name</label>
								<input name="name" value="{{ company.name }}" required>
							</div>
							<div class="field full">
								<label>Domain</label>
								<input name="domain" value="{{ company.domain }}" required>
							</div>
{#
							Company type is shown, not chosen. It is derived from what the company
							actually does, so there is nothing here to submit and no way for the
							stored answer to disagree with the real one. The System Company is the
							one exception, because being the System Company is a property of the
							installation rather than of anything the company has done.
#}
							<div class="field field-wide">
								<span class="cl-inferred-label">Company type</span>
								<div class="chip-row">
									{% if company.is_system %}
										<span class="badge permanent">System company</span>
									{% else %}
										<span class="badge {{ company.is_client ? 'good' : 'muted' }}">{{ company.is_client ? 'Client' : 'Not yet a client' }}</span>
										<span class="badge {{ company.is_course_provider ? 'good' : 'muted' }}">{{ company.is_course_provider ? 'Course provider' : 'Not a course provider' }}</span>
									{% endif %}
								</div>
								<div class="help">
									Client once it holds course credits or has staff; course provider once it owns a course. A company can be both, and neither is chosen here.
								</div>
							</div>
						</div>
					</div>
					<div class="modal-foot">
						<button class="btn btn-soft" type="button" data-close-modal>Cancel</button>
						<button class="btn btn-primary" type="submit">Save company</button>
					</div>
				</form>
				{% if not company.is_system %}
					<form action="/admin/companies/{{ company.id }}/status" method="post" class="modal-foot">
						<input type="hidden" name="csrf" value="{{ csrf }}">
						<input type="hidden" name="status" value="{{ company.status=='active' ? 'disabled' : 'active' }}">
						<button class="btn {{ company.status=='active' ? 'btn-danger' : 'btn-soft' }} btn-sm">{{ company.status=='active' ? 'Disable company' : 'Enable company' }}</button>
					</form>
				{% endif %}
			</div>
		</div>
	{% endfor %}
{% endif %}
