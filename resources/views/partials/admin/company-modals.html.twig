{% if can_manage_companies %}
	{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'company-add', title: 'Add Company', action: '/admin/companies', method: 'post'})} %}
{% block modal_body %}

				<input type="hidden" name="csrf" value="{{ csrf }}">

					{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Company name', full_width: true, for: 'field-company-modals-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

							<input name="name" required id="field-company-modals-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}">

{% endblock %}
{% endembed %}
						{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Registered email domain', full_width: true, for: 'field-company-modals-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

							<input name="domain" placeholder="example.co.za" required id="field-company-modals-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}">

{% endblock %}
{% endembed %}
						<div class="cl-ui-field--full">
							<span class="cl-inferred-label">Company type</span>
							<p class="help">
								A company is a client once it holds course credits or has staff, and a course provider once it owns a course. It can be both. Nothing is chosen here because nothing needs to be: the type follows from what the company does.
							</p>
						</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% block modal_actions %}

					{{ ui('action.button', {label: 'Cancel', variant: 'secondary', size: 'normal', type: 'button', close_modal: true}) }}{{ ui('action.button', {label: 'Create Company', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-add'}) }}

{% endblock %}
{% endembed %}
	{% for company in cm_rows %}
		{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'company-edit-' ~ (company.id), title: 'Edit ' ~ (company.name), action: '/admin/companies/' ~ (company.id), method: 'post'})} %}
{% block modal_body %}

					<input type="hidden" name="csrf" value="{{ csrf }}">

						{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Company name', full_width: true, for: 'field-company-modals-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

								<input name="name" value="{{ company.name }}" required id="field-company-modals-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}">

{% endblock %}
{% endembed %}
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Domain', full_width: true, for: 'field-company-modals-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

								<input name="domain" value="{{ company.domain }}" required id="field-company-modals-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}">

{% endblock %}
{% endembed %}
{#
							Company type is shown, not chosen. It is derived from what the company
							actually does, so there is nothing here to submit and no way for the
							stored answer to disagree with the real one. The System Company is the
							one exception, because being the System Company is a property of the
							installation rather than of anything the company has done.
#}
							<div class="cl-ui-field--full">
								<span class="cl-inferred-label">Company type</span>
								<div class="chip-row">
									{% if company.is_system %}
										{{ ui('feedback.badge', {label: 'System company', tone: 'permanent'}) }}
									{% else %}
										{{ ui('feedback.badge', {label: (company.is_client ? 'Client' : 'Not yet a client'), tone: company.is_client ? 'success' : 'neutral'}) }}
										{{ ui('feedback.badge', {label: (company.is_course_provider ? 'Course provider' : 'Not a course provider'), tone: company.is_course_provider ? 'success' : 'neutral'}) }}
									{% endif %}
								</div>
								<div class="help">
									Client once it holds course credits or has staff; course provider once it owns a course. A company can be both, and neither is chosen here.
								</div>
							</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% block modal_actions %}

						{{ ui('action.button', {label: 'Cancel', variant: 'secondary', size: 'normal', type: 'button', close_modal: true}) }}
						{{ ui('action.button', {label: 'Save company', variant: 'primary', size: 'normal', type: 'submit'}) }}
					{% if not company.is_system %}{{ ui('action.button', {label: (company.status=='active' ? 'Disable company' : 'Enable company'), variant: company.status=='active' ? 'danger' : 'secondary', size: 'small', form: 'company-edit-' ~ (company.id) ~ '-status'}) }}{% endif %}
{% endblock %}
{% block additional_forms %}
{% if not company.is_system %}<form action="/admin/companies/{{ company.id }}/status" method="post" id="company-edit-{{ company.id }}-status"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="status" value="{{ company.status=='active' ? 'disabled' : 'active' }}"></form>{% endif %}
{% endblock %}
{% endembed %}
	{% endfor %}
{% endif %}
