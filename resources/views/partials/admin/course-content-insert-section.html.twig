{# Add section at one "+ Add here" place: the insert modal's body, or the form on its own page without JavaScript. A refused submission returns here with the reason and everything entered. #}
<div class="cl-course-insert-panel">
{{ ui('layout.section-head', {heading: 'Add section', heading_level: 3}) }}
{% if insert_error %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger'})} %}{% block body %}<p>{{ insert_error }}</p>{% endblock %}{% endembed %}{% endif %}
<form action="/admin/courses/{{ course.id }}/content/sections" method="post"{% if in_modal %} hx-post="/admin/courses/{{ course.id }}/content/sections" hx-target="#course-content-insert-body" hx-swap="innerHTML"{% endif %}><input type="hidden" name="csrf" value="{{ csrf }}">
{# The three options first, as feature cards in one row, and the introduction in CKEditor (owner, 2026-11-01). #}
{% set so_selected = [] %}{% if values.show_outline %}{% set so_selected = so_selected|merge(['show_outline']) %}{% endif %}{% if values.numbered|default(false) %}{% set so_selected = so_selected|merge(['numbered']) %}{% endif %}{% if values.public_preview %}{% set so_selected = so_selected|merge(['public_preview']) %}{% endif %}
{% include '@platform/partials/admin/section-options.html.twig' with {so_id: 'insert-section-options', so_selected: so_selected} %}
{% include '@platform/partials/admin/course-insert-position.html.twig' with {structure: course.structure, parent: place.parent, index: place.index} %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Section title', for: 'insert-section-title', required: true})} %}{% block control %}<input class="cl-input" id="insert-section-title" name="title" value="{{ values.title }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Optional introduction', for: 'insert-section-intro', full_width: true})} %}{% block control %}<textarea class="cl-input cl-rich-editor" id="insert-section-intro" name="introduction_html" rows="6" {{ ui_field_attrs(props) }}>{{ values.introduction_html }}</textarea>{% endblock %}{% endembed %}
<div class="mt-5">{% include '@platform/partials/course-availability-fields.html.twig' with {delay_total: values.delay_total, delay_prefix: 'insert-section'} %}</div>
{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save new section', variant: 'primary', type: 'submit', icon: 'action-save-changes'}) }}{% endblock %}{% block secondary_actions %}{% if in_modal %}{{ ui('action.button', {label: 'Cancel', type: 'button', close_modal: true, icon: 'action-cancel'}) }}{% else %}{{ ui('action.link', {label: 'Cancel', href: '/admin/courses/' ~ course.id ~ '/content', icon: 'action-cancel'}) }}{% endif %}{% endblock %}{% endembed %}
</form>
</div>
