	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Courses', eyebrow: 'Courses', summary: 'One canonical list for creating, importing, reviewing and maintaining courses.'})} %}
{% block section_actions %}{% if not section_standalone|default(false) %}{% include '@platform/partials/section-actions.html.twig' with {actions: section_actions|default([])} %}{% endif %}{% endblock %}
{% endembed %}

		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'courses', pagination: courses_pagination, search: {ds_name: 'courses', ds_label: 'Search courses', ds_value: courses_search, ds_action: '/admin/courses'}})} %}
{% block results %}

				{% if courses %}
		{# The canonical data table owns its wrapper and shared column controls. In the catalogue's order a course is
		   dragged by its handle, or moved with the arrow keys on it, or with the ⋯ menu (owner, 2026-10-20). #}
					{% set arrange = courses_can_arrange|default(false) %}
					{% if arrange %}<div class="cl-course-order" data-controller="course-order" data-course-order-csrf-value="{{ csrf }}" data-course-order-before-value="{{ courses_before_page|default(0) }}" data-action="dragstart->course-order#start dragover->course-order#over drop->course-order#drop dragend->course-order#end">
						<p class="visually-hidden" id="course-order-keys">Drag the handle, or press the up or down arrow, Home or End on it, to move the course in the catalogue.</p>
						<p class="cl-course-order-status" data-course-order-target="status" role="status" aria-live="polite"></p>{% endif %}

						{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

								<tr>
									{% for sh in courses_sort_headers %}
										{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: courses_region, sort_results: courses_results} %}
									{% endfor %}
								</tr>

{% endblock %}
{% block body %}

								{% for course in courses %}
									<tr data-course-id="{{ course.id }}" data-course-title="{{ course.title }}">
										<td class="cl-course-position">
											{% if arrange %}<button type="button" class="cl-row-handle" aria-label="Move {{ course.title }}" aria-describedby="course-order-keys" data-course-order-target="handle" data-action="pointerdown->course-order#arm keydown->course-order#key" hidden>{{ ui('icon', {name: 'action-drag'}) }}</button>{% endif %}
											<span data-position>{{ course.catalogue_position|default('') }}</span>
										</td>
										<td><code class="cl-course-code">{{ course.code }}</code></td>
										{# The whole title wraps (owner, 2026-10-20): two courses that differ only at the end, such as the parts of a series, stay told apart. #}
										<td class="cell-text">
											<strong>{{ course.title }}</strong>
										</td>
										<td>
											{# What the course is sold at now, first, then its was price struck through and its period; blank when no price is set (owner, 2026-10-20). #}
											{% if course.price %}<strong class="cl-price-now">{{ course.price.price_label }}</strong><br><small class="cl-text-muted">{% if course.price.was_label %}<s class="cl-price-was"><span class="visually-hidden">Was </span>{{ course.price.was_label }}</s> · {% endif %}{{ course.price.period_label }}</small>{% endif %}
										</td>
										<td>
											{{ ui('feedback.badge', {label: (course.status|ucfirst), tone: {published: 'success', draft: 'neutral', retired: 'warning', archived: 'neutral'}[course.status]|default('neutral')}) }}
										</td>
										<td>
											{{ course.learner_count }}
										</td>
										<td>
											{{ course.updated_at }}
										</td>
										<td>
											{{ ui('feedback.badge', {label: (course.category_name ?: 'Uncategorised'), tone: 'neutral'}) }}
										</td>
										<td title="{{ course.owner_company_name }}">
											<strong>{{ course.owner_company_name ?: '—' }}</strong>
											<br>
											<small class="cl-text-muted">{% if course.owner_user_id %}{{ ui('data.person', {name: course.owner_person_name, reference: course.owner_person_reference|default(''), href: '/admin/people/' ~ course.owner_user_id}) }}{% else %}—{% endif %}</small>
										</td>
										<td class="cell-actions">
											{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true, icon: 'action-more'})} %}
{% block body %}

													{{ ui('action.link', {label: 'Manage', variant: 'primary', size: 'small', href: '/admin/courses/' ~ (course.id), icon: 'action-manage'}) }}
													{{ ui('action.link', {label: 'Preview', variant: 'secondary', size: 'small', href: '/admin/courses/' ~ (course.id) ~ '/preview', icon: 'action-preview'}) }}
													{{ ui('action.link', {label: 'Export', variant: 'secondary', size: 'small', href: '/admin/courses/' ~ (course.id) ~ '/export', icon: 'action-export'}) }}
													{% if arrange %}
														{% for move in [['up', 'Move up', 'action-move-up'], ['down', 'Move down', 'action-move-down'], ['top', 'Move to the top', 'action-move-top']] %}
														<form action="/admin/courses/{{ course.id }}/catalogue-move" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															<input type="hidden" name="direction" value="{{ move[0] }}">
															{{ ui('action.button', {label: move[1], variant: 'secondary', size: 'small', type: 'submit', icon: move[2]}) }}
														</form>
														{% endfor %}
													{% endif %}
													{% if can_delete_courses %}
														<form action="/admin/courses/{{ course.id }}/reset" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															{{ ui('action.button', {label: 'Reset', variant: 'secondary', size: 'small', type: 'submit', confirm: 'Reset ' ~ (course.title) ~ '? This removes all course content and learner test data but keeps the empty course shell for re-import.', icon: 'action-reset'}) }}
														</form>
														{# Never for a course that was bought: its orders, invoices and receipts are kept for good (owner, 2026-10-21). #}
														{% if not course.bought_lines %}
														<form action="/admin/courses/{{ course.id }}/delete" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															{{ ui('action.button', {label: 'Delete', variant: 'danger', size: 'small', type: 'submit', confirm: 'Permanently delete ' ~ (course.title) ~ ' and all associated learner access, progress, attempts and results?', icon: 'action-remove'}) }}
														</form>
														{% endif %}
													{% endif %}

{% endblock %}
{% endembed %}
										</td>
									</tr>
								{% endfor %}

{% endblock %}
{% endembed %}
					{% if arrange %}</div>{% endif %}

{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {heading: 'No courses exist yet', summary: 'Import one of the existing self-study HTML files or create a course manually.'})} %}
{% block actions %}

						{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

							{{ ui('action.link', {label: 'Import HTML', variant: 'primary', size: 'normal', href: '/admin/courses/import', icon: 'action-import'}) }}
							{{ ui('action.link', {label: 'Create manually', variant: 'secondary', size: 'normal', href: '/admin/courses/new', icon: 'action-add'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endif %}
{% endblock %}
{% block preview %}

		{#
								Consolidated workspace preview: bounded rows plus a link to the deep-paging
								route, and no COUNT query merely to render a dashboard panel.
							#}
						{% if courses_preview_has_more %}
							<div class="pagination-row">
								<span class="pagination-summary">Showing the first {{ preview_page_size }} courses.</span>
								{{ ui('action.link', {label: 'View all courses', variant: 'secondary', size: 'small', href: '/admin/courses', icon: 'action-view-all'}) }}
							</div>
						{% endif %}
					{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
