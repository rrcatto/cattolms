{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{# The tab strip is part of this section's card, above its head, on all three Courses pages. #}
		{% include '@platform/partials/admin/course-group-nav.html.twig' %}
		{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Courses', eyebrow: 'Courses', summary: 'One canonical list for creating, importing, reviewing and maintaining courses.'})} %}
{% block section_actions %}
{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

				{{ ui('action.link', {label: 'Categories', variant: 'secondary', size: 'small', href: '/admin/courses/categories'}) }}
				{{ ui('action.link', {label: 'Import HTML course', variant: 'secondary', size: 'small', href: '/admin/courses/import'}) }}
				{{ ui('action.link', {label: 'Create course', variant: 'primary', size: 'small', href: '/admin/courses/new', icon: 'action-add'}) }}

{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}

		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'courses', pagination: courses_pagination, search: {ds_name: 'courses', ds_label: 'Search courses', ds_value: courses_search, ds_action: '/admin/courses'}})} %}
{% block results %}

				{% if courses %}
		{# The canonical data table owns its wrapper and shared column controls. #}

						{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

								<tr>
									{% for sh in courses_sort_headers %}
										{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: courses_region, sort_results: courses_results} %}
									{% endfor %}
								</tr>

{% endblock %}
{% block body %}

								{% for course in courses %}
									<tr>
										<td>
											<strong title="{{ course.title }}">{{ course.title }}</strong>
										</td>
										<td>
											{{ ui('feedback.badge', {label: (course.category_name ?: 'Uncategorised'), tone: 'neutral'}) }}
										</td>
										<td>
											{{ ui('feedback.badge', {label: (course.status|ucfirst), tone: {published: 'success', draft: 'neutral', retired: 'warning', archived: 'neutral'}[course.status]|default('neutral')}) }}
										</td>
										<td title="{{ course.owner_company_name }}">
											<strong>{{ course.owner_company_name ?: '—' }}</strong>
											<br>
											<small class="text-body-secondary">{{ course.owner_person_name ?: '—' }}</small>
										</td>
										<td>
											{{ course.learner_count }}
										</td>
										<td>
											{{ course.started_count }}
										</td>
										<td>
											{{ course.updated_at }}
										</td>
										<td class="cell-actions">
											{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true})} %}
{% block body %}

													{{ ui('action.link', {label: 'Manage', variant: 'primary', size: 'small', href: '/admin/courses/' ~ (course.id)}) }}
													{{ ui('action.link', {label: 'Preview', variant: 'secondary', size: 'small', href: '/admin/courses/' ~ (course.id) ~ '/preview'}) }}
													{{ ui('action.link', {label: 'Export', variant: 'secondary', size: 'small', href: '/admin/courses/' ~ (course.id) ~ '/export'}) }}
													{% if can_delete_courses %}
														<form action="/admin/courses/{{ course.id }}/reset" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															{{ ui('action.button', {label: 'Reset', variant: 'secondary', size: 'small', type: 'submit', confirm: 'Reset ' ~ (course.title) ~ '? This removes all course content and learner test data but keeps the empty course shell for re-import.'}) }}
														</form>
														<form action="/admin/courses/{{ course.id }}/delete" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															{{ ui('action.button', {label: 'Delete', variant: 'danger', size: 'small', type: 'submit', confirm: 'Permanently delete ' ~ (course.title) ~ ' and all associated learner access, progress, attempts and results?', icon: 'action-remove'}) }}
														</form>
													{% endif %}

{% endblock %}
{% endembed %}
										</td>
									</tr>
								{% endfor %}

{% endblock %}
{% endembed %}

{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {heading: 'No courses exist yet', summary: 'Import one of the existing self-study HTML files or create a course manually.'})} %}
{% block actions %}

						{% embed ui_template('action.group') with {props: ui_props('action.group', {})} %}
{% block body %}

							{{ ui('action.link', {label: 'Import HTML', variant: 'primary', size: 'normal', href: '/admin/courses/import'}) }}
							{{ ui('action.link', {label: 'Create manually', variant: 'secondary', size: 'normal', href: '/admin/courses/new', icon: 'action-add'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endif %}
{% endblock %}
{% block preview %}

		{#
								Consolidated workspace preview: bounded rows plus a link to the deep-paging
								route, and no COUNT query merely to render a dashboard panel.
							#}
						{% if courses_preview_has_more %}
							<div class="pagination-row">
								<span class="pagination-summary">Showing the first {{ preview_page_size }} courses.</span>
								{{ ui('action.link', {label: 'View all courses', variant: 'secondary', size: 'small', href: '/admin/courses'}) }}
							</div>
						{% endif %}
					{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
