{# Add existing item at one "+ Add here" place: the insert modal's body, or the form on its own page without JavaScript. The search reloads this panel; the item stays shared wherever it is placed. #}
{% set insert_href = '/admin/courses/' ~ course.id ~ '/content/insert/existing' %}
<div class="cl-course-insert-panel">
{{ ui('layout.section-head', {heading: 'Add existing item', heading_level: 3, summary: 'Place a reusable item that already exists. It stays shared: edits to it apply wherever it is used.'}) }}
{% if insert_error %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger'})} %}{% block body %}<p>{{ insert_error }}</p>{% endblock %}{% endembed %}{% endif %}
<form class="cl-course-insert-search" action="{{ insert_href }}" method="get"{% if in_modal %} hx-get="{{ insert_href }}" hx-target="#course-content-insert-body" hx-swap="innerHTML"{% endif %}><input type="hidden" name="insert_parent" value="{{ place.parent }}"><input type="hidden" name="insert_index" value="{{ place.index }}">
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Find an existing item by title or key', for: 'insert-existing-search'})} %}{% block control %}<input class="form-control" id="insert-existing-search" name="q" value="{{ item_search }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}{{ ui('action.button', {label: 'Search items', type: 'submit'}) }}</form>
<form action="/admin/courses/{{ course.id }}/content/placements" method="post"{% if in_modal %} hx-post="/admin/courses/{{ course.id }}/content/placements" hx-target="#course-content-insert-body" hx-swap="innerHTML"{% endif %}><input type="hidden" name="csrf" value="{{ csrf }}">
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Existing Course Item', for: 'insert-existing-item', required: true, help: library_items ? '' : 'No Course Item matches that search.'})} %}{% block control %}<select class="form-select" id="insert-existing-item" name="course_item_id" required {{ ui_field_attrs(props) }}><option value="">Choose a Course Item</option>{% for item in library_items %}<option value="{{ item.id }}"{% if values.course_item_id == item.id ~ '' %} selected{% endif %}>{{ item.title }} · {{ item.item_key }}</option>{% endfor %}</select>{% endblock %}{% endembed %}
{% include '@platform/partials/admin/course-insert-position.html.twig' with {structure: course.structure, parent: place.parent, index: place.index} %}
{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Add to course', variant: 'primary', type: 'submit'}) }}{% endblock %}{% block secondary_actions %}{% if in_modal %}{{ ui('action.button', {label: 'Cancel', type: 'button', close_modal: true}) }}{% else %}{{ ui('action.link', {label: 'Cancel', href: '/admin/courses/' ~ course.id ~ '/content'}) }}{% endif %}{% endblock %}{% endembed %}
</form>
</div>
