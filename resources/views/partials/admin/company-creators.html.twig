	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Companies that create courses', eyebrow: 'Course Creators', summary: 'Companies that own courses and offer them to others.'})} %}{% block section_actions %}{% if not section_standalone|default(false) %}{% include '@platform/partials/section-actions.html.twig' with {actions: section_actions|default([])} %}{% endif %}{% endblock %}{% endembed %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

			<div>
				<strong>A course creator owns courses.</strong> Every company listed here owns at least one; a company that also trains its own staff is listed under Course Consumers as well.
			</div>

{% endblock %}
{% endembed %}

		{% include '@platform/partials/admin/company-modals.html.twig' with {cm_rows: company_creators} %}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'company_creators', pagination: company_creators_pagination, search: {ds_name: 'company_creators', ds_label: 'Search course creators', ds_value: company_creators_search, ds_action: '/admin/companies/creators'}})} %}
{% block toolbar %}{% if company_creators_view_switch is defined and company_creators_pagination %}<div class="cl-list-toolbar">{% include '@platform/partials/view-switch.html.twig' with {vs: company_creators_view_switch} %}{% if company_creators_view == 'grid' %}{% include '@platform/partials/grid-sort.html.twig' with {gs_name: 'company_creators', gs_headers: company_creators_sort_headers, gs_pager: company_creators_pagination} %}{% endif %}</div>{% endif %}{% endblock %}
{% block results %}

					{% if company_creators_view|default('list') == 'grid' and company_creators_pagination|default(null) %}
						{% include '@platform/partials/admin/company-cards.html.twig' with {cc_rows: company_creators, cc_creators: true} %}
					{% else %}
					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% for sh in company_creators_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: company_creators_region, sort_results: company_creators_results} %}
								{% endfor %}
							</tr>

{% endblock %}
{% block body %}

							{% for company in company_creators %}
								<tr>
									<td title="{{ company.name }} · {{ company.domain }}">
										{# The name opens the company's page (owner, 2026-10-26). #}
										<strong><a href="/admin/companies/{{ company.id }}">{{ company.name }}</a></strong>
									</td>
									<td>
										{{ company.owned_course_count }}
									</td>
									<td>
										{{ ui('feedback.badge', {label: (company.status_label), tone: company.status=='active' ? 'success' : 'danger'}) }}
									</td>
									<td class="cell-actions">
										{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true, icon: 'action-more'})} %}
{% block body %}

												{% if can_select_company and company.status=='active' %}
													<form action="/company/context" method="post">
														<input type="hidden" name="csrf" value="{{ csrf }}">
														<input type="hidden" name="company_id" value="{{ company.id }}">
														{{ ui('action.button', {label: 'Manage', variant: 'primary', size: 'small', type: 'submit', icon: 'action-manage'}) }}
													</form>
												{% endif %}
												{% if can_manage_companies %}
													{{ ui('action.button', {label: 'Edit', variant: 'secondary', size: 'small', type: 'button', modal: 'company-edit-' ~ (company.id), icon: 'action-edit'}) }}
												{% endif %}

{% endblock %}
{% endembed %}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}
					{% endif %}

{% endblock %}
{% block preview %}

					{% if company_creators_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} companies.</span>
							{{ ui('action.link', {label: 'View all course creators', variant: 'secondary', size: 'small', href: '/admin/companies/creators', icon: 'action-view-all'}) }}
						</div>
					{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
