<div class="grid section">
	<div class="card">
		<div class="section-head">
			<div>
				<div class="eyebrow">
					Course Creators
				</div>
				<h2>
					Companies that create courses
				</h2>
				<p>
					Companies that own courses and offer them to others.
				</p>
			</div>
		</div>
		{% include '@platform/partials/admin/company-group-nav.html.twig' %}
		<div class="notice">
			<span>ⓘ</span>
			<div>
				<strong>A course creator owns courses.</strong> Every company listed here owns at least one; a company that also trains its own staff is listed under Course Consumers as well.
			</div>
		</div>
		{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'company_creators', ds_label: 'Search course creators', ds_value: company_creators_search, ds_action: '/admin/companies/creators'} %}
		<div class="toolbar">
			<div>
			</div>
			{% if can_manage_companies %}
				<button class="btn btn-primary" type="button" data-open-modal="company-add">＋ Add Company</button>
			{% endif %}
		</div>
		{% include '@platform/partials/admin/company-modals.html.twig' with {cm_rows: company_creators} %}
		<div id="company_creators-region" data-server-search-target>
			<div id="company_creators-results">
				{% if company_creators_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: company_creators_pagination} %}
				{% endif %}
				<div class="table-wrap section">
					<table>
						<thead>
							<tr>
								{% for sh in company_creators_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: company_creators_region, sort_results: company_creators_results} %}
								{% endfor %}
							</tr>
						</thead>
						<tbody>
							{% for company in company_creators %}
								<tr>
									<td title="{{ company.name }} · {{ company.domain }}">
										<strong>{{ company.name }}</strong>
										{% if company.is_system %}
											<span class="badge permanent">System</span>
										{% endif %}
									</td>
									<td>
										{{ company.owned_course_count }}
									</td>
									<td>
										<span class="badge {{ company.status=='active' ? 'good' : 'danger' }}">{{ company.status_label }}</span>
									</td>
									<td class="cell-actions">
										<details class="row-menu" data-cl-dropdown>
											<summary class="btn btn-soft btn-sm row-menu-trigger">
												Actions ▾
											</summary>
											<div class="row-menu-panel">
												{% if can_select_company and company.status=='active' %}
													<form action="/company/context" method="post">
														<input type="hidden" name="csrf" value="{{ csrf }}">
														<input type="hidden" name="company_id" value="{{ company.id }}">
														<button class="btn btn-primary btn-sm" type="submit">Manage</button>
													</form>
												{% endif %}
												{% if can_manage_companies %}
													<button class="btn btn-soft btn-sm" type="button" data-open-modal="company-edit-{{ company.id }}">Edit</button>
												{% endif %}
											</div>
										</details>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% if company_creators_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: company_creators_pagination} %}
				{% else %}
					{% if company_creators_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} companies.</span>
							<a class="btn btn-soft btn-sm" href="/admin/companies/creators">View all course creators</a>
						</div>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</div>
</div>
