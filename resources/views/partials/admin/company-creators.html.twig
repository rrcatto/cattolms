{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Companies that create courses', eyebrow: 'Course Creators', summary: 'Companies that own courses and offer them to others.'}) }}
		{% include '@platform/partials/admin/company-group-nav.html.twig' %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

			<div>
				<strong>A course creator owns courses.</strong> Every company listed here owns at least one; a company that also trains its own staff is listed under Course Consumers as well.
			</div>

{% endblock %}
{% endembed %}

		{% embed ui_template('layout.toolbar') with {props: ui_props('layout.toolbar', {})} %}
{% block toolbar_primary %}

{% endblock %}
{% block toolbar_actions %}

			{% if can_manage_companies %}
				{{ ui('action.button', {label: '＋ Add Company', variant: 'primary', size: 'normal', type: 'button', modal: 'company-add', icon: 'action-add'}) }}
			{% endif %}

{% endblock %}
{% endembed %}
		{% include '@platform/partials/admin/company-modals.html.twig' with {cm_rows: company_creators} %}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'company_creators', pagination: company_creators_pagination, search: {ds_name: 'company_creators', ds_label: 'Search course creators', ds_value: company_creators_search, ds_action: '/admin/companies/creators'}})} %}
{% block results %}

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% for sh in company_creators_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: company_creators_region, sort_results: company_creators_results} %}
								{% endfor %}
							</tr>

{% endblock %}
{% block body %}

							{% for company in company_creators %}
								<tr>
									<td title="{{ company.name }} · {{ company.domain }}">
										<strong>{{ company.name }}</strong>
										{% if company.is_system %}
											{{ ui('feedback.badge', {label: 'System', tone: 'permanent'}) }}
										{% endif %}
									</td>
									<td>
										{{ company.owned_course_count }}
									</td>
									<td>
										{{ ui('feedback.badge', {label: (company.status_label), tone: company.status=='active' ? 'success' : 'danger'}) }}
									</td>
									<td class="cell-actions">
										{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true})} %}
{% block body %}

												{% if can_select_company and company.status=='active' %}
													<form action="/company/context" method="post">
														<input type="hidden" name="csrf" value="{{ csrf }}">
														<input type="hidden" name="company_id" value="{{ company.id }}">
														{{ ui('action.button', {label: 'Manage', variant: 'primary', size: 'small', type: 'submit'}) }}
													</form>
												{% endif %}
												{% if can_manage_companies %}
													{{ ui('action.button', {label: 'Edit', variant: 'secondary', size: 'small', type: 'button', modal: 'company-edit-' ~ (company.id)}) }}
												{% endif %}

{% endblock %}
{% endembed %}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

					{% if company_creators_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} companies.</span>
							{{ ui('action.link', {label: 'View all course creators', variant: 'secondary', size: 'small', href: '/admin/companies/creators'}) }}
						</div>
					{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
