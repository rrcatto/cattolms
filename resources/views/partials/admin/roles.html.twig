<div class="toolbar">
	<div></div>
	{% if can_manage_roles %}<button class="btn btn-primary" type="button" data-open-modal="createRoleModal">＋ Create role</button>{% endif %}
</div>

<div class="notice"><span>ⓘ</span><div>Roles grant business capabilities. Normal and seed-only roles use the same business permission catalogue; SYSTEM permissions remain reserved for ADMIN.</div></div>

<div class="table-wrap section">
	<table>
		<thead>
			<tr>
				<th style="width:22%">Role</th>
				<th style="width:12%">Role family</th>
				<th style="width:40%">Description</th>
				<th style="width:8%">Permissions</th>
				<th style="width:7%">Users</th>
				<th class="cell-actions" style="width:11%">Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for role in roles_acl %}
				<tr>
					<td title="{{ role.role_name }} · {{ role.role_key }}">
						<strong>{{ role.role_name }}</strong>
						<div class="muted"><code>{{ role.role_key }}</code>{{ role.is_builtin_role ? ' · built in' : '' }}</div>
					</td>
					<td title="{{ role.role_family }}">{{ role.role_family }}</td>
					<td title="{{ role.role_description }}">{{ role.role_description }}</td>
					<td>{{ role.permission_count }}</td>
					<td>{{ role.user_count }}</td>
					<td><div class="row-actions"><a class="btn btn-soft btn-sm" href="/admin/roles/{{ role.id }}">Manage</a></div></td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>

{% if can_manage_roles %}
	<div class="modal-backdrop" id="createRoleModal" role="dialog" aria-modal="true" aria-labelledby="createRoleTitle" aria-hidden="true" hidden>
		<div class="modal-card">
			<div class="modal-head">
				<div>
					<div class="eyebrow">Roles &amp; ACL</div>
					<h3 id="createRoleTitle">Create role</h3>
				</div>
				<button class="close-btn" type="button" data-close-modal aria-label="Close">×</button>
			</div>
			<form action="/admin/roles" method="post">
				<div class="modal-body">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<div class="form-grid">
						<div class="field full">
							<label>Role key</label>
							<input name="role_key" required pattern="[A-Z][A-Z0-9_]+" placeholder="TRAINING_MANAGER">
							<div class="help">Uppercase snake notation. Prefix SEED_ only when the role is reserved for seed identities.</div>
						</div>
						<div class="field full">
							<label>Role name</label>
							<input name="role_name" required pattern="[A-Z][A-Za-z0-9]*" title="CamelCase without spaces, for example TrainingManager" placeholder="TrainingManager">
							<div class="help">CamelCase without spaces.</div>
						</div>
						<div class="field full"><label>Description</label><textarea name="role_description" rows="3"></textarea></div>
					</div>
				</div>
				<div class="modal-foot">
					<button class="btn btn-ghost" type="button" data-close-modal>Cancel</button>
					<button class="btn btn-primary" type="submit">Create role</button>
				</div>
			</form>
		</div>
	</div>
{% endif %}
