{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Roles and permissions', eyebrow: 'Roles & ACL', summary: 'Roles, permissions and access-control assignments.'}) }}
		{% embed ui_template('layout.toolbar') with {props: ui_props('layout.toolbar', {})} %}
{% block toolbar_primary %}

{% endblock %}
{% block toolbar_actions %}

			{% if can_manage_roles %}
				{{ ui('action.button', {label: '＋ Create role', variant: 'primary', size: 'normal', type: 'button', modal: 'createRoleModal', icon: 'action-add'}) }}
			{% endif %}

{% endblock %}
{% endembed %}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

			<div>
				Roles grant business capabilities. Normal and seed-only roles use the same business permission catalogue; SYSTEM permissions remain reserved for ADMIN.
			</div>

{% endblock %}
{% endembed %}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 29, label: 'Role'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 11, label: 'Role family'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 35, label: 'Description'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 11, label: 'Permissions'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 6, label: 'Users'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 8, label: 'Actions'}} %}
					</tr>

{% endblock %}
{% block body %}

					{% for role in roles_acl %}
						<tr>
							<td title="{{ role.role_name }} · {{ role.role_key }}">
								<strong>{{ role.role_name }}</strong>
								<div class="muted">
									<code>{{ role.role_key }}</code>{{ role.is_builtin_role ? ' · built in' : '' }}
								</div>
							</td>
							<td title="{{ role.role_family }}">
								{{ role.role_family }}
							</td>
							<td title="{{ role.role_description }}">
								{{ role.role_description }}
							</td>
							<td>
								{{ role.permission_count }}
							</td>
							<td>
								{{ role.user_count }}
							</td>
							<td>
								{% embed ui_template('action.row') with {props: ui_props('action.row', {})} %}
{% block body %}

									{{ ui('action.link', {label: 'Manage', variant: 'secondary', size: 'small', href: '/admin/roles/' ~ (role.id)}) }}

{% endblock %}
{% endembed %}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}

		{% if can_manage_roles %}
			{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'createRoleModal', title: 'Create role', action: '/admin/roles', method: 'post'})} %}
{% block modal_body %}

							<input type="hidden" name="csrf" value="{{ csrf }}">
							{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Role key', full_width: true, for: 'field-roles-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true, help: 'Uppercase snake notation. Prefix SEED_ only when the role is reserved for seed identities.'})} %}
{% block control %}

									<input name="role_key" required pattern="[A-Z][A-Z0-9_]+" placeholder="TRAINING_MANAGER" id="field-roles-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Role name', full_width: true, for: 'field-roles-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true, help: 'CamelCase without spaces.'})} %}
{% block control %}

									<input name="role_name" required pattern="[A-Z][A-Za-z0-9]*" title="CamelCase without spaces, for example TrainingManager" placeholder="TrainingManager" id="field-roles-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Description', full_width: true, for: 'field-roles-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

									<textarea name="role_description" rows="3" id="field-roles-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}></textarea>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block modal_actions %}

							{{ ui('action.button', {label: 'Cancel', variant: 'quiet', size: 'normal', type: 'button', close_modal: true}) }}
							{{ ui('action.button', {label: 'Create role', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-add'}) }}

{% endblock %}
{% endembed %}
		{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
