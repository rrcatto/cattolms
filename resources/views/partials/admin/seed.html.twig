{#
Generated by: Claude Code CLI
Date time: 2026/08/23 04:19 SAST
Version: 0.5.8
Description:
  The Seed Database Administration section: generate a disposable seed set, review the history
  of previous sets, and clean one up again.

  Core owns this markup. Themes style it through the ordinary platform table, form and button
  classes; a theme never recreates it.

  Comments here are plain prose only: no angle brackets, no comment delimiters, no template
  tokens and no code. Each of those is read as markup rather than as text.

Changelog:
  2026/08/23 04:19 SAST
  - Created for the v0.5.8 Seed Database phase.
#}
<div class="section-head">
	<div>
		<h2>
			Seed Database
		</h2>
		<p>
			Generate disposable SEED records so list screens, counts and pagination can be exercised at realistic volume.
		</p>
	</div>
	<div class="row-actions">
		<span class="badge text-bg-light border">{{ seed_total_records }} seed records on the platform</span>
	</div>
</div>
<div class="notice">
	<span>ⓘ</span>
	<div>
		Seed records live in a separate data universe. Ordinary users and the public catalogue never see them, and
    a seed identity never sees genuine data. Removing a set deletes only its own records.
	</div>
</div>
{% if seed_cleanup_preview %}
	<div class="card section">
		<div class="section-head">
			<div>
				<h2>
					Confirm cleanup
				</h2>
				<p>
					Review what will be removed before confirming.
				</p>
			</div>
		</div>
		<div class="card-body p-4">
			<p>
				<strong>{{ seed_cleanup_preview.records }}</strong> records will be deleted from set
          <span class="mono small">{{ seed_cleanup_preview.token }}</span>.
			</p>
			<div class="table-wrap">
				<table class="table table-sm align-middle mb-0">
					<thead>
						<tr>
							<th style="width:76%">
								Table
							</th>
							<th style="width:24%">
								Records
							</th>
						</tr>
					</thead>
					<tbody>
						{% for preview_table, preview_count in seed_cleanup_preview.tables %}
							<tr>
								<td class="mono small">
									{{ preview_table }}
								</td>
								<td>
									{{ preview_count }}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
			{% if seed_cleanup_preview.collateral %}
				<div class="notice section">
					<span>⚠</span>
					<div>
						Records belonging to other seed sets depend on this one and will be removed with it.
              Seed tokens record where data came from; they are not separate tenancies.
						<ul>
							{% for other_token, other_count in seed_cleanup_preview.collateral %}
								<li>
									<span class="mono small">{{ other_token }}</span> — {{ other_count }} records
								</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			{% endif %}
			<div class="d-flex gap-2 mt-4">
				<form action="/admin/seed/{{ seed_cleanup_preview.token }}/cleanup" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<button class="btn btn-danger" type="submit">Delete these records</button>
				</form>
				<a class="btn btn-soft" href="/admin/seed">Cancel</a>
			</div>
		</div>
	</div>
{% else %}
	{% if can_manage_seed %}
		<div class="card section">
			<div class="section-head">
				<div>
					<h2>
						Generate a seed set
					</h2>
					<p>
						The volume is a whole-set target across every seeded table, not a per-table quota.
					</p>
				</div>
			</div>
			<form action="/admin/seed/generate" method="post" class="form-grid">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				<div class="field">
					<label for="seed-volume">Approximate records</label>
					<input id="seed-volume" name="volume" type="number"
                   min="{{ seed_volume.minimum }}" max="{{ seed_volume.maximum }}"
                   value="{{ seed_volume.default }}" required>
					<div class="help">
						Between {{ seed_volume.minimum }} and {{ seed_volume.maximum }}. Large sets take a while; generate several rather than one enormous one.
					</div>
				</div>
				<div class="field full">
					<label for="seed-description">Description</label>
					<input id="seed-description" name="description" maxlength="500" placeholder="What is this set for?">
				</div>
				<div class="field full">
					<button class="btn btn-primary" type="submit"
                    data-confirm="Generate seed records? This writes a large amount of disposable test data.">Generate seed set</button>
				</div>
			</form>
		</div>
	{% endif %}
{% endif %}
{% if seed_sets %}
	<div class="card">
		<div class="table-wrap">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th style="width:26%">
							Token
						</th>
						<th style="width:23%">
							Description
						</th>
						<th style="width:6%">
							Requested
						</th>
						<th style="width:6%">
							Generated
						</th>
						<th style="width:6%">
							Current
						</th>
						<th style="width:5%">
							Time
						</th>
						<th style="width:10%">
							Created
						</th>
						<th style="width:12%">
							By
						</th>
						<th class="cell-actions" style="width:6%">
							Actions
						</th>
					</tr>
				</thead>
				<tbody>
					{% for seed_set in seed_sets %}
						<tr>
							<td class="mono small">
								<a href="/admin/seed/{{ seed_set.seed_token }}">{{ seed_set.seed_token }}</a>
							</td>
							<td>
								{{ seed_set.description ?: '—' }}
							</td>
							<td>
								{{ seed_set.requested_volume }}
							</td>
							<td>
								{{ seed_set.initial_record_count }}
							</td>
							<td>
								{% if seed_set.is_cleaned %}
									<span class="badge text-bg-light border">Cleaned</span>
								{% else %}
									<strong>{{ seed_set.current_record_count }}</strong>
								{% endif %}
							</td>
							<td>
								{{ seed_set.generation_seconds }}s
							</td>
							<td>
								{{ seed_set.created_at }}
							</td>
							<td>
								{{ seed_set.created_by_name }}
							</td>
							<td class="cell-actions">
								<details class="row-menu" data-cl-dropdown>
									<summary class="btn btn-soft btn-sm row-menu-trigger">
										Actions ▾
									</summary>
									<div class="row-menu-panel">
										<a class="btn btn-sm btn-soft" href="/admin/seed/{{ seed_set.seed_token }}" title="What this set wrote to each table">Records</a>
										{% if can_manage_seed and not seed_set.is_cleaned %}
											<a class="btn btn-sm btn-outline-danger" href="/admin/seed/{{ seed_set.seed_token }}/cleanup">Clean up</a>
										{% endif %}
									</div>
								</details>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% else %}
	<div class="cl-empty-state">
		<h2>
			No seed sets yet
		</h2>
		<p>
			Generate one to populate the platform with disposable records for volume testing.
		</p>
	</div>
{% endif %}
