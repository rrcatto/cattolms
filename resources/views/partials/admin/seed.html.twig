{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

	{{ ui('layout.section-head', {heading: 'Generate data', eyebrow: 'Seed Database', summary: 'Companies, people, courses, modules, assessments, enrolments, results and certificates, generated as one coherent graph so every screen has something on it.'}) }}
	{% if can_manage_seed %}
		<form action="/admin/seed/generate" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Approximate number of rows', full_width: false, for: 'seed-volume', required: true, help: 'Between ' ~ (seed_volume.minimum|number_format) ~ ' and ' ~ (seed_volume.maximum|number_format) ~ '. The figure is the total across every table, not the number of people.'})} %}
{% block control %}

				<input id="seed-volume" name="volume" type="number" value="{{ seed_volume.default }}"
				       min="{{ seed_volume.minimum }}" max="{{ seed_volume.maximum }}" required{% if props.help or props.error %} aria-describedby="{% if props.help %}{{ props.for }}-help{% endif %}{% if props.error %} {{ props.for }}-error{% endif %}"{% endif %}{% if props.error %} aria-invalid="true"{% endif %}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'What this set is for', full_width: false, for: 'seed-description', help: 'Recorded in the activity log so a later reader knows why the data appeared.'})} %}
{% block control %}

				<input id="seed-description" name="description" type="text" maxlength="500" placeholder="Catalogue screenshots"{% if props.help or props.error %} aria-describedby="{% if props.help %}{{ props.for }}-help{% endif %}{% if props.error %} {{ props.for }}-error{% endif %}"{% endif %}{% if props.error %} aria-invalid="true"{% endif %}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

				{{ ui('action.button', {label: 'Generate', variant: 'primary', size: 'normal', type: 'submit', confirm: 'Generate this data now? A large volume can take a while.'}) }}
				<div class="help">
					Generation runs in one transaction: if it fails, nothing is left behind. No email is sent, whatever the volume.
				</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
	{% else %}
		<p class="help">
			Generating data needs the Seed Database management permission.
		</p>
	{% endif %}

{% endblock %}
{% endembed %}
