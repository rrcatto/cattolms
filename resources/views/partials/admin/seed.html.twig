<div class="card">
	<div class="section-head">
		<div>
			<h2>
				Generate data
			</h2>
			<p>
				Companies, people, courses, modules, assessments, enrolments, results and certificates, generated as one coherent graph so every screen has something on it.
			</p>
		</div>
	</div>
	{% if can_manage_seed %}
		<form action="/admin/seed/generate" method="post" class="form-grid">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			<div class="field">
				<label for="seed-volume">Approximate number of rows</label>
				<input id="seed-volume" name="volume" type="number" value="{{ seed_volume.default }}"
				       min="{{ seed_volume.minimum }}" max="{{ seed_volume.maximum }}" required>
				<div class="help">
					Between {{ seed_volume.minimum|number_format }} and {{ seed_volume.maximum|number_format }}. The figure is the total across every table, not the number of people.
				</div>
			</div>
			<div class="field">
				<label for="seed-description">What this set is for</label>
				<input id="seed-description" name="description" type="text" maxlength="500" placeholder="Catalogue screenshots">
				<div class="help">
					Recorded in the activity log so a later reader knows why the data appeared.
				</div>
			</div>
			<div class="field field-wide">
				<button class="btn btn-primary" type="submit" data-confirm="Generate this data now? A large volume can take a while.">Generate</button>
				<div class="help">
					Generation runs in one transaction: if it fails, nothing is left behind. No email is sent, whatever the volume.
				</div>
			</div>
		</form>
	{% else %}
		<p class="help">
			Generating data needs the Seed Database management permission.
		</p>
	{% endif %}
</div>
