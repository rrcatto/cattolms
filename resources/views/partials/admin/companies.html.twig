	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{% embed ui_template('layout.section-head') with {props: ui_props('layout.section-head', {heading: 'Companies on the platform', eyebrow: 'Companies', summary: 'Companies whose staff are trained.'})} %}{% block section_actions %}{% if not section_standalone|default(false) %}{% include '@platform/partials/section-actions.html.twig' with {actions: section_actions|default([])} %}{% endif %}{% endblock %}{% endembed %}

		{% include '@platform/partials/admin/company-modals.html.twig' with {cm_rows: companies} %}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'companies', pagination: companies_pagination, search: {ds_name: 'companies', ds_label: 'Search course consumers', ds_value: companies_search, ds_action: '/admin/companies'}})} %}
{% block toolbar %}{% if companies_view_switch is defined and companies_pagination %}<div class="cl-list-toolbar">{% include '@platform/partials/view-switch.html.twig' with {vs: companies_view_switch} %}{% if companies_view == 'grid' %}{% include '@platform/partials/grid-sort.html.twig' with {gs_name: 'companies', gs_headers: companies_sort_headers, gs_pager: companies_pagination} %}{% endif %}</div>{% endif %}{% endblock %}
{% block results %}

					{% if companies_view|default('list') == 'grid' and companies_pagination|default(null) %}
						{% include '@platform/partials/admin/company-cards.html.twig' with {cc_rows: companies, cc_creators: false} %}
					{% else %}
					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% for sh in companies_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: companies_region, sort_results: companies_results} %}
								{% endfor %}
							</tr>

{% endblock %}
{% block body %}

							{% for company in companies %}
								<tr>
									<td title="{{ company.name }} · {{ company.domain }}">
										{# The name opens the company's page (owner, 2026-10-26). #}
										<strong><a href="/admin/companies/{{ company.id }}">{{ company.name }}</a></strong>
									</td>
									<td>
										{{ company.people_count }}
									</td>
									<td>
										{{ company.enrolment_count }}
									</td>
									<td>
										{{ ui('feedback.badge', {label: (company.status_label), tone: company.status=='active' ? 'success' : 'danger'}) }}
									</td>
									<td class="cell-actions">
										{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true, icon: 'action-more'})} %}
{% block body %}

												{% if can_select_company and company.status=='active' %}
													<form action="/company/context" method="post">
														<input type="hidden" name="csrf" value="{{ csrf }}">
														<input type="hidden" name="company_id" value="{{ company.id }}">
														{{ ui('action.button', {label: 'Manage', variant: 'primary', size: 'small', type: 'submit', icon: 'action-manage'}) }}
													</form>
												{% endif %}
												{% if can_manage_companies %}
													{{ ui('action.button', {label: 'Edit', variant: 'secondary', size: 'small', type: 'button', modal: 'company-edit-' ~ (company.id), icon: 'action-edit'}) }}
												{% endif %}

{% endblock %}
{% endembed %}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}
					{% endif %}

{% endblock %}
{% block preview %}

					{% if companies_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} companies.</span>
							{{ ui('action.link', {label: 'View all course consumers', variant: 'secondary', size: 'small', href: '/admin/companies', icon: 'action-view-all'}) }}
						</div>
					{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
