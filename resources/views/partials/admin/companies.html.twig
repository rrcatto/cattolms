<div class="grid section">
	<div class="card">
		<div class="section-head">
			<div>
				<div class="eyebrow">
					Companies
				</div>
				<h2>
					Companies on the platform
				</h2>
				<p>
					Companies whose staff are trained, and the System Company.
				</p>
			</div>
		</div>
		{% include '@platform/partials/admin/company-group-nav.html.twig' %}
		<div class="notice">
			<span>ⓘ</span>
			<div>
				<strong>System Company:</strong> the permanent host organisation. It cannot be disabled or deleted.
			</div>
		</div>
		{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'companies', ds_label: 'Search course consumers', ds_value: companies_search, ds_action: '/admin/companies'} %}
		<div class="toolbar">
			<div>
			</div>
			{% if can_manage_companies %}
				<button class="btn btn-primary" type="button" data-open-modal="company-add">＋ Add Company</button>
			{% endif %}
		</div>
		{% include '@platform/partials/admin/company-modals.html.twig' with {cm_rows: companies} %}
		<div id="companies-region" data-server-search-target>
			<div id="companies-results">
				{% if companies_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: companies_pagination} %}
				{% endif %}
				<div class="table-wrap section">
					<table>
						<thead>
							<tr>
								{% for sh in companies_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: companies_region, sort_results: companies_results} %}
								{% endfor %}
							</tr>
						</thead>
						<tbody>
							{% for company in companies %}
								<tr>
									<td title="{{ company.name }} · {{ company.domain }}">
										<strong>{{ company.name }}</strong>
										{% if company.is_system %}
											<span class="badge permanent">System</span>
										{% endif %}
									</td>
									<td>
										{{ company.people_count }}
									</td>
									<td>
										{{ company.enrolment_count }}
									</td>
									<td>
										<span class="badge {{ company.status=='active' ? 'good' : 'danger' }}">{{ company.status_label }}</span>
									</td>
									<td class="cell-actions">
										<details class="row-menu" data-cl-dropdown>
											<summary class="btn btn-soft btn-sm row-menu-trigger">
												Actions ▾
											</summary>
											<div class="row-menu-panel">
												{% if can_select_company and company.status=='active' %}
													<form action="/company/context" method="post">
														<input type="hidden" name="csrf" value="{{ csrf }}">
														<input type="hidden" name="company_id" value="{{ company.id }}">
														<button class="btn btn-primary btn-sm" type="submit">Manage</button>
													</form>
												{% endif %}
												{% if can_manage_companies %}
													<button class="btn btn-soft btn-sm" type="button" data-open-modal="company-edit-{{ company.id }}">Edit</button>
												{% endif %}
											</div>
										</details>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% if companies_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: companies_pagination} %}
				{% else %}
					{% if companies_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} companies.</span>
							<a class="btn btn-soft btn-sm" href="/admin/companies">View all course consumers</a>
						</div>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</div>
</div>
