{#
	The Page Builder for course pages (owner, 2026-10-30, from the accepted mockup; layouts of one's own, 2026-11-01): the
	blocks under a course page's header, each dragged or moved with its arrows, half or full width, hidden or shown,
	beside a sketch of the page as visitors see it, for one course, with the blocks that course leaves out and why. A
	layout's page (Administration > Courses > Course Page Layouts) and a course's custom layout share it, inside their
	own form, which saves it.

	Without JavaScript every button sends the whole form and the server acts on it and saves (a move, a block hidden or
	shown; CoursePageLayouts::fromForm). With JavaScript (page_layout_controller.js) the same buttons change the page in
	place by moving the blocks drawn here. Course access is always shown. Variables: plb (CoursePageLayouts::builder),
	plb_sketch (CoursePageLayouts::sketch), plb_present (the blocks with something to show on the course drawn, joined
	by commas), plb_locked (a layout the reader may not change); on a layout's page plb_courses (the courses the sketch
	may be drawn for) with plb_course_form (the id of the form that draws it for another without JavaScript); on a
	course's custom layout plb_start_layouts and plb_layouts_json (the layouts Start again from copies in).
#}
<div class="cl-page-builder" data-controller="page-layout" data-page-layout-present-value="{{ plb_present }}" data-page-layout-locked-value="{{ plb_locked|default(false) ? 'true' : 'false' }}"{% if plb_layouts_json|default('') %} data-page-layout-layouts-value="{{ plb_layouts_json }}"{% endif %}>
	<input type="hidden" name="order" value="{{ plb.order }}" data-page-layout-target="order">
	{# The course the sketch is drawn for, so a save comes back to it. #}
	{% if plb_courses|default([]) %}<input type="hidden" name="course" value="{{ (plb_courses|filter(c => c.selected)|first).code|default('') }}" data-page-layout-target="courseField">{% endif %}
	<div class="cl-page-builder-work">
		<div class="cl-page-builder-part" data-page-layout-target="lockable">
			<div class="cl-page-builder-part-head">
				<h3 class="h5">Arrange the page</h3>
				<p>Drag a block by its handle, or move it with its arrows. Half-width blocks side by side share a row and match each other's height.</p>
			</div>
			{% if plb_start_layouts|default([]) %}
			{# A course's custom layout starts again from one of the layouts, copied in (saved with the form). #}
			<div class="cl-page-builder-start">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Start again from', for: 'page-layout-start-from'})} %}
{% block control %}<select class="cl-select" id="page-layout-start-from" name="start_from" data-page-layout-target="startFrom" {{ ui_field_attrs(props) }}>
					{% for start in plb_start_layouts %}<option value="{{ start.id }}">{{ start.name }}{{ start.is_default ? ' (the default layout)' : '' }}</option>{% endfor %}
				</select>{% endblock %}
{% endembed %}
				{{ ui('action.button', {label: 'Copy it in', variant: 'secondary', size: 'small', name: 'action', value: 'start', icon: 'action-copy', stimulus_action: 'page-layout#start', title: 'The custom layout takes that layout\'s blocks. Nothing is saved until you press Save.'}) }}
			</div>
			{% endif %}
			<div class="cl-page-builder-fixed"><span><strong>Page header</strong><span>The cover with the title and the favourite star, then Watch course presentation. Always first, as it is.</span></span><span class="cl-page-builder-fixed-tag">Fixed</span></div>
			{% set tiles = {board: plb.blocks|filter(block => block.shown), shelf: plb.blocks|filter(block => not block.shown)} %}
			{% for place, blocks in tiles %}
			{% if place == 'shelf' %}
			<div class="cl-page-builder-shelf">
				<strong>Hidden from the page</strong>
				<p class="cl-page-builder-shelf-empty" data-page-layout-target="empty"{% if blocks %} hidden{% endif %}>Nothing is hidden.</p>
			{% endif %}
			<ol class="cl-page-builder-{{ place }}" data-page-layout-target="{{ place }}" aria-label="{{ place == 'board' ? 'Blocks in their order on the page' : 'Blocks hidden from the page' }}">
				{% for block in blocks %}
				<li class="cl-page-builder-tile" data-page-layout-target="tile" data-block="{{ block.id }}" data-width="{{ block.width }}"{% if block.required %} data-required{% endif %} data-action="dragstart->page-layout#dragStart dragover->page-layout#dragOver drop->page-layout#drop dragend->page-layout#dragEnd">
					<input type="hidden" name="shown[{{ block.id }}]" value="{{ block.shown ? '1' : '0' }}">
					<div class="cl-page-builder-tile-head">
						<span class="cl-page-builder-handle" aria-hidden="true" data-action="pointerdown->page-layout#grab">{{ ui('icon', {name: 'action-drag'}) }}</span>
						<span class="cl-page-builder-tile-name"><strong>{{ block.name }}</strong><span>{{ block.note }}</span></span>
						<span class="cl-page-builder-arrows">
							{{ ui('action.button', {label: 'Up', aria_label: 'Move ' ~ block.name ~ ' up', variant: 'quiet', size: 'small', name: 'action', value: 'move:' ~ block.id ~ ':up', icon: 'action-move-up', stimulus_action: 'page-layout#move'}) }}
							{{ ui('action.button', {label: 'Down', aria_label: 'Move ' ~ block.name ~ ' down', variant: 'quiet', size: 'small', name: 'action', value: 'move:' ~ block.id ~ ':down', icon: 'action-move-down', stimulus_action: 'page-layout#move'}) }}
						</span>
					</div>
					<div class="cl-page-builder-tile-tools">
						<fieldset class="cl-width-switch"><legend class="cl-visually-hidden">Width of {{ block.name }}</legend>
							<label><input type="radio" name="width[{{ block.id }}]" value="half"{% if block.width == 'half' %} checked{% endif %}><span>Half</span></label>
							<label><input type="radio" name="width[{{ block.id }}]" value="full"{% if block.width == 'full' %} checked{% endif %}><span>Full width</span></label>
						</fieldset>
						{% if block.required %}
						<span class="cl-page-builder-always">Always shown</span>
						{% else %}
						<span class="cl-page-builder-hide">{{ ui('action.button', {label: 'Hide', aria_label: 'Hide ' ~ block.name, variant: 'quiet', size: 'small', name: 'action', value: 'hide:' ~ block.id, icon: 'action-hide', stimulus_action: 'page-layout#hide'}) }}</span>
						<span class="cl-page-builder-show">{{ ui('action.button', {label: 'Show', aria_label: 'Show ' ~ block.name, variant: 'secondary', size: 'small', name: 'action', value: 'show:' ~ block.id, icon: 'action-view', stimulus_action: 'page-layout#show'}) }}</span>
						{% endif %}
					</div>
				</li>
				{% endfor %}
			</ol>
			{% if place == 'shelf' %}</div>{% endif %}
			{% endfor %}
		</div>

		<aside class="cl-page-builder-part cl-page-builder-preview" aria-labelledby="page-layout-sketch">
			<h3 class="h5" id="page-layout-sketch">The page, as visitors see it</h3>
			{% if plb_courses|default([]) %}
			{# Drawn for one course at a time: a block with nothing to show on that course is left out of its page. #}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Show it for', for: 'page-layout-course'})} %}
{% block control %}<select class="cl-select" id="page-layout-course" name="course" form="{{ plb_course_form }}" data-action="change->page-layout#course" {{ ui_field_attrs(props) }}>
					{% for course in plb_courses %}<option value="{{ course.code }}" data-present="{{ course.present|join(',') }}"{% if course.selected %} selected{% endif %}>{{ course.label }}</option>{% endfor %}
				</select>{% endblock %}
{% endembed %}
			<noscript>{{ ui('action.button', {label: 'Show', variant: 'secondary', size: 'small', type: 'submit', form: plb_course_form, icon: 'action-filter'}) }}</noscript>
			{% endif %}
			{% include '@platform/partials/admin/page-sketch.html.twig' with {ps: plb_sketch, ps_target: 'page-layout'} %}
			<p>On a phone every block takes the full width, in the same order.</p>
		</aside>
	</div>
</div>
