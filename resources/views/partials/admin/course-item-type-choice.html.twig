{# Choosing a Course Item type, shared by its full page and the Course Content insert modal. #}
{% if in_modal|default(false) %}{{ ui('layout.section-head', {heading: 'Create new item', heading_level: 3, summary: 'Choose the kind of Course Item to create. You configure it next.'}) }}{% endif %}
<form action="/admin/course-items/new" method="get"{% if in_modal|default(false) %} hx-get="/admin/course-items/new" hx-target="#course-content-insert-body" hx-swap="innerHTML"{% endif %}><input type="hidden" name="course" value="{{ course_code|default('') }}">{% if placement.insert_index != '' %}<input type="hidden" name="parent_node_id" value="{{ placement.parent_node_id }}"><input type="hidden" name="insert_index" value="{{ placement.insert_index }}">{% endif %}{% if resource %}<input type="hidden" name="resource_id" value="{{ resource.id }}">{% endif %}
{% set type_icons = {html_lesson: 'book-open', assessment: 'clipboard-check', diagnostic: 'stethoscope', pdf: 'file-text', image_graphic: 'image', uploaded_video: 'video', youtube: 'square-play', audio: 'audio-lines', markdown: 'file-code', downloadable_file: 'file-down', slide_deck: 'presentation', flashcards: 'layers', practical: 'pencil-ruler'} %}
{{ ui('form.picture-choice', {name: 'type', legend: 'Course Item type', size: 'small', required: true, selected: (type_choices|first).value, items: type_choices|map(choice => {value: choice.value, label: choice.label, icon: lucide(type_icons[choice.value]|default('file')), note: choice.description})}) }}
{% embed ui_template('form.actions') with {props:ui_props('form.actions',{})} %}{% block primary_actions %}{{ ui('action.button',{label:'Continue',type:'submit',variant:'primary', icon: 'action-next'}) }}{% endblock %}{% block secondary_actions %}{% if in_modal|default(false) %}{{ ui('action.button', {label: 'Cancel', type: 'button', close_modal: true, icon: 'action-cancel'}) }}{% else %}{{ ui('action.link', {label: 'Cancel', href: cancel_href, icon: 'action-cancel'}) }}{% endif %}{% endblock %}{% endembed %}
</form>
