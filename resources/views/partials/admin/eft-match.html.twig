{#
	Who a bank statement's reference names and their orders that can take an EFT payment
	(BankPayments::find), each with a button that records the deposit against it. Shared by Record EFT
	Payment and an unmatched deposit's page. Takes eft_match (the result of find), eft_action (where the
	buttons post), eft_hidden (the fields each button carries) and eft_button (its label).
#}
{% if eft_match.found %}
	<p data-eft-account>Account {% if eft_match.account.person %}{{ ui('data.person', eft_match.account.person|merge({full: true})) }}{% else %}<strong>{{ eft_match.account.label }}</strong>{% endif %}</p>
{% endif %}
{% if eft_match.orders %}
	{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
	{% block header %}<tr>{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Order'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 42, label: 'What was bought', wide: true}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Still due'}} %}{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 22, label: ''}} %}</tr>{% endblock %}
	{% block body %}{% for order in eft_match.orders %}
		<tr data-eft-order="{{ order.id }}">
			<td class="cell-text"><a href="{{ order.href }}">{{ order.number }}</a><br><span class="small">Placed {{ order.placed }}</span></td>
			<td class="cell-text">{{ order.bought }}<br><span class="small">{{ order.note }}</span></td>
			<td>{{ order.state == 'cancelled' ? 'Cancelled' : order.due_label }}</td>
			<td class="cell-actions"><form action="{{ eft_action }}" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="order_id" value="{{ order.id }}">{% for name, value in eft_hidden %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}{{ ui('action.button', {label: eft_button, variant: 'primary', size: 'small', type: 'submit', aria_label: eft_button ~ ' ' ~ order.number, icon: 'action-record-money'}) }}</form></td>
		</tr>
	{% endfor %}{% endblock %}
	{% endembed %}
{% endif %}
{% if eft_match.message %}{{ ui('feedback.notice', {tone: 'warning', heading: eft_match.message}) }}{% endif %}
