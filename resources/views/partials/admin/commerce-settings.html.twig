{#
	The commerce settings, as sections of Administration > Settings (owner, 2026-10-18: one settings
	area). Each value has a .env default; a value saved here replaces it until it is reset, and orders
	already placed keep the values they were placed with. Durations are written with y (years), w
	(weeks), d (days) and h (hours), in that order, such as 3y, 4w2d or 1h. commerce_fields comes from
	CommerceSettingsController::fieldsView().
#}
{% set fields = commerce_fields %}
    {% set sections = [
        {key: 'fees', heading: 'Commerce: fees', summary: 'What Stitch charges, and the fee on a money-back refund of an EFT payment. Deducted from refunds as the Refund Policy says.'},
        {key: 'references', heading: 'Commerce: account references', summary: 'The letters every new account reference starts with.'},
        {key: 'wallet', heading: 'Commerce: wallet credit', summary: 'How long credit lasts and when the reminder is sent.'},
        {key: 'orders', heading: 'Commerce: orders and refunds', summary: 'The refund window, unpaid order cancellation and payment links.'}
    ] %}
        {% for section in sections %}
        {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: section.heading, summary: section.summary, id: 'commerce-settings-' ~ section.key, open: settings_open_section|default('') == 'commerce-' ~ section.key})} %}{% block body %}
            <form action="/admin/settings/commerce/{{ section.key }}" method="post"><input type="hidden" name="csrf" value="{{ csrf }}">
            {% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}{% block body %}
            {% for field in fields[section.key] %}
                {% set help = (field.words ? 'In force: ' ~ field.words ~ '. ' : '') ~ (field.source == 'database' ? 'Set here; the .env default (' ~ field.env ~ ') is ' ~ field.default ~ '.' : 'The .env default (' ~ field.env ~ ').') %}
                {% if field.type == 'processor_fee' %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: field.label ~ ': percentage', for: 'setting-' ~ field.key ~ '-percent', required: true, help: help})} %}{% block control %}<input id="setting-{{ field.key }}-percent" name="{{ field.key }}_percent" value="{{ field.percent }}" inputmode="decimal" required {{ ui_field_attrs(props) }} {{ can_manage_settings ? '' : 'disabled' }}>{% endblock %}{% endembed %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: field.label ~ ': fixed amount (R)', for: 'setting-' ~ field.key ~ '-fixed', required: true})} %}{% block control %}<input id="setting-{{ field.key }}-fixed" name="{{ field.key }}_fixed" value="{{ field.fixed }}" inputmode="decimal" required {{ ui_field_attrs(props) }} {{ can_manage_settings ? '' : 'disabled' }}>{% endblock %}{% endembed %}
                {% elseif field.type == 'fee_tiers' %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: field.label ~ ': from amount (R) and fee (R)', for: 'setting-' ~ field.key ~ '-from-0', full_width: true, help: help ~ ' The fee of the highest tier an amount reaches applies. The first tier starts at R0. Leave unused rows empty.'})} %}{% block control %}
                        <div>{% for row in field.rows %}<div class="cl-row-inline"><input id="setting-{{ field.key }}-from-{{ loop.index0 }}" name="{{ field.key }}_from[]" value="{{ row.from }}" inputmode="decimal" aria-label="Tier {{ loop.index }}: from amount in rands" class="cl-input" {{ can_manage_settings ? '' : 'disabled' }}><input name="{{ field.key }}_fee[]" value="{{ row.fee }}" inputmode="decimal" aria-label="Tier {{ loop.index }}: fee in rands" class="cl-input" {{ can_manage_settings ? '' : 'disabled' }}></div>{% endfor %}</div>
                    {% endblock %}{% endembed %}
                {% else %}
                    {% embed ui_template('form.field') with {props: ui_props('form.field', {label: field.label, for: 'setting-' ~ field.key, required: true, help: help})} %}{% block control %}<input id="setting-{{ field.key }}" name="{{ field.key }}" value="{{ field.text }}" required {{ field.type == 'prefix' ? 'pattern="[A-Z]{1,3}" maxlength="3"' : 'maxlength="20"' }} {{ ui_field_attrs(props) }} {{ can_manage_settings ? '' : 'disabled' }}>{% endblock %}{% endembed %}
                {% endif %}
            {% endfor %}
            {% endblock %}{% endembed %}
            {% if can_manage_settings %}{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save ' ~ section.heading|replace({'Commerce: ': ''})|lower, variant: 'primary', size: 'normal', type: 'submit'}) }}{% endblock %}{% endembed %}{% endif %}
            </form>
            {% if can_manage_settings %}{% for field in fields[section.key] %}{% if field.source == 'database' %}
                <form action="/admin/settings/commerce/reset/{{ field.key }}" method="post" class="mt-3"><input type="hidden" name="csrf" value="{{ csrf }}">{{ ui('action.button', {label: 'Reset ' ~ field.label|lower ~ ' to the .env default', variant: 'secondary', size: 'small', type: 'submit'}) }}</form>
            {% endif %}{% endfor %}{% endif %}
        {% endblock %}{% endembed %}
        {% endfor %}
