{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Everyone on the platform', eyebrow: 'People', summary: 'People, roles, organisations and learner access.'}) }}

		{% embed ui_template('layout.toolbar') with {props: ui_props('layout.toolbar', {})} %}
{% block toolbar_primary %}

{% endblock %}
{% block toolbar_actions %}

			{% if can_manage_people %}
				{{ ui('action.button', {label: '＋ Add person', variant: 'primary', size: 'normal', type: 'button', modal: 'quickAddPersonModal', icon: 'action-add'}) }}
			{% endif %}

{% endblock %}
{% endembed %}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'people', pagination: people_pagination, search: {ds_name: 'people', ds_label: 'Search people', ds_value: people_search, ds_action: '/admin/people'}})} %}
{% block results %}

				{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

					<div>
						<strong>One complete profile:</strong> open any person to edit personal particulars, primary and secondary email addresses, company, roles, account status, sessions and learning information from the same screen.
					</div>

{% endblock %}
{% endembed %}

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% for sh in people_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: people_region, sort_results: people_results} %}
								{% endfor %}
							</tr>

{% endblock %}
{% block body %}

							{% for person in people %}
								<tr data-person-row>
									<td>
										<div class="person">
											<div class="avatar">
												U
											</div>
											<div>
												<strong title="{{ person.name }}">{{ person.name }}</strong>
												<div class="muted small" title="{{ person.email }}">
													{{ person.email }}
												</div>
											</div>
										</div>
									</td>
									<td>
										{{ person.company_name ?: '—' }}
									</td>
									<td>
										<div class="role-list">
											{% for role in person.roles %}
												{{ ui('feedback.badge', {label: (role), tone: 'info'}) }}
											{% endfor %}
										</div>
									</td>
									<td>
										{{ person.course_count }}
									</td>
									<td>
										{{ person.created_at }}
									</td>
									<td>
										{{ person.last_login_at ?: 'Never' }}
									</td>
									<td>
										{% embed ui_template('action.row') with {props: ui_props('action.row', {})} %}
{% block body %}

											{{ ui('action.link', {label: 'Edit', variant: 'primary', size: 'small', href: '/admin/people/' ~ (person.id), title: 'Open this person\'s full profile'}) }}

{% endblock %}
{% endembed %}
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

					{% if people_preview_has_more %}
						<div class="pagination-row">
							<span class="pagination-summary">Showing the first {{ preview_page_size }} people.</span>
							{{ ui('action.link', {label: 'View all people', variant: 'secondary', size: 'small', href: '/admin/people'}) }}
						</div>
					{% endif %}

{% endblock %}
{% endembed %}
		{% if can_manage_people %}
			{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'quickAddPersonModal', title: 'Add person', action: '/admin/people', method: 'post'})} %}
{% block modal_body %}

							<input type="hidden" name="csrf" value="{{ csrf }}">
							{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'First name', full_width: false, for: 'field-people-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

									<input name="first_name" required id="field-people-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Last name', full_width: false, for: 'field-people-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

									<input name="last_name" required id="field-people-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Email address', full_width: true, for: 'field-people-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

									<input type="email" name="email" required id="field-people-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
								{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Initial role', full_width: true, for: 'field-people-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), help: 'The person is initially added to the System Company. Open their full profile afterwards only if they belong to another company.'})} %}
{% block control %}

									<select name="role" id="field-people-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>
									{% for role in roles %}
										<option value="{{ role.role_key }}">{{ role.role_name }}</option>
									{% endfor %}
									</select>

{% endblock %}
{% endembed %}
								<div class="cl-ui-field--full">
									{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: 'Send plain account notification email'})} %}
{% block control %}
<input type="checkbox" name="send_notice" value="1" style="width:auto;margin-right:7px">
{% endblock %}
{% endembed %}
								</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% block modal_actions %}

							{{ ui('action.button', {label: 'Cancel', variant: 'quiet', size: 'normal', type: 'button', close_modal: true}) }}
							{{ ui('action.button', {label: 'Create person', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-add'}) }}

{% endblock %}
{% endembed %}
		{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
