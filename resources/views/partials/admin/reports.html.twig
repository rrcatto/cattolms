{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Reports', eyebrow: 'Course Performance', summary: 'Operational and learning results summarised into useful figures. Detailed event history belongs in Activity.'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
<div class="admin-reports-grid">
	{{ ui('data.stat-card', {value: (report_summary.enrolments), label: 'Total enrolments', note: (report_summary.active) ~ ' active · ' ~ (report_summary.completed) ~ ' completed'}) }}
	{{ ui('data.stat-card', {value: (report_summary.graded_assessments), label: 'Graded assessments', note: 'Completed learner attempts'}) }}
	{{ ui('data.stat-card', {value: (report_summary.assessment_pass_rate) ~ '%', label: 'Assessment pass rate', note: 'Average score ' ~ (report_summary.assessment_average) ~ '%'}) }}
	{{ ui('data.stat-card', {value: (report_summary.certificates), label: 'Certificates', note: 'Currently valid certificates'}) }}
</div>
{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

	{{ ui('layout.section-head', {heading: 'Course performance', summary: 'Enrolment, completion and result figures by course.'}) }}

	{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'course_report', pagination: course_report_pagination, search: {ds_name: 'course_report', ds_label: 'Search course performance', ds_value: course_report_search, ds_action: '/admin/reports'}})} %}
{% block results %}

			{% if course_report %}

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% for sh in course_report_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: course_report_region, sort_results: course_report_results} %}
								{% endfor %}
							</tr>

{% endblock %}
{% block body %}

							{% for row in course_report %}
								<tr>
									<td>
										<strong>{{ row.title }}</strong>
									</td>
									<td>
										{{ ui('feedback.badge', {label: (row.status), tone: 'info'}) }}
									</td>
									<td>
										{{ row.enrolments }}
									</td>
									<td>
										{{ row.started }}
									</td>
									<td>
										{{ row.completed }}
									</td>
									<td>
										{{ row.completion_rate }}%
									</td>
									<td>
										{{ row.average_result }}%
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

			{% else %}
				{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

					No courses match this search.

{% endblock %}
{% endembed %}
			{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
