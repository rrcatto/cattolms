    {% set section_html %}
    {# Identity verification (owner, 2026-10-19): through Didit's hosted page; the keys come from .env only. #}
    {% if identity_settings|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Identity verification', summary: identity_settings.available ? (identity_settings.key_kind == 'sandbox' ? 'Connected to Didit\'s sandbox.' : 'Connected to Didit.') : (identity_settings.sandbox_on_live ? 'Not available: a sandbox key on a live site.' : 'Not available: keys missing from .env.'), id: 'settings-identity-verification', open: settings_open_section|default('') == 'identity-verification'})} %}
{% block body %}

			<p>Learners verify on Didit's hosted page: they photograph their ID or passport and take a live selfie, and Didit matches them. This site keeps no images. Verification is needed only before a certificate and transcript are issued. Nothing is asked before a purchase.</p>
			{# Didit's keys say what they are (owner, 2026-11-06): sk_test_ is the sandbox, sk_live_ the live application. #}
			{% if identity_settings.sandbox_on_live %}
				{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger', heading: 'Identity verification is not available: this live site has a sandbox key.'})} %}{% block body %}<p>DIDIT_API_KEY starts with <span class="mono">sk_test_</span>, so it belongs to Didit's sandbox, whose checks are mocked and can be forced to pass. A live site needs the live key, which starts with <span class="mono">sk_live_</span>, with the live application's workflow and webhook secret. Until then certificates and transcripts wait. Verification is never skipped.</p>{% endblock %}{% endembed %}
			{% elseif identity_settings.available %}
				{{ ui('feedback.notice', {tone: 'success', heading: 'Didit is configured: DIDIT_API_KEY, DIDIT_WORKFLOW_ID and DIDIT_WEBHOOK_SECRET are in .env.'}) }}
				{% if identity_settings.key_kind == 'sandbox' %}
					{{ ui('feedback.notice', {tone: 'info', heading: 'This is Didit\'s sandbox: checks are mocked, nothing is billed, and you can choose the result. Learners are not really verified.'}) }}
				{% elseif identity_settings.key_kind == 'live' and identity_settings.demo_site %}
					{{ ui('feedback.notice', {tone: 'warning', heading: 'This demo site has Didit\'s live key: every check here is real and billed. For testing, use the sandbox key, which starts with sk_test_.'}) }}
				{% endif %}
			{% else %}
				{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Identity verification is not available.'})} %}{% block body %}<p>Add {{ identity_settings.missing_keys|join(', ') }} to <span class="mono">.env</span>. Until then certificates and transcripts wait. Verification is never skipped.</p>{% endblock %}{% endembed %}
			{% endif %}
			{{ ui('data.key-value-list', {items: [{label: 'Didit key', value: identity_settings.key_kind == 'sandbox' ? 'Sandbox (starts with sk_test_)' : (identity_settings.key_kind == 'live' ? 'Live (starts with sk_live_)' : (identity_settings.missing_keys is empty ? 'Not a key Didit\'s prefixes recognise' : 'Not set'))}, {label: 'Webhook address for the Didit console', value: identity_settings.webhook_url}]}) }}

{% endblock %}
{% endembed %}
    {% endif %}
