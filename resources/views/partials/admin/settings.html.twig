{# Each settings form saves independently; presentation uses the shared accordion pattern. #}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Platform settings', eyebrow: 'Settings', summary: 'Open a section to change its settings, then use that section’s save button.'}) }}

{% endblock %}
{% endembed %}
<div class="cl-admin-workspace">
    {% if site_mode|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Site mode', summary: site_mode.mode == 'live' ? 'Live: real orders.' : 'Demo: test and development, nothing real.', id: 'settings-site', open: settings_open_section|default('') == 'site'})} %}
{% block body %}

			<p>This site is {{ site_mode.mode == 'live' ? 'live' : 'a demo site' }}. {% if site_mode.source == 'database' %}This is saved here and overrides <span class="mono">APP_SITE_MODE</span>, which says {{ site_mode.environment }}.{% elseif site_mode.source == 'environment' %}<span class="mono">APP_SITE_MODE</span> in <span class="mono">.env</span> sets it.{% else %}<span class="mono">APP_SITE_MODE</span> is not set in <span class="mono">.env</span>, so it is a demo site.{% endif %}</p>
			<p>A demo site says so on every page and in every email, keeps out of search engines, marks every order and its documents as a simulation, shows fake bank details labelled as fake, and offers the simulated card. A live site does none of that: it offers only the payment methods ticked under Payment methods, and never the simulated card.</p>
			<form action="/admin/settings/site-mode" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Site mode', full_width: false, for: 'site-mode', required: true})} %}
{% block control %}
<select id="site-mode" name="site_mode" required {{ ui_field_attrs(props) }}>
	<option value="demo" {{ site_mode.mode == 'demo' ? 'selected' : '' }}>Demo: test and development, nothing real</option>
	<option value="live" {{ site_mode.mode == 'live' ? 'selected' : '' }}>Live: real orders</option>
</select>
{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Save site mode', variant: 'primary', size: 'normal', type: 'submit', confirm: 'Change the site mode? A live site takes real orders and real money.', icon: 'action-save-changes'}) }}
{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
			{% if site_mode.source == 'database' %}
			<form action="/admin/settings/site-mode/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Reset site mode to .env', variant: 'danger', size: 'small', confirm: 'Remove the saved site mode and follow APP_SITE_MODE in .env?', icon: 'action-reset'}) }}
			</form>
			{% endif %}

{% endblock %}
{% endembed %}
    {% endif %}
    {# Who can sign in (owner, 2026-10-21: "disallow all non-admin logins ... a whitelist of allowed emails"). #}
    {% if sign_in|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Who can sign in', summary: sign_in.restricted ? 'Administrators and the listed addresses only.' : 'Everyone.', id: 'settings-sign-in', open: settings_open_section|default('') == 'sign-in'})} %}
{% block body %}
			<p>Everyone, or administrators and the email addresses you list only. While it is limited, anyone else is refused when they sign in or register, and a session they already have stops working at once. A listed address needs no approval on a demo site: listing it is the approval.</p>
			{# Where it comes from, as Site mode says (owner, 2026-10-24): what is saved here overrides .env, and Reset returns to it. #}
			<p>{% if sign_in.source == 'database' %}This is saved here and overrides <span class="mono">AUTH_SIGNIN</span> and <span class="mono">AUTH_SIGNIN_ALLOWED_EMAILS</span> in <span class="mono">.env</span>, which say {{ sign_in.environment ? 'administrators and the listed addresses only' : 'everyone' }}{% if sign_in.environment and sign_in.environment_emails %}, listing {{ sign_in.environment_emails|join(', ') }}{% endif %}.{% elseif sign_in.source == 'environment' %}<span class="mono">AUTH_SIGNIN={{ sign_in.environment ? 'ADMIN' : 'EVERYONE' }}</span>{% if sign_in.environment %} and <span class="mono">AUTH_SIGNIN_ALLOWED_EMAILS</span>{% endif %} in <span class="mono">.env</span> set it.{% else %}<span class="mono">AUTH_SIGNIN</span> in <span class="mono">.env</span> is not ADMIN or EVERYONE (or is not there), so only administrators and the listed addresses can sign in.{% endif %}</p>
			<form action="/admin/settings/sign-in" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('form.picture-choice', {name: 'sign_in', legend: 'Who can sign in', id: 'sign-in-choice', size: 'small', selected: sign_in.restricted ? 'listed' : 'everyone', items: [
					{value: 'everyone', label: 'Everyone', icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20v-1a5.5 5.5 0 0 1 11 0v1"/><circle cx="17" cy="9" r="2.5"/><path d="M15.5 14.2A4.5 4.5 0 0 1 21.5 18.5v1.5"/></svg>', note: 'Anyone with an account, as normal.'},
					{value: 'listed', label: 'Administrators and the listed addresses', icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>', note: 'Everyone else is kept out.'}
				]}) }}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Allowed email addresses', for: 'allowed-emails', full_width: true, help: 'One a line. Used only while sign-in is limited to them.'})} %}
{% block control %}<textarea class="cl-input" id="allowed-emails" name="allowed_emails" rows="6" {{ ui_field_attrs(props) }}>{{ sign_in.emails }}</textarea>{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}{{ ui('action.button', {label: 'Save who can sign in', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}{% endblock %}
{% endembed %}
			</form>
			{% if sign_in.source == 'database' %}
			<form action="/admin/settings/sign-in/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Reset who can sign in to .env', variant: 'danger', size: 'small', confirm: 'Remove what is saved here and follow AUTH_SIGNIN and AUTH_SIGNIN_ALLOWED_EMAILS in .env?', icon: 'action-reset'}) }}
			</form>
			{% endif %}
{% endblock %}
{% endembed %}
    {% endif %}
    {# Mailing (owner, 2026-10-26): how news is sent, through what, and the sending discipline. #}
    {# Sign-up checks (owner, 2026-10-26): the countries registrations are judged by, and what the check reads. #}
    {% if signup_checks|default(null) %}
    {% set sc = signup_checks %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Sign-up checks', summary: 'Allowed: ' ~ sc.allowed_names ~ '. Blocked: ' ~ (sc.blocked_count == 0 ? 'none' : (sc.blocked_count == 1 ? '1 country' : sc.blocked_count ~ ' countries')) ~ '.', id: 'settings-signup-checks', open: settings_open_section|default('') == 'signup-checks'})} %}
{% block body %}
			<p>Every registration is checked: where it comes from, its network, its email address, its browser and how the form was filled in. Each attempt is listed at People &amp; Companies, Sign-up Attempts, with its risk.</p>
			<p>The countries are those of the visitor's IP address. A registration from a blocked country may register like anyone else and is held for your approval without being told why, and is marked high risk. One from outside the allowed countries is a warning sign on Sign-up Attempts, not a hold: someone abroad who lives in South Africa may register. On a live site a high-risk registration is held too. A throwaway email address is refused.</p>
			<p>{% if sc.source == 'database' %}These lists are saved here and override <span class="mono">SIGNUP_ALLOWED_COUNTRIES</span> and <span class="mono">SIGNUP_BLOCKED_COUNTRIES</span> in <span class="mono">.env</span>, which say: {{ sc.environment }}.{% else %}These lists come from <span class="mono">SIGNUP_ALLOWED_COUNTRIES</span> and <span class="mono">SIGNUP_BLOCKED_COUNTRIES</span> in <span class="mono">.env</span>. Saving them here overrides <span class="mono">.env</span>.{% endif %}</p>
			<form action="/admin/settings/signup-checks" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Allowed countries', for: 'allowed-countries', full_width: true, help: 'Two-letter country codes separated by commas, such as ZA. Empty allows every country. Now: ' ~ sc.allowed_names ~ '.'})} %}
{% block control %}<input class="cl-input" id="allowed-countries" name="allowed_countries" value="{{ sc.allowed }}" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Blocked countries', for: 'blocked-countries', full_width: true, help: 'Two-letter country codes separated by commas. Now: ' ~ sc.blocked_names ~ '.'})} %}
{% block control %}<textarea class="cl-input" id="blocked-countries" name="blocked_countries" rows="3" {{ ui_field_attrs(props) }}>{{ sc.blocked }}</textarea>{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}{{ ui('action.button', {label: 'Save the country lists', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}{% endblock %}
{% endembed %}
			</form>
			{% if sc.source == 'database' %}
			<form action="/admin/settings/signup-checks/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Reset the country lists to .env', variant: 'danger', size: 'small', confirm: 'Remove the lists saved here and follow SIGNUP_ALLOWED_COUNTRIES and SIGNUP_BLOCKED_COUNTRIES in .env?', icon: 'action-reset'}) }}
			</form>
			{% endif %}
			<h3 class="h5 cl-mt-3">What the check reads</h3>
			{% set sc_items = [
				{label: 'Country database (GeoLite2)', value: sc.geo ? 'Present' : 'Missing: set GEOIP_DATABASE in .env to a GeoLite2 City or Country database'},
				{label: 'Network database (GeoLite2 ASN)', value: sc.network ? 'Present' : 'Missing: put GeoLite2-ASN.mmdb beside the country database'}
			] %}
			{% for list in sc.lists %}{% set sc_items = sc_items|merge([{label: list.label, value: list.entries ~ ' entries, fetched ' ~ list.fetched}]) %}{% endfor %}
			{{ ui('data.key-value-list', {items: sc_items}) }}
			<form action="/admin/settings/signup-checks/lists" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Fetch the lists now', variant: 'secondary', size: 'small', type: 'submit', icon: 'action-refresh'}) }}
			</form>
			<p class="small cl-text-secondary">The scheduler fetches the Tor list every day and the others every week.</p>
{% endblock %}
{% endembed %}
    {% endif %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Platform identity', summary: 'The platform name.', id: 'settings-identity', open: settings_open_section|default('') == 'identity'})} %}
{% block body %}

		<form action="/admin/settings" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Platform name', full_width: true, for: 'field-settings-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="platform_name" value="{{ platform_name }}" id="field-settings-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% block help_content %}

					{{ ui('feedback.badge', {label: (platform_name_source=='database' ? 'Database override' : '.env default'), tone: 'info', size: 'small'}) }} Overrides <span class="mono">APP_NAME</span>. The same effective name is used by the web interface, API and outgoing email.

{% endblock %}
{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

				{{ ui('action.button', {label: 'Save platform identity', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
		{% if platform_name_source=='database' %}
			<form action="/admin/settings/platform-name/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Use APP_NAME from .env', variant: 'quiet', size: 'small', type: 'submit', icon: 'action-reset'}) }}
			</form>
		{% endif %}

{% endblock %}
{% endembed %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'SMTP / outgoing email', summary: 'Mail server and sender details.', id: 'settings-mail', open: settings_open_section|default('') == 'mail'})} %}
{% block body %}

		{% if mail_settings.mail_configuration_error %}
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', section_spacing: false})} %}
{% block body %}

				<strong>Mail configuration needs attention.</strong> {{ mail_settings.mail_configuration_error }}

{% endblock %}
{% endembed %}
		{% endif %}
		<form action="/admin/settings/mail" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Connection type', full_width: false, for: 'field-settings-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<select name="smtp_scheme" id="field-settings-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="smtp" {{ mail_settings.smtp_scheme=='smtp' ? 'selected' : '' }}>SMTP / STARTTLS</option><option value="smtps" {{ mail_settings.smtp_scheme=='smtps' ? 'selected' : '' }}>SMTP over TLS</option></select>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'SMTP port', full_width: false, for: 'field-settings-5-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

				<input type="number" min="1" max="65535" name="smtp_port" value="{{ mail_settings.smtp_port }}" required id="field-settings-5-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'SMTP server', full_width: true, for: 'field-settings-6-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

				<input name="smtp_host" value="{{ mail_settings.smtp_host }}" placeholder="smtp.example.com" required id="field-settings-6-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'SMTP username', full_width: true, for: 'field-settings-7-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="smtp_username" value="{{ mail_settings.smtp_username }}" autocomplete="off" id="field-settings-7-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'SMTP password', full_width: true, for: 'field-settings-8-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<div class="cl-password-control"><input type="password" name="smtp_password" value="" autocomplete="new-password" id="field-settings-8-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>{{ ui('action.button', {label: 'Show', type: 'button', variant: 'quiet', id: 'smtp-password-toggle', disabled: true, hidden: true, icon: 'action-view'}) }}</div>

{% endblock %}
{% block help_content %}

					{{ mail_settings.smtp_password_configured ? 'A password is configured. Leave this blank to keep it.' : 'No SMTP password is currently configured.' }} Passwords saved here are encrypted using <span class="mono">APP_KEY</span>.

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'From address', full_width: true, for: 'field-settings-9-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), required: true})} %}
{% block control %}

				<input type="email" name="mail_from_address" value="{{ mail_settings.mail_from_address }}" required id="field-settings-9-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'From name', full_width: true, for: 'field-settings-10-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), help: 'Leave blank to use the effective Platform name.'})} %}
{% block control %}

				<input name="mail_from_name" value="{{ mail_settings.mail_from_name }}" id="field-settings-10-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Reply-to address', full_width: true, for: 'field-settings-11-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0)), help: 'Optional. Leave blank to receive replies at the From address.'})} %}
{% block control %}

				<input type="email" name="mail_reply_to" value="{{ mail_settings.mail_reply_to }}" id="field-settings-11-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Advanced SMTP DSN options'})} %}
{% block body %}
{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Query options', for: 'smtp-query', help: 'Normally leave this unchanged. Optional Symfony Mailer DSN query parameters.'})} %}
{% block control %}
<input id="smtp-query" name="smtp_query" value="{{ mail_settings.smtp_query }}" placeholder="require_tls=true" {{ ui_field_attrs(props) }}>
{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

				{{ ui('action.button', {label: 'Save SMTP settings', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
		<div class="cl-row-wrap cl-mt-2">
			<form action="/admin/mail/test" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Send test email', variant: 'quiet', size: 'small', icon: 'action-email'}) }}
			</form>
			{% if mail_settings.mail_override_active %}
				<form action="/admin/settings/mail/reset" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					{{ ui('action.button', {label: 'Reset mail settings to .env', variant: 'danger', size: 'small', confirm: 'Discard the database mail override and return to .env mail settings?', icon: 'action-reset'}) }}
				</form>
			{% endif %}
		</div>

{% endblock %}
{% endembed %}
    {# The Site Owner (owner, 2026-10-18): the business hosting the site, which the legal pages, financial
       documents, certificates and EFT instructions name. Each detail has a .env default; a value saved here
       replaces it until Reset. Every change is in the Activity log with its old and new value. #}
    {% if site_owner|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Site Owner', summary: 'The business hosting the site, and its bank account for EFT payments.', id: 'settings-site-owner', open: settings_open_section|default('') == 'site-owner'})} %}
{% block body %}

			<p>The legal pages, invoices, receipts, credit notes, certificates and EFT instructions name the Site Owner. A course no company owns is the Site Owner's. Nobody belongs to it: ADMIN acts for it. A document keeps the details it was issued with, and an order those its buyer accepted.</p>
			<form action="/admin/settings/site-owner" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% for key, field in site_owner.fields %}
					{% set help = field.source == 'database' ? 'Set here. .env (' ~ field.env ~ ') says: ' ~ (field.environment ?: 'nothing') ~ '.' : 'From .env (' ~ field.env ~ ').' %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: field.label, for: 'site-owner-' ~ key, full_width: key in ['address', 'memberships', 'accreditation'], required: key in ['trading_name', 'legal_name', 'legal_form'], help: help})} %}
{% block control %}
{% if key == 'legal_form' %}<select id="site-owner-{{ key }}" name="{{ key }}" required {{ ui_field_attrs(props) }}>{% for value, label in site_owner.legal_forms %}<option value="{{ value }}" {{ field.value == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>{% elseif key in ['address', 'memberships', 'accreditation'] %}<textarea id="site-owner-{{ key }}" name="{{ key }}" rows="3" {{ ui_field_attrs(props) }}>{{ field.value }}</textarea>{% else %}<input id="site-owner-{{ key }}" name="{{ key }}" value="{{ field.value }}" {{ key in ['trading_name', 'legal_name'] ? 'required' : '' }}{{ key == 'email' ? ' type=email' : '' }}{{ key == 'bank_account_number' ? ' inputmode=numeric pattern=[0-9]{1,34}' : '' }}{{ key == 'bank_branch_code' ? ' inputmode=numeric pattern=[0-9]{6}' : '' }} {{ ui_field_attrs(props) }}>{% endif %}
{% endblock %}
{% endembed %}
				{% endfor %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Save Site Owner details', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}
{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
			{% if site_owner.overridden %}
			<form action="/admin/settings/site-owner/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Reset Site Owner details to .env', variant: 'danger', size: 'small', confirm: 'Remove every saved Site Owner detail and follow .env?', icon: 'action-reset'}) }}
			</form>
			{% endif %}

{% endblock %}
{% endembed %}
    {% endif %}
    {# Payment methods (owner, 2026-10-19): one tick box per method; a method can be ticked only when it is configured. #}
    {% if payment_methods|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Payment methods', summary: 'What checkout offers. The wallet is always available to spend.', id: 'settings-payment-methods', open: settings_open_section|default('') == 'payment-methods'})} %}
{% block body %}

			<p>Checkout offers only the ticked methods, each named with its provider. No method collects card details on this site: a card is paid on the provider's own page. Wallet credit is not a payment method here: it can always be spent. Every change is recorded in the Activity log.</p>
			<form action="/admin/settings/payment-methods" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% for method in payment_methods %}
					{% embed ui_template('form.choice') with {props: ui_props('form.choice', {label: method.label ~ (method.problem ? ' (cannot be ticked: ' ~ method.problem ~ ')' : '')})} %}{% block control %}<input type="checkbox" name="methods[]" value="{{ method.key }}" {{ method.ticked ? 'checked' : '' }} {{ method.problem ? 'disabled' : '' }} data-payment-method="{{ method.key }}">{% endblock %}{% endembed %}
				{% endfor %}
				{% if can_manage_settings|default(false) %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save payment methods', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}{% endblock %}{% endembed %}
				{% endif %}
			</form>

{% endblock %}
{% endembed %}
    {% endif %}
    {# Identity verification (owner, 2026-10-19): through Didit's hosted page; the keys come from .env only. #}
    {% if identity_settings|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Identity verification', summary: identity_settings.available ? 'Connected to Didit.' : 'Not available: keys missing from .env.', id: 'settings-identity-verification', open: settings_open_section|default('') == 'identity-verification'})} %}
{% block body %}

			<p>Learners verify on Didit's hosted page: they photograph their ID or passport and take a live selfie, and Didit matches them. This site keeps no images. Verification is needed only before a certificate and transcript are issued. Nothing is asked before a purchase.</p>
			{% if identity_settings.available %}
				{{ ui('feedback.notice', {tone: 'success', heading: 'Didit is configured: DIDIT_API_KEY, DIDIT_WORKFLOW_ID and DIDIT_WEBHOOK_SECRET are in .env.'}) }}
			{% else %}
				{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Identity verification is not available.'})} %}{% block body %}<p>Add {{ identity_settings.missing_keys|join(', ') }} to <span class="mono">.env</span>. Until then certificates and transcripts wait. Verification is never skipped.</p>{% endblock %}{% endembed %}
			{% endif %}
			{{ ui('data.key-value-list', {items: [{label: 'Webhook address for the Didit console', value: identity_settings.webhook_url}]}) }}

{% endblock %}
{% endembed %}
    {% endif %}
