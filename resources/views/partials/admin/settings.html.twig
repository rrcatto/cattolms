    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Maintenance', summary: 'The scheduled jobs, and expired login and session records.', id: 'settings-maintenance', open: settings_open_section|default('') == 'maintenance'})} %}
{% block body %}

		{# The scheduled jobs (owner, 2026-10-19): schedule:run runs them and records each run. #}
		{% if scheduled_jobs|default(null) %}
		<h3 class="h5">Scheduled jobs</h3>
		<p>One scheduler, <span class="mono">schedule:run</span>, runs these on this installation (see <span class="mono">docs/OPERATIONS.md</span>, Scheduled work).</p>
		{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}
			{% for job in scheduled_jobs %}
			{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}
					<strong>{{ job.label }}</strong>
					<p>{{ job.description }}</p>
					<p>Last run: {{ job.last_run }}. Last success: {{ job.last_success }}.{% if job.last_failure %} Failed at {{ job.last_failure }}: {{ job.error }}{% elseif job.summary %} {{ job.summary }}{% endif %}</p>
{% endblock %}
{% block actions %}
				{{ ui('feedback.badge', {label: job.overdue ? 'Not running' : 'Running', tone: job.overdue ? 'danger' : 'success'}) }}
{% endblock %}
{% endembed %}
			{% endfor %}
{% endblock %}
{% endembed %}
		{% endif %}
		{# The application log and its archives (owner, 2026-10-27: "I don't want to burn space on keeping unnecessary logs"). #}
		{% if log_archive|default(null) %}
		{% set la = log_archive %}
		<h3 class="h5 mt-7">The application log</h3>
		<p>Every request and error is written to the application log. Just after midnight each day the Log archive job moves it, and any other log beside it, into the archive folder, compressed, and starts each afresh, then deletes the archives older than {{ la.keep_words }}.</p>
		{% set la_items = [{label: 'The log', value: la.log ~ ' (' ~ la.log_size ~ ')'}] %}
		{% for other in la.others %}{% set la_items = la_items|merge([{label: 'Beside it', value: other.path ~ ' (' ~ other.size ~ ')'}]) %}{% endfor %}
		{{ ui('data.key-value-list', {items: la_items|merge([
			{label: 'Its archives', value: la.folder},
			{label: 'Archives kept', value: la.archives == 0 ? 'None yet' : (la.archives == 1 ? '1 archive, ' ~ la.archive_size ~ ': ' ~ la.newest : la.archives ~ ' archives, ' ~ la.archive_size ~ ', from ' ~ la.oldest ~ ' to ' ~ la.newest)}
		])}) }}
		<p>{% if la.source == 'database' %}This period is saved here and overrides <span class="mono">LOG_ARCHIVES_KEPT_FOR</span> in <span class="mono">.env</span>, which says {{ la.environment }}.{% else %}This period comes from <span class="mono">LOG_ARCHIVES_KEPT_FOR</span> in <span class="mono">.env</span>. Saving it here overrides <span class="mono">.env</span>.{% endif %}</p>
		<form action="/admin/settings/log-archives" method="post">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Keep the log archives for', for: 'log-archives-keep', help: la.how ~ ' At least a day.'})} %}
{% block control %}<input class="cl-input" id="log-archives-keep" name="keep" value="{{ la.keep }}" required {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}{{ ui('action.button', {label: 'Save how long archives are kept', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}{% endblock %}
{% endembed %}
		</form>
		{% if la.source == 'database' %}
		<form action="/admin/settings/log-archives/reset" method="post" class="cl-mt-2">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			{{ ui('action.button', {label: 'Reset how long archives are kept to .env', variant: 'danger', size: 'small', confirm: 'Remove the period saved here and follow LOG_ARCHIVES_KEPT_FOR in .env?', icon: 'action-reset'}) }}
		</form>
		{% endif %}
		{% endif %}
		{% if scheduled_jobs|default(null) %}
		<h3 class="h5 mt-7">Expired records</h3>
		{% endif %}

		{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

			{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

					<strong>Expired login links</strong>
					<p>
						{{ maintenance.login_tokens }} passwordless login links are past their validity period.
					</p>

{% endblock %}
{% block actions %}

				{{ ui('feedback.badge', {label: (maintenance.login_tokens), tone: 'info'}) }}

{% endblock %}
{% endembed %}
			{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

					<strong>Expired authentication sessions</strong>
					<p>
						{{ maintenance.auth_sessions }} authentication sessions can no longer be used.
					</p>

{% endblock %}
{% block actions %}

				{{ ui('feedback.badge', {label: (maintenance.auth_sessions), tone: 'info'}) }}

{% endblock %}
{% endembed %}
			{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

					<strong>Expired web sessions</strong>
					<p>
						{{ maintenance.web_sessions }} browser sessions have expired.
					</p>

{% endblock %}
{% block actions %}

				{{ ui('feedback.badge', {label: (maintenance.web_sessions), tone: 'info'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
