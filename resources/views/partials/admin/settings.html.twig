    {% set section_html %}
    {# Messages to you (owner, 2026-11-05: "yes telegram, paid orders only"): a message to the owner's phone by Telegram. The key is never shown back. #}
    {% if owner_messages|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Messages to you', summary: owner_messages.title, summary_tone: owner_messages.title_tone, id: 'settings-owner-messages', open: settings_open_section|default('') == 'owner-messages'})} %}
{% block body %}

			{% set om = owner_messages %}
