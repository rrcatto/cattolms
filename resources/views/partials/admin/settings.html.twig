{# Each settings form saves independently; presentation uses the shared accordion pattern. #}
<div class="cl-admin-workspace">
    {#
        Every section is drawn into settings_sections under its name, then they are drawn in the order the owner arranged
        (owner, 2026-11-09: "Is it possible for me to be able to drag and drop the settings accordions into the order I wish
        them to display?", then "yes"; Configuration\SettingsOrder, settings_order). Whoever may change settings drags a
        section by its handle, moves it from the keyboard on the handle, or uses its menu, which works without JavaScript
        (settings_order_controller.js); a move puts the sections in their new order and draws nothing again, so what is
        open and what is typed stay as they are.
    #}
    {# Stimulus, once for the page: the sections' order and the site logo's editor. #}
    {{ importmap() }}
    {% set settings_sections = {} %}
    {% set section_html %}
    {% if site_mode|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Site mode', summary: site_mode.mode == 'live' ? 'Live: real orders.' : 'Demo: test and development, nothing real.', id: 'settings-site', open: settings_open_section|default('') == 'site'})} %}
{% block body %}

			<p>This site is {{ site_mode.mode == 'live' ? 'live' : 'a demo site' }}. {% if site_mode.source == 'database' %}This is saved here and overrides <span class="mono">APP_SITE_MODE</span>, which says {{ site_mode.environment }}.{% elseif site_mode.source == 'environment' %}<span class="mono">APP_SITE_MODE</span> in <span class="mono">.env</span> sets it.{% else %}<span class="mono">APP_SITE_MODE</span> is not set in <span class="mono">.env</span>, so it is a demo site.{% endif %}</p>
			<p>A demo site says so on every page and in every email, keeps out of search engines, marks every order and its documents as a simulation, shows fake bank details labelled as fake, and offers the simulated card. A live site does none of that: it offers only the payment methods ticked under Payment methods, and never the simulated card.</p>
			<form action="/admin/settings/site-mode" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Site mode', full_width: false, for: 'site-mode', required: true})} %}
{% block control %}
<select id="site-mode" name="site_mode" required {{ ui_field_attrs(props) }}>
	<option value="demo" {{ site_mode.mode == 'demo' ? 'selected' : '' }}>Demo: test and development, nothing real</option>
	<option value="live" {{ site_mode.mode == 'live' ? 'selected' : '' }}>Live: real orders</option>
</select>
{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Save site mode', variant: 'primary', size: 'normal', type: 'submit', confirm: 'Change the site mode? A live site takes real orders and real money.', icon: 'action-save-changes'}) }}
{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
			{% if site_mode.source == 'database' %}
			<form action="/admin/settings/site-mode/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Reset site mode to .env', variant: 'danger', size: 'small', confirm: 'Remove the saved site mode and follow APP_SITE_MODE in .env?', icon: 'action-reset'}) }}
			</form>
			{% endif %}
			<form action="/admin/settings/demo-words" method="post" class="cl-mt-3">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Heading of the demo notice', full_width: true, for: 'demo-heading', required: true, help: 'Above the notice at the top of every page. Up to ' ~ site_mode.limits.heading ~ ' characters.'})} %}
{% block control %}<input class="cl-input" type="text" id="demo-heading" name="demo_heading" value="{{ site_mode.heading }}" maxlength="{{ site_mode.limits.heading }}" required {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Demo notice', full_width: true, for: 'demo-notice', required: true, help: 'At the top of every page and on the legal PDFs. Plain text, up to ' ~ site_mode.limits.notice ~ ' characters.'})} %}
{% block control %}<textarea class="cl-input" id="demo-notice" name="demo_notice" rows="3" maxlength="{{ site_mode.limits.notice }}" required {{ ui_field_attrs(props) }}>{{ site_mode.notice }}</textarea>{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Email message', full_width: true, for: 'demo-email-notice', required: true, help: 'The first line of every email the site sends. Plain text, up to ' ~ site_mode.limits.email_notice ~ ' characters. The subject still starts with [DEMO].'})} %}
{% block control %}<textarea class="cl-input" id="demo-email-notice" name="demo_email_notice" rows="3" maxlength="{{ site_mode.limits.email_notice }}" required {{ ui_field_attrs(props) }}>{{ site_mode.email_notice }}</textarea>{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Checkout message', full_width: true, for: 'demo-simulation', required: true, help: 'At checkout, on the order and on invoices, receipts and credit notes issued from now on. One already issued keeps its words. Plain text, up to ' ~ site_mode.limits.simulation ~ ' characters.'})} %}
{% block control %}<textarea class="cl-input" id="demo-simulation" name="demo_simulation" rows="3" maxlength="{{ site_mode.limits.simulation }}" required {{ ui_field_attrs(props) }}>{{ site_mode.simulation }}</textarea>{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Save demo messages', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}
{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
			{% if site_mode.own_words %}
			<form action="/admin/settings/demo-words/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Back to the standard words', variant: 'danger', size: 'small', confirm: 'Remove your words for all four demo messages?', icon: 'action-reset'}) }}
			</form>
			{% endif %}

{% endblock %}
{% endembed %}
    {% endif %}
    {% endset %}{% set settings_sections = settings_sections|merge({'site-mode': section_html}) %}
    {% set section_html %}
    {# The site notification (owner, 2026-11-05: a promotion, or a warning that the site is going offline, with a countdown if wanted). #}
    {% if site_notification|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Site notification', summary: site_notification.showing ? (site_notification.on_course_pages ? 'Showing, also while taking a course.' : 'Showing, except while taking a course.') : (site_notification.ended ? 'Its countdown has ended, so it is not showing.' : 'Not showing.'), id: 'settings-site-notification', open: settings_open_section|default('') == 'site-notification'})} %}
{% block body %}

			<p>A message at the top of the site's pages, under the demo notice, for everyone who visits: a promotion, or a warning that the site is going offline. It shows on a demo site and a live one.</p>
			{% if can_manage_settings|default(false) %}
			{% set icon_attributes = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' %}
			<form action="/admin/settings/site-notification" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% set notification_ticks = (site_notification.show ? ['show'] : [])|merge(site_notification.on_course_pages ? ['on_course_pages'] : []) %}
				{{ ui('form.picture-choice', {multiple: true, legend: 'Show it', id: 'site-notification-show', size: 'small', selected: notification_ticks, items: [
					{value: 'show', label: 'Show this notification', icon: '<svg ' ~ icon_attributes ~ '><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>', note: 'At the top of the site\'s pages, for everyone. Untick it to hide the notification and keep its words.'},
					{value: 'on_course_pages', label: 'Also while taking a course', icon: '<svg ' ~ icon_attributes ~ '><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/></svg>', note: 'On the lessons and assessments too. Leave it off for a promotion, and tick it for a warning learners need to see, such as the site going offline.'},
				]}) }}
				{# Each card is drawn in the colour of what it chooses, with its icon, and the real thing is shown under them. #}
				{{ ui('form.picture-choice', {name: 'kind', legend: 'Kind of message', id: 'site-notification-kind', size: 'small', selected: site_notification.kind, items: [
					{value: 'promotion', label: 'Promotion', icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4" fill="#166534"/><g transform="translate(4.8 4.8) scale(.6)" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 6a13 13 0 0 0 8.4-2.8A1 1 0 0 1 21 4v12a1 1 0 0 1-1.6.8A13 13 0 0 0 11 14H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/><path d="M6 14a12 12 0 0 0 2.4 7.2 2 2 0 0 0 3.2-2.4A8 8 0 0 1 10 14"/><path d="M8 6v8"/></g></svg>', note: 'Green, with a megaphone. For an offer or good news.'},
					{value: 'information', label: 'Information', icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4" fill="#1e4e8c"/><g transform="translate(4.8 4.8) scale(.6)" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></g></svg>', note: 'Blue, with an information sign. For something people should know.'},
					{value: 'warning', label: 'Warning', icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4" fill="#f5b301"/><g transform="translate(4.8 4.8) scale(.6)" fill="none" stroke="#231700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></g></svg>', note: 'Amber, with a warning triangle. For the site going offline, or anything urgent.'},
				]}) }}
				<div class="cl-site-notification-samples" data-site-notification-samples>
					<p class="cl-site-notification-samples-label">How each one looks at the top of a page</p>
					{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'success', heading: 'Promotion', solid: true, icon: 'notice-promotion'})} %}{% block body %}An offer or good news looks like this.{% endblock %}{% endembed %}
					{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', heading: 'Information', solid: true, icon: 'notice-information'})} %}{% block body %}Something people should know looks like this.{% endblock %}{% endembed %}
					{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Warning', solid: true, icon: 'notice-warning'})} %}{% block body %}Anything urgent looks like this.{% endblock %}{% endembed %}
				</div>
				{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Heading (optional)', full_width: true, for: 'site-notification-heading', help: 'Above the message. Up to ' ~ site_notification.limits.heading ~ ' characters.'})} %}
{% block control %}<input class="cl-input" type="text" id="site-notification-heading" name="heading" value="{{ site_notification.heading }}" maxlength="{{ site_notification.limits.heading }}" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Message', full_width: true, for: 'site-notification-message', help: 'Plain text, up to ' ~ site_notification.limits.message ~ ' characters.'})} %}
{% block control %}<textarea class="cl-input" id="site-notification-message" name="message" rows="3" maxlength="{{ site_notification.limits.message }}" {{ ui_field_attrs(props) }}>{{ site_notification.message }}</textarea>{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Count down to (optional)', for: 'site-notification-ends', help: 'In the site\'s time (' ~ site_notification.zone ~ '). The count shows weeks, days, hours, minutes and seconds, and the notification goes away by itself when it reaches zero. Leave it empty for no countdown.'})} %}
{% block control %}<input class="cl-input" type="datetime-local" id="site-notification-ends" name="ends_at" value="{{ site_notification.ends_at_local }}" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Words before the countdown (optional)', for: 'site-notification-words', help: 'For example, Offer ends in, or The site goes offline in. Left empty, it says ' ~ site_notification.standard_words ~ ' Up to ' ~ site_notification.limits.countdown_words ~ ' characters.'})} %}
{% block control %}<input class="cl-input" type="text" id="site-notification-words" name="countdown_words" value="{{ site_notification.countdown_words }}" maxlength="{{ site_notification.limits.countdown_words }}" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}{% block primary_actions %}{{ ui('action.button', {label: 'Save site notification', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}{% endblock %}{% endembed %}
			</form>
			{% if site_notification.exists %}
			<form action="/admin/settings/site-notification/remove" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Remove the notification', variant: 'danger', size: 'small', confirm: 'Remove the site notification and its words?', icon: 'action-remove'}) }}
			</form>
			{% endif %}
			{% endif %}

{% endblock %}
{% endembed %}
    {% endif %}
    {% endset %}{% set settings_sections = settings_sections|merge({'site-notification': section_html}) %}
    {% set section_html %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Platform identity', summary: 'The platform name.', id: 'settings-identity', open: settings_open_section|default('') == 'identity'})} %}
{% block body %}

		<form action="/admin/settings" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Platform name', full_width: true, for: 'field-settings-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="platform_name" value="{{ platform_name }}" id="field-settings-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% block help_content %}

					{{ ui('feedback.badge', {label: (platform_name_source=='database' ? 'Database override' : '.env default'), tone: 'info', size: 'small'}) }} Overrides <span class="mono">APP_NAME</span>. The same effective name is used by the web interface, API and outgoing email.

{% endblock %}
{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

				{{ ui('action.button', {label: 'Save platform identity', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
		{% if platform_name_source=='database' %}
			<form action="/admin/settings/platform-name/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Use APP_NAME from .env', variant: 'quiet', size: 'small', type: 'submit', icon: 'action-reset'}) }}
			</form>
		{% endif %}

{% endblock %}
{% endembed %}
    {% endset %}{% set settings_sections = settings_sections|merge({'identity': section_html}) %}
    {% set section_html %}
    {# The Site Owner (owner, 2026-10-18): the business hosting the site, which the legal pages, financial
       documents, certificates and EFT instructions name. Each detail has a .env default; a value saved here
       replaces it until Reset. Every change is in the Activity log with its old and new value. #}
    {% if site_owner|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Site Owner', summary: 'The business hosting the site, its logo, and its bank account for EFT payments.', picture: site_owner.logo.url ?: '', id: 'settings-site-owner', open: settings_open_section|default('') == 'site-owner'})} %}
{% block body %}

			<p>The legal pages, invoices, receipts, credit notes, certificates and EFT instructions name the Site Owner. A course no company owns is the Site Owner's. Nobody belongs to it: ADMIN acts for it. A document keeps the details it was issued with, and an order those its buyer accepted.</p>
			<form action="/admin/settings/site-owner" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% for key, field in site_owner.fields %}
					{% set help = field.source == 'database' ? 'Set here. .env (' ~ field.env ~ ') says: ' ~ (field.environment ?: 'nothing') ~ '.' : 'From .env (' ~ field.env ~ ').' %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: field.label, for: 'site-owner-' ~ key, full_width: key in ['address', 'memberships', 'accreditation'], required: key in ['trading_name', 'legal_name', 'legal_form'], help: help})} %}
{% block control %}
{% if key == 'legal_form' %}<select id="site-owner-{{ key }}" name="{{ key }}" required {{ ui_field_attrs(props) }}>{% for value, label in site_owner.legal_forms %}<option value="{{ value }}" {{ field.value == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>{% elseif key in ['address', 'memberships', 'accreditation'] %}<textarea id="site-owner-{{ key }}" name="{{ key }}" rows="3" {{ ui_field_attrs(props) }}>{{ field.value }}</textarea>{% else %}<input id="site-owner-{{ key }}" name="{{ key }}" value="{{ field.value }}" {{ key in ['trading_name', 'legal_name'] ? 'required' : '' }}{{ key == 'email' ? ' type=email' : '' }}{{ key == 'bank_account_number' ? ' inputmode=numeric pattern=[0-9]{1,34}' : '' }}{{ key == 'bank_branch_code' ? ' inputmode=numeric pattern=[0-9]{6}' : '' }} {{ ui_field_attrs(props) }}>{% endif %}
{% endblock %}
{% endembed %}
				{% endfor %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Save Site Owner details', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}
{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
			{% if site_owner.overridden %}
			<form action="/admin/settings/site-owner/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Reset Site Owner details to .env', variant: 'danger', size: 'small', confirm: 'Remove every saved Site Owner detail and follow .env?', icon: 'action-reset'}) }}
			</form>
			{% endif %}
			{# The site logo (owner, 2026-11-09: "this should appear on PDFs the site generates"), on its own form: every PDF
			   prints it, invoices, receipts, credit notes and certificates unless their design chooses another logo or none,
			   and an email template shows it when it chooses the site logo. #}
			<div class="cl-site-logo" id="settings-site-logo">
				<h3 class="h5">Site logo</h3>
				<p class="help">Your business's logo, in the top bar of every page. Every PDF the site makes prints it at the top: invoices, receipts, credit notes and certificates unless their design chooses another logo or none, and the money reports, ledger, wallet statements, legal pages and course PDFs. An email shows it when its template chooses the site logo (Mailing, Templates). Documents already issued keep the logo they had.</p>
				{# The same controls as a profile picture (owner, 2026-11-09): turn it, size it, drag it, see it before it is saved;
				   the frame is the logo's own shape (profile_image_controller.js, frame 'picture'). Without JavaScript the file is
				   sent as it is. #}
				<div class="cl-profile-image-panel cl-site-logo-panel" {{ stimulus_controller('profile-image', {frame: 'picture', maxWidth: 1200, maxHeight: 600}) }}>
					<div class="cl-profile-image-current cl-site-logo-current" {{ stimulus_target('profile-image', 'placeholder') }}>
						{% if site_owner.logo.url %}
							<img class="cl-site-logo-preview" src="{{ site_owner.logo.url }}" alt="The site logo now">
						{% else %}
							<div class="cl-site-logo-preview cl-site-logo-empty"><span>No logo yet</span></div>
						{% endif %}
						<p class="help">{{ site_owner.logo.url ? 'The site logo now.' : 'Upload one to show it in the top bar, the PDFs and the emails that choose it.' }}</p>
					</div>
					<div class="cl-profile-image-actions">
						<form action="/admin/settings/site-owner/logo" method="post" enctype="multipart/form-data" data-action="submit->profile-image#capture">
							<input type="hidden" name="csrf" value="{{ csrf }}">
							<input type="hidden" name="edited_image" {{ stimulus_target('profile-image', 'data') }}>
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: site_owner.logo.url ? 'Replace the site logo' : 'Upload the site logo', for: 'site-owner-logo', required: true,
								help: 'PNG with a transparent background is best, or JPEG' ~ (site_owner.logo.draws_svg ? ', or SVG, which the site draws as it is' : '') ~ '. At most 12 MB. Stored at most 1200 by 600 pixels, its shape kept.'})} %}
{% block control %}<input id="site-owner-logo" type="file" name="logo" accept="image/png,image/jpeg{{ site_owner.logo.draws_svg ? ',image/svg+xml,.svg' : '' }}" required {{ stimulus_target('profile-image', 'file') }} data-action="change->profile-image#choose" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
							<div class="cl-image-editor cl-image-editor--picture" {{ stimulus_target('profile-image', 'editor') }} hidden>
								<div class="cl-image-editor-stage">
									<canvas class="cl-image-editor-canvas" width="480" height="240" {{ stimulus_target('profile-image', 'stage') }} data-action="pointerdown->profile-image#onPointerDown" aria-label="Drag to move the logo inside the frame"></canvas>
									<div class="cl-image-editor-mask" aria-hidden="true"></div>
								</div>
								<div class="cl-image-editor-controls">
									<div class="cl-image-editor-buttons">
										{{ ui('action.button', {label: 'Left', variant: 'secondary', size: 'small', type: 'button', title: 'Rotate a quarter turn anticlockwise', stimulus_action: 'profile-image#rotateLeft', icon: 'action-rotate-left'}) }}
										{{ ui('action.button', {label: 'Right', variant: 'secondary', size: 'small', type: 'button', title: 'Rotate a quarter turn clockwise', stimulus_action: 'profile-image#rotateRight', icon: 'action-rotate-right'}) }}
										{{ ui('action.button', {label: 'Reset', variant: 'secondary', size: 'small', type: 'button', title: 'Back to the starting position', stimulus_action: 'profile-image#recentre', icon: 'action-reset'}) }}
									</div>
									{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Size', full_width: false, for: 'site-logo-zoom', help: 'At the smallest size the whole logo is kept. Make it larger and drag it to choose what the frame holds.'})} %}
{% block control %}<input type="range" id="site-logo-zoom" min="1" max="4" step="0.02" value="1" {{ stimulus_target('profile-image', 'zoom') }} data-action="input->profile-image#zoom" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
									<div class="cl-image-editor-preview">
										<canvas width="240" height="120" {{ stimulus_target('profile-image', 'preview') }} aria-label="Preview of the site logo"></canvas>
										<span class="help">Preview</span>
									</div>
								</div>
							</div>
