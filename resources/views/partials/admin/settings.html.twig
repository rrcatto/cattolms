{# Each settings form saves independently; presentation uses the shared accordion pattern. #}
<div class="grid section">
	<div class="card">
		<div class="section-head">
			<div>
				<div class="eyebrow">
					Settings
				</div>
				<h2>
					Platform settings
				</h2>
				<p>
					Open a section to change its settings, then use that section’s save button.
				</p>
			</div>
		</div>
	</div>
</div>
<div class="cl-admin-workspace">
    <details class="cl-admin-section" id="settings-identity" {% if settings_open_section|default('') == 'identity' %}open{% endif %}>
        <summary class="cl-admin-section-summary">
            <span class="cl-admin-section-title">Platform identity</span>
            <span class="cl-admin-section-description">Platform name and host organisation.</span>
            <span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
        </summary>
        <div class="cl-admin-section-content">


		<form action="/admin/settings" method="post" class="form-grid">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			<div class="field full">
				<label>Platform name <span class="badge info">{{ platform_name_source=='database' ? 'Database override' : '.env default' }}</span></label>
				<input name="platform_name" value="{{ platform_name }}">
				<div class="help">
					Overrides <span class="mono">APP_NAME</span>. The same effective name is used by the web interface, API and outgoing email.
				</div>
			</div>
			<div class="field full">
				<label>System Company name</label>
				<input name="system_company_name" value="{{ system_company_name }}">
				<div class="help">
					The permanent host organisation. It cannot be deleted, but its name is yours to control.
				</div>
			</div>
			<div class="field full">
				<label>System Company domain</label>
				<input name="system_company_domain" value="{{ system_company_domain }}" required>
				<div class="help">
					Initially defaults from <span class="mono">APP_DOMAIN</span>. Enter only the domain, for example <span class="mono">prettythings.capetown</span>.
				</div>
			</div>
			<div class="cl-form-actions field full">
				<button class="btn btn-primary" type="submit">Save platform identity</button>
			</div>
		</form>
		{% if platform_name_source=='database' %}
			<form action="/admin/settings/platform-name/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				<button class="btn btn-ghost btn-sm" type="submit">Use APP_NAME from .env</button>
			</form>
		{% endif %}
        </div>
    </details>
    <details class="cl-admin-section" id="settings-mail" {% if settings_open_section|default('') == 'mail' %}open{% endif %}>
        <summary class="cl-admin-section-summary">
            <span class="cl-admin-section-title">SMTP / outgoing email</span>
            <span class="cl-admin-section-description">Mail server and sender details.</span>
            <span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
        </summary>
        <div class="cl-admin-section-content">


		{% if mail_settings.mail_configuration_error %}
			<div class="alert alert-warning">
				<strong>Mail configuration needs attention.</strong> {{ mail_settings.mail_configuration_error }}
			</div>
		{% endif %}
		<form action="/admin/settings/mail" method="post" class="form-grid">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			<div class="field">
				<label>Connection type</label><select name="smtp_scheme"><option value="smtp" {{ mail_settings.smtp_scheme=='smtp' ? 'selected' : '' }}>SMTP / STARTTLS</option><option value="smtps" {{ mail_settings.smtp_scheme=='smtps' ? 'selected' : '' }}>SMTP over TLS</option></select>
			</div>
			<div class="field">
				<label>SMTP port</label>
				<input type="number" min="1" max="65535" name="smtp_port" value="{{ mail_settings.smtp_port }}" required>
			</div>
			<div class="field full">
				<label>SMTP server</label>
				<input name="smtp_host" value="{{ mail_settings.smtp_host }}" placeholder="smtp.example.com" required>
			</div>
			<div class="field full">
				<label>SMTP username</label>
				<input name="smtp_username" value="{{ mail_settings.smtp_username }}" autocomplete="off">
			</div>
			<div class="field full">
				<label>SMTP password</label>
				<input type="password" name="smtp_password" value="" autocomplete="new-password">
				<div class="help">
					{{ mail_settings.smtp_password_configured ? 'A password is configured. Leave this blank to keep it.' : 'No SMTP password is currently configured.' }} Passwords saved here are encrypted using <span class="mono">APP_KEY</span>.
				</div>
			</div>
			<div class="field full">
				<label>From address</label>
				<input type="email" name="mail_from_address" value="{{ mail_settings.mail_from_address }}" required>
			</div>
			<div class="field full">
				<label>From name</label>
				<input name="mail_from_name" value="{{ mail_settings.mail_from_name }}">
				<div class="help">
					Leave blank to use the effective Platform name.
				</div>
			</div>
			<div class="field full">
				<label>Reply-to address</label>
				<input type="email" name="mail_reply_to" value="{{ mail_settings.mail_reply_to }}">
				<div class="help">
					Optional. Leave blank to receive replies at the From address.
				</div>
			</div>
			<details class="field full">
				<summary>
					<strong>Advanced SMTP DSN options</strong>
				</summary>
				<label class="cl-mt-2">Query options</label>
				<input name="smtp_query" value="{{ mail_settings.smtp_query }}" placeholder="require_tls=true">
				<div class="help">
					Normally leave this unchanged. This preserves optional Symfony Mailer DSN query parameters.
				</div>
			</details>
			<div class="cl-form-actions field full">
				<button class="btn btn-primary" type="submit">Save SMTP settings</button>
			</div>
		</form>
		<div class="cl-row-wrap cl-mt-2">
			<form action="/admin/mail/test" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				<button class="btn btn-ghost btn-sm">Send test email</button>
			</form>
			{% if mail_settings.mail_override_active %}
				<form action="/admin/settings/mail/reset" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					<button class="btn btn-danger btn-sm" data-confirm="Discard the database mail override and return to .env mail settings?">Reset mail settings to .env</button>
				</form>
			{% endif %}
		</div>
        </div>
    </details>
    <details class="cl-admin-section" id="settings-bank" {% if settings_open_section|default('') == 'bank' %}open{% endif %}>
        <summary class="cl-admin-section-summary">
            <span class="cl-admin-section-title">Bank details</span>
            <span class="cl-admin-section-description">The bank account customers use for EFT payments.</span>
            <span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
        </summary>
        <div class="cl-admin-section-content">
            <p>Customers paying by EFT see these details on their orders. Updates apply to existing orders as well as new orders.</p>
            {% if not bank_details.configured %}<p class="alert alert-warning">Add bank details before accepting EFT payments.</p>{% endif %}
            <form action="/admin/settings/bank" method="post" class="form-grid">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                <div class="field"><label for="bank-name">Bank name</label><input id="bank-name" name="bank_name" value="{{ bank_details.bank_name }}" maxlength="160" required></div>
                <div class="field"><label for="bank-account-name">Account name</label><input id="bank-account-name" name="account_name" value="{{ bank_details.account_name }}" maxlength="160" required></div>
                <div class="field"><label for="bank-account-number">Account number</label><input id="bank-account-number" name="account_number" value="{{ bank_details.account_number }}" inputmode="numeric" pattern="[0-9]{1,34}" maxlength="34" required></div>
                <div class="field"><label for="bank-branch-code">Branch code</label><input id="bank-branch-code" name="branch_code" value="{{ bank_details.branch_code }}" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required></div>
                <div class="cl-form-actions field full"><button class="btn btn-primary" type="submit">Save bank details</button></div>
            </form>
        </div>
    </details>
    <details class="cl-admin-section" id="settings-configuration" {% if settings_open_section|default('') == 'configuration' %}open{% endif %}>
        <summary class="cl-admin-section-summary">
            <span class="cl-admin-section-title">Configuration model</span>
            <span class="cl-admin-section-description">How platform configuration is stored.</span>
            <span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
        </summary>
        <div class="cl-admin-section-content">


		<div class="list">
			<div class="list-item">
				<div>
					<strong>Platform name and outgoing mail</strong>
					<p>
						Platform name and outgoing mail may be changed here. Removing an override returns that setting to its <span class="mono">.env</span> default.
					</p>
				</div>
			</div>
			<div class="list-item">
				<div>
					<strong>Infrastructure remains in .env</strong>
					<p>
						Database credentials, <span class="mono">APP_KEY</span>, application URL/domain, cookie/security settings and filesystem/deployment configuration are not exposed in the web UI.
					</p>
				</div>
			</div>
		</div><p>Bank details are saved in the database and managed here. They have no environment-file fallback.</p>
        </div>
    </details>
    <details class="cl-admin-section" id="settings-maintenance" {% if settings_open_section|default('') == 'maintenance' %}open{% endif %}>
        <summary class="cl-admin-section-summary">
            <span class="cl-admin-section-title">Maintenance</span>
            <span class="cl-admin-section-description">Clean up expired login and session records.</span>
            <span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
        </summary>
        <div class="cl-admin-section-content">


		<div class="list">
			<div class="list-item">
				<div>
					<strong>Expired login links</strong>
					<p>
						{{ maintenance.login_tokens }} passwordless login links are past their validity period.
					</p>
				</div>
				<span class="badge info">{{ maintenance.login_tokens }}</span>
			</div>
			<div class="list-item">
				<div>
					<strong>Expired authentication sessions</strong>
					<p>
						{{ maintenance.auth_sessions }} authentication sessions can no longer be used.
					</p>
				</div>
				<span class="badge info">{{ maintenance.auth_sessions }}</span>
			</div>
			<div class="list-item">
				<div>
					<strong>Expired web sessions</strong>
					<p>
						{{ maintenance.web_sessions }} browser sessions have expired.
					</p>
				</div>
				<span class="badge info">{{ maintenance.web_sessions }}</span>
			</div>
		</div>
		<form action="/admin/database/prune" method="post" class="cl-form-actions">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			<button class="btn btn-danger" data-confirm="Remove the expired login and session records listed above?">Clean expired records</button>
		</form>
        </div>
    </details>
</div>
