			{% if om.state == 'connected' %}
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'success', heading: 'Connected'})} %}{% block body %}<p class="mb-0" data-owner-messages-status>@{{ om.bot_name }} sends your messages to @{{ om.username }}.</p>{% endblock %}{% endembed %}
			{% elseif om.state == 'failing' %}
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger', heading: 'Messages are not getting through'})} %}{% block body %}<p class="mb-0" data-owner-messages-status>{{ om.last_error }}{% if om.waiting %} Waiting to go: {{ om.waiting }}.{% endif %}</p>{% endblock %}{% endembed %}
			{% elseif om.state == 'waiting' %}
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', heading: 'Not connected yet'})} %}{% block body %}<p class="mb-0" data-owner-messages-status>Telegram has not seen @{{ om.username }} yet. Open your bot, send it hello, then press Connect to Telegram again.</p>{% endblock %}{% endembed %}
			{% else %}
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'neutral', heading: om.disconnected ? 'Disconnected' : 'Not connected'})} %}{% block body %}{% endblock %}{% endembed %}
			{% endif %}
			{% if can_manage_settings|default(false) %}
			{% if om.state == 'none' or om.state == 'waiting' %}
			<form action="/admin/settings/owner-messages/connect" method="post" autocomplete="off" class="cl-owner-messages">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Bot key from @BotFather', for: 'owner-messages-key'})} %}
{% block control %}<input class="cl-input" type="password" id="owner-messages-key" name="bot_key" value="" placeholder="{{ om.has_key ? 'Saved' : '123456789:AAF...' }}" autocomplete="new-password" spellcheck="false" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Your personal Telegram username', for: 'owner-messages-username'})} %}
{% block control %}<input class="cl-input" type="text" id="owner-messages-username" name="telegram_username" value="{{ om.username }}" placeholder="@your_username" maxlength="33" autocomplete="off" spellcheck="false" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
				{% if owner_messages_note|default(null) %}<p class="cl-owner-messages-note cl-owner-messages-note--{{ owner_messages_note.tone }}" role="status" data-owner-messages-note>{{ owner_messages_note.words }}</p>{% endif %}
				<div class="cl-owner-messages-actions">
					{% if om.state == 'waiting' %}{{ ui('action.link', {label: 'Open @' ~ om.bot_name, variant: 'secondary', size: 'normal', href: 'https://t.me/' ~ om.bot_name|url_encode, new_window: true, icon: 'action-external'}) }}{% endif %}
					{{ ui('action.button', {label: 'Connect to Telegram', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-connect'}) }}
				</div>
			</form>
			{% else %}
			<div class="cl-owner-messages-actions">
				<form action="/admin/settings/owner-messages/test" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					{{ ui('action.button', {label: 'Send test message', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-send'}) }}
				</form>
				<form action="/admin/settings/owner-messages/disconnect" method="post">
					<input type="hidden" name="csrf" value="{{ csrf }}">
					{{ ui('action.button', {label: 'Disconnect', variant: 'danger', size: 'normal', type: 'submit', confirm: 'Disconnect Telegram and forget the key?', icon: 'action-disconnect'}) }}
				</form>
				{% if owner_messages_note|default(null) %}<p class="cl-owner-messages-note cl-owner-messages-note--{{ owner_messages_note.tone }}" role="status" data-owner-messages-note>{{ owner_messages_note.words }}</p>{% endif %}
			</div>
			{% endif %}
			{% set icon_attributes = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' %}
			<form action="/admin/settings/owner-messages/choices" method="post" hx-post="/admin/settings/owner-messages/choices" hx-trigger="change" hx-swap="none" data-owner-messages-choices>
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{# One row of four ticks, in the owner's order (owner, 2026-11-06: "Put them in this order: sign in, new account, new order, payment"). #}
				{{ ui('form.picture-choice', {multiple: true, legend: 'Use Telegram for', id: 'owner-messages-events', size: 'small', columns: 4,
					selected: (om.sign_in ? ['telegram_sign_in'] : [])|merge(om.on_register ? ['on_register'] : [])|merge(om.on_order ? ['on_order'] : [])|merge(om.on_sale ? ['on_sale'] : []), items: [
					{value: 'telegram_sign_in', label: 'Login via Telegram', icon: '<svg ' ~ icon_attributes ~ '><path d="M21 4 3 11l6 2.5L19 7l-7.5 8 6 4.5z"/></svg>'},
					{value: 'on_register', label: 'New Account', icon: '<svg ' ~ icon_attributes ~ '><circle cx="9" cy="8" r="3.5"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M18 8v6"/><path d="M15 11h6"/></svg>'},
					{value: 'on_order', label: 'New Order', icon: '<svg ' ~ icon_attributes ~ '><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.6 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.5L22 7H6"/></svg>'},
					{value: 'on_sale', label: 'Payment made', icon: '<svg ' ~ icon_attributes ~ '><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/></svg>'},
				]}) }}
				<p class="small cl-text-secondary mb-0" data-telegram-one-site>A bot can serve one site for sign-in: reading what people send it uses it up, so give each site its own bot.{% if not om.has_key %} It needs a bot key saved above.{% endif %}</p>
				<noscript>{{ ui('action.button', {label: 'Save', variant: 'secondary', size: 'small', type: 'submit', icon: 'action-save'}) }}</noscript>
			</form>
			{% endif %}
			{% if can_view_telegram_log|default(false) %}<div class="cl-owner-messages-actions">{{ ui('action.link', {label: 'Telegram log', variant: 'secondary', size: 'small', href: '/admin/site-analytics/telegram-log', icon: 'action-view'}) }}</div>{% endif %}
			</div>

{% endblock %}
{% endembed %}
    {% endif %}
    {% endset %}{% set settings_sections = settings_sections|merge({'owner-messages': section_html}) %}
    {% set section_html %}
    {# Who can sign in (owner, 2026-10-21: "disallow all non-admin logins ... a whitelist of allowed emails"). #}
    {% if sign_in|default(null) %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Who can sign in', summary: sign_in.restricted ? 'Administrators and the listed addresses only.' : 'Everyone.', id: 'settings-sign-in', open: settings_open_section|default('') == 'sign-in'})} %}
{% block body %}
			<p>Everyone, or administrators and the email addresses you list only. While it is limited, anyone else is refused when they sign in or register, and a session they already have stops working at once. A listed address needs no approval on a demo site: listing it is the approval.</p>
			{# Where it comes from, as Site mode says (owner, 2026-10-24): what is saved here overrides .env, and Reset returns to it. #}
			<p>{% if sign_in.source == 'database' %}This is saved here and overrides <span class="mono">AUTH_SIGNIN</span> and <span class="mono">AUTH_SIGNIN_ALLOWED_EMAILS</span> in <span class="mono">.env</span>, which say {{ sign_in.environment ? 'administrators and the listed addresses only' : 'everyone' }}{% if sign_in.environment and sign_in.environment_emails %}, listing {{ sign_in.environment_emails|join(', ') }}{% endif %}.{% elseif sign_in.source == 'environment' %}<span class="mono">AUTH_SIGNIN={{ sign_in.environment ? 'ADMIN' : 'EVERYONE' }}</span>{% if sign_in.environment %} and <span class="mono">AUTH_SIGNIN_ALLOWED_EMAILS</span>{% endif %} in <span class="mono">.env</span> set it.{% else %}<span class="mono">AUTH_SIGNIN</span> in <span class="mono">.env</span> is not ADMIN or EVERYONE (or is not there), so only administrators and the listed addresses can sign in.{% endif %}</p>
			<form action="/admin/settings/sign-in" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('form.picture-choice', {name: 'sign_in', legend: 'Who can sign in', id: 'sign-in-choice', size: 'small', selected: sign_in.restricted ? 'listed' : 'everyone', items: [
					{value: 'everyone', label: 'Everyone', icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20v-1a5.5 5.5 0 0 1 11 0v1"/><circle cx="17" cy="9" r="2.5"/><path d="M15.5 14.2A4.5 4.5 0 0 1 21.5 18.5v1.5"/></svg>', note: 'Anyone with an account, as normal.'},
					{value: 'listed', label: 'Administrators and the listed addresses', icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>', note: 'Everyone else is kept out.'}
				]}) }}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Allowed email addresses', for: 'allowed-emails', full_width: true, help: 'One a line. Used only while sign-in is limited to them.'})} %}
{% block control %}<textarea class="cl-input" id="allowed-emails" name="allowed_emails" rows="6" {{ ui_field_attrs(props) }}>{{ sign_in.emails }}</textarea>{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}{{ ui('action.button', {label: 'Save who can sign in', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}{% endblock %}
{% endembed %}
			</form>
			{% if sign_in.source == 'database' %}
			<form action="/admin/settings/sign-in/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Reset who can sign in to .env', variant: 'danger', size: 'small', confirm: 'Remove what is saved here and follow AUTH_SIGNIN and AUTH_SIGNIN_ALLOWED_EMAILS in .env?', icon: 'action-reset'}) }}
			</form>
			{% endif %}
{% endblock %}
{% endembed %}
    {% endif %}
    {% endset %}{% set settings_sections = settings_sections|merge({'sign-in': section_html}) %}
    {% set section_html %}
    {# Two-step sign-in (owner, 2026-11-05, the approved mockup): who has to use a code from an authenticator app, over AUTH_TWO_STEP. #}
    {% if two_step_policy|default(null) %}
    {% set tsp = two_step_policy %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Two-step sign-in', summary: tsp.summary, id: 'settings-two-step', open: settings_open_section|default('') == 'two-step'})} %}
{% block body %}
			{% set icon_attributes = 'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' %}
			<p>{% if tsp.source == 'database' %}This is saved here and overrides <span class="mono">AUTH_TWO_STEP</span> in <span class="mono">.env</span>, which says {{ tsp.choices[tsp.environment].label|lower }}.{% elseif tsp.source == 'environment' %}<span class="mono">AUTH_TWO_STEP={{ tsp.environment }}</span> in <span class="mono">.env</span> sets it.{% else %}<span class="mono">AUTH_TWO_STEP</span> in <span class="mono">.env</span> is not CHOICE, ADMINS or EVERYONE (or is not there), so administrators must use it.{% endif %} Someone who must use it sets it up at their next sign-in, before they get in, and cannot turn it off.</p>
			<form action="/admin/settings/two-step" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('form.picture-choice', {name: 'two_step', legend: 'Who has to use a code from an authenticator app when they sign in?', id: 'two-step-choice', size: 'small', selected: tsp.value, items: [
					{value: 'CHOICE', label: tsp.choices.CHOICE.label, icon: '<svg ' ~ icon_attributes ~ '><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>', note: tsp.choices.CHOICE.note},
					{value: 'ADMINS', label: tsp.choices.ADMINS.label, icon: '<svg ' ~ icon_attributes ~ '><path d="M12 3 5 6v5c0 4.5 3 8.5 7 10 4-1.5 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>', note: tsp.choices.ADMINS.note},
					{value: 'EVERYONE', label: tsp.choices.EVERYONE.label, icon: '<svg ' ~ icon_attributes ~ '><circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 14.5a5 5 0 0 1 5 5.5"/></svg>', note: tsp.choices.EVERYONE.note},
				]}) }}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}{{ ui('action.button', {label: 'Save', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}{% endblock %}
{% endembed %}
			</form>
			{% if tsp.source == 'database' %}
			<form action="/admin/settings/two-step/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Reset two-step sign-in to .env', variant: 'danger', size: 'small', confirm: 'Remove what is saved here and follow AUTH_TWO_STEP in .env?', icon: 'action-reset'}) }}
			</form>
			{% endif %}
{% endblock %}
{% endembed %}
    {% endif %}
    {% endset %}{% set settings_sections = settings_sections|merge({'two-step': section_html}) %}
    {% set section_html %}
    {# Sign-up checks (owner, 2026-10-26): the countries registrations are judged by, and what the check reads. #}
    {% if signup_checks|default(null) %}
    {% set sc = signup_checks %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Sign-up checks', summary: 'Allowed: ' ~ sc.allowed_names ~ '. Blocked: ' ~ (sc.blocked_count == 0 ? 'none' : (sc.blocked_count == 1 ? '1 country' : sc.blocked_count ~ ' countries')) ~ '.', id: 'settings-signup-checks', open: settings_open_section|default('') == 'signup-checks'})} %}
{% block body %}
			<p>Every registration is checked: where it comes from, its network, its email address, its browser and how the form was filled in. Each attempt is listed at People &amp; Companies, Sign-up Attempts, with its risk.</p>
			<p>The countries are those of the visitor's IP address. A registration from a blocked country may register like anyone else and is held for your approval without being told why, and is marked high risk. One from outside the allowed countries is a warning sign on Sign-up Attempts, not a hold: someone abroad who lives in South Africa may register. On a live site a high-risk registration is held too. A throwaway email address is refused.</p>
			<p>{% if sc.source == 'database' %}These lists are saved here and override <span class="mono">SIGNUP_ALLOWED_COUNTRIES</span> and <span class="mono">SIGNUP_BLOCKED_COUNTRIES</span> in <span class="mono">.env</span>, which say: {{ sc.environment }}.{% else %}These lists come from <span class="mono">SIGNUP_ALLOWED_COUNTRIES</span> and <span class="mono">SIGNUP_BLOCKED_COUNTRIES</span> in <span class="mono">.env</span>. Saving them here overrides <span class="mono">.env</span>.{% endif %}</p>
			<form action="/admin/settings/signup-checks" method="post">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Allowed countries', for: 'allowed-countries', full_width: true, help: 'Two-letter country codes separated by commas, such as ZA. Empty allows every country. Now: ' ~ sc.allowed_names ~ '.'})} %}
{% block control %}<input class="cl-input" id="allowed-countries" name="allowed_countries" value="{{ sc.allowed }}" {{ ui_field_attrs(props) }}>{% endblock %}
{% endembed %}
				{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Blocked countries', for: 'blocked-countries', full_width: true, help: 'Two-letter country codes separated by commas. Now: ' ~ sc.blocked_names ~ '.'})} %}
{% block control %}<textarea class="cl-input" id="blocked-countries" name="blocked_countries" rows="3" {{ ui_field_attrs(props) }}>{{ sc.blocked }}</textarea>{% endblock %}
{% endembed %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}{{ ui('action.button', {label: 'Save the country lists', variant: 'primary', size: 'normal', type: 'submit', icon: 'action-save-changes'}) }}{% endblock %}
{% endembed %}
			</form>
			{% if sc.source == 'database' %}
			<form action="/admin/settings/signup-checks/reset" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Reset the country lists to .env', variant: 'danger', size: 'small', confirm: 'Remove the lists saved here and follow SIGNUP_ALLOWED_COUNTRIES and SIGNUP_BLOCKED_COUNTRIES in .env?', icon: 'action-reset'}) }}
			</form>
			{% endif %}
			<h3 class="h5 cl-mt-3">What the check reads</h3>
			{% set sc_items = [
				{label: 'Country database (GeoLite2)', value: sc.geo ? 'Present' : 'Missing: set GEOIP_DATABASE in .env to a GeoLite2 City or Country database'},
				{label: 'Network database (GeoLite2 ASN)', value: sc.network ? 'Present' : 'Missing: put GeoLite2-ASN.mmdb beside the country database'}
			] %}
			{% for list in sc.lists %}{% set sc_items = sc_items|merge([{label: list.label, value: list.entries ~ ' entries, fetched ' ~ list.fetched}]) %}{% endfor %}
			{{ ui('data.key-value-list', {items: sc_items}) }}
			<form action="/admin/settings/signup-checks/lists" method="post" class="cl-mt-2">
				<input type="hidden" name="csrf" value="{{ csrf }}">
				{{ ui('action.button', {label: 'Fetch the lists now', variant: 'secondary', size: 'small', type: 'submit', icon: 'action-refresh'}) }}
			</form>
			<p class="small cl-text-secondary">The scheduler fetches the Tor list every day and the others every week.</p>
{% endblock %}
{% endembed %}
    {% endif %}
    {% endset %}{% set settings_sections = settings_sections|merge({'signup-checks': section_html}) %}
    {% set section_html %}
    {# Search engines and AI (owner, 2026-11-06): AI crawlers, the Search Console and Bing codes, and share pictures. #}
    {% if search_engines|default(null) %}{% include '@platform/partials/admin/settings-search-engines.html.twig' %}{% endif %}
    {% endset %}{% set settings_sections = settings_sections|merge({'search-engines': section_html}) %}
    {% set section_html %}
    {% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'SMTP / outgoing email', summary: 'Mail server and sender details.', id: 'settings-mail', open: settings_open_section|default('') == 'mail'})} %}
{% block body %}

		{% if mail_settings.mail_configuration_error %}
			{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'warning', section_spacing: false})} %}
{% block body %}

				<strong>Mail configuration needs attention.</strong> {{ mail_settings.mail_configuration_error }}

{% endblock %}
{% endembed %}
		{% endif %}
		<form action="/admin/settings/mail" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
