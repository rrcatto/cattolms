{% block primary_actions %}

			<input type="hidden" name="csrf" value="{{ csrf }}">
			{{ ui('action.button', {label: 'Clean expired records', variant: 'danger', size: 'normal', confirm: 'Remove the expired login and session records listed above?', icon: 'action-remove'}) }}

{% endblock %}
