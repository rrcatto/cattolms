{% block secondary_actions %}{% if site_owner.picture.url %}{{ ui('action.button', {label: 'Remove the site picture', variant: 'danger', size: 'small', type: 'submit', confirm: 'Remove the site picture? Pages without a picture of their own are then shared without one.', form: 'remove-site-picture', icon: 'action-remove'}) }}{% endif %}{% endblock %}
