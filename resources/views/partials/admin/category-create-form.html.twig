{# The form for a new category: a main category (create_parent null) or a subcategory of create_parent. The parent is part of the form's address, never a field, and the server checks it can still hold one. Used in the tree's modal (in_modal: Cancel closes it) and on its own page. #}
{% set parent = create_parent|default(null) %}
{% set values = create_values|default({}) %}
{% set field_prefix = parent ? 'category-' ~ parent.id : 'category-root' %}
<form action="{{ parent ? '/admin/courses/categories/' ~ parent.id ~ '/children' : '/admin/courses/categories' }}" method="post" class="cl-category-create-form">
	<input type="hidden" name="csrf" value="{{ csrf }}">
	<p class="cl-category-create-place">{% if parent %}A {{ parent.level == 1 ? 'subcategory' : 'sub-subcategory' }} inside <strong>{{ parent.path|default(parent.name) }}</strong>, placed last among its categories.{% else %}A main category, placed last among the main categories.{% endif %}</p>
	{% if create_errors|default([]) %}{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'danger', heading: 'The category was not created.'})} %}{% block body %}<ul class="mb-0">{% for error in create_errors %}<li>{{ error }}</li>{% endfor %}</ul>{% endblock %}{% endembed %}{% endif %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Name', for: field_prefix ~ '-name', required: true, full_width: true})} %}{% block control %}<input class="form-control" id="{{ props.for }}" name="name" maxlength="120" required value="{{ values.name|default('') }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Slug (optional)', for: field_prefix ~ '-slug', help: 'Made from the name unless you give one.', full_width: true})} %}{% block control %}<input class="form-control" id="{{ props.for }}" name="slug" placeholder="made-from-the-name" value="{{ values.slug|default('') }}" {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Description', for: field_prefix ~ '-description', full_width: true})} %}{% block control %}<textarea class="form-control" id="{{ props.for }}" name="description" rows="3" {{ ui_field_attrs(props) }}>{{ values.description|default('') }}</textarea>{% endblock %}{% endembed %}
	{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
		{% block primary_actions %}{{ ui('action.button', {label: parent ? 'Add subcategory' : 'Add category', variant: 'primary', type: 'submit', icon: 'action-add'}) }}{% endblock %}
		{% block secondary_actions %}{% if in_modal|default(false) %}{{ ui('action.button', {label: 'Cancel', variant: 'quiet', type: 'button', close_modal: true}) }}{% else %}{{ ui('action.link', {label: 'Cancel', variant: 'quiet', href: '/admin/courses/categories' ~ (parent ? '?reveal=' ~ parent.id ~ '#category-' ~ parent.id : '')}) }}{% endif %}{% endblock %}
	{% endembed %}
</form>
