{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

	{{ ui('layout.section-head', {heading: 'Company Enrolments', eyebrow: 'Company Enrolments', summary: 'Learner and completion figures by organisation.'}) }}

	{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'company_report', pagination: company_report_pagination, search: {ds_name: 'company_report', ds_label: 'Search companies', ds_value: company_report_search, ds_action: '/admin/reports/companies'}})} %}
{% block results %}

			{% if company_report %}

					{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

							<tr>
								{% for sh in company_report_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: company_report_region, sort_results: company_report_results} %}
								{% endfor %}
							</tr>

{% endblock %}
{% block body %}

							{% for row in company_report %}
								<tr>
									<td>
										<strong>{{ row.name }}</strong>
									</td>
									<td>
										{{ row.people }}
									</td>
									<td>
										{{ row.enrolments }}
									</td>
									<td>
										{{ row.completed }}
									</td>
									<td>
										{{ row.completion_rate }}%
									</td>
								</tr>
							{% endfor %}

{% endblock %}
{% endembed %}

			{% else %}
				{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

					No companies match this search.

{% endblock %}
{% endembed %}
			{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
