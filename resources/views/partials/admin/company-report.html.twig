<div class="card section admin-wide-card">
	<div class="section-head">
		<div>
			<div class="eyebrow">
				Company Enrolments
			</div>
			<h2>
				Company Enrolments
			</h2>
			<p>
				Learner and completion figures by organisation.
			</p>
		</div>
	</div>
	{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'company_report', ds_label: 'Search companies', ds_value: company_report_search, ds_action: '/admin/reports/companies'} %}
	<div id="company_report-region" data-server-search-target>
		<div id="company_report-results">
			{% if company_report_pagination %}
				{% include '@platform/partials/pagination.html.twig' with {pg: company_report_pagination} %}
			{% endif %}
			{% if company_report %}
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								{% for sh in company_report_sort_headers %}
									{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: company_report_region, sort_results: company_report_results} %}
								{% endfor %}
							</tr>
						</thead>
						<tbody>
							{% for row in company_report %}
								<tr>
									<td>
										<strong>{{ row.name }}</strong>
									</td>
									<td>
										{{ row.people }}
									</td>
									<td>
										{{ row.enrolments }}
									</td>
									<td>
										{{ row.completed }}
									</td>
									<td>
										{{ row.completion_rate }}%
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% include '@platform/partials/pagination.html.twig' with {pg: company_report_pagination} %}
			{% else %}
				<div class="empty">
					No companies match this search.
				</div>
			{% endif %}
		</div>
	</div>
</div>
