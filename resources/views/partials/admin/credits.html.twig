{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: false})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Add or correct a credit', eyebrow: 'Credits', summary: 'Every adjustment is recorded in the audit log.'}) }}
		<form action="/admin/course/credits" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'company_id', lk_type: 'companies', lk_label: 'Company holding the credit', lk_empty: 'Search for the company', lk_selected: 0, lk_required: 1} %}
			{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'course_id', lk_type: 'courses', lk_label: 'Course', lk_required: 1, lk_empty: 'Search for the course', lk_selected: 0} %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Access period', full_width: false, for: 'field-credits-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<select name="access_period_seconds" id="field-credits-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}"><option value="15552000">6 months</option><option value="31536000" selected>12 months</option></select>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Quantity', full_width: false, for: 'field-credits-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input type="number" name="quantity" min="1" value="1" id="field-credits-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}">

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Reason', full_width: false, for: 'field-credits-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<select name="reason" id="field-credits-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}"><option value="administrator">Manual grant</option><option value="replacement">Replacement credit</option><option value="correction">Correction</option></select>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Audit note', full_width: true, for: 'field-credits-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<textarea name="note" id="field-credits-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}"></textarea>

{% endblock %}
{% endembed %}
			<div class="cl-ui-field--full">
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Add credit', variant: 'primary', size: 'normal', icon: 'action-add'}) }}
{% endblock %}
{% endembed %}
			</div>

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'How credits work'}) }}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

			<div>
				<strong>A credit is specific to a course and access period.</strong> It is assigned before commencement and consumed permanently when the learner starts the course.
			</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'credits', pagination: credits_pagination, search: {ds_name: 'credits', ds_label: 'Search credits', ds_value: credits_search, ds_action: '/admin/course/credits'}})} %}
{% block results %}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% for sh in credits_sort_headers %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: credits_region, sort_results: credits_results} %}
						{% endfor %}
					</tr>

{% endblock %}
{% block body %}

					{% for credit in credits %}
						<tr>
							<td>
								{{ credit.holder_name }}
							</td>
							<td>
								{{ credit.course_title }}
							</td>
							<td>
								{{ credit.access_period_label }}
							</td>
							<td>
								{{ credit.available_count }}
							</td>
							<td>
								{{ credit.assigned_count }}
							</td>
							<td>
								{{ credit.consumed_count }}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

			{% if credits_preview_has_more %}
				<div class="pagination-row">
					<span class="pagination-summary">Showing the first {{ preview_page_size }} credit records.</span>
					{{ ui('action.link', {label: 'View all credit records', variant: 'secondary', size: 'small', href: '/admin/credits'}) }}
				</div>
			{% endif %}

{% endblock %}
{% endembed %}
