{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: false})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Add or correct a credit', eyebrow: 'Credits', summary: 'Every adjustment is recorded in the audit log.'}) }}
		<form action="/admin/course/credits" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'company_id', lk_type: 'companies', lk_label: 'Company holding the credit', lk_empty: 'Search for the company', lk_selected: 0, lk_required: 1} %}
			{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'course_id', lk_type: 'courses', lk_label: 'Course', lk_required: 1, lk_empty: 'Search for the course', lk_selected: 0} %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Length of access', full_width: false, help: 'The lengths the course is sold for.', for: 'field-credits-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				{# The lengths the chosen course is sold for, redrawn when the course is chosen (owner, 2026-10-26). #}
				<select name="access_period_seconds" required id="field-credits-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" hx-get="/admin/course/credits/lengths" hx-trigger="change from:#course_id-value" hx-include="#course_id-value" hx-target="this" hx-swap="innerHTML" {{ ui_field_attrs(props) }}>{% include '@platform/partials/credit-length-options.html.twig' with {lengths: [], course_chosen: false} %}</select>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Quantity', full_width: false, for: 'field-credits-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input type="number" name="quantity" min="1" value="1" id="field-credits-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Reason', full_width: false, for: 'field-credits-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<select name="reason" id="field-credits-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="administrator">Manual grant</option><option value="replacement">Replacement credit</option><option value="correction">Correction</option></select>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Audit note', full_width: true, for: 'field-credits-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<textarea name="note" id="field-credits-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}></textarea>

{% endblock %}
{% endembed %}
			<div class="cl-ui-field--full">
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}
{{ ui('action.button', {label: 'Add credit', variant: 'primary', size: 'normal', icon: 'action-add'}) }}
{% endblock %}
{% endembed %}
			</div>

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'How credits work'}) }}
		{% embed ui_template('feedback.notice') with {props: ui_props('feedback.notice', {tone: 'info', section_spacing: false})} %}
{% block body %}

			<div>
				<strong>A credit is specific to a course and access period.</strong> It is assigned before commencement and consumed permanently when the learner starts the course.
			</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}
	{{ ui('layout.section-head', {heading: 'Credit records', eyebrow: 'Credits', summary: 'Course credits each company holds, and how many remain.'}) }}
{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'credits', pagination: credits_pagination, search: {ds_name: 'credits', ds_label: 'Search credits', ds_value: credits_search, ds_action: '/admin/course/credits'}})} %}
{% block results %}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% for sh in credits_sort_headers %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: credits_region, sort_results: credits_results} %}
						{% endfor %}
					</tr>

{% endblock %}
{% block body %}

					{% for credit in credits %}
						<tr>
							<td>
								{# A company holds it, or a person, named with their account reference and linked to their account (owner, 2026-10-21). #}
								{% if credit.company_id %}<a href="/admin/companies/{{ credit.company_id }}">{{ credit.holder_name }}</a>{% else %}{{ ui('data.person', {name: credit.holder_name, reference: credit.holder_reference, href: '/admin/people/' ~ credit.user_id}) }}{% endif %}
							</td>
							<td>
								{% if credit.course_id|default(0) %}<a href="/admin/courses/{{ credit.course_id }}">{{ credit.course_title }}</a>{% else %}{{ credit.course_title }}{% endif %}
							</td>
							<td>
								{{ credit.access_period_label }}
							</td>
							<td>
								{{ credit.available_count }}
								{# Unused places of a credit given by hand can be taken back (owner, 2026-10-26); a bought one's go through a refund. #}
								{% if can_manage_credits|default(false) and credit.given_by_hand|default(false) in [true, 1, '1', 't'] and credit.available_count > 0 %}
									{{ ui('action.button', {label: 'Take back', variant: 'secondary', size: 'small', type: 'button', modal: 'take-back-credit-' ~ credit.id, icon: 'action-revoke'}) }}
									{% embed ui_template('overlay.modal') with {props: ui_props('overlay.modal', {id: 'take-back-credit-' ~ credit.id, title: 'Take back unused places', action: '/admin/course/credits/' ~ credit.id ~ '/take-back', method: 'post'})} %}
{% block modal_body %}
										<input type="hidden" name="csrf" value="{{ csrf }}">
										<p>{{ credit.holder_name }}: {{ credit.course_title }}, {{ credit.access_period_label }}. {{ credit.available_count }} of its places are free. Places already assigned or used are never taken back.</p>
										{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Places to take back', for: 'take-back-places-' ~ credit.id, required: true})} %}{% block control %}<input type="number" id="take-back-places-{{ credit.id }}" name="places" min="1" max="{{ credit.available_count }}" value="{{ credit.available_count }}" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
										{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Why', for: 'take-back-reason-' ~ credit.id, required: true, help: 'Kept on the credit and in the activity log.'})} %}{% block control %}<input id="take-back-reason-{{ credit.id }}" name="reason" maxlength="500" required {{ ui_field_attrs(props) }}>{% endblock %}{% endembed %}
{% endblock %}
{% block modal_actions %}
										{{ ui('action.button', {label: 'Cancel', variant: 'secondary', size: 'normal', type: 'button', close_modal: true, icon: 'action-cancel'}) }}
										{{ ui('action.button', {label: 'Take back', variant: 'danger', size: 'normal', type: 'submit', icon: 'action-revoke'}) }}
{% endblock %}
{% endembed %}
								{% endif %}
							</td>
							<td>
								{{ credit.assigned_count }}
							</td>
							<td>
								{{ credit.consumed_count }}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

			{% if credits_preview_has_more %}
				<div class="pagination-row">
					<span class="pagination-summary">Showing the first {{ preview_page_size }} credit records.</span>
					{{ ui('action.link', {label: 'View all credit records', variant: 'secondary', size: 'small', href: '/admin/course/credits', icon: 'action-view-all'}) }}
				</div>
			{% endif %}

{% endblock %}
{% endembed %}
{% endblock %}
{% endembed %}
