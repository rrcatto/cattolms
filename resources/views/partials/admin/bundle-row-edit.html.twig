{#
	One bundle's row in Administration > Bundles as a form, edited in place as a course's row is (owner, 2026-11-06: "In
	the bundle list, it must be editable, just like courses are. these fields must be editable: bundle code, title, status,
	price, start & end dates, access period"). The form sits in the last cell, every field tied to it by its form
	attribute. With JavaScript, Save sends it and the row comes back as it now is (or as it was typed, with why it was
	refused), and Cancel draws the row again unchanged; only this row changes. Without JavaScript the same buttons send it
	and the list comes back. Variables: bundle, bundle_edit (BundleService::form), bundle_error, bundles_list_href, units,
	currency, csrf.
#}
{% set bq = bundle_edit %}
{% set bq_form = 'bundle-quick-' ~ bundle.id %}
<tr id="{{ bundle_anchor(bundle) }}" class="cl-course-quick" data-bundle-id="{{ bundle.id }}">
	<td><input class="cl-input" form="{{ bq_form }}" name="code" value="{{ bq.code }}" maxlength="20" autocomplete="off" aria-label="Bundle code" autofocus></td>
	<td class="cell-text">
		<input class="cl-input" form="{{ bq_form }}" name="title" value="{{ bq.title }}" required maxlength="240" autocomplete="off" aria-label="Bundle title">
		{% if bundle_error|default('') %}<p class="cl-course-quick-error" role="alert">{{ bundle_error }}</p>{% endif %}
	</td>
	<td class="cl-bundle-quick-status">{% include '@platform/partials/admin/bundle-status-choice.html.twig' with {bsc_selected: bq.status, bsc_form: bq_form, bsc_stacked: true} only %}</td>
	<td class="cl-course-quick-price">
		<label class="cl-course-quick-field"><span>Now ({{ currency }})</span><input class="cl-input" form="{{ bq_form }}" name="price" value="{{ bq.price }}" inputmode="decimal" autocomplete="off" placeholder="2500.00"></label>
		<label class="cl-course-quick-field"><span>Was</span><input class="cl-input" form="{{ bq_form }}" name="was_price" value="{{ bq.was_price }}" inputmode="decimal" autocomplete="off"></label>
	</td>
	<td class="cl-bundle-quick-when"><input class="cl-input" form="{{ bq_form }}" type="datetime-local" name="available_from" value="{{ bq.available_from }}" aria-label="On sale from"></td>
	<td class="cl-bundle-quick-when"><input class="cl-input" form="{{ bq_form }}" type="datetime-local" name="available_until" value="{{ bq.available_until }}" aria-label="On sale until"></td>
	<td class="cl-bundle-quick-access"><span class="cl-course-quick-period"><input class="cl-input" form="{{ bq_form }}" type="number" min="1" max="3650" name="access_period_value" value="{{ bq.access_period_value }}" aria-label="Access period"><select class="cl-select" form="{{ bq_form }}" name="access_period_unit" aria-label="Unit">{% for unit in units %}<option value="{{ unit }}"{% if unit == bq.access_period_unit %} selected{% endif %}>{{ unit|capitalize }}</option>{% endfor %}</select></span></td>
	<td>{{ bundle.course_count }}</td>
	<td>{{ bundle.sales }}</td>
	<td class="cell-actions">
		<form id="{{ bq_form }}" class="cl-course-quick-actions" action="{{ bundle_admin_url(bundle, '/row') }}" method="post" hx-post="{{ bundle_admin_url(bundle, '/row') }}" hx-target="closest tr" hx-swap="outerHTML">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			<input type="hidden" name="view" value="list">
			<input type="hidden" name="return" value="{{ bundles_list_href }}">
			{{ ui('action.button', {label: 'Save', aria_label: 'Save ' ~ bundle.title, title: 'Save', icon: 'action-save-changes', icon_only: true, variant: 'primary', size: 'small'}) }}
			{{ ui('action.link', {label: 'Cancel', aria_label: 'Cancel editing ' ~ bundle.title, title: 'Cancel', icon: 'action-cancel', icon_only: true, variant: 'quiet', size: 'small', href: bundles_list_href|trim('?&', 'right') ~ '#' ~ bundle_anchor(bundle), get: bundle_admin_url(bundle, '/row?view=list'), target: 'closest tr', swap: 'outerHTML'}) }}
		</form>
	</td>
</tr>
