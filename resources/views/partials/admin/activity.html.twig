{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Activity', eyebrow: 'Activity', summary: 'A chronological view of audited activity across the LMS. Filter it to the people, companies, courses or event types you need.'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
<form class="activity-filters" action="/admin/activity" method="get">{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

	{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'From', full_width: false, for: 'field-activity-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

			<input type="date" name="from" value="{{ activity_filters.from }}" id="field-activity-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}">

{% endblock %}
{% endembed %}
		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'To', full_width: false, for: 'field-activity-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

			<input type="date" name="to" value="{{ activity_filters.to }}" id="field-activity-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}">

{% endblock %}
{% endembed %}
		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Activity type', full_width: false, for: 'field-activity-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

			<select name="family" id="field-activity-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}"><option value="">All types</option>
			{% for family in activity_families %}
				<option value="{{ family }}" {{ activity_filters.family==family ? 'selected' : '' }}>{{ family|replace({'_': ' '})|ucfirst }}</option>
			{% endfor %}
			</select>

{% endblock %}
{% endembed %}
		{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'actor_id', lk_type: 'people', lk_label: 'Person / actor', lk_selected: activity_selected_actor, lk_empty: 'All people', lk_required: 0} %}{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'course_id', lk_type: 'courses', lk_label: 'Course', lk_selected: activity_selected_course, lk_empty: 'All courses', lk_required: 0} %}{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'company_id', lk_type: 'companies', lk_label: 'Company', lk_selected: activity_selected_company, lk_empty: 'All companies', lk_required: 0} %}
		{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Search', full_width: true, for: 'field-activity-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

			<div class="cl-row-inline">
				<input name="q" value="{{ activity_filters.q }}" placeholder="Event, person, ID or metadata" class="cl-flex-fill" id="field-activity-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}">
				{{ ui('action.button', {label: 'Filter', variant: 'primary', size: 'normal', type: 'submit'}) }}{{ ui('action.link', {label: 'Clear', variant: 'secondary', size: 'normal', href: '/admin/activity'}) }}
			</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>
{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'activity', pagination: activity_pagination})} %}
{% block results %}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% for sh in activity_sort_headers %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: activity_region, sort_results: activity_results} %}
						{% endfor %}
					</tr>

{% endblock %}
{% block body %}

					{% for event in activity_events %}
						<tr data-activity-id="{{ event.id }}">
							<td class="small">
								{{ event.created_at }}
							</td>
							<td>
								{{ event.actor_name }}
							</td>
							<td>
								{{ event.company_name ?: '—' }}
							</td>
							<td title="{{ event.event_label }}">
								<strong>{{ event.event_label }}</strong>
								<div class="small muted">
									{{ event.family_label }}
								</div>
							</td>
							<td title="{{ event.subject }}">
								{{ event.subject }}
							</td>
							<td class="small">
								{{ event.ip_address ?: '—' }}
							</td>
							<td class="small">
								{{ event.geo_location }}
							</td>
							<td class="cell-actions">
								{{ ui('action.link', {label: 'Details', variant: 'secondary', size: 'small', href: '/admin/activity/' ~ (event.id)}) }}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}
			{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

				<h3>
					No matching activity
				</h3>
				<p>
					Change or clear the filters.
				</p>

{% endblock %}
{% endembed %}

{% endblock %}
{% block preview %}

			{% if activity_preview_has_more %}
				<div class="pagination-row">
					<span class="pagination-summary">Showing the {{ preview_page_size }} most recent events.</span>
					{{ ui('action.link', {label: 'View all activity', variant: 'secondary', size: 'small', href: '/admin/activity'}) }}
				</div>
			{% endif %}

{% endblock %}
{% endembed %}
