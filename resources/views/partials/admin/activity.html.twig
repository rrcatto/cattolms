<div class="section-head">
	<div>
		<h2>
			Activity
		</h2>
		<p>
			A chronological view of audited activity across the LMS. Filter it to the people, companies, courses or event types you need.
		</p>
	</div>
</div>
{% if universe_switch %}
	{% include '@platform/partials/universe-switch.html.twig' with {us: universe_switch, ct: activity_universe_counts} %}
{% endif %}
<form class="card activity-filters" action="/admin/activity" method="get">
	<div class="form-grid">
		<div class="field">
			<label>From</label>
			<input type="date" name="from" value="{{ activity_filters.from }}">
		</div>
		<div class="field">
			<label>To</label>
			<input type="date" name="to" value="{{ activity_filters.to }}">
		</div>
		<div class="field">
			<label>Activity type</label><select name="family"><option value="">All types</option>
			{% for family in activity_families %}
				<option value="{{ family }}" {{ activity_filters.family==family ? 'selected' : '' }}>{{ family|replace({'_': ' '})|ucfirst }}</option>
			{% endfor %}
			</select>
		</div>
		{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'actor_id', lk_type: 'people', lk_label: 'Person / actor', lk_selected: activity_selected_actor, lk_empty: 'All people', lk_required: 0} %}{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'course_id', lk_type: 'courses', lk_label: 'Course', lk_selected: activity_selected_course, lk_empty: 'All courses', lk_required: 0} %}{% include '@platform/partials/entity-lookup.html.twig' with {lk_name: 'company_id', lk_type: 'companies', lk_label: 'Company', lk_selected: activity_selected_company, lk_empty: 'All companies', lk_required: 0} %}
		<div class="field full">
			<label>Search</label>
			<div class="cl-row-inline">
				<input name="q" value="{{ activity_filters.q }}" placeholder="Event, person, ID or metadata" class="cl-flex-fill">
				<button class="btn btn-primary" type="submit">Filter</button><a class="btn btn-soft" href="/admin/activity">Clear</a>
			</div>
		</div>
	</div>
</form>
<div id="activity-region" data-server-search-target>
	<div id="activity-results">
		{% if activity_pagination %}
			{% include '@platform/partials/pagination.html.twig' with {pg: activity_pagination} %}
		{% endif %}
		<div class="table-wrap section" data-activity-table data-activity-page="{{ activity_page ?: 1 }}" data-last-event-id="{{ activity_last_id }}">
			<table>
				<thead>
					<tr>
						{% for sh in activity_sort_headers %}
							{% include '@platform/partials/sortable-header.html.twig' with {sh: sh, sort_region: activity_region, sort_results: activity_results} %}
						{% endfor %}
					</tr>
				</thead>
				<tbody data-activity-feed>
					{% for event in activity_events %}
						<tr data-activity-id="{{ event.id }}">
							<td class="small">
								{{ event.created_at }}
							</td>
							<td>
								{{ event.actor_name }}
							</td>
							<td>
								{{ event.company_name ?: '—' }}
							</td>
							<td title="{{ event.event_label }}">
								<strong>{{ event.event_label }}</strong>
								<div class="small muted">
									{{ event.family_label }}
								</div>
							</td>
							<td title="{{ event.subject }}">
								{{ event.subject }}
							</td>
							<td class="small">
								{{ event.ip_address ?: '—' }}
							</td>
							<td class="small">
								{{ event.geo_location }}
							</td>
							<td class="cell-actions">
								<a class="btn btn-soft btn-sm" href="/admin/activity/{{ event.id }}">Details</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
			<div class="empty" data-activity-empty {{ activity_events ? 'hidden' : '' }}>
				<h3>
					No matching activity
				</h3>
				<p>
					Change or clear the filters.
				</p>
			</div>
		</div>
		{% if activity_pagination %}
			{% include '@platform/partials/pagination.html.twig' with {pg: activity_pagination} %}
		{% else %}
			{% if activity_preview_has_more %}
				<div class="pagination-row">
					<span class="pagination-summary">Showing the {{ preview_page_size }} most recent events.</span>
					<a class="btn btn-soft btn-sm" href="/admin/activity{{ universe_query }}">View all activity</a>
				</div>
			{% endif %}
		{% endif %}
	</div>
</div>
