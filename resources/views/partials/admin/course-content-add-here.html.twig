{# "+ Add here" between Course Content rows: the three Add item routes, each told the exact parent (empty for the outer level) and position. A list-start slot is an <li>; the slot after a row sits inside that row's <li>, so it travels with the row. #}
{% set place = {insert_parent: parent, insert_index: index} %}
<{{ element }} class="cl-course-tree-add">{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true, label: 'Add here', icon: 'action-add', aria_label: 'Add here, ' ~ place_label})} %}{% block body %}{{ ui('action.link', {label: 'Create new item', href: '/admin/course-items/new?' ~ {course_id: course_id, parent_node_id: parent, insert_index: index}|url_encode, size: 'small', variant: 'quiet', icon: 'action-add'}) }}{{ ui('action.link', {label: 'Add existing item', href: '/admin/courses/' ~ course_id ~ '/content?' ~ place|url_encode ~ '#add-existing', size: 'small', variant: 'quiet'}) }}{{ ui('action.link', {label: 'Add section', href: '/admin/courses/' ~ course_id ~ '/content?' ~ place|url_encode ~ '#add-section', size: 'small', variant: 'quiet'}) }}{% endblock %}{% endembed %}</{{ element }}>
