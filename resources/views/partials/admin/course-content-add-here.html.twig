{# "+ Add here" in the Course Content tree: Create new item, Add existing item and Add section, each told the exact parent (empty for the outer level), position and the depth the new row would have. Each link opens the editor's insert modal and loads its form there with htmx; without JavaScript it is an ordinary link to the same form on its own page. A list-start slot is an <li>; the slot after a row sits inside that row's <li>, so it travels with the row. #}
{% set place = {insert_parent: parent, insert_index: index} %}
{% set create_href = '/admin/course-items/new?' ~ {course_id: course_id, parent_node_id: parent, insert_index: index}|url_encode %}
{% set existing_href = '/admin/courses/' ~ course_id ~ '/content/insert/existing?' ~ place|url_encode %}
{% set section_href = '/admin/courses/' ~ course_id ~ '/content/insert/section?' ~ place|url_encode %}
<{{ element }} class="cl-course-tree-add">{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true, label: 'Add here', icon: 'action-add', aria_label: 'Add here, ' ~ place_label})} %}{% block body %}{{ ui('action.link', {label: 'Create new item', href: create_href, get: create_href, target: '#course-content-insert-body', modal: 'course-content-insert', size: 'small', variant: 'quiet', icon: 'action-add'}) }}{{ ui('action.link', {label: 'Add existing item', href: existing_href, get: existing_href, target: '#course-content-insert-body', modal: 'course-content-insert', size: 'small', variant: 'quiet'}) }}{% if depth <= 3 %}{{ ui('action.link', {label: 'Add section', href: section_href, get: section_href, target: '#course-content-insert-body', modal: 'course-content-insert', size: 'small', variant: 'quiet'}) }}{% endif %}{% endblock %}{% endembed %}</{{ element }}>
