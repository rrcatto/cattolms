<div id="cl-course-reader-progress" class="cl-course-reader-progress progress-strip"><div class="ps-inner"><div class="ps-row"><span class="ps-label">Course progress, <b>{{ course.progress.done|default(0) }} of {{ course.progress.total|default(0) }} parts done</b></span><span class="ps-pct">{{ course.progress.percentage|default(0) }}%</span></div>{{ ui('feedback.progress', {value: course.progress.percentage|default(0), label: 'Course progress', size: 'normal'}) }}</div></div>
