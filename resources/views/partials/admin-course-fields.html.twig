<div class="row g-3">
	<div class="col-md-8">
		<label class="form-label" for="title">Course title</label>
		<input class="form-control" id="title" name="title" value="{{ course.title }}" maxlength="240" required>
	</div>
	<div class="col-md-4">
		<label class="form-label" for="slug">Slug</label>
		<input class="form-control" id="slug" name="slug" value="{{ course.slug }}" placeholder="generated-from-title">
	</div>
	<div class="col-12">
		<label class="form-label" for="subtitle">Subtitle</label>
		<input class="form-control" id="subtitle" name="subtitle" value="{{ course.subtitle }}" maxlength="320">
	</div>
	<div class="col-md-6" data-category-picker>
		<label class="form-label" for="category">Category</label>
		<div class="input-group">
			<select class="form-select" id="category" name="category_id" data-category-select><option value="0">Uncategorised</option>
			{% for category in categories %}
				<option value="{{ category.id }}" {{ category.id == course.category_id ? 'selected' : '' }}>{{ category.name }}</option>
			{% endfor %}
			</select>
			{% if can_manage_categories %}
				<button class="btn btn-outline-secondary" type="button" data-category-create-toggle>+ New</button>
			{% endif %}
		</div>
		{% if can_manage_categories %}
			<div class="border rounded p-3 mt-2 d-none" data-category-create-panel data-create-url="/admin/courses/categories/inline" data-csrf="{{ csrf }}">
				<strong class="d-block mb-2">Create category</strong>
				<input class="form-control mb-2" data-category-name maxlength="120" placeholder="Category name">
				<textarea class="form-control mb-2" data-category-description rows="2" placeholder="Description (optional)"></textarea>
				<div class="small text-danger mb-2 d-none" data-category-error>
				</div>
				<div class="d-flex gap-2">
					<button class="btn btn-sm btn-primary" type="button" data-category-create>Create category</button><button class="btn btn-sm btn-outline-secondary" type="button" data-category-create-cancel>Cancel</button>
				</div>
			</div>
		{% endif %}
	</div>
	<div class="col-md-3">
		<label class="form-label" for="level">Level</label>
		<input class="form-control" id="level" name="level" value="{{ course.level }}" placeholder="Beginner">
	</div>
	<div class="col-md-3">
		<label class="form-label" for="minutes">Estimated minutes</label>
		<input class="form-control" id="minutes" type="number" min="0" name="estimated_minutes" value="{{ course.estimated_minutes }}">
	</div>
	<div class="col-12">
		<label class="form-label" for="summary">Catalogue summary</label>
		<textarea class="form-control" id="summary" name="summary" rows="3">{{ course.summary }}</textarea>
	</div>
	<div class="col-12">
		<label class="form-label" for="description">Full description</label>
		<textarea class="form-control cl-rich-editor" id="description" name="description_html" rows="10">{{ course.description_html }}</textarea>
	</div>
	<div class="col-md-4">
		<label class="form-label" for="access-days">Default access period in days</label>
		<input class="form-control" id="access-days" type="number" min="1" name="access_days" value="{{ course.access_days }}" required>
	</div>
	<div class="col-md-4">
		<label class="form-label" for="module-weight">Module assessment weight</label>
		<input class="form-control" id="module-weight" type="number" min="0" max="1" step="0.01" name="module_weight" value="{{ course.module_weight }}" required>
	</div>
	<div class="col-md-4">
		<label class="form-label" for="final-weight">Final assessment weight</label>
		<input class="form-control" id="final-weight" type="number" min="0" max="1" step="0.01" name="final_weight" value="{{ course.final_weight }}" required>
	</div>
</div>
