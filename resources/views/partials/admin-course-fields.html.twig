{% embed ui_template('form.grid') with {props: ui_props('form.grid', {columns: 'wide'})} %}
{% block body %}

	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Course title', span: 'two-thirds', for: 'title', required: true})} %}
{% block control %}

		<input class="cl-input" id="title" name="title" value="{{ course.title }}" maxlength="240" required {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
	{# The course's code (owner, 2026-10-23): every site and catalogue file knows the course by it. #}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Course code', span: 'third', for: 'code', help: 'Capital letters and digits joined by hyphens, such as GDN-101. Every site and catalogue file knows the course by this code, so change it only if the course has not been exported. Left empty, a code is made from the title.'})} %}
{% block control %}

		<input class="cl-input text-uppercase" id="code" name="code" value="{{ course.code|default('') }}" maxlength="20" placeholder="GDN-101" autocomplete="off" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Slug', span: 'third', for: 'slug', help: 'The last part of the course\'s web address, /courses/' ~ (course.slug ?: 'the-slug') ~ '. Left empty, it is made from the title.'})} %}
{% block control %}

		<input class="cl-input" id="slug" name="slug" value="{{ course.slug }}" placeholder="generated-from-title" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Subtitle', span: 'two-thirds', for: 'subtitle'})} %}
{% block control %}

		<input class="cl-input" id="subtitle" name="subtitle" value="{{ course.subtitle }}" maxlength="320" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Category', for: 'category'})} %}
{% block control %}

		{% include '@platform/partials/admin/course-category-field.html.twig' with {cf_id: 'category', cf_name: 'category_id', cf_picker: category_picker, cf_places: category_places} %}

{% endblock %}
{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Level', span: 'quarter', for: 'level'})} %}
{% block control %}

		<input class="cl-input" id="level" name="level" value="{{ course.level }}" placeholder="Beginner" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
	{% if course.course_type|default('full') == 'short' %}
	{# A short course's time is in minutes, 60 to 120 (Course Specification 4.13, section 15.1; owner, 2026-11-11). #}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Study time in minutes', help: 'A short course: what a buyer is told it takes, 60 to 120 minutes. Empty adds up its parts.', span: 'quarter', for: 'study-minutes'})} %}
{% block control %}

		<input class="cl-input" id="study-minutes" type="number" min="0" name="study_minutes" value="{{ course.study_minutes is defined ? course.study_minutes : (course.estimated_minutes|default(0) ?: '') }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
	{% else %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Study time in hours', help: 'What a buyer is told the whole course takes. Empty adds up its parts.', span: 'quarter', for: 'study-hours'})} %}
{% block control %}

		<input class="cl-input" id="study-hours" type="number" min="0" name="study_hours" value="{{ course.study_hours is defined ? course.study_hours : (course.estimated_minutes|default(0) ? (course.estimated_minutes / 60)|round : '') }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
	{% endif %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Default access period in days', span: 'third', for: 'access-days', required: true})} %}
{% block control %}

		<input class="cl-input" id="access-days" type="number" min="1" name="access_days" value="{{ course.access_days }}" required {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Catalogue summary', full_width: true, for: 'summary'})} %}
{% block control %}

		<textarea class="cl-input" id="summary" name="summary" rows="3" {{ ui_field_attrs(props) }}>{{ course.summary }}</textarea>

{% endblock %}
{% endembed %}
{% embed ui_template('form.field') with {props:ui_props('form.field',{label:'Course introduction',for:'course-introduction',full_width:true})} %}{% block control %}<textarea class="cl-input cl-rich-editor" id="course-introduction" name="introduction_html" rows="6" {{ ui_field_attrs(props) }}>{{ course.introduction_html|default('') }}</textarea>{% endblock %}{% endembed %}
	{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Full description', full_width: true, for: 'description'})} %}
{% block control %}

		<textarea class="cl-input cl-rich-editor" id="description" name="description_html" rows="10" {{ ui_field_attrs(props) }}>{{ course.description_html }}</textarea>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
