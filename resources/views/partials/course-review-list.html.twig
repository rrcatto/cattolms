{#
	Approved reviews as a list: the published version of each, its stars, its comment and the reviewer's
	first name and initial with the date. The course page pages through them; a landing page shows its
	latest few. Never an email address, an id or a moderation note.
#}
<ol class="cl-review-list">
	{% for review in reviews %}
		<li class="cl-review">
			<p class="cl-review-rating">
				<span class="cl-rating-stars" aria-hidden="true">{% for stars in 1..5 %}<span class="{{ stars <= review.rating ? 'is-filled' : '' }}">{{ stars <= review.rating ? '★' : '☆' }}</span>{% endfor %}</span>
				<span class="cl-visually-hidden">{{ review.rating }} out of 5 stars</span>
			</p>
			{% if review.comment %}<p class="cl-review-comment">{{ review.comment|nl2br }}</p>{% endif %}
			<p class="cl-review-byline">{{ review.reviewer }} · <time datetime="{{ review.published_at|date('Y-m-d') }}">{{ review.published_at|date('j M Y') }}</time></p>
		</li>
	{% endfor %}
</ol>
