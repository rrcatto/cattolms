{% set pg_id = pg.prefix ~ '-' ~ pg_position|default('single') %}
<nav class="pagination-row" role="navigation" aria-label="{{ pg.label }} pagination" data-pagination="{{ pg.prefix }}">
	<div class="pagination-summary" aria-live="polite">
		<span>Showing {{ pg.from }}-{{ pg.to }} of {{ pg.total }}</span>
		<span class="pagination-pages">Page {{ pg.page }} of {{ pg.total_pages }}</span>
	</div>
	{% if pg.has_pages %}
		<div class="pagination-controls">
			{% if pg.has_previous %}
				{{ ui('action.link', {label: '« First', variant: 'secondary', size: 'small', href: (pg.first_href), aria_label: 'First page', get: (pg.first_href), target: '#' ~ (pg.region), select: '#' ~ (pg.results), indicator: 'closest .pagination-row', push_url: true}) }}
				{{ ui('action.link', {label: 'Previous', variant: 'secondary', size: 'small', href: (pg.previous_href), aria_label: 'Previous page', get: (pg.previous_href), target: '#' ~ (pg.region), select: '#' ~ (pg.results), indicator: 'closest .pagination-row', rel: 'prev', push_url: true}) }}
			{% else %}
				<span class="pagination-state" aria-disabled="true">&laquo; First</span>
				<span class="pagination-state" aria-disabled="true">Previous</span>
			{% endif %}
			<ol class="pagination-pages-list">
				{% for pg_item in pg.pages %}
					<li>
						{% if pg_item.is_gap %}
							<span class="pagination-gap" aria-hidden="true">&hellip;</span>
						{% else %}
							{% if pg_item.is_current %}
								<span class="pagination-state" aria-current="page">{{ pg_item.page }}</span>
							{% else %}
								{{ ui('action.link', {label: (pg_item.page), variant: 'secondary', size: 'small', href: (pg_item.href), aria_label: 'Page ' ~ (pg_item.page), get: (pg_item.href), target: '#' ~ (pg.region), select: '#' ~ (pg.results), indicator: 'closest .pagination-row', push_url: true}) }}
							{% endif %}
						{% endif %}
					</li>
				{% endfor %}
			</ol>
			{% if pg.has_next %}
				{{ ui('action.link', {label: 'Next', variant: 'secondary', size: 'small', href: (pg.next_href), aria_label: 'Next page', get: (pg.next_href), target: '#' ~ (pg.region), select: '#' ~ (pg.results), indicator: 'closest .pagination-row', rel: 'next', push_url: true}) }}
				{{ ui('action.link', {label: 'Last »', variant: 'secondary', size: 'small', href: (pg.last_href), aria_label: 'Last page', get: (pg.last_href), target: '#' ~ (pg.region), select: '#' ~ (pg.results), indicator: 'closest .pagination-row', push_url: true}) }}
			{% else %}
				<span class="pagination-state" aria-disabled="true">Next</span>
				<span class="pagination-state" aria-disabled="true">Last &raquo;</span>
			{% endif %}
		</div>
		<form class="pagination-jump" method="get" action="{{ pg.base }}"
	      hx-get="{{ pg.base }}" hx-target="#{{ pg.region }}" hx-select="#{{ pg.results }}"
	      hx-swap="innerHTML" hx-push-url="true" hx-indicator="closest .pagination-row">
			{% for filter_key, filter_value in pg.filters %}
				<input type="hidden" name="{{ filter_key }}" value="{{ filter_value }}">
			{% endfor %}
			<input type="hidden" name="{{ pg.size_param }}" value="{{ pg.page_size }}">
			<label for="{{ pg_id }}-jump-page">Jump to page</label>
			<input id="{{ pg_id }}-jump-page" name="{{ pg.page_param }}" type="number" inputmode="numeric"
		       min="1" max="{{ pg.total_pages }}" step="1" value="{{ pg.page }}"
		       aria-describedby="{{ pg_id }}-jump-help">
			{{ ui('action.button', {label: 'Go', variant: 'secondary', size: 'small', type: 'submit'}) }}
			<span class="help" id="{{ pg_id }}-jump-help">of {{ pg.total_pages }}</span>
		</form>
		<form class="pagination-page-size" method="get" action="{{ pg.base }}"
	      hx-get="{{ pg.base }}" hx-target="#{{ pg.region }}" hx-select="#{{ pg.results }}"
	      hx-swap="innerHTML" hx-push-url="true" hx-indicator="closest .pagination-row">
			<input type="hidden" name="{{ pg.page_param }}" value="1">
			{% for filter_key, filter_value in pg.filters %}
				<input type="hidden" name="{{ filter_key }}" value="{{ filter_value }}">
			{% endfor %}
			<label for="{{ pg_id }}-page-size">Rows per page</label>
			<select id="{{ pg_id }}-page-size" name="{{ pg.size_param }}" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
			{% for size in pg.page_sizes %}
				<option value="{{ size }}" {{ pg.page_size == size ? 'selected' : '' }}>{{ size }}</option>
			{% endfor %}
			</select>
			<noscript>
				{{ ui('action.button', {label: 'Apply', variant: 'secondary', size: 'small', type: 'submit'}) }}
			</noscript>
		</form>
	{% endif %}
</nav>
