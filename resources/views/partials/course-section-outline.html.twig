{# A section page's outline of what the section holds, when the section shows one. Shared by the learner reader and the public preview; each passes the structure it may show, so the public outline lists only public rows. A module's section lists each part with its kind and time, and the module's total (course structure, owner 2026-10-28). #}
{% if item.node_type == 'section' and item.show_outline %}
{% set part_labels = constant('CattoLearning\\Course\\CourseItemService::PART_LABELS') %}
<ol class="cl-section-outline">{% set in_section = false %}{% for node in course.structure %}{% if node.id == item.id %}{% set in_section = true %}{% elseif in_section and node.depth <= item.depth %}{% set in_section = false %}{% elseif in_section and item.section_number|default(null) is not null %}<li><span class="cl-section-outline-part">{{ node.node_type == 'section' ? 'Section' : part_labels[node.part|default('')]|default('') }}</span><span>{{ node.node_type == 'section' ? node.section_title : (node.display_title_override ?: node.item_title) }}</span><span class="cl-section-outline-time">{{ node.node_type == 'section' ? '' : node.minutes_label|default('') }}</span></li>{% elseif in_section %}<li>{{ node.node_type == 'section' ? node.section_title : (node.display_title_override ?: node.item_title) }}</li>{% endif %}{% endfor %}</ol>
{% if item.section_number|default(null) is not null and item.total_minutes_label|default('') %}<p class="cl-section-outline-total">In all: {{ item.total_minutes_label }}</p>{% endif %}
{% endif %}
