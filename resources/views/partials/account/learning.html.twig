<div class="section-head">
	<div>
		<div class="eyebrow">
			My Course Library
		</div>
		<h2>
			Your complete course library
		</h2>
		<p>
			Current, completed, favourite and requested courses in one place.
		</p>
	</div>
</div>
<details class="cl-admin-section" data-library-section="current" open>
	<summary class="cl-admin-section-summary">
		<span class="cl-admin-section-title">Current courses</span>
		<span class="cl-admin-section-description">Courses assigned to you or already under way.</span>
		<span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
	</summary>
	<div class="cl-admin-section-content">
		{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'current', ds_label: 'Search current courses', ds_value: current_search, ds_action: '/account/library'} %}
		<div id="current-region" data-server-search-target>
			<div id="current-results">
				{% if current_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: current_pagination} %}
				{% endif %}
				{% if current %}
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th style="width:52%">
										Course
									</th>
									<th style="width:10%">
										Status
									</th>
									<th style="width:10%">
										Progress
									</th>
									<th style="width:16%">
										Access
									</th>
									<th class="cell-actions" style="width:12%">
										Actions
									</th>
								</tr>
							</thead>
							<tbody>
								{% for course in current %}
									<tr>
										<td>
											<strong>{{ course.title }}</strong>
										</td>
										<td>
											<span class="badge {{ course.is_started ? 'info' : 'warn' }}">{{ course.is_started ? 'Started' : 'Not started' }}</span>
										</td>
										<td>
											<div class="progress">
												<span style="width:{{ course.progress_percentage }}%"></span>
											</div>
											<span class="small muted">{{ course.progress_percentage }}%</span>
										</td>
										<td class="small">
											{{ course.access_period_label }}
										</td>
										<td class="cell-actions">
											<details class="row-menu" data-cl-dropdown>
												<summary class="btn btn-soft btn-sm row-menu-trigger">
													Actions ▾
												</summary>
												<div class="row-menu-panel">
													<a class="btn btn-primary btn-sm" href="/learn/{{ course.slug }}">{{ course.is_started ? 'Resume' : 'Review and start' }}</a>
													{% if is_platform_admin %}
														<form action="/account/library/enrolments/{{ course.id }}/remove" method="post">
															<input type="hidden" name="csrf" value="{{ csrf }}">
															<button class="btn btn-danger btn-sm" type="submit" data-confirm="Remove this test course from your library?">Remove</button>
														</form>
													{% endif %}
												</div>
											</details>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
					{% include '@platform/partials/pagination.html.twig' with {pg: current_pagination} %}
				{% else %}
					<div class="empty">
						No current courses.
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</details>
<details class="cl-admin-section" data-library-section="completed">
	<summary class="cl-admin-section-summary">
		<span class="cl-admin-section-title">Completed courses</span>
		<span class="cl-admin-section-description">Courses you have finished, with their results and certificates.</span>
		<span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
	</summary>
	<div class="cl-admin-section-content">
		{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'completed', ds_label: 'Search completed courses', ds_value: completed_search, ds_action: '/account/library'} %}
		<div id="completed-region" data-server-search-target>
			<div id="completed-results">
				{% if completed_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: completed_pagination} %}
				{% endif %}
				{% if completed %}
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th style="width:60%">
										Course
									</th>
									<th style="width:12%">
										Result
									</th>
									<th style="width:14%">
										Grade
									</th>
									<th class="cell-actions" style="width:14%">
										Actions
									</th>
								</tr>
							</thead>
							<tbody>
								{% for course in completed %}
									<tr>
										<td>
											<strong>{{ course.title }}</strong>
										</td>
										<td>
											{{ course.overall_percentage != null ? course.overall_percentage ~ '%' : '—' }}
										</td>
										<td>
											<span class="badge good">{{ course.overall_grade_code ?: 'Completed' }}</span>
										</td>
										<td>
											{% if course.certificate_public_id %}
												<a class="btn btn-soft btn-sm" href="/certificates/{{ course.certificate_public_id }}">View certificate</a>
											{% endif %}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
					{% include '@platform/partials/pagination.html.twig' with {pg: completed_pagination} %}
				{% else %}
					<div class="empty">
						No completed courses yet.
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</details>
<details class="cl-admin-section" data-library-section="favourites">
	<summary class="cl-admin-section-summary">
		<span class="cl-admin-section-title">Favourites</span>
		<span class="cl-admin-section-description">Courses you have marked to come back to.</span>
		<span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
	</summary>
	<div class="cl-admin-section-content">
		{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'favourites', ds_label: 'Search favourites', ds_value: favourites_search, ds_action: '/account/library'} %}
		<div id="favourites-region" data-server-search-target>
			<div id="favourites-results">
				{% if favourites_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: favourites_pagination} %}
				{% endif %}
				{% if favourites %}
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th style="width:70%">
										Course
									</th>
									<th style="width:16%">
										Level
									</th>
									<th class="cell-actions" style="width:14%">
										Actions
									</th>
								</tr>
							</thead>
							<tbody>
								{% for course in favourites %}
									<tr>
										<td>
											<strong>{{ course.title }}</strong>
											<div class="small muted">
												{{ course.summary }}
											</div>
										</td>
										<td class="small">
											{{ course.level ?: '—' }}
										</td>
										<td>
											<a class="btn btn-primary btn-sm" href="/courses/{{ course.slug }}">View</a>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
					{% include '@platform/partials/pagination.html.twig' with {pg: favourites_pagination} %}
				{% else %}
					<div class="empty">
						No favourite courses.
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</details>
<details class="cl-admin-section" data-library-section="requests">
	<summary class="cl-admin-section-summary">
		<span class="cl-admin-section-title">Course requests</span>
		<span class="cl-admin-section-description">Courses you have asked to be enrolled on, and where each request stands.</span>
		<span class="cl-admin-section-toggle" aria-hidden="true">⌄</span>
	</summary>
	<div class="cl-admin-section-content">
		{% include '@platform/partials/dataset-search.html.twig' with {ds_name: 'requests', ds_label: 'Search course requests', ds_value: requests_search, ds_action: '/account/library'} %}
		<div id="requests-region" data-server-search-target>
			<div id="requests-results">
				{% if requests_pagination %}
					{% include '@platform/partials/pagination.html.twig' with {pg: requests_pagination} %}
				{% endif %}
				{% if requests %}
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th style="width:58%">
										Course
									</th>
									<th style="width:12%">
										Requested
									</th>
									<th style="width:16%">
										Status
									</th>
									<th class="cell-actions" style="width:14%">
										Actions
									</th>
								</tr>
							</thead>
							<tbody>
								{% for request in requests %}
									<tr>
										<td>
											<strong>{{ request.course_title }}</strong>
										</td>
										<td class="small">
											{{ request.requested_at }}
										</td>
										<td>
											<span class="badge {{ request.status=='pending' ? 'warn' : 'info' }}">{{ request.status }}</span>
										</td>
										<td>
											<a class="btn btn-soft btn-sm" href="/courses/{{ request.slug }}">View course</a>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
					{% include '@platform/partials/pagination.html.twig' with {pg: requests_pagination} %}
				{% else %}
					<div class="empty">
						No course requests.
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</details>
