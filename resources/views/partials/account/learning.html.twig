{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Your complete course library', eyebrow: 'My Course Library', summary: 'Current, completed, favourite and requested courses in one place.'}) }}
		{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Current courses', summary: 'Courses assigned to you or already under way.', open: true, workspace: 'library', section_key: 'current'})} %}
{% block body %}

				{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'current', pagination: current_pagination, search: {ds_name: 'current', ds_label: 'Search current courses', ds_value: current_search, ds_action: '/account/library'}})} %}
{% block results %}

						{% if current %}

								{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

										<tr>
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 52, label: 'Course'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 10, label: 'Status'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 10, label: 'Progress'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Access'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Actions'}} %}
										</tr>

{% endblock %}
{% block body %}

										{% for course in current %}
											<tr>
												<td>
													<strong>{{ course.title }}</strong>
												</td>
												<td>
													{{ ui('feedback.badge', {label: (course.is_started ? 'Started' : 'Not started'), tone: course.is_started ? 'info' : 'warning'}) }}
												</td>
												<td>
													{{ ui('feedback.progress', {value: course.progress_percentage, label: 'Course progress', size: 'normal'}) }}
													<span class="small muted">{{ course.progress_percentage }}%</span>
												</td>
												<td class="small">
													{{ course.access_period_label }}
												</td>
												<td class="cell-actions">
													{% embed ui_template('action.row') with {props: ui_props('action.row', {menu: true})} %}
{% block body %}

															{{ ui('action.link', {label: (course.is_started ? 'Resume' : 'Review and start'), variant: 'primary', size: 'small', href: '/learn/' ~ (course.slug)}) }}
															{% if is_platform_admin %}
																<form action="/account/library/enrolments/{{ course.id }}/remove" method="post">
																	<input type="hidden" name="csrf" value="{{ csrf }}">
																	{{ ui('action.button', {label: 'Remove', variant: 'danger', size: 'small', type: 'submit', confirm: 'Remove this test course from your library?', icon: 'action-remove'}) }}
																</form>
															{% endif %}

{% endblock %}
{% endembed %}
												</td>
											</tr>
										{% endfor %}

{% endblock %}
{% endembed %}

						{% else %}
							{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

								No current courses.

{% endblock %}
{% endembed %}
						{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
		{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Completed courses', summary: 'Courses you have finished, with their results and certificates.', open: false, workspace: 'library', section_key: 'completed'})} %}
{% block body %}

				{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'completed', pagination: completed_pagination, search: {ds_name: 'completed', ds_label: 'Search completed courses', ds_value: completed_search, ds_action: '/account/library'}})} %}
{% block results %}

						{% if completed %}

								{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

										<tr>
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 60, label: 'Course'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Result'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Grade'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Actions'}} %}
										</tr>

{% endblock %}
{% block body %}

										{% for course in completed %}
											<tr>
												<td>
													<strong>{{ course.title }}</strong>
												</td>
												<td>
													{{ course.overall_percentage != null ? course.overall_percentage ~ '%' : '—' }}
												</td>
												<td>
													{{ ui('feedback.badge', {label: (course.overall_grade_code ?: 'Completed'), tone: 'success'}) }}
												</td>
												<td>
													{% if course.certificate_public_id %}
														{{ ui('action.link', {label: 'View certificate', variant: 'secondary', size: 'small', href: '/certificates/' ~ (course.certificate_public_id)}) }}
													{% endif %}
												</td>
											</tr>
										{% endfor %}

{% endblock %}
{% endembed %}

						{% else %}
							{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

								No completed courses yet.

{% endblock %}
{% endembed %}
						{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
		{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Favourites', summary: 'Courses you have marked to come back to.', open: false, workspace: 'library', section_key: 'favourites'})} %}
{% block body %}

				{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'favourites', pagination: favourites_pagination, search: {ds_name: 'favourites', ds_label: 'Search favourites', ds_value: favourites_search, ds_action: '/account/library'}})} %}
{% block results %}

						{% if favourites %}

								{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

										<tr>
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 70, label: 'Course'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Level'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Actions'}} %}
										</tr>

{% endblock %}
{% block body %}

										{% for course in favourites %}
											<tr>
												<td>
													<strong>{{ course.title }}</strong>
													<div class="small muted">
														{{ course.summary }}
													</div>
												</td>
												<td class="small">
													{{ course.level ?: '—' }}
												</td>
												<td>
													{{ ui('action.link', {label: 'View', variant: 'primary', size: 'small', href: '/courses/' ~ (course.slug)}) }}
												</td>
											</tr>
										{% endfor %}

{% endblock %}
{% endembed %}

						{% else %}
							{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

								No favourite courses.

{% endblock %}
{% endembed %}
						{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
		{% embed ui_template('overlay.accordion-section') with {props: ui_props('overlay.accordion-section', {heading: 'Course requests', summary: 'Courses you have asked to be enrolled on, and where each request stands.', open: false, workspace: 'library', section_key: 'requests'})} %}
{% block body %}

				{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'requests', pagination: requests_pagination, search: {ds_name: 'requests', ds_label: 'Search course requests', ds_value: requests_search, ds_action: '/account/library'}})} %}
{% block results %}

						{% if requests %}

								{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

										<tr>
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 58, label: 'Course'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Requested'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Status'}} %}
											{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Actions'}} %}
										</tr>

{% endblock %}
{% block body %}

										{% for request in requests %}
											<tr>
												<td>
													<strong>{{ request.course_title }}</strong>
												</td>
												<td class="small">
													{{ request.requested_at }}
												</td>
												<td>
													{{ ui('feedback.badge', {label: (request.status), tone: request.status=='pending' ? 'warning' : 'info'}) }}
												</td>
												<td>
													{{ ui('action.link', {label: 'View course', variant: 'secondary', size: 'small', href: '/courses/' ~ (request.slug)}) }}
												</td>
											</tr>
										{% endfor %}

{% endblock %}
{% endembed %}

						{% else %}
							{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

								No course requests.

{% endblock %}
{% endembed %}
						{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
