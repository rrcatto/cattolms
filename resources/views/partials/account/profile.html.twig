<div class="card"><div class="profile-head"><div class="avatar">U</div><div class="profile-meta"><h2>{{ profile.full_name }}</h2><p>{{ profile.primary_email }}{% if company %} · {{ company.name }}{% endif %}</p><div class="chip-row" style="margin-top:10px">{% for role in user_roles %}<span class="badge info">{{ role }}</span>{% endfor %}<span class="badge good">{{ profile.status }}</span></div></div></div></div>
<div class="grid grid-2 section">
  <div class="card"><div class="section-head"><div><h2>Personal particulars</h2><p>Information used across your account and certificates.</p></div></div><form class="form-grid" action="/account/profile" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="field"><label>First name</label><input name="first_name" maxlength="120" value="{{ profile.first_name }}"></div><div class="field"><label>Middle names</label><input name="middle_names" maxlength="160" value="{{ profile.middle_names }}" placeholder="Any names between your first name and surname"></div><div class="field"><label>Last name</label><input name="last_name" maxlength="120" value="{{ profile.last_name }}"></div><div class="field"><label>Identification number</label><input name="identification_number" maxlength="120" value="{{ profile.identification_number }}"></div><div class="field"><label>Birthdate</label><input type="date" name="birthdate" value="{{ profile.birthdate }}"></div><div class="field"><label>Gender</label><select name="gender"><option value="">Select</option><option {{ profile.gender=='Male' ? 'selected' : '' }}>Male</option><option {{ profile.gender=='Female' ? 'selected' : '' }}>Female</option><option {{ profile.gender=='Non-binary' ? 'selected' : '' }}>Non-binary</option><option {{ profile.gender=='Prefer not to say' ? 'selected' : '' }}>Prefer not to say</option></select></div><div class="field"><label>Mobile number</label><input name="mobile_number" maxlength="60" value="{{ profile.mobile_number }}"></div><div class="field full"><label>Display name</label><input name="display_name" maxlength="160" value="{{ profile.display_name }}"></div><div class="field full"><label>Name to print on certificates</label><input name="certificate_name" maxlength="160" value="{{ profile.certificate_name }}"></div><div class="field full"><button class="btn btn-primary" type="submit">Save particulars</button></div></form></div>
  <div class="card" id="emails"><div class="section-head"><div><h2>Email addresses</h2><p>One primary email and one optional verified secondary email.</p></div></div><div class="list">{% for email in emails %}<div class="list-item"><div><strong>{{ email.email }}</strong><p>{{ email.is_primary ? 'Primary login address' : 'Verified secondary address' }}</p></div>{% if not email.is_primary %}<form action="/account/email/remove" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="email_id" value="{{ email.id }}"><button class="btn btn-danger btn-sm" type="submit">Remove</button></form>{% endif %}</div>{% endfor %}</div><form action="/account/email/secondary" method="post" style="margin-top:16px"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="field"><label>Add or replace secondary email</label><input type="email" name="email" required><div class="help">A verification link is sent before this address is added.</div></div><button class="btn btn-soft btn-sm" type="submit" style="margin-top:10px">Send verification</button></form></div>
</div>