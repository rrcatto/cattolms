{#
Generated by: Claude Code CLI
Date time: 2026/09/10 02:25 SAST
Version: 0.7
Description:
  Personal Particulars: who this person is, and the image that stands for them.

  One of the three pages under the Profile pop-out. Email addresses and social media used to sit on
  this screen as two more cards; they are their own pages now, because each is a separate decision
  with its own rules and neither is a personal particular.

  The image form is a second form rather than a field inside the first. An upload has to be
  multipart and a text form does not, and posting the whole particulars form as multipart every time
  somebody corrects a middle name is a cost paid on every save for a file that is almost never
  attached.

  Comments here are plain prose only: no angle brackets, no comment delimiters and no template
  tokens.
Changelog:
  2026/09/10 07:45 SAST
  - Both cards now end in the shared action row. Save image was flush against the help text above it and read as part of it, so the card looked as though it had no save control at all.
  2026/09/10 07:10 SAST
  - Added the image editor: rotate, size, position and preview before the image is stored. Without JavaScript the file input alone still works and the server takes a centred square.
  2026/09/10 02:25 SAST
  - Split from the combined profile screen and given the profile image.
#}
{#
  The identity block that used to open this page is now partials/account/identity-head.html.twig,
  included by the Account section page so that all six pages open with it rather than this one.
#}
<div class="grid grid-2 section">
	<div class="card">
		<div class="section-head">
			<div>
				<div class="eyebrow">
					Personal Particulars
				</div>
				<h2>
					Personal particulars
				</h2>
				<p>
					Information used across your account and certificates.
				</p>
			</div>
		</div>
		<form class="form-grid" action="/account/profile" method="post">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			<div class="field">
				<label>First name</label>
				<input name="first_name" maxlength="120" value="{{ profile.first_name }}">
			</div>
			<div class="field">
				<label>Middle names</label>
				<input name="middle_names" maxlength="160" value="{{ profile.middle_names }}" placeholder="Any names between your first name and surname">
			</div>
			<div class="field">
				<label>Last name</label>
				<input name="last_name" maxlength="120" value="{{ profile.last_name }}">
			</div>
			<div class="field">
				<label>Identification number</label>
				<input name="identification_number" maxlength="120" value="{{ profile.identification_number }}">
			</div>
			<div class="field">
				<label>Birthdate</label>
				<input type="date" name="birthdate" value="{{ profile.birthdate }}">
			</div>
			<div class="field">
				<label>Gender</label><select name="gender"><option value="">Select</option><option {{ profile.gender=='Male' ? 'selected' : '' }}>Male</option><option {{ profile.gender=='Female' ? 'selected' : '' }}>Female</option><option {{ profile.gender=='Non-binary' ? 'selected' : '' }}>Non-binary</option><option {{ profile.gender=='Prefer not to say' ? 'selected' : '' }}>Prefer not to say</option></select>
			</div>
			<div class="field">
				<label>Mobile number</label>
				<input name="mobile_number" maxlength="60" value="{{ profile.mobile_number }}">
			</div>
			<div class="field">
				<label>Display name</label>
				<input name="display_name" maxlength="160" value="{{ profile.display_name }}">
			</div>
			<div class="field field-wide">
				<label>Name to print on certificates</label>
				<input name="certificate_name" maxlength="160" value="{{ profile.certificate_name }}">
			</div>
			<div class="field-wide cl-form-actions">
				<button class="btn btn-primary" type="submit">Save particulars</button>
			</div>
		</form>
	</div>
	<div class="card" id="profile-image">
		<div class="section-head">
			<div>
				<h2>
					Profile image
				</h2>
				<p>
					A square picture of you, shown wherever your name appears.
				</p>
			</div>
		</div>
{#
		The importmap goes before any module script on the page. Themes put the platform's own
		scripts at the end of the body, so emitting it here keeps it first without asking five
		themes to carry a tag for one page.
#}
		{{ importmap() }}
		<div class="cl-profile-image-panel" {{ stimulus_controller('profile-image', {size: profile_image_size}) }}>
			<div class="cl-profile-image-current" {{ stimulus_target('profile-image', 'placeholder') }}>
				{% if profile_image_url %}
					<img class="cl-profile-image-preview" src="{{ profile_image_url }}" alt="Your current profile image" width="128" height="128">
				{% else %}
					<div class="cl-profile-image-preview cl-profile-image-empty">
						<span>{{ profile.full_name|slice(0, 1)|upper }}</span>
					</div>
				{% endif %}
				<p class="help">
					{{ profile_image_url ? 'Your image now.' : 'No image yet.' }}
				</p>
			</div>
			<div class="cl-profile-image-actions">
				<form action="/account/profile/image" method="post" enctype="multipart/form-data" data-action="submit->profile-image#capture">
					<input type="hidden" name="csrf" value="{{ csrf }}">
{#
					What the editor produced, at the stored size. Empty unless the editor ran, and
					the server falls back to the file and its own centred crop when it is.
#}
					<input type="hidden" name="edited_image" {{ stimulus_target('profile-image', 'data') }}>
					<div class="field">
						<label for="profile-image-file">Choose an image</label>
						<input type="file" id="profile-image-file" name="image" accept="image/png,image/jpeg,image/webp" required
						       {{ stimulus_target('profile-image', 'file') }} data-action="change->profile-image#choose">
						<div class="help">
							PNG, JPEG or WebP, up to 8 MB. Stored as a {{ profile_image_size }} by {{ profile_image_size }} pixel square.
						</div>
					</div>
{#
					The editor. Hidden until a file is chosen, and never shown at all without
					JavaScript - the file input above is the whole control then, and the server
					takes a centred square.
#}
					<div class="cl-image-editor" {{ stimulus_target('profile-image', 'editor') }} hidden>
						<div class="cl-image-editor-stage">
							<canvas class="cl-image-editor-canvas" width="320" height="320"
							        {{ stimulus_target('profile-image', 'stage') }}
							        data-action="pointerdown->profile-image#onPointerDown"
							        aria-label="Drag to move the picture inside the frame"></canvas>
							<div class="cl-image-editor-mask" aria-hidden="true">
							</div>
						</div>
						<div class="cl-image-editor-controls">
							<div class="cl-image-editor-buttons">
								<button class="btn btn-soft btn-sm" type="button" data-action="profile-image#rotateLeft" title="Rotate a quarter turn anticlockwise">↺ Left</button>
								<button class="btn btn-soft btn-sm" type="button" data-action="profile-image#rotateRight" title="Rotate a quarter turn clockwise">↻ Right</button>
								<button class="btn btn-soft btn-sm" type="button" data-action="profile-image#recentre" title="Back to the starting position">Reset</button>
							</div>
							<div class="field">
								<label for="profile-image-zoom">Size</label>
								<input type="range" id="profile-image-zoom" min="1" max="4" step="0.02" value="1"
								       {{ stimulus_target('profile-image', 'zoom') }} data-action="input->profile-image#zoom">
								<div class="help">
									Drag the picture to choose what the square holds.
								</div>
							</div>
							<div class="cl-image-editor-preview">
								<canvas width="96" height="96" {{ stimulus_target('profile-image', 'preview') }} aria-label="Preview of your profile image"></canvas>
								<span class="help">
									Preview
								</span>
							</div>
						</div>
					</div>
{#
					One action row for the card, holding both of its actions. Save is the primary and
					comes first; Remove is pushed to the far end so the two are never a pair of
					equal-looking buttons. Remove posts to a different route, so it carries its own
					form attribute rather than sitting inside this form.
#}
					<div class="cl-form-actions">
						<button class="btn btn-primary" type="submit">Save profile image</button>
						{% if profile_image_url %}
							<button class="btn btn-danger btn-sm cl-form-actions-secondary" type="submit"
							        form="remove-profile-image" data-confirm="Remove your profile image? Your initial is shown instead.">Remove image</button>
						{% endif %}
					</div>
				</form>
				{% if profile_image_url %}
					<form action="/account/profile/image/remove" method="post" id="remove-profile-image">
						<input type="hidden" name="csrf" value="{{ csrf }}">
					</form>
				{% endif %}
			</div>
		</div>
	</div>
</div>
