{#
  The identity block that used to open this page is now partials/account/identity-head.html.twig,
  included by the Account section page so that all six pages open with it rather than this one.
#}
{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Personal particulars', eyebrow: 'Personal Particulars', summary: 'Information used across your account and certificates.'}) }}
		<form action="/account/profile" method="post">{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'First name', full_width: false, for: 'field-profile-1-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="first_name" maxlength="120" value="{{ profile.first_name }}" id="field-profile-1-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Middle names', full_width: false, for: 'field-profile-2-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="middle_names" maxlength="160" value="{{ profile.middle_names }}" placeholder="Any names between your first name and surname" id="field-profile-2-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Last name', full_width: false, for: 'field-profile-3-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="last_name" maxlength="120" value="{{ profile.last_name }}" id="field-profile-3-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Identification number', full_width: false, for: 'field-profile-4-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="identification_number" maxlength="120" value="{{ profile.identification_number }}" id="field-profile-4-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Birthdate', full_width: false, for: 'field-profile-5-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input type="date" name="birthdate" value="{{ profile.birthdate }}" id="field-profile-5-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Gender', full_width: false, for: 'field-profile-6-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<select name="gender" id="field-profile-6-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}><option value="">Select</option><option {{ profile.gender=='Male' ? 'selected' : '' }}>Male</option><option {{ profile.gender=='Female' ? 'selected' : '' }}>Female</option><option {{ profile.gender=='Non-binary' ? 'selected' : '' }}>Non-binary</option><option {{ profile.gender=='Prefer not to say' ? 'selected' : '' }}>Prefer not to say</option></select>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Mobile number', full_width: false, for: 'field-profile-7-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="mobile_number" maxlength="60" value="{{ profile.mobile_number }}" id="field-profile-7-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Display name', full_width: false, for: 'field-profile-8-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="display_name" maxlength="160" value="{{ profile.display_name }}" id="field-profile-8-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Name to print on certificates', full_width: true, for: 'field-profile-9-' ~ (company.id|default('')) ~ '-' ~ (loop.index|default(0))})} %}
{% block control %}

				<input name="certificate_name" maxlength="160" value="{{ profile.certificate_name }}" id="field-profile-9-{{ company.id|default('') }}-{{ loop.index|default(0) }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

				{{ ui('action.button', {label: 'Save particulars', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}</form>

{% endblock %}
{% endembed %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {id: 'profile-image'})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Profile image', summary: 'A square picture of you, shown wherever your name appears.'}) }}
{#
		The importmap goes before any module script on the page. Themes put the platform's own
		scripts at the end of the body, so emitting it here keeps it first without asking five
		themes to carry a tag for one page.
#}
		{{ importmap() }}
		<div class="cl-profile-image-panel" {{ stimulus_controller('profile-image', {size: profile_image_size}) }}>
			<div class="cl-profile-image-current" {{ stimulus_target('profile-image', 'placeholder') }}>
				{% if profile_image_url %}
					<img class="cl-profile-image-preview" src="{{ profile_image_url }}" alt="Your current profile image" width="128" height="128">
				{% else %}
					<div class="cl-profile-image-preview cl-profile-image-empty">
						<span>{{ profile.full_name|slice(0, 1)|upper }}</span>
					</div>
				{% endif %}
				<p class="help">
					{{ profile_image_url ? 'Your image now.' : 'No image yet.' }}
				</p>
			</div>
			<div class="cl-profile-image-actions">
				<form action="/account/profile/image" method="post" enctype="multipart/form-data" data-action="submit->profile-image#capture">
					<input type="hidden" name="csrf" value="{{ csrf }}">
{#
					What the editor produced, at the stored size. Empty unless the editor ran, and
					the server falls back to the file and its own centred crop when it is.
#}
					<input type="hidden" name="edited_image" {{ stimulus_target('profile-image', 'data') }}>
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Choose an image', full_width: false, for: 'profile-image-file', required: true, help: 'PNG, JPEG or WebP, up to 8 MB. Stored as a ' ~ (profile_image_size) ~ ' by ' ~ (profile_image_size) ~ ' pixel square.'})} %}
{% block control %}

						<input type="file" id="profile-image-file" name="image" accept="image/png,image/jpeg,image/webp" required
						       {{ stimulus_target('profile-image', 'file') }} data-action="change->profile-image#choose" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
{#
					The editor. Hidden until a file is chosen, and never shown at all without
					JavaScript - the file input above is the whole control then, and the server
					takes a centred square.
#}
					<div class="cl-image-editor" {{ stimulus_target('profile-image', 'editor') }} hidden>
						<div class="cl-image-editor-stage">
							<canvas class="cl-image-editor-canvas" width="320" height="320"
							        {{ stimulus_target('profile-image', 'stage') }}
							        data-action="pointerdown->profile-image#onPointerDown"
							        aria-label="Drag to move the picture inside the frame"></canvas>
							<div class="cl-image-editor-mask" aria-hidden="true">
							</div>
						</div>
						<div class="cl-image-editor-controls">
							<div class="cl-image-editor-buttons">
								{{ ui('action.button', {label: '↺ Left', variant: 'secondary', size: 'small', type: 'button', title: 'Rotate a quarter turn anticlockwise', stimulus_action: 'profile-image#rotateLeft'}) }}
								{{ ui('action.button', {label: '↻ Right', variant: 'secondary', size: 'small', type: 'button', title: 'Rotate a quarter turn clockwise', stimulus_action: 'profile-image#rotateRight'}) }}
								{{ ui('action.button', {label: 'Reset', variant: 'secondary', size: 'small', type: 'button', title: 'Back to the starting position', stimulus_action: 'profile-image#recentre'}) }}
							</div>
							{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Size', full_width: false, for: 'profile-image-zoom', help: 'Drag the picture to choose what the square holds.'})} %}
{% block control %}

								<input type="range" id="profile-image-zoom" min="1" max="4" step="0.02" value="1"
								       {{ stimulus_target('profile-image', 'zoom') }} data-action="input->profile-image#zoom" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
							<div class="cl-image-editor-preview">
								<canvas width="96" height="96" {{ stimulus_target('profile-image', 'preview') }} aria-label="Preview of your profile image"></canvas>
								<span class="help">
									Preview
								</span>
							</div>
						</div>
					</div>
{#
					One action row for the card, holding both of its actions. Save is the primary and
					comes first; Remove is pushed to the far end so the two are never a pair of
					equal-looking buttons. Remove posts to a different route, so it carries its own
					form attribute rather than sitting inside this form.
#}
					{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

						{{ ui('action.button', {label: 'Save profile image', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% block secondary_actions %}
{% if profile_image_url %}
							{{ ui('action.button', {label: 'Remove image', variant: 'danger', size: 'small', type: 'submit', confirm: 'Remove your profile image? Your initial is shown instead.', form: 'remove-profile-image', icon: 'action-remove'}) }}
						{% endif %}

{% endblock %}
{% endembed %}
				</form>
				{% if profile_image_url %}
					<form action="/account/profile/image/remove" method="post" id="remove-profile-image">
						<input type="hidden" name="csrf" value="{{ csrf }}">
					</form>
				{% endif %}
			</div>
		</div>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
