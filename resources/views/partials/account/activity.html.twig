{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Account activity', eyebrow: 'Activity', summary: 'Recent actions recorded for this account. Login sessions are managed separately under Sessions.'}) }}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 13, label: 'Time'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 31, label: 'Activity'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 30, label: 'Subject'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 13, label: 'IP'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 13, label: 'Location'}} %}
					</tr>

{% endblock %}
{% block body %}

					{% for event in account_activity %}
						<tr>
							<td class="small">
								{{ event.created_at }}
							</td>
							<td title="{{ event.event_label }}">
								<strong>{{ event.event_label }}</strong>
								<div class="small muted">
									{{ event.family_label }}
								</div>
							</td>
							<td title="{{ event.subject }}">
								{{ event.subject }}
							</td>
							<td>
								{{ event.ip_address ?: '—' }}
							</td>
							<td>
								{{ event.geo_location }}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}
			{% if not account_activity %}
				{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

					No account activity has been recorded yet.

{% endblock %}
{% endembed %}
			{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
