<div class="grid section">
	<div class="card">
		<div class="section-head">
			<div>
				<div class="eyebrow">
					Social Media
				</div>
				<h2>
					Links to your profiles elsewhere
				</h2>
				<p>
					Paste the full web address of each profile. Leave a field empty to remove that link.
				</p>
			</div>
		</div>
		<form action="/account/social" method="post">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			<div class="form-grid">
				{% for link in social_links %}
					<div class="field">
						<label for="social-{{ link.key }}">{{ link.label }}</label>
						<input type="url" id="social-{{ link.key }}" name="social[{{ link.key }}]" maxlength="500" value="{{ link.url }}" placeholder="{{ link.placeholder }}">
					</div>
				{% endfor %}
				<div class="field-wide cl-form-actions">
					<button class="btn btn-primary" type="submit">Save social media</button>
				</div>
			</div>
		</form>
	</div>
</div>
