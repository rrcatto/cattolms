{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Links to your profiles elsewhere', eyebrow: 'Social Media', summary: 'Paste the full web address of each profile. Leave a field empty to remove that link.'}) }}
		<form action="/account/social" method="post">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% embed ui_template('form.grid') with {props: ui_props('form.grid', {})} %}
{% block body %}

				{% for link in social_links %}
					{% embed ui_template('form.field') with {props: ui_props('form.field', {label: (link.label), full_width: false, for: 'social-' ~ (link.key)})} %}
{% block control %}

						<input type="url" id="social-{{ link.key }}" name="social[{{ link.key }}]" maxlength="500" value="{{ link.url }}" placeholder="{{ link.placeholder }}" {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
				{% endfor %}
				{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

					{{ ui('action.button', {label: 'Save social media', variant: 'primary', size: 'normal', type: 'submit'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
		</form>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
