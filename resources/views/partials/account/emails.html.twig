{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'The addresses you sign in with', eyebrow: 'Email Addresses', summary: 'Both addresses sign you in. Each one belongs to a single account across the whole platform.'}) }}
		{% embed ui_template('data.list') with {props: ui_props('data.list', {})} %}
{% block body %}

			{% for email in emails %}
				{% embed ui_template('data.list-item') with {props: ui_props('data.list-item', {})} %}
{% block body %}

						<strong>{{ email.email }}</strong>
						<p>
							{{ email.is_primary ? 'Primary address. This is the one you signed in with, and it cannot be changed.' : 'Alternative address. Verified, and it signs you in exactly as the primary does.' }}
						</p>

{% endblock %}
{% block actions %}

					{% if email.is_primary %}
						{{ ui('feedback.badge', {label: 'Primary', tone: 'permanent'}) }}
					{% else %}
						<form action="/account/email/remove" method="post">
							<input type="hidden" name="csrf" value="{{ csrf }}">
							<input type="hidden" name="email_id" value="{{ email.id }}">
							{{ ui('action.button', {label: 'Remove', variant: 'danger', size: 'small', type: 'submit', confirm: 'Remove ' ~ (email.email) ~ '? You will no longer be able to sign in with it.', icon: 'action-remove'}) }}
						</form>
					{% endif %}

{% endblock %}
{% endembed %}
			{% endfor %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Alternative address', summary: 'Add a second address you can also sign in with, or replace the one you have.'}) }}
		<form action="/account/email/secondary" method="post">
			<input type="hidden" name="csrf" value="{{ csrf }}">
			{% embed ui_template('form.field') with {props: ui_props('form.field', {label: 'Alternative email address', full_width: false, for: 'secondary-email', required: true, help: 'A verification link is sent to the address. It is added to your account only once you follow that link.'})} %}
{% block control %}

				<input type="email" id="secondary-email" name="email" required {{ ui_field_attrs(props) }}>

{% endblock %}
{% endembed %}
			{% embed ui_template('form.actions') with {props: ui_props('form.actions', {})} %}
{% block primary_actions %}

			{{ ui('action.button', {label: 'Send verification', variant: 'primary', size: 'small', type: 'submit'}) }}

{% endblock %}
{% endembed %}
		</form>

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
