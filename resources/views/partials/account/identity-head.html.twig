{% if identity_placement|default('page') == 'page' %}
{% set identity_signed_in = is_authenticated is defined and is_authenticated %}
<section class="cl-identity cl-identity-head" aria-label="Account identity">
	<div class="cl-identity-meta">
		{% if identity_signed_in %}
			{% if identity_image is defined and identity_image %}
				<img class="cl-identity-avatar" src="{{ identity_image }}" alt="" width="72" height="72">
			{% else %}
				<div class="cl-identity-avatar cl-identity-avatar-empty">
					{{ identity_name is defined and identity_name ? identity_name|slice(0, 1)|upper : '?' }}
				</div>
			{% endif %}
			<div class="cl-identity-details">
				<h2 class="cl-identity-name">
					{{ identity_name is defined ? identity_name : '' }}
				</h2>
				<p class="cl-identity-email">
					{{ identity_email is defined ? identity_email : '' }}
				</p>
				<div class="cl-identity-roles cl-mt-2">
					{% if identity_roles is defined %}
						{% for role in identity_roles %}
							{{ ui('feedback.badge', {label: (role), tone: 'info'}) }}
						{% endfor %}
					{% endif %}
					{% if identity_status is defined and identity_status %}
						{{ ui('feedback.badge', {label: (identity_status), tone: 'success'}) }}
					{% endif %}
				</div>
			</div>
			{# The account reference at the band's right edge under its label, opening the person's profile (owner, 2026-10-21:
			   "right align the Account Reference number and link it to the person's profile", then "Put the label
			   "Account Reference:" in a line above it. Without a label, people will not know what it is"). #}
			{% if identity_reference|default('') %}
				<div class="cl-identity-account">
					<span class="cl-identity-account-label">Account Reference:</span>
					<a class="cl-identity-reference" href="/account/profile" title="Open your profile">{{ identity_reference|account_reference }}</a>
				</div>
			{% endif %}
		{% else %}
			<div class="cl-identity-avatar cl-identity-avatar-empty cl-identity-head-anonymous" aria-hidden="true">
				<svg width="34" height="34" viewBox="0 0 24 24"><use href="{{ platform.icon_sprite }}#nav-account"></use></svg>
			</div>
			<div class="cl-identity-details">
				<h2 class="cl-identity-name">
					Welcome to {{ app.name }}
				</h2>
				<p class="cl-identity-email">
					Sign in to see your courses, or register to start one.
				</p>
				<div class="cl-identity-roles cl-mt-2">
					{{ ui('action.link', {label: 'Sign in', variant: 'primary', size: 'small', href: '/login', icon: 'nav-signin'}) }}
                    {{ ui('action.link', {label: 'Register', variant: 'secondary', size: 'small', href: '/register', icon: 'action-register'}) }}
				</div>
			</div>
		{% endif %}
	</div>
</section>
{% endif %}
