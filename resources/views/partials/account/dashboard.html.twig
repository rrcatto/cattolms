{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Your learning at a glance', eyebrow: 'Dashboard', summary: 'Learning progress, course history and account statistics.'}) }}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {})} %}
{% block body %}

	{{ ui('data.stat-card', {value: (account_stats.current_courses), label: 'Current courses', note: 'Assigned or in progress'}) }}
	{{ ui('data.stat-card', {value: (account_stats.completed_courses), label: 'Completed', note: 'Courses completed'}) }}
	{{ ui('data.stat-card', {value: (account_stats.certificates), label: 'Certificates', note: 'Issued certificates'}) }}
	{{ ui('data.stat-card', {value: (account_stats.average_progress) ~ '%', label: 'Current progress', note: 'Average active-course progress'}) }}

{% endblock %}
{% endembed %}
{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 'auto', section_spacing: true})} %}
{% block body %}

	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Course history', eyebrow: 'Course History', summary: 'Every course assigned to this account, including completion result and certificate status.'}) }}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 50, label: 'Course'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Status'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Progress'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Grade'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Certificate'}} %}
					</tr>

{% endblock %}
{% block body %}

					{% for course in account_courses %}
						<tr>
							<td>
								<strong>{{ course.title }}</strong>
								<div class="small muted">
									{{ course.category_name }}
								</div>
							</td>
							<td>
								{{ course.status }}
							</td>
							<td>
								{{ course.progress_percentage }}%
							</td>
							<td>
								{{ course.overall_grade_code ?: '—' }}
							</td>
							<td>
								{% if course.certificate_public_id %}
									{{ ui('feedback.badge', {label: 'Issued', tone: 'success'}) }} {{ ui('action.link', {label: 'View', variant: 'secondary', size: 'small', href: '/certificates/' ~ (course.certificate_public_id)}) }}
								{% else %}
									<span class="muted">Not issued</span>
								{% endif %}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}
			{% if not account_courses %}
				{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

					No courses have been assigned yet.

{% endblock %}
{% endembed %}
			{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
