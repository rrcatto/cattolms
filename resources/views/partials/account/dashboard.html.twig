	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Your learning at a glance', eyebrow: 'Dashboard', summary: 'Learning progress, course history and account statistics.'}) }}
		<p>Your account reference: <strong>{{ account_reference_label }}</strong>. Quote it as the reference when you pay by EFT.</p>
		{# The figures sit in the card they summarise, four to a row, each with its icon and opening what it counts (owner,
		   2026-10-21: "Dashboard cards also need svg icons"). #}
		{% embed ui_template('data.stat-grid') with {props: ui_props('data.stat-grid', {columns: 4})} %}
		{% block body %}

			{{ ui('data.stat-card', {value: (account_stats.current_courses), label: 'Current courses', note: 'Assigned or in progress', icon: 'figure-courses', href: '/account/courses'}) }}
			{{ ui('data.stat-card', {value: (account_stats.completed_courses), label: 'Completed', note: 'Courses completed', icon: 'figure-completed', href: '/account/courses?list=completed'}) }}
			{{ ui('data.stat-card', {value: (account_stats.certificates), label: 'Certificates', note: 'Issued certificates', icon: 'figure-certificates', href: '/account/certificates'}) }}
			{{ ui('data.stat-card', {value: (account_stats.average_progress) ~ '%', label: 'Current progress', note: 'Average active-course progress', icon: 'figure-progress', href: '/account/courses'}) }}

		{% endblock %}
		{% endembed %}

{% endblock %}
{% endembed %}
	{% if account_current_courses|default([]) %}
	{% embed ui_template('layout.section-grid') with {props: ui_props('layout.section-grid', {columns: 2, section_spacing: true})} %}
	{% block body %}
		{% for course in account_current_courses %}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {})} %}
		{% block surface_body %}
			{{ ui('layout.section-head', {heading: course.title, eyebrow: 'Your course', heading_level: 3}) }}
			{% for line in course.timing.lines %}<p>{{ line }}</p>{% endfor %}
			<p>{{ ui('action.link', {label: course.timing.state == 'not_started' ? 'Review and start' : 'Open course', variant: 'primary', size: 'small', icon: 'action-start', href: '/learn/' ~ course.slug}) }}</p>
		{% endblock %}
		{% endembed %}
		{% endfor %}
	{% endblock %}
	{% endembed %}
	{% endif %}
	{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Course history', eyebrow: 'Course History', summary: 'Every course assigned to this account, including completion result and certificate status.'}) }}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 50, label: 'Course'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Status'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Progress'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Grade', wide: true}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Certificate', wide: true}} %}
					</tr>

{% endblock %}
{% block body %}

					{% for course in account_courses %}
						<tr>
							<td>
								<strong>{{ course.title }}</strong>
								<div class="small muted">
									{{ course.category_name }}
								</div>
							</td>
							<td>
								{{ course.status }}
							</td>
							<td>
								{{ course.progress_percentage }}%
							</td>
							<td>
								{{ course.overall_grade_code ?: '—' }}
							</td>
							<td>
								{% if course.certificate_public_id %}
									{{ ui('feedback.badge', {label: 'Issued', tone: 'success'}) }} {{ ui('action.link', {label: 'View', variant: 'secondary', size: 'small', icon: 'action-view', href: '/certificates/' ~ (course.certificate_public_id)}) }}
								{% else %}
									<span class="muted">Not issued</span>
								{% endif %}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}
			{% if not account_courses %}
				{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

					No courses have been assigned yet.

{% endblock %}
{% endembed %}
			{% endif %}

{% endblock %}
{% endembed %}
