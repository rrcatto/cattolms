{#
	Course Requests (owner, 2026-11-06: its own page after Favourites, as it was a list on My Courses), only for an account
	that belongs to a company: the courses the person asked their company for, newest first, with where each request
	stands. Searched from five requests and paged like My Courses (LearningService::courseRequestsView).
#}
		{% embed ui_template('layout.surface') with {props: ui_props('layout.surface', {section_spacing: true})} %}
{% block surface_body %}

		{{ ui('layout.section-head', {heading: 'Your course requests', eyebrow: 'Course Requests', summary: 'The courses you asked your company for. Your company decides each request.'}) }}
		{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'requests', pagination: requests_pagination, search: requests_searchable ? {ds_name: 'requests', ds_label: 'Search your course requests', ds_value: requests_search, ds_action: '/account/requests'} : []})} %}
{% block results %}

				{% if requests_rows %}
					{% embed ui_template('data.table') with {props: ui_props('data.table', {caption: 'Your course requests'})} %}
{% block header %}

						<tr>
							{% include '@CattoPHP/ui/data/sortable-header.html.twig' with {sh: {sortable: false, width: 58, label: 'Course'}} %}
							{% include '@CattoPHP/ui/data/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Requested', wide: true}} %}
							{% include '@CattoPHP/ui/data/sortable-header.html.twig' with {sh: {sortable: false, width: 16, label: 'Status'}} %}
							{% include '@CattoPHP/ui/data/sortable-header.html.twig' with {sh: {sortable: false, width: 14, label: 'Actions'}} %}
						</tr>

{% endblock %}
{% block body %}

						{% for request in requests_rows %}
							<tr>
								<td>
									<strong>{{ request.course_title }}</strong>
								</td>
								<td class="small">
									{{ request.requested_at }}
								</td>
								<td>
									{{ ui('feedback.badge', {label: (request.status), tone: request.status=='pending' ? 'warning' : 'info'}) }}
								</td>
								<td class="cell-actions">
									{{ ui('action.link', {label: 'View course', variant: 'secondary', size: 'small', href: '/courses/' ~ (request.slug), icon: 'action-view'}) }}
								</td>
							</tr>
						{% endfor %}

{% endblock %}
{% endembed %}
				{% else %}
					{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

						{{ requests_search ? 'Nothing in your course requests matches your search.' : 'No course requests.' }}

{% endblock %}
{% endembed %}
				{% endif %}

{% endblock %}
{% endembed %}

{% endblock %}
{% endembed %}
