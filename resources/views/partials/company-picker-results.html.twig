{% embed ui_template('data.dataset') with {props: ui_props('data.dataset', {name: 'picker', pagination: picker_pagination, search: {ds_name: 'picker', ds_label: 'Search companies', ds_value: picker_search, ds_action: '/company/picker'}})} %}
{% block results %}

	{% if picker_companies %}

			{% embed ui_template('data.table') with {props: ui_props('data.table', {})} %}
{% block header %}

					<tr>
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 36, label: 'Company'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 34, label: 'Domain'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 12, label: 'Status'}} %}
						{% include '@platform/partials/sortable-header.html.twig' with {sh: {sortable: false, width: 18, label: 'Actions'}} %}
					</tr>

{% endblock %}
{% block body %}

					{% for company in picker_companies %}
						<tr>
							<td>
								<strong>{{ company.name }}</strong>
								{% if company.is_system %}
									{{ ui('feedback.badge', {label: 'System', tone: 'permanent'}) }}
								{% endif %}
							</td>
							<td class="mono small">
								{{ company.domain }}
							</td>
							<td>
								{{ ui('feedback.badge', {label: (company.status_label), tone: company.status=='active' ? 'success' : 'danger'}) }}
							</td>
							<td class="cell-actions">
								{% if company.id == company_context_id %}
									{{ ui('feedback.badge', {label: 'Administering', tone: 'success'}) }}
								{% else %}
									{% if company.status=='active' %}
										<form action="/company/context" method="post">
											<input type="hidden" name="csrf" value="{{ csrf }}">
											<input type="hidden" name="company_id" value="{{ company.id }}">
											{{ ui('action.button', {label: 'Manage', variant: 'primary', size: 'small', type: 'submit'}) }}
										</form>
									{% else %}
										<span class="muted small">Disabled</span>
									{% endif %}
								{% endif %}
							</td>
						</tr>
					{% endfor %}

{% endblock %}
{% endembed %}

	{% else %}
		{% embed ui_template('feedback.empty') with {props: ui_props('feedback.empty', {})} %}
{% block body %}

			No companies match “{{ picker_search }}”.

{% endblock %}
{% endembed %}
	{% endif %}

{% endblock %}
{% endembed %}
