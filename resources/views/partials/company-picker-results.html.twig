<div id="picker-results">
	{% if picker_pagination %}
		{% include '@platform/partials/pagination.html.twig' with {pg: picker_pagination} %}
	{% endif %}
	{% if picker_companies %}
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th style="width:46%">
							Company
						</th>
						<th style="width:24%">
							Domain
						</th>
						<th style="width:8%">
							Data
						</th>
						<th style="width:10%">
							Status
						</th>
						<th class="cell-actions" style="width:12%">
							Actions
						</th>
					</tr>
				</thead>
				<tbody>
					{% for company in picker_companies %}
						<tr>
							<td>
								<strong>{{ company.name }}</strong>
								{% if company.is_system %}
									<span class="badge permanent">System</span>
								{% endif %}
							</td>
							<td class="mono small">
								{{ company.domain }}
							</td>
							<td>
								<span class="badge {{ company.is_seed ? 'warn' : 'info' }}">{{ company.universe_label }}</span>
							</td>
							<td>
								<span class="badge {{ company.status=='active' ? 'good' : 'danger' }}">{{ company.status_label }}</span>
							</td>
							<td class="cell-actions">
								{% if company.id == company_context_id %}
									<span class="badge good">Administering</span>
								{% else %}
									{% if company.status=='active' %}
										<form action="/company/context" method="post">
											<input type="hidden" name="csrf" value="{{ csrf }}">
											<input type="hidden" name="company_id" value="{{ company.id }}">
											<button class="btn btn-primary btn-sm" type="submit">Manage</button>
										</form>
									{% else %}
										<span class="muted small">Disabled</span>
									{% endif %}
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		{% if picker_pagination %}
			{% include '@platform/partials/pagination.html.twig' with {pg: picker_pagination} %}
		{% endif %}
	{% else %}
		<p class="empty">
			No companies match “{{ picker_search }}”.
		</p>
	{% endif %}
</div>
