{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catto Learning Theme 3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "template_api", "theme"],
  "properties": {
    "format": {"const": "catto-learning-theme"},
    "schema_version": {"const": "3.0"},
    "template_api": {"const": "1.0"},
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "version", "author", "created_at", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"},
        "author": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "parent": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"}
          }
        }
      ]
    },
    "styles": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^css/.+\\.css$"}
    },
    "scripts": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^js/.+\\.js$"}
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styles": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
        "scripts": {"type": "array", "items": {"type": "string", "pattern": "^https://"}}
      }
    },
    "palettes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "colors"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "colors": {
            "type": "array", "minItems": 5, "maxItems": 5,
            "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
          }
        }
      }
    }
  }
}