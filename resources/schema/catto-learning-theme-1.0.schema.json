{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catto-learning-theme-1.0.schema.json",
  "title": "Catto Learning Theme Package 1.0",
  "type": "object",
  "required": ["format", "schema_version", "theme", "templates", "stylesheets"],
  "properties": {
    "format": {"const": "catto-learning-theme"},
    "schema_version": {"const": "1.0"},
    "theme": {
      "type": "object",
      "required": ["name", "version", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string"},
        "version": {"type": "string", "minLength": 1},
        "author": {"type": "string"},
        "generated_by": {"type": "string"},
        "created_at": {"type": "string"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "templates": {
      "type": "object",
      "required": ["base"],
      "properties": {
        "base": {"type": "string", "pattern": "\\.html$"},
        "header": {"type": ["string", "null"]},
        "footer": {"type": ["string", "null"]},
        "sidebar": {"type": ["string", "null"]}
      },
      "additionalProperties": {"type": ["string", "null"]}
    },
    "pages": {"type": "object", "additionalProperties": {"type": "string", "pattern": "\\.html$"}},
    "stylesheets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\.css$"}},
    "scripts": {"type": "array", "items": {"type": "string", "pattern": "\\.js$"}},
    "assets": {"type": "array", "items": {"type": "string"}},
    "external": {
      "type": "object",
      "properties": {
        "stylesheets": {"type": "array"},
        "scripts": {"type": "array"}
      }
    },
    "palettes": {"type": "object"},
    "active_palette": {"type": "string"},
    "design": {"type": "object"},
    "advanced_css": {"type": ["string", "null"]}
  }
}
